---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import { locations } from '../../data/locations.js';

export async function getStaticPaths() {
  const { locations } = await import('../../data/locations.js');
  return locations.map((loc) => ({
    params: { city: loc.citySlug, service: loc.serviceSlug },
    props: { loc },
  }));
}

const { loc } = Astro.props;
const canonical = `https://onwardcraft.com/${loc.citySlug}/${loc.serviceSlug}/`;
const CALENDLY = 'https://calendly.com/getonwardcraft/30min';

const sameCity = locations.filter(
  (l) => l.citySlug === loc.citySlug && l.serviceSlug !== loc.serviceSlug
);

// ── Ranking-climb line chart geometry (illustrative projection) ──
const rt = loc.proof.rankTrajectory;
const W = 320, H = 150, padX = 22, padT = 18, padB = 26;
const maxPos = Math.max(...rt.map((p) => p.pos));
const minPos = Math.min(...rt.map((p) => p.pos));
const lx = (i) => padX + (i / (rt.length - 1)) * (W - padX * 2);
const ly = (pos) => padT + ((pos - minPos) / (maxPos - minPos)) * (H - padT - padB);
const linePts = rt.map((p, i) => `${lx(i).toFixed(1)},${ly(p.pos).toFixed(1)}`).join(' ');
const areaPts = `${lx(0).toFixed(1)},${H - padB} ` + linePts + ` ${lx(rt.length - 1).toFixed(1)},${H - padB}`;

// ── Structured data (Review/AggregateRating intentionally omitted — honesty rule) ──
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `${loc.city} ${loc.service}`,
    serviceType: `${loc.service} for ${loc.city}, ${loc.stateAbbr} businesses`,
    description: loc.metaDescription,
    url: canonical,
    provider: { '@id': 'https://onwardcraft.com/#organization' },
    areaServed: loc.areasServed.map((a) => ({ '@type': 'City', name: `${a}, ${loc.stateAbbr}` })),
    audience: { '@type': 'Audience', audienceType: 'Home-service contractors and local businesses' },
    offers: loc.pricing.tiers.map((t) => ({
      '@type': 'Offer',
      name: t.name,
      price: t.price.replace(/[^0-9]/g, ''),
      priceCurrency: 'USD',
      description: t.desc,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: loc.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://onwardcraft.com/' },
      { '@type': 'ListItem', position: 2, name: loc.city, item: `https://onwardcraft.com/${loc.citySlug}/` },
      { '@type': 'ListItem', position: 3, name: loc.service, item: canonical },
    ],
  },
];
---

<Layout title={loc.titleTag} description={loc.metaDescription} canonical={canonical} schema={schema}>
  <Navbar dark />

  <main class="loc">
    <!-- Hero (dark) -->
    <section class="loc-hero">
      <div class="hero-orb orb-1" aria-hidden="true"></div>
      <div class="hero-orb orb-2" aria-hidden="true"></div>
      <div class="hero-grid-lines" aria-hidden="true"></div>
      <div class="container loc-hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span>
          <span class="breadcrumb-current">{loc.city} {loc.service}</span>
        </nav>
        <p class="eyebrow"><span class="eyebrow-dot"></span>{loc.eyebrow}</p>
        <h1>{loc.h1}</h1>
        <p class="h2-exact">{loc.h2Exact}</p>
        <p class="hero-sub">{loc.heroSubhead}</p>
        <div class="hero-actions">
          <a href={CALENDLY} class="btn-primary" rel="noopener noreferrer">{loc.primaryCta}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/pricing/" class="btn-ghost">See pricing</a>
        </div>
        <ul class="hero-proof">
          {loc.heroProof.map((p) => (
            <li>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
              {p}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Founder note -->
    <section class="section founder-section">
      <div class="container">
        <figure class="founder-note">
          <span class="quote-mark" aria-hidden="true">&ldquo;</span>
          <blockquote>{loc.founderNote}</blockquote>
          <figcaption>{loc.founderName}</figcaption>
        </figure>
      </div>
    </section>

    <!-- Intro + AI answer block -->
    <section class="section pt-0">
      <div class="container">
        <p class="lead">{loc.intro}</p>
        <div class="answer-block">
          <p class="answer-q">{loc.aioQuestion}</p>
          <p>{loc.aioAnswer}</p>
        </div>
      </div>
    </section>

    <!-- ★ Local market (with charts) -->
    <section class="section section-alt">
      <div class="container">
        <div class="market-head">
          <p class="eyebrow">The {loc.metro} market</p>
          <h2>{loc.localMarket.heading}</h2>
        </div>
        <div class="market-grid">
          <div class="market-copy">
            <p>{loc.localMarket.body}</p>
            <p class="pull-quote">{loc.localMarket.pullQuote}</p>
          </div>

          <div class="bento">
            <!-- Donut (metro's headline data point) -->
            <div class="viz-card">
              <span class="viz-title">{loc.localMarket.donut.title}</span>
              <div class="donut-wrap">
                <div class="donut-figure">
                  <div class="donut" style={`--pct:${loc.localMarket.donut.value}`}></div>
                  <div class="donut-center">
                    <strong>{loc.localMarket.donut.value}%</strong>
                    <span>{loc.localMarket.donut.centerLabel}</span>
                  </div>
                </div>
                <ul class="donut-legend">
                  {loc.localMarket.donut.legend.map((g) => (
                    <li><span class={`dot dot-${g.kind}`}></span>{g.label} · {g.pct}%</li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- Seasonal demand bars -->
            <div class="viz-card">
              <span class="viz-title">{loc.localMarket.seasonTitle}</span>
              <div class="season-chart">
                {loc.localMarket.seasonalDemand.map((d) => (
                  <div class={`season-bar${d.peak ? ' peak' : ''}`} style={`height:${d.v}%`}></div>
                ))}
              </div>
              <div class="season-labels">
                {loc.localMarket.seasonalDemand.map((d) => <span>{d.m}</span>)}
              </div>
              <span class="viz-cap"><span class="swatch"></span>{loc.localMarket.seasonCaption}</span>
            </div>

            <div class="stat">
              <span class="stat-value">{loc.localMarket.stats[0].value}</span>
              <span class="stat-label">{loc.localMarket.stats[0].label}</span>
            </div>
            <div class="stat stat-accent">
              <span class="stat-value">{loc.localMarket.stats[3].value}</span>
              <span class="stat-label">{loc.localMarket.stats[3].label}</span>
            </div>
          </div>
        </div>

        <div class="neighborhoods">
          <span class="neighborhoods-label">Neighborhoods we target</span>
          <div class="chips">
            {loc.localMarket.neighborhoods.map((n) => <span class="chip">{n}</span>)}
          </div>
        </div>
      </div>
    </section>

    <!-- Problem (PAS) + Map Pack illustration -->
    <section class="section">
      <div class="container">
        <div class="problem-layout">
          <div class="problem-main">
            <div class="section-head">
              <p class="eyebrow">The real problem</p>
              <h2>{loc.problemHeading}</h2>
            </div>
            <div class="problem-rows">
              {loc.painPoints.map((p, i) => (
                <div class="problem-row">
                  <span class="problem-num">{String(i + 1).padStart(2, '0')}</span>
                  <div class="problem-body">
                    <h3>{p.title}</h3>
                    <p>{p.body}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <aside class="mappack" aria-label="Illustration of Google's local 3-pack">
            <div class="mappack-bar">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
              <span>{loc.service.toLowerCase().includes('seo') ? 'roofers near me' : 'service near me'}</span>
            </div>
            <ul class="mappack-list">
              <li class="mp-row mp-you">
                <span class="mp-pin">1</span>
                <div class="mp-info"><strong>Your business</strong><span class="mp-stars">★★★★★</span></div>
                <span class="mp-tag">You</span>
              </li>
              <li class="mp-row">
                <span class="mp-pin">2</span>
                <div class="mp-info"><strong>A competitor</strong><span class="mp-stars muted">★★★★☆</span></div>
              </li>
              <li class="mp-row">
                <span class="mp-pin">3</span>
                <div class="mp-info"><strong>Another competitor</strong><span class="mp-stars muted">★★★★☆</span></div>
              </li>
            </ul>
            <span class="viz-cap">Illustration of Google's local 3-pack. The top three take most of the clicks.</span>
          </aside>
        </div>
      </div>
    </section>

    <!-- Services -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">What we do</p>
          <h2>{loc.servicesHeading}</h2>
        </div>
        <div class="service-grid">
          {loc.services.map((s) => (
            <div class={`service-card${s.featured ? ' service-card-featured' : ''}`}>
              {s.featured && <span class="service-tag">Miami edge</span>}
              <h3>{s.name}</h3>
              <p>{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Process (timeline) -->
    <section class="section">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">How we work</p>
          <h2>{loc.processName}</h2>
        </div>
        <ol class="timeline">
          {loc.process.map((step, i) => (
            <li class="timeline-item">
              <span class="timeline-num">{i + 1}</span>
              <h3>{step.name}</h3>
              <p>{step.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ★ Proof / projection (charts) -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">The honest math</p>
          <h2>{loc.proof.heading}</h2>
        </div>
        <p class="lead">{loc.proof.body}</p>

        <div class="proof-grid">
          <!-- Benchmark bar chart -->
          <div class="chart-card">
            <span class="viz-title">Why local search converts</span>
            <div class="bar-chart">
              {loc.proof.stats.map((s) => (
                <div class="bar-col">
                  <div class="bar-track">
                    <div class="bar-fill" style={`height:${s.n}%`}><span>{s.value}</span></div>
                  </div>
                  <span class="bar-label">{s.label}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Ranking climb line chart -->
          <div class="chart-card">
            <span class="viz-title">Projected map-pack climb</span>
            <svg class="linechart" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Illustrative ranking climb from position 14 to top 3 over 180 days">
              <defs>
                <linearGradient id="lcGrad" x1="0" x2="0" y1="0" y2="1">
                  <stop offset="0%" stop-color="rgba(6,214,160,0.28)" />
                  <stop offset="100%" stop-color="rgba(6,214,160,0)" />
                </linearGradient>
              </defs>
              <polyline class="lc-area" points={areaPts} />
              <polyline class="lc-line" points={linePts} />
              {rt.map((p, i) => <circle class="lc-dot" cx={lx(i)} cy={ly(p.pos)} r="3.5" />)}
            </svg>
            <div class="lc-axis">
              {rt.map((p) => <span>{p.d}</span>)}
            </div>
            <span class="viz-cap">Avg. position (lower = better). Illustrative projection, not a claimed result.</span>
          </div>
        </div>

        <div class="answer-block">
          <p>{loc.proof.projection}</p>
        </div>
        <p class="disclaimer">{loc.proof.disclaimer}</p>
      </div>
    </section>

    <!-- ★ Pricing -->
    <section class="section">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Transparent pricing</p>
          <h2>{loc.pricing.heading}</h2>
          <p class="section-sub">{loc.pricing.note}</p>
        </div>
        <div class="pricing-grid">
          {loc.pricing.tiers.map((t) => (
            <div class={`price-card${t.featured ? ' price-card-featured' : ''}`}>
              {t.featured && <span class="price-badge">Most popular</span>}
              <h3>{t.name}</h3>
              <div class="price"><span class="price-amt">{t.price}</span><span class="price-cad">{t.cadence}</span></div>
              <p class="price-desc">{t.desc}</p>
              <ul class="price-features">
                {t.features.map((f) => (
                  <li>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
                    {f}
                  </li>
                ))}
              </ul>
              <a href={CALENDLY} class={t.featured ? 'btn-primary price-cta' : 'btn-ghost-light price-cta'} rel="noopener noreferrer">Start with a free audit</a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Why us -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Why us</p>
          <h2>Why {loc.city} businesses pick OnwardCraft</h2>
        </div>
        <div class="why-grid">
          {loc.whyUs.map((w) => (
            <div class="why-card">
              <h3>{w.title}</h3>
              <p>{w.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">{loc.city} {loc.service} FAQ</p>
          <h2>Questions {loc.city} owners ask us</h2>
        </div>
        <div class="faq-list">
          {loc.faqs.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Areas served -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Areas we serve</p>
          <h2>{loc.service} across {loc.metro}</h2>
        </div>
        <div class="chips">
          {loc.areasServed.map((a) => <span class="chip">{a}</span>)}
        </div>
        {sameCity.length > 0 && (
          <div class="service-links">
            <span>More for {loc.city} businesses:</span>
            {sameCity.map((l) => (
              <a href={`/${l.citySlug}/${l.serviceSlug}/`}>{l.service}</a>
            ))}
          </div>
        )}
      </div>
    </section>
  </main>

  <FinalCTA dark />
  <Footer />
</Layout>

<style>
  /* Light content palette — hero stays dark, everything below is light. */
  .loc {
    --l-bg: #FFFFFF;
    --l-alt: #F4F7FB;
    --l-ink: #0E1B33;
    --l-body: #475067;
    --l-muted: #6B7791;
    --l-border: rgba(14, 27, 51, 0.10);
    --l-border-2: rgba(14, 27, 51, 0.16);
    --l-teal: #06D6A0;
    --l-teal-ink: #07866A;
    --l-gold: #E08A0B;
    --l-gold-soft: #FFF6E8;
    --l-teal-soft: #E9FBF5;
    --l-shadow: 0 1px 2px rgba(14,27,51,0.05), 0 10px 30px rgba(14,27,51,0.06);
    background: var(--l-bg);
    color: var(--l-ink);
  }
  .container { max-width: var(--container, 1140px); margin: 0 auto; padding: 0 40px; }

  /* ── Hero (dark) ── */
  .loc-hero { position: relative; padding: 168px 0 90px; overflow: hidden; background: var(--bg-primary); color: var(--text-primary); }
  .hero-orb { position: absolute; border-radius: 50%; filter: blur(80px); pointer-events: none; opacity: 0.5; }
  .orb-1 { top: -120px; right: -80px; width: 520px; height: 520px; background: radial-gradient(circle, rgba(6,214,160,0.22), transparent 70%); }
  .orb-2 { bottom: -160px; left: -120px; width: 460px; height: 460px; background: radial-gradient(circle, rgba(255,184,77,0.10), transparent 70%); }
  .hero-grid-lines { position: absolute; inset: 0;
    background-image: linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 80% 60% at 60% 0%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 60% 0%, #000 30%, transparent 75%); pointer-events: none; }
  /* Full container width so the hero's left edge lines up with every other section. */
  .loc-hero-inner { position: relative; z-index: 1; }

  .breadcrumb { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: 13px; color: var(--text-muted); margin-bottom: 30px; }
  .breadcrumb a { color: var(--text-secondary); text-decoration: none; transition: color 0.2s; }
  .breadcrumb a:hover { color: var(--accent-primary); }
  .breadcrumb-current { color: var(--text-primary); font-weight: 600; }

  .loc-hero h1 { font-family: var(--font-heading); font-size: clamp(34px, 5.2vw, 60px); font-weight: 800; line-height: 1.02; letter-spacing: -0.035em; margin-bottom: 14px; max-width: 16ch; color: var(--text-primary); }
  .h2-exact { font-family: var(--font-heading); font-size: 17px; font-weight: 600; color: var(--text-muted); margin-bottom: 24px; }
  .hero-sub { font-size: clamp(17px, 2vw, 21px); color: var(--text-secondary); line-height: 1.6; max-width: 640px; margin-bottom: 34px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 30px; }
  .btn-ghost { display: inline-flex; align-items: center; gap: 8px; padding: 15px 26px; border-radius: 100px; border: 1px solid rgba(6,214,160,0.28); color: var(--text-primary); text-decoration: none; font-weight: 600; transition: all 0.3s; }
  .btn-ghost:hover { border-color: var(--accent-primary); background: rgba(6,214,160,0.06); }
  .hero-proof { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 10px 22px; }
  .hero-proof li { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; color: var(--text-secondary); }
  .hero-proof svg { color: var(--accent-primary); }
  .loc-hero .eyebrow { color: var(--accent-primary); }
  .loc-hero .eyebrow-dot { background: var(--accent-primary); box-shadow: 0 0 0 4px rgba(6,214,160,0.18); }

  /* ── Eyebrow (shared) ── */
  .eyebrow { display: inline-flex; align-items: center; gap: 9px; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--l-teal-ink); margin-bottom: 16px; }
  .eyebrow-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--l-teal); }

  /* ── Sections (light) ── */
  .section { padding: 88px 0; background: var(--l-bg); }
  .section.pt-0 { padding-top: 0; }
  .section-alt { background: var(--l-alt); }
  .section-head { max-width: 720px; margin-bottom: 46px; }
  .section-head h2, .market-head h2 { font-family: var(--font-heading); font-size: clamp(26px, 3.6vw, 40px); font-weight: 700; line-height: 1.12; letter-spacing: -0.025em; margin-bottom: 16px; color: var(--l-ink); }
  .section-sub { font-size: 16px; color: var(--l-muted); line-height: 1.7; }
  .lead { font-size: clamp(18px, 2.1vw, 23px); line-height: 1.55; color: var(--l-ink); margin-bottom: 30px; letter-spacing: -0.01em; max-width: 860px; }

  .answer-block { border-left: 3px solid var(--l-teal); background: var(--l-teal-soft); border-radius: 0 14px 14px 0; padding: 24px 28px; max-width: 860px; }
  .answer-q { font-family: var(--font-heading); font-size: 19px; font-weight: 700; margin-bottom: 10px; color: var(--l-ink); }
  .answer-block p { font-size: 16px; line-height: 1.7; color: var(--l-body); margin: 0; }

  /* ── Founder note ── */
  .founder-section { padding: 70px 0; }
  .founder-note { position: relative; margin: 0; padding: 8px 0 0; max-width: 940px; }
  .quote-mark { position: absolute; top: -30px; left: -8px; font-family: var(--font-heading); font-size: 120px; line-height: 1; color: rgba(6,214,160,0.16); pointer-events: none; }
  .founder-note blockquote { margin: 0; position: relative; z-index: 1; font-size: clamp(19px, 2.4vw, 27px); line-height: 1.5; font-weight: 500; letter-spacing: -0.015em; color: var(--l-ink); }
  .founder-note figcaption { margin-top: 22px; font-size: 14px; color: var(--l-muted); display: flex; align-items: center; gap: 12px; }
  .founder-note figcaption::before { content: ''; width: 28px; height: 1px; background: var(--l-teal); }

  /* ── Local market + bento ── */
  .market-head { margin-bottom: 44px; }
  .market-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 48px; align-items: start; }
  .market-copy p { font-size: 16px; line-height: 1.8; color: var(--l-body); margin: 0 0 22px; }
  .pull-quote { font-family: var(--font-heading); font-size: 20px !important; line-height: 1.4 !important; font-weight: 600; color: var(--l-ink) !important; padding-left: 18px; border-left: 3px solid var(--l-gold); margin-bottom: 0 !important; }

  .bento { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .stat { background: var(--l-bg); border: 1px solid var(--l-border); border-radius: 16px; padding: 22px; box-shadow: var(--l-shadow); }
  .stat-accent { background: var(--l-gold-soft); border-color: rgba(224,138,11,0.28); }
  .stat-accent .stat-value { color: var(--l-gold); }
