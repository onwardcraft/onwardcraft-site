---
import '../../styles/guide.css';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Newsletter from '../../components/Newsletter.astro';
import { SITE, AUTHOR } from '../../data/site.js';
import { locations } from '../../data/locations.js';
import { nearbyCities } from '../../data/related.js';
import { GUIDE_TOPICS, GUIDE_ORDER, COST_DISCLAIMER } from '../../data/guides.js';
import { PUBLISHED_ISO, PUBLISHED_LABEL } from '../../data/posts.js';

export async function getStaticPaths() {
  const { locations } = await import('../../data/locations.js');
  return locations.map((loc) => ({
    params: { city: loc.citySlug, service: loc.serviceSlug },
    props: { loc },
  }));
}

const { loc } = Astro.props;
const topic = GUIDE_TOPICS[loc.serviceSlug];
const canonical = `${SITE.url}/${loc.citySlug}/${loc.serviceSlug}/`;

const heading = topic.title(loc.city);
const dek = topic.dek(loc.city);

// The sibling guide for this same metro, plus the same guide in neighbouring
// metros. This sideways mesh is what keeps 480 location pages out of a crawl
// cul-de-sac behind the single /locations/ hub.
const sibling = locations.find(
  (l) => l.citySlug === loc.citySlug && l.serviceSlug !== loc.serviceSlug
);
const nearby = nearbyCities(loc.citySlug, 8);

const market = loc.localMarket;
const peak = Math.max(...(market.seasonalDemand?.map((d) => d.v) ?? [1]));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    '@id': `${canonical}#article`,
    headline: heading,
    description: dek,
    url: canonical,
    inLanguage: SITE.language,
    datePublished: PUBLISHED_ISO,
    dateModified: PUBLISHED_ISO,
    author: { '@id': `${SITE.url}/#desk` },
    publisher: { '@id': `${SITE.url}/#organization` },
    isPartOf: { '@id': `${SITE.url}/#blog` },
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    about: [
      { '@type': 'Thing', name: topic.label },
      { '@type': 'City', name: `${loc.city}, ${loc.stateAbbr}` },
    ],
    contentLocation: {
      '@type': 'City',
      name: loc.city,
      address: { '@type': 'PostalAddress', addressLocality: loc.city, addressRegion: loc.stateAbbr, addressCountry: 'US' },
    },
  },
  ...(loc.faqs.length > 0
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          '@id': `${canonical}#faq`,
          mainEntity: loc.faqs.map((f) => ({
            '@type': 'Question',
            name: f.q,
            acceptedAnswer: { '@type': 'Answer', text: f.a },
          })),
        },
      ]
    : []),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'City guides', item: `${SITE.url}/locations/` },
      { '@type': 'ListItem', position: 3, name: loc.city, item: `${SITE.url}/${loc.citySlug}/` },
      { '@type': 'ListItem', position: 4, name: topic.label, item: canonical },
    ],
  },
];

const title = `${heading} | ${SITE.name}`;
const description = loc.metaDescription && loc.metaDescription.length > 60 ? dek : dek;
---

<Layout title={title} description={description} canonical={canonical} ogType="article" schema={schema}>
  <div class="read-progress" id="readProgress"></div>
  <SiteHeader compact />

  <main id="main">
    <article class="guide" data-progress-target>
      <div class="container guide__grid">
        <div class="guide__main">
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/locations/">City guides</a>
            <span aria-hidden="true">/</span>
            <a href={`/${loc.citySlug}/`}>{loc.city}</a>
            <span aria-hidden="true">/</span>
            <span>{topic.label}</span>
          </nav>

          <header class="guide__head">
            <p class="kicker">{topic.desk} · {loc.metro}</p>
            <h1 class="guide__title">{heading}</h1>
            <p class="guide__dek">{dek}</p>
            <div class="guide__byline">
              <span class="guide__author">{AUTHOR.name}</span>
              <span aria-hidden="true">·</span>
              <time datetime={PUBLISHED_ISO}>{PUBLISHED_LABEL}</time>
              <span aria-hidden="true">·</span>
              <span>{loc.city}, {loc.stateAbbr}</span>
            </div>
          </header>

          <!-- Direct answer — the block AI summaries and featured snippets quote. -->
          <section class="answer" aria-labelledby="answer-h">
            <h2 id="answer-h" class="answer__q">{loc.aioQuestion}</h2>
            <p class="answer__a">{loc.aioAnswer}</p>
          </section>

          <div class="guide__body">
            <p class="lead">{loc.intro}</p>
          </div>

          <!-- ── The market ────────────────────────────────── -->
          <section class="block" aria-labelledby="market-h">
            <h2 id="market-h">{market.heading}</h2>
            <div class="guide__body">
              <p>{market.body}</p>
            </div>

            {market.pullQuote && <blockquote class="pull">{market.pullQuote}</blockquote>}

            {market.stats?.length > 0 && (
              <ul class="stats" aria-label={`${loc.city} in numbers`}>
                {market.stats.map((s) => (
                  <li>
                    <span class="stats__v">{s.value}</span>
                    <span class="stats__l">{s.label}</span>
                  </li>
                ))}
              </ul>
            )}

            {market.seasonalDemand?.length > 0 && (
              <figure class="season">
                <figcaption>
                  <strong>{market.seasonTitle || 'When demand spikes'}</strong>
                  <span>{market.seasonCaption}</span>
                </figcaption>
                <div class="season__chart" role="img" aria-label={`Relative monthly search demand in ${loc.city}. ${market.seasonCaption}`}>
                  {market.seasonalDemand.map((d) => (
                    <div class="season__col">
                      <div class:list={['season__bar', d.peak && 'is-peak']} style={`height:${Math.round((d.v / peak) * 100)}%`}></div>
                      <span class="season__m">{d.m}</span>
                    </div>
                  ))}
                </div>
                <p class="season__note">
                  Relative demand through the year, indexed to this market's own
                  peak. Illustrative — it shows the shape of the season, not
                  absolute search volume.
                </p>
              </figure>
            )}

            {market.donut && (
              <p class="inline-stat">
                <strong>{market.donut.value}%</strong> of {loc.city} searches in this
                category happen {market.donut.centerLabel || 'on mobile'} — which is
                why page speed and a tappable phone number decide more rankings
                here than any keyword does.
              </p>
            )}
          </section>

          <!-- ── What makes it hard ────────────────────────── -->
          <section class="block" aria-labelledby="hard-h">
            <h2 id="hard-h">What makes ranking in {loc.city} hard</h2>
            <ol class="numbered">
              {loc.painPoints.map((p) => (
                <li>
                  <h3>{p.title}</h3>
                  <p>{p.body}</p>
                </li>
              ))}
            </ol>
          </section>

          <!-- ── What moves the needle ─────────────────────── -->
          <section class="block" aria-labelledby="factors-h">
            <h2 id="factors-h">{loc.servicesHeading}</h2>
            <p class="block__intro">
              In rough order of how much each one tends to move a {loc.city}{' '}
              listing. Work top down; the first three account for most of it.
            </p>
            <ul class="factors">
              {loc.services.map((s) => (
                <li>
                  <h3>{s.name}</h3>
                  <p>{s.desc}</p>
                </li>
              ))}
            </ul>
          </section>

          <Newsletter
            variant="inline"
            heading={`More guides like the ${loc.city} one`}
            blurb="One SEO email every other week. New city guides, what changed in local search, and the checklist to act on it. Free — we sell nothing."
            location="guide-inline"
          />

          <!-- ── The plan ──────────────────────────────────── -->
          <section class="block" aria-labelledby="plan-h">
            <h2 id="plan-h">A running order you can follow yourself</h2>
            <p class="block__intro">
              Nothing here needs an agency. It needs sequence — doing step four
              before step one is the most common way this work stalls.
            </p>
            <ol class="steps">
              {loc.process.map((p, i) => (
                <li>
                  <span class="steps__n">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    <h3>{p.name}</h3>
                    <p>{p.desc}</p>
                  </div>
                </li>
              ))}
            </ol>
          </section>

          <!-- ── What it costs ─────────────────────────────── -->
          {loc.pricing?.tiers?.length > 0 && (
            <section class="block" aria-labelledby="cost-h">
              <h2 id="cost-h">What this costs in {loc.city}</h2>
              <p class="block__intro">
                Three tiers of work you will be quoted for locally, and what each
                one usually includes.
              </p>
              <div class="table-wrap">
                <table class="oc-table">
                  <thead>
                    <tr>
                      <th scope="col">Tier</th>
                      <th scope="col">Typical rate</th>
                      <th scope="col">What it usually covers</th>
                    </tr>
                  </thead>
                  <tbody>
                    {loc.pricing.tiers.map((t) => (
                      <tr>
                        <th scope="row" class="tier">{t.name}</th>
                        <td class="tier__price">{t.price}<span>{t.cadence}</span></td>
                        <td>
                          <p class="tier__desc">{t.desc}</p>
                          <ul class="tier__feat">
                            {t.features.map((f) => <li>{f}</li>)}
                          </ul>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="disclaimer">{COST_DISCLAIMER}</p>
            </section>
          )}

          <!-- ── Where the searches come from ──────────────── -->
          <section class="block" aria-labelledby="areas-h">
            <h2 id="areas-h">Where the {loc.city} searches come from</h2>
            <p class="block__intro">
              Proximity is still a ranking factor, so the part of the metro you
              sit in changes what you can realistically rank for. These are the
              areas that generate the volume.
            </p>
            <ul class="areas">
              {loc.areasServed.map((a) => <li>{a}</li>)}
            </ul>
          </section>

          <!-- ── Benchmarks ────────────────────────────────── -->
          {loc.proof?.stats?.length > 0 && (
            <section class="block" aria-labelledby="bench-h">
              <h2 id="bench-h">The numbers behind all of this</h2>
              <ul class="stats stats--bench">
                {loc.proof.stats.map((s) => (
                  <li>
                    <span class="stats__v">{s.value}</span>
                    <span class="stats__l">{s.label}</span>
                  </li>
                ))}
              </ul>
              {loc.proof.disclaimer && <p class="disclaimer">{loc.proof.disclaimer}</p>}
            </section>
          )}

          <!-- ── FAQ ───────────────────────────────────────── -->
          {loc.faqs.length > 0 && (
          <section class="block" aria-labelledby="faq-h">
            <h2 id="faq-h">{loc.city} questions, answered</h2>
            <div class="faqs">
              {loc.faqs.map((f) => (
                <details class="faq">
                  <summary>{f.q}</summary>
                  <p>{f.a}</p>
                </details>
              ))}
            </div>
          </section>
          )}
        </div>

        <!-- ── Rail ────────────────────────────────────────── -->
        <aside class="guide__rail">
          <div class="rail__sticky">
            <div class="rail__box">
              <h2 class="rail__h">In this guide</h2>
              <ul class="rail__toc">
                <li><a href="#answer-h">The short answer</a></li>
                <li><a href="#market-h">The {loc.city} market</a></li>
                <li><a href="#hard-h">What makes it hard</a></li>
                <li><a href="#factors-h">What moves rankings</a></li>
                <li><a href="#plan-h">The running order</a></li>
                <li><a href="#cost-h">What it costs</a></li>
                <li><a href="#areas-h">Where searches come from</a></li>
                <li><a href="#faq-h">FAQ</a></li>
              </ul>
            </div>

            <Newsletter variant="rail" heading="The OnwardCraft email" location="guide-rail" />

            <div class="rail__box">
              <h2 class="rail__h">More on {loc.city}</h2>
              <ul class="rail__links">
                <li><a href={`/${loc.citySlug}/`}>{loc.city} overview</a></li>
                {sibling && (
                  <li>
                    <a href={`/${sibling.citySlug}/${sibling.serviceSlug}/`}>
                      {GUIDE_TOPICS[sibling.serviceSlug].title(loc.city)}
                    </a>
                  </li>
                )}
              </ul>
            </div>
          </div>
        </aside>
      </div>

      <!-- ── Nearby ────────────────────────────────────────── -->
      <section class="nearby" aria-labelledby="nearby-h">
        <div class="container">
          <div class="section-head">
            <h2 id="nearby-h">{topic.label} in nearby markets</h2>
            <a class="section-more" href="/locations/">All cities →</a>
          </div>
          <ul class="nearby__grid">
            {nearby.map((c) => (
              <li>
                <a href={`/${c.citySlug}/${loc.serviceSlug}/`}>
                  <span class="nearby__city">{c.city}</span>
                  <span class="nearby__state">{c.stateAbbr}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </article>
  </main>

  <SiteFooter />
</Layout>
