---
import '../../styles/guide.css';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Newsletter from '../../components/Newsletter.astro';
import { SITE, AUTHOR } from '../../data/site.js';
import { cities } from '../../data/cities.js';
import { locations } from '../../data/locations.js';
import { nearbyCities } from '../../data/related.js';
import { GUIDE_TOPICS } from '../../data/guides.js';
import { posts, PUBLISHED_ISO, PUBLISHED_LABEL } from '../../data/posts.js';

export async function getStaticPaths() {
  const { cities } = await import('../../data/cities.js');
  return cities.map((city) => ({ params: { city: city.citySlug }, props: { city } }));
}

const { city } = Astro.props;
const canonical = `${SITE.url}/${city.citySlug}/`;

// The guides published for this metro, in a fixed editorial order.
const guides = locations
  .filter((l) => l.citySlug === city.citySlug)
  .sort((a, b) => (a.serviceSlug === 'local-seo' ? -1 : 1));

const nearby = nearbyCities(city.citySlug, 10);

// The voice filter drops the hub's commercial FAQs ("How much does it cost to
// work with you?"), which can leave a hub with very few. The topic guides for
// the same metro answer the same readers' questions, so the hub pools all of
// them and de-duplicates by question.
const seenQuestions = new Set();
const faqs = [...city.faqs, ...guides.flatMap((g) => g.faqs)].filter((f) => {
  const key = f.q.trim().toLowerCase();
  if (seenQuestions.has(key)) return false;
  seenQuestions.add(key);
  return true;
});
const market = city.localMarket;
const peak = Math.max(...(market?.seasonalDemand?.map((d) => d.v) ?? [1]));

// A few general articles to pair with the local material.
const generalReading = posts.slice(0, 4);

const heading = `Search in ${city.city}, ${city.stateAbbr}: A Local Market Overview`;
const dek = `An overview of how search demand behaves in the ${city.city} metro — the seasonality, the neighbourhoods that generate the queries, what ranking here takes, and where to go next for the how-to.`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    '@id': `${canonical}#article`,
    headline: heading,
    description: dek,
    url: canonical,
    inLanguage: SITE.language,
    datePublished: PUBLISHED_ISO,
    dateModified: PUBLISHED_ISO,
    author: { '@id': `${SITE.url}/#desk` },
    publisher: { '@id': `${SITE.url}/#organization` },
    isPartOf: { '@id': `${SITE.url}/#blog` },
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    contentLocation: {
      '@type': 'City',
      name: city.city,
      address: { '@type': 'PostalAddress', addressLocality: city.city, addressRegion: city.stateAbbr, addressCountry: 'US' },
    },
  },
  ...(faqs.length > 0
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          '@id': `${canonical}#faq`,
          mainEntity: faqs.map((f) => ({
            '@type': 'Question',
            name: f.q,
            acceptedAnswer: { '@type': 'Answer', text: f.a },
          })),
        },
      ]
    : []),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'City guides', item: `${SITE.url}/locations/` },
      { '@type': 'ListItem', position: 3, name: city.city, item: canonical },
    ],
  },
];
---

<Layout title={`${heading} | ${SITE.name}`} description={dek} canonical={canonical} ogType="article" schema={schema}>
  <div class="read-progress" id="readProgress"></div>
  <SiteHeader compact />

  <main id="main">
    <article class="guide" data-progress-target>
      <div class="container guide__grid">
        <div class="guide__main">
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/locations/">City guides</a>
            <span aria-hidden="true">/</span>
            <span>{city.city}</span>
          </nav>

          <header class="guide__head">
            <p class="kicker">City guide · {city.metro}</p>
            <h1 class="guide__title">{heading}</h1>
            <p class="guide__dek">{dek}</p>
            <div class="guide__byline">
              <span class="guide__author">{AUTHOR.name}</span>
              <span aria-hidden="true">·</span>
              <time datetime={PUBLISHED_ISO}>{PUBLISHED_LABEL}</time>
              <span aria-hidden="true">·</span>
              <span>{city.city}, {city.state}</span>
            </div>
          </header>

          <section class="answer" aria-labelledby="answer-h">
            <h2 id="answer-h" class="answer__q">{city.aioQuestion}</h2>
            <p class="answer__a">{city.aioAnswer}</p>
          </section>

          <div class="guide__body">
            <p class="lead">{city.intro}</p>
          </div>

          <!-- ── The two guides for this metro ─────────────── -->
          <section class="block" aria-labelledby="guides-h">
            <h2 id="guides-h">The {city.city} guides</h2>
            <div class="guide-cards">
              {guides.map((g) => {
                const t = GUIDE_TOPICS[g.serviceSlug];
                return (
                  <a class="guide-card" href={`/${g.citySlug}/${g.serviceSlug}/`}>
                    <span class="guide-card__kicker">{t.desk}</span>
                    <span class="guide-card__title">{t.title(city.city)}</span>
                    <span class="guide-card__dek">{t.dek(city.city)}</span>
                    <span class="guide-card__go">Read the guide →</span>
                  </a>
                );
              })}
            </div>
          </section>

          <!-- ── Market ────────────────────────────────────── -->
          {market && (
            <section class="block" aria-labelledby="market-h">
              <h2 id="market-h">{market.heading}</h2>
              <div class="guide__body"><p>{market.body}</p></div>

              {market.pullQuote && <blockquote class="pull">{market.pullQuote}</blockquote>}

              {market.stats?.length > 0 && (
                <ul class="stats" aria-label={`${city.city} in numbers`}>
                  {market.stats.map((s) => (
                    <li>
                      <span class="stats__v">{s.value}</span>
                      <span class="stats__l">{s.label}</span>
                    </li>
                  ))}
                </ul>
              )}

              {market.seasonalDemand?.length > 0 && (
                <figure class="season">
                  <figcaption>
                    <strong>{market.seasonTitle || 'When demand spikes'}</strong>
                    <span>{market.seasonCaption}</span>
                  </figcaption>
                  <div class="season__chart" role="img" aria-label={`Relative monthly search demand in ${city.city}. ${market.seasonCaption}`}>
                    {market.seasonalDemand.map((d) => (
                      <div class="season__col">
                        <div class:list={['season__bar', d.peak && 'is-peak']} style={`height:${Math.round((d.v / peak) * 100)}%`}></div>
                        <span class="season__m">{d.m}</span>
                      </div>
                    ))}
                  </div>
                  <p class="season__note">
                    Relative demand through the year, indexed to this market's own
                    peak. Illustrative — it shows the shape of the season, not
                    absolute search volume.
                  </p>
                </figure>
              )}
            </section>
          )}

          <Newsletter
            variant="inline"
            heading="New city guides, by email"
            blurb="One SEO email every other week — new market guides, what changed in local search, and the checklist to act on it. Free."
            location="city-inline"
          />

          <!-- ── What ranking takes ────────────────────────── -->
          {city.services?.length > 0 && (
            <section class="block" aria-labelledby="what-h">
              <h2 id="what-h">What ranking in {city.city} actually takes</h2>
              <ul class="factors">
                {city.services.map((s) => (
                  <li>
                    <h3>{s.name}</h3>
                    <p>{s.desc}</p>
                  </li>
                ))}
              </ul>
            </section>
          )}

          <!-- ── Areas ─────────────────────────────────────── -->
          <section class="block" aria-labelledby="areas-h">
            <h2 id="areas-h">The areas that generate {city.city} searches</h2>
            <p class="block__intro">
              Proximity still moves local rankings, so where you sit in the metro
              changes what you can realistically rank for.
            </p>
            <ul class="areas">
              {city.areasServed.map((a) => <li>{a}</li>)}
            </ul>
          </section>

          <!-- ── FAQ ───────────────────────────────────────── -->
          {faqs.length > 0 && (
            <section class="block" aria-labelledby="faq-h">
              <h2 id="faq-h">{city.city} questions, answered</h2>
              <div class="faqs">
                {faqs.map((f) => (
                  <details class="faq">
                    <summary>{f.q}</summary>
                    <p>{f.a}</p>
                  </details>
                ))}
              </div>
            </section>
          )}
        </div>

        <aside class="guide__rail">
          <div class="rail__sticky">
            <div class="rail__box">
              <h2 class="rail__h">{city.city} guides</h2>
              <ul class="rail__links">
                {guides.map((g) => (
                  <li><a href={`/${g.citySlug}/${g.serviceSlug}/`}>{GUIDE_TOPICS[g.serviceSlug].label}</a></li>
                ))}
              </ul>
            </div>

            <Newsletter variant="rail" heading="The OnwardCraft email" location="city-rail" />

            <div class="rail__box">
              <h2 class="rail__h">Start with the basics</h2>
              <ul class="rail__links">
                {generalReading.map((p) => (
                  <li><a href={`/blog/${p.slug}/`}>{p.title}</a></li>
                ))}
              </ul>
            </div>
          </div>
        </aside>
      </div>

      <section class="nearby" aria-labelledby="nearby-h">
        <div class="container">
          <div class="section-head">
            <h2 id="nearby-h">Nearby markets</h2>
            <a class="section-more" href="/locations/">All cities →</a>
          </div>
          <ul class="nearby__grid">
            {nearby.map((c) => (
              <li>
                <a href={`/${c.citySlug}/`}>
                  <span class="nearby__city">{c.city}</span>
                  <span class="nearby__state">{c.stateAbbr}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </article>
  </main>

  <SiteFooter />
</Layout>

<style>
  /* Cards for the two topic guides. The rest of this page reuses the global
     guide styles defined by [service].astro. */
  .guide-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--rule); border: 1px solid var(--rule); }
  .guide-card {
    display: flex; flex-direction: column; gap: 9px;
    padding: 24px; background: var(--paper);
    transition: background 0.18s var(--ease);
  }
  .guide-card:hover { background: var(--paper-2); }
  .guide-card__kicker {
    font-family: var(--font-ui); font-size: 11px; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent);
  }
  .guide-card__title {
    font-family: var(--font-display); font-weight: 700; font-size: 20px;
    line-height: 1.16; color: var(--ink);
  }
  .guide-card:hover .guide-card__title { color: var(--accent); }
  .guide-card__dek { font-family: var(--font-read); font-size: 16px; line-height: 1.5; color: var(--ink-3); }
  .guide-card__go {
    margin-top: auto; padding-top: 6px;
    font-family: var(--font-ui); font-size: 12.5px; font-weight: 600; color: var(--accent);
  }

  @media (max-width: 680px) { .guide-cards { grid-template-columns: 1fr; } }
</style>
