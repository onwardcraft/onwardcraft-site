---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../data/site.js';
import { posts } from '../data/posts.js';
---

<Layout title={`Page not found | ${SITE.name}`} description="That page does not exist. Here is where to go instead.">
  <SiteHeader />
  <main id="main">
    <section class="container nf">
      <p class="kicker">404</p>
      <h1>That page is not here</h1>
      <p class="nf__dek">
        It may have moved when we turned this site into a publication, or it may
        never have existed. Either way, here is somewhere better to be.
      </p>
      <div class="nf__links">
        <a class="btn btn-primary" href="/blog/">Read the archive</a>
        <a class="btn btn-secondary" href="/locations/">Find your city</a>
      </div>

      <h2 class="nf__h">Popular reading</h2>
      <ul class="nf__list">
        {posts.slice(0, 6).map((p) => (
          <li><a href={`/blog/${p.slug}/`}>{p.title}</a><span>{p.category}</span></li>
        ))}
      </ul>
    </section>
  </main>
  <SiteFooter />
</Layout>

<style>
  .nf { padding: 72px 0 80px; max-width: 720px; }
  .nf h1 { font-size: clamp(34px, 5vw, 52px); margin: 12px 0 16px; }
  .nf__dek { font-family: var(--font-read); font-size: 19px; line-height: 1.6; color: var(--ink-3); }
  .nf__links { display: flex; gap: 12px; flex-wrap: wrap; margin: 28px 0 56px; }
  .nf__h {
    font-family: var(--font-ui); font-size: 11.5px; font-weight: 700;
    letter-spacing: 0.13em; text-transform: uppercase; color: var(--ink-3);
    padding-bottom: 12px; border-bottom: 1px solid var(--rule);
  }
  .nf__list { list-style: none; }
  .nf__list li {
    display: flex; justify-content: space-between; align-items: baseline; gap: 18px;
    padding: 13px 0; border-bottom: 1px solid var(--rule);
  }
  .nf__list a { font-family: var(--font-display); font-weight: 700; font-size: 17px; color: var(--ink); }
  .nf__list a:hover { color: var(--accent); }
  .nf__list span { font-family: var(--font-ui); font-size: 12px; color: var(--ink-3); white-space: nowrap; }
</style>
