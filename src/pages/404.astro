---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FinalCTA from '../components/FinalCTA.astro';
---

<Layout title="Page Not Found — OnwardCraft" description="We could not find the page you were looking for. It may have been moved or removed. Explore our services or contact us for help.">
  <Navbar />

  <section class="not-found">
    <div class="container">
      <div class="not-found-content reveal">
        <span class="error-code">404</span>
        <h1>Page Not Found</h1>
        <p>We couldn't find the page you were looking for. It might have been moved, renamed, or removed.</p>
        <div class="not-found-actions">
          <a href="/" class="btn-primary">Back to Homepage</a>
          <a href="/services/" class="btn-secondary">Explore Services</a>
        </div>
      </div>
    </div>
  </section>

  <FinalCTA />
  <Footer />
</Layout>

<style>
  .not-found {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 160px 0 100px;
    text-align: center;
  }

  .not-found-content {
    max-width: 560px;
    margin: 0 auto;
  }

  .error-code {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(80px, 15vw, 140px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.05em;
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 24px;
  }

  .not-found h1 {
    font-size: clamp(32px, 5vw, 48px);
    margin-bottom: 20px;
  }

  .not-found p {
    font-size: 18px;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 40px;
  }

  .not-found-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }
</style>
