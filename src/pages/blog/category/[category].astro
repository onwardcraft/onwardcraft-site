---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import { posts, getCategories, getPostsByCategory, categorySlug } from '../../../data/posts.js';

export async function getStaticPaths() {
  const { getCategories, getPostsByCategory } = await import('../../../data/posts.js');
  return getCategories().map((cat) => ({
    params: { category: cat.slug },
    props: { categoryName: cat.name, categoryPosts: getPostsByCategory(cat.name) },
  }));
}

const { categoryName, categoryPosts } = Astro.props;
const categories = getCategories();

const title = `${categoryName} Articles — OnwardCraft Blog`;
const description = `${categoryPosts.length} in-depth ${categoryName.toLowerCase()} articles for home-service contractors: actionable guides on web design, SEO, lead generation, and conversion built specifically for the trades.`;
const canonical = `https://onwardcraft.com/blog/category/${categorySlug(categoryName)}/`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${categoryName} Articles`,
    description,
    url: canonical,
    isPartOf: { '@id': 'https://onwardcraft.com/#website' },
    publisher: { '@id': 'https://onwardcraft.com/#organization' },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: categoryPosts.length,
      itemListElement: categoryPosts.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `https://onwardcraft.com/blog/${p.slug}/`,
        name: p.title,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://onwardcraft.com/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://onwardcraft.com/blog/' },
      { '@type': 'ListItem', position: 3, name: categoryName, item: canonical },
    ],
  },
];
---

<Layout title={title} description={description} canonical={canonical} schema={schema}>
  <Navbar dark />

  <div class="blog-page">
  <!-- Hero -->
  <section class="cat-hero">
    <div class="cat-hero-inner container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/blog/">Blog</a>
        <span aria-hidden="true">/</span>
        <span class="breadcrumb-current">{categoryName}</span>
      </nav>
      <p class="section-label">Category</p>
      <h1 class="cat-title">{categoryName}</h1>
      <p class="cat-desc">
        {categoryPosts.length} {categoryPosts.length === 1 ? 'article' : 'articles'} on {categoryName.toLowerCase()} for contractors and home-service businesses.
      </p>
    </div>
  </section>

  <!-- Categories nav -->
  <section class="categories-section">
    <div class="container">
      <nav class="category-list" aria-label="Blog categories">
        <a href="/blog/" class="category-btn">All</a>
        {categories.map((cat) => (
          <a
            href={`/blog/category/${cat.slug}/`}
            class={`category-btn ${cat.name === categoryName ? 'active' : ''}`}
          >{cat.name} <span class="category-count">{cat.count}</span></a>
        ))}
      </nav>
    </div>
  </section>

  <!-- Posts Grid -->
  <section class="posts-section">
    <div class="container">
      <div class="posts-grid">
        {categoryPosts.map((post) => (
          <a href={`/blog/${post.slug}/`} class="post-card">
            <div class="post-card-inner">
              <div class="post-meta">
                <span class="post-category">{post.category}</span>
                <span class="post-date">{post.date}</span>
              </div>
              <h2>{post.title}</h2>
              <p>{post.excerpt}</p>
              <div class="post-footer">
                <span class="post-read">{post.readTime}</span>
                <span class="post-arrow">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="cat-back">
        <a href="/blog/" class="back-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
          Browse all articles
        </a>
      </div>
    </div>
  </section>
  </div>

  <Footer />
</Layout>

<style>
  .blog-page {
    --bg-primary: #ffffff;
    --bg-secondary: #f8fafc;
    --text-primary: #0f172a;
    --text-secondary: rgba(15, 23, 42, 0.75);
    --text-muted: rgba(15, 23, 42, 0.5);
    --border: rgba(0, 0, 0, 0.08);
    --border-hover: rgba(0, 0, 0, 0.15);
    color: var(--text-primary);
    background: var(--bg-primary);
    min-height: 100vh;
  }

  .cat-hero {
    padding: 150px 0 40px;
    background: #ffffff;
  }

  .cat-hero-inner {
    max-width: 820px;
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 28px;
  }

  .breadcrumb a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .breadcrumb a:hover { color: var(--accent-primary); }
  .breadcrumb-current { color: var(--text-primary); font-weight: 600; }

  .section-label {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent-primary);
    margin-bottom: 12px;
  }

  .cat-title {
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #000000;
    margin-bottom: 16px;
  }

  .cat-desc {
    font-size: 18px;
    color: #444444;
    line-height: 1.6;
    max-width: 580px;
  }

  /* Categories nav */
  .categories-section {
    padding: 20px 0 40px;
    background: var(--bg-primary);
  }

  .category-list {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .category-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    background: rgba(0, 0, 0, 0.04);
    border: 1px solid var(--border);
    border-radius: 100px;
    transition: all 0.3s;
    font-family: var(--font-body);
    text-decoration: none;
  }

  .category-btn:hover {
    background: rgba(6, 214, 160, 0.08);
    border-color: var(--accent-primary);
    color: var(--text-primary);
  }

  .category-btn.active {
    background: var(--accent-primary);
    border-color: var(--accent-primary);
    color: var(--accent-on, #03100B);
    font-weight: 600;
  }

  .category-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    font-size: 11px;
    font-weight: 700;
    border-radius: 100px;
    background: rgba(0, 0, 0, 0.06);
    color: var(--text-muted);
  }

  .category-btn.active .category-count {
    background: rgba(0, 0, 0, 0.14);
    color: var(--accent-on, #03100B);
  }

  /* Posts Grid */
  .posts-section {
    padding: 20px 0 120px;
    background: var(--bg-primary);
    position: relative;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .post-card {
    display: block;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: all 0.4s var(--transition);
    text-decoration: none;
  }

  .post-card:hover {
    border-color: var(--accent-primary);
    transform: translateY(-4px);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.12);
  }

  .post-card-inner { padding: 36px; }

  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .post-category {
    font-size: 12px;
    font-weight: 600;
    color: var(--accent-primary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .post-date { font-size: 12px; color: var(--text-muted); }

  .post-card h2 {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 12px;
    color: var(--text-primary);
    transition: color 0.3s;
  }

  .post-card:hover h2 { color: var(--accent-primary); }

  .post-card p {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  .post-read { font-size: 13px; color: var(--text-muted); }
  .post-arrow { color: var(--text-muted); transition: all 0.3s; }
  .post-card:hover .post-arrow { color: var(--accent-primary); transform: translateX(4px); }

  .cat-back {
    margin-top: 56px;
    display: flex;
    justify-content: center;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    color: var(--accent-primary);
    text-decoration: none;
    transition: gap 0.3s;
  }

  .back-link:hover { gap: 12px; }

  @media (max-width: 1024px) {
    .posts-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .cat-hero { padding: 130px 0 30px; }
    .post-card-inner { padding: 28px 24px; }
  }
</style>
