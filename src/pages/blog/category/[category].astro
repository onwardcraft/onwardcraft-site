---
import Layout from '../../../layouts/Layout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import Newsletter from '../../../components/Newsletter.astro';
import StoryCard from '../../../components/StoryCard.astro';
import { SITE, SECTIONS } from '../../../data/site.js';
import { getCategories, getPostsByCategory, categorySlug, PUBLISHED_ISO } from '../../../data/posts.js';

export async function getStaticPaths() {
  const { getCategories, getPostsByCategory } = await import('../../../data/posts.js');
  return getCategories().map((c) => ({
    params: { category: c.slug },
    props: { name: c.name, slug: c.slug, items: getPostsByCategory(c.name) },
  }));
}

const { name, slug, items } = Astro.props;
const section = SECTIONS.find((s) => s.slug === slug);
const others = getCategories().filter((c) => c.slug !== slug);

const title = `${name} — ${items.length} Articles | ${SITE.name}`;
const description = section
  ? `${section.blurb} ${items.length} articles from the ${name} desk at OnwardCraft.`
  : `Every OnwardCraft article filed under ${name} — ${items.length} guides and studies.`;
const canonical = `${SITE.url}/blog/category/${slug}/`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${canonical}#collection`,
    url: canonical,
    name: `${name} articles`,
    description,
    isPartOf: { '@id': `${SITE.url}/#website` },
    dateModified: PUBLISHED_ISO,
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: items.length,
      itemListElement: items.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${SITE.url}/blog/${p.slug}/`,
        name: p.title,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Articles', item: `${SITE.url}/blog/` },
      { '@type': 'ListItem', position: 3, name, item: canonical },
    ],
  },
];
---

<Layout title={title} description={description} canonical={canonical} schema={schema}>
  <SiteHeader />

  <main id="main">
    <header class="cat-head">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/blog/">Articles</a>
          <span aria-hidden="true">/</span>
          <span>{name}</span>
        </nav>
        <p class="kicker">Desk</p>
        <h1>{name}</h1>
        {section && <p class="cat-head__dek">{section.blurb}</p>}
        <p class="cat-head__count">{items.length} {items.length === 1 ? 'article' : 'articles'}</p>
      </div>
    </header>

    <section class="container cat-body">
      <div class="cat-grid">
        {items.map((p) => <StoryCard post={p} />)}
      </div>

      <nav class="cat-other" aria-label="Other desks">
        <h2 class="cat-other__h">Other desks</h2>
        {others.map((c) => (
          <a href={`/blog/category/${c.slug}/`}>{c.name} ({c.count})</a>
        ))}
        <a href="/blog/">All articles</a>
      </nav>
    </section>

    <Newsletter location="category-band" />
  </main>

  <SiteFooter />
</Layout>

<style>
  .cat-head { padding: 34px 0 30px; border-bottom: 2px solid var(--ink); }
  .crumbs {
    display: flex; gap: 8px;
    font-family: var(--font-ui); font-size: 12.5px; color: var(--ink-3);
    margin-bottom: 22px;
  }
  .crumbs a:hover { color: var(--accent); text-decoration: underline; }
  .cat-head h1 { font-size: clamp(34px, 5vw, 52px); margin: 12px 0 14px; }
  .cat-head__dek {
    font-family: var(--font-read);
    font-size: 19px; line-height: 1.55; color: var(--ink-3); max-width: 62ch;
  }
  .cat-head__count {
    margin-top: 16px;
    font-family: var(--font-ui); font-size: 12.5px; font-weight: 600;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3);
  }

  .cat-body { padding: 40px 0 20px; }
  .cat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px 40px; }

  .cat-other {
    display: flex; flex-wrap: wrap; align-items: center; gap: 10px;
    margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--rule);
    font-family: var(--font-ui); font-size: 13.5px; font-weight: 600;
  }
  .cat-other__h {
    font-family: var(--font-ui); font-size: 11.5px; font-weight: 700;
    letter-spacing: 0.13em; text-transform: uppercase; color: var(--ink-3);
    margin-right: 6px;
  }
  .cat-other a { padding: 8px 16px; border: 1px solid var(--rule-strong); border-radius: 100px; color: var(--ink-2); }
  .cat-other a:hover { border-color: var(--ink); color: var(--accent); }

  @media (max-width: 960px) { .cat-grid { grid-template-columns: 1fr 1fr; gap: 4px 32px; } }
  @media (max-width: 620px) { .cat-grid { grid-template-columns: 1fr; } }
</style>
