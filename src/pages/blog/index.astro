---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Newsletter from '../../components/Newsletter.astro';
import StoryCard from '../../components/StoryCard.astro';
import { SITE } from '../../data/site.js';
import { posts, getCategories, PUBLISHED_ISO } from '../../data/posts.js';

const categories = getCategories();
const title = `All Articles | ${SITE.name}`;
const description = `Every article OnwardCraft has published on SEO — ${posts.length} guides, checklists, and studies on local, organic, and technical search for small businesses.`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${SITE.url}/blog/#archive`,
  url: `${SITE.url}/blog/`,
  name: 'All Articles',
  description,
  isPartOf: { '@id': `${SITE.url}/#website` },
  dateModified: PUBLISHED_ISO,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: posts.length,
    itemListElement: posts.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE.url}/blog/${p.slug}/`,
      name: p.title,
    })),
  },
};
---

<Layout title={title} description={description} schema={schema}>
  <SiteHeader />

  <main id="main">
    <header class="archive-head">
      <div class="container">
        <p class="kicker">The archive</p>
        <h1>All articles</h1>
        <p class="archive-head__dek">
          Everything we have published, newest first. {posts.length} articles across
          three desks — all of them about search, none of them selling anything.
        </p>
        <nav class="filters" aria-label="Filter by desk">
          <span class="filters__current">All ({posts.length})</span>
          {categories.map((c) => (
            <a href={`/blog/category/${c.slug}/`}>{c.name} ({c.count})</a>
          ))}
        </nav>
      </div>
    </header>

    <section class="container archive">
      <div class="archive__grid">
        {posts.map((p) => <StoryCard post={p} />)}
      </div>
    </section>

    <Newsletter location="archive-band" />
  </main>

  <SiteFooter />
</Layout>

<style>
  .archive-head {
    padding: 44px 0 30px;
    border-bottom: 1px solid var(--rule);
  }
  .archive-head h1 { font-size: clamp(34px, 5vw, 52px); margin: 12px 0 14px; }
  .archive-head__dek {
    font-family: var(--font-read);
    font-size: 19px;
    line-height: 1.55;
    color: var(--ink-3);
    max-width: 62ch;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 26px;
    font-family: var(--font-ui);
    font-size: 13.5px;
    font-weight: 600;
  }
  .filters a, .filters__current {
    padding: 8px 16px;
    border: 1px solid var(--rule-strong);
    border-radius: 100px;
    color: var(--ink-2);
  }
  .filters__current { background: var(--ink); border-color: var(--ink); color: var(--ink-invert); }
  .filters a:hover { border-color: var(--ink); color: var(--accent); }

  .archive { padding: 40px 0 20px; }
  .archive__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px 40px;
  }

  @media (max-width: 960px) { .archive__grid { grid-template-columns: 1fr 1fr; gap: 4px 32px; } }
  @media (max-width: 620px) { .archive__grid { grid-template-columns: 1fr; } }
</style>
