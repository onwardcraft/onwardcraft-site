---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const title = 'Blog — Growth Tactics, Web Design & SEO Insights';
const description = 'Actionable insights on web design, SEO, conversion optimization, and digital growth for ambitious business owners.';

const categories = ['All', 'Web Design', 'SEO', 'Conversion', 'Growth Strategy', 'Case Studies'];

const posts = [
  {
    slug: 'how-much-does-a-website-cost-2026',
    title: 'How Much Does a Website Cost in 2026? The Honest Breakdown',
    excerpt: 'Stop guessing. Here is exactly what you should expect to pay for a website in 2026 — from DIY builders to custom agencies — and what you actually get for your money.',
    category: 'Web Design',
    date: 'May 2026',
    readTime: '8 min read',
    featured: true,
  },
  {
    slug: 'wix-vs-custom-website',
    title: 'Wix vs Custom Website: Which Is Right for Your Business?',
    excerpt: 'The honest truth about website builders vs custom development. When Wix is enough, when it is not, and how to make the right choice for your stage of business.',
    category: 'Web Design',
    date: 'May 2026',
    readTime: '6 min read',
    featured: false,
  },
  {
    slug: 'signs-your-website-needs-redesign',
    title: '10 Signs Your Website Needs a Redesign (And What to Do About It)',
    excerpt: 'Is your website helping or hurting your business? Here are 10 warning signs that your site is due for an overhaul — plus a roadmap to fix it.',
    category: 'Web Design',
    date: 'April 2026',
    readTime: '7 min read',
    featured: false,
  },
  {
    slug: 'why-cheap-websites-cost-money',
    title: 'Why Cheap Websites Cost You Money in the Long Run',
    excerpt: 'That $500 website seemed like a deal. Here is why it is probably costing you thousands in lost leads, poor rankings, and missed opportunities.',
    category: 'Growth Strategy',
    date: 'April 2026',
    readTime: '5 min read',
    featured: false,
  },
  {
    slug: 'seo-for-local-businesses',
    title: 'SEO for Local Businesses: The Complete 2026 Guide',
    excerpt: 'Local SEO is not magic. It is a system. Here is the step-by-step playbook we use to get local businesses ranking on page one of Google.',
    category: 'SEO',
    date: 'April 2026',
    readTime: '10 min read',
    featured: false,
  },
  {
    slug: 'conversion-rate-optimization-basics',
    title: 'Conversion Rate Optimization: A Beginner\'s Guide for Business Owners',
    excerpt: 'You are getting traffic but no leads. Here is how to turn more of your existing visitors into paying customers — without spending more on ads.',
    category: 'Conversion',
    date: 'March 2026',
    readTime: '6 min read',
    featured: false,
  },
  {
    slug: 'roofing-marketing-guide-2026',
    title: 'The Complete Roofing Marketing Guide (2026): 15 Lead Generation Strategies',
    excerpt: 'Learn how to market your roofing company with 15 proven strategies. Includes local SEO, storm damage leads, PPC, website design, and a 12-month marketing calendar.',
    category: 'Growth Strategy',
    date: 'June 2026',
    readTime: '45 min read',
    featured: false,
  },
  {
    slug: 'how-much-does-seo-cost-in-2026',
    title: 'How Much Does SEO Cost in 2026?',
    excerpt: 'SEO costs range from $500 to $50,000+ per month in 2026. Here is exactly what you get at each price tier, what drives the cost, and how to budget without wasting money.',
    category: 'SEO',
    date: 'June 2026',
    readTime: '10 min read',
    featured: false,
  },
  {
    slug: 'diy-seo-vs-hiring-an-agency-pros-and-cons',
    title: 'DIY SEO vs Hiring an Agency: Pros and Cons for Business Owners',
    excerpt: 'Should you do your own SEO or hire an agency? This guide breaks down the real costs, time investment, risks, and ROI of each approach so you can make the right decision for your business.',
    category: 'SEO',
    date: 'June 2026',
    readTime: '14 min read',
    featured: false,
  },
  {
    slug: 'diy-website-vs-hiring-an-agency',
    title: 'DIY Website vs Hiring an Agency: Which Is Right for Your Business?',
    excerpt: 'An honest comparison of DIY website builders, freelancers, and agencies. Learn the real costs, hidden trade-offs, and which option fits your business stage.',
    category: 'Web Design',
    date: 'June 2026',
    readTime: '12 min read',
    featured: false,
  },
  {
    slug: 'seo-services-complete-guide-for-business-owners',
    title: 'SEO Services: The Complete Guide for Business Owners in 2026',
    excerpt: 'A no-fluff guide to SEO services in 2026. Learn what SEO companies actually do, what services you need, and how to choose the right provider for your business.',
    category: 'SEO',
    date: 'June 2026',
    readTime: '14 min read',
    featured: false,
  },
  {
    slug: 'seo-vs-google-ads-which-has-better-roi',
    title: 'SEO vs Google Ads: Which Has Better ROI?',
    excerpt: 'SEO vs Google Ads: a data-driven comparison of ROI, cost per lead, time to results, and which channel wins for small businesses in 2026.',
    category: 'SEO',
    date: 'June 2026',
    readTime: '12 min read',
    featured: false,
  },
  {
    slug: 'custom-website-vs-template-which-is-better',
    title: 'Custom Website vs Template: Which Is Better for Your Business?',
    excerpt: 'A complete comparison of custom websites and template sites. Learn which option drives more leads, ranks higher on Google, and delivers real ROI for your business.',
    category: 'Web Design',
    date: 'June 2026',
    readTime: '10 min read',
    featured: false,
  },
  {
    slug: 'how-to-choose-a-web-design-agency',
    title: 'How to Choose a Web Design Agency: The 2026 Guide for Business Owners',
    excerpt: 'A practical guide for business owners who need to hire a web design agency. Learn what to look for, what to avoid, and how to make the right choice in 2026.',
    category: 'Web Design',
    date: 'June 2026',
    readTime: '12 min read',
    featured: false,
  },
  {
    slug: 'how-to-choose-the-right-seo-agency',
    title: 'How to Choose the Right SEO Agency in 2026',
    excerpt: 'Choosing the wrong SEO agency can cost you months and thousands of dollars. Here is the exact framework we recommend for evaluating, comparing, and hiring an SEO agency that delivers real business results.',
    category: 'SEO',
    date: 'June 2026',
    readTime: '11 min read',
    featured: false,
  },
  {
    slug: 'what-does-an-seo-agency-actually-do',
    title: 'What Does an SEO Agency Actually Do?',
    excerpt: 'Most business owners have no idea what an SEO agency actually does. Here is the complete breakdown of every service, deliverable, and result you should expect.',
    category: 'SEO',
    date: 'June 2026',
    readTime: '10 min read',
    featured: false,
  },
  {
    slug: 'how-long-does-it-take-to-build-a-website',
    title: 'How Long Does It Take to Build a Website?',
    excerpt: 'A realistic breakdown of website build timelines in 2026. From DIY builders to custom agency builds — see exactly how long each approach takes and what slows projects down.',
    category: 'Web Design',
    date: 'June 2026',
    readTime: '10 min read',
    featured: false,
  },
];

const featuredPost = posts.find(p => p.featured);
const regularPosts = posts.filter(p => !p.featured);
---

<Layout title={title} description={description}>
  <Navbar dark />

  <div class="blog-page">
  <!-- Hero -->
  <section class="blog-hero">
    <div class="hero-bg">
      <div class="gradient-blob blob-1"></div>
      <div class="gradient-blob blob-2"></div>
    </div>
    <div class="blog-hero-inner container">
      <p class="section-label reveal">The Blog</p>
      <h1 class="blog-title reveal">
        Growth Tactics for<br/>
        <span class="accent">Ambitious Businesses.</span>
      </h1>
      <p class="blog-desc reveal">
        No fluff. No generic advice. Just actionable insights on web design, SEO, and conversion optimization that actually moves the needle.
      </p>
    </div>
  </section>

  <!-- Featured Post -->
  {featuredPost && (
    <section class="featured-section">
      <div class="container">
        <a href={`/blog/${featuredPost.slug}`} class="featured-card reveal">
          <div class="featured-badge">Featured</div>
          <div class="featured-content">
            <div class="featured-meta">
              <span class="featured-category">{featuredPost.category}</span>
              <span class="featured-date">{featuredPost.date} · {featuredPost.readTime}</span>
            </div>
            <h2>{featuredPost.title}</h2>
            <p>{featuredPost.excerpt}</p>
            <span class="featured-link">
              Read Article
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- Categories -->
  <section class="categories-section">
    <div class="container">
      <div class="category-list reveal">
        {categories.map((cat, i) => (
          <button class={`category-btn ${i === 0 ? 'active' : ''}`}>{cat}</button>
        ))}
      </div>
    </div>
  </section>

  <!-- Posts Grid -->
  <section class="posts-section">
    <div class="container">
      <div class="posts-grid stagger-children">
        {regularPosts.map((post) => (
          <a href={`/blog/${post.slug}`} class="post-card stagger-item">
            <div class="post-card-inner">
              <div class="post-meta">
                <span class="post-category">{post.category}</span>
                <span class="post-date">{post.date}</span>
              </div>
              <h3>{post.title}</h3>
              <p>{post.excerpt}</p>
              <div class="post-footer">
                <span class="post-read">{post.readTime}</span>
                <span class="post-arrow">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="newsletter-section">
    <div class="container">
      <div class="newsletter-card reveal gradient-border">
        <div class="newsletter-inner">
          <div class="newsletter-content">
            <h2>Get Weekly Growth Tactics</h2>
            <p>One email per week. Zero spam. Actionable insights you can implement the same day.</p>
          </div>
          <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Thanks for subscribing!');">
            <input type="email" placeholder="your@email.com" required />
            <button type="submit" class="btn-primary">Subscribe</button>
          </form>
        </div>
      </div>
    </div>
  </section>
  </div>

  <Footer />
</Layout>

<style>
  .blog-page {
    --bg-primary: #ffffff;
    --bg-secondary: #f8fafc;
    --bg-card: #ffffff;
    --bg-card-hover: #f1f5f9;
    --text-primary: #0f172a;
    --text-secondary: rgba(15, 23, 42, 0.75);
    --text-muted: rgba(15, 23, 42, 0.5);
    --border: rgba(0, 0, 0, 0.08);
    --border-hover: rgba(0, 0, 0, 0.15);
    color: var(--text-primary);
  }
  .blog-hero {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 160px 0 80px;
    position: relative;
    overflow: hidden;
    background: #ffffff;
    justify-content: center;
  }

  .hero-bg { display: none; }

  .gradient-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.5;
  }

  .blob-1 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.4), transparent 70%);
    top: -10%;
    left: -5%;
    animation: blobFloat1 20s ease-in-out infinite;
  }

  .blob-2 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.3), transparent 70%);
    bottom: -5%;
    right: -5%;
    animation: blobFloat2 18s ease-in-out infinite;
  }

  @keyframes blobFloat1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(40px, -30px) scale(1.1); }
  }

  @keyframes blobFloat2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-30px, 20px) scale(1.15); }
  }

  .blog-hero-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  .blog-title {
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.04em;
    margin-bottom: 24px;
    text-align: left;
    color: #000000;
  }

  .blog-title .accent {
    background: linear-gradient(135deg, #A78BFA 0%, #22D3EE 50%, #34D399 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-style: italic;
    font-weight: 500;
    font-family: 'Georgia', 'Times New Roman', serif;
  }

  .blog-desc {
    font-size: 18px;
    color: #444444;
    line-height: 1.7;
    max-width: 560px;
    margin: 0 auto;
  }

  /* Featured */
  .featured-section {
    padding: 60px 0 40px;
    background: var(--bg-primary);
    position: relative;
  }

  .featured-card {
    display: block;
    background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 48px;
    position: relative;
    overflow: hidden;
    transition: all 0.5s var(--transition);
    text-decoration: none;
  }

  .featured-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-4px);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.35);
  }

  .featured-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent-primary), var(--accent-secondary));
  }

  .featured-badge {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: white;
    padding: 6px 16px;
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
    border-radius: 100px;
    margin-bottom: 20px;
  }

  .featured-meta {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .featured-category {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent-primary);
  }

  .featured-date {
    font-size: 13px;
    color: var(--text-muted);
  }

  .featured-content h2 {
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 16px;
    color: var(--text-primary);
    max-width: 700px;
  }

  .featured-content p {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 24px;
    max-width: 640px;
  }

  .featured-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    color: var(--accent-primary);
    transition: gap 0.3s;
  }

  .featured-card:hover .featured-link {
    gap: 12px;
  }

  /* Categories */
  .categories-section {
    padding: 20px 0 40px;
    background: var(--bg-primary);
  }

  .category-list {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .category-btn {
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    background: rgba(0, 0, 0, 0.04);
    border: 1px solid var(--border);
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.3s;
    font-family: var(--font-body);
  }

  .category-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--border-hover);
    color: var(--text-primary);
  }

  .category-btn.active {
    background: var(--accent-primary);
    border-color: var(--accent-primary);
    color: white;
  }

  /* Posts Grid */
  .posts-section {
    padding: 40px 0 120px;
    background: var(--bg-primary);
    position: relative;
  }

  .posts-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .post-card {
    display: block;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: all 0.4s var(--transition);
    text-decoration: none;
  }

  .post-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-4px);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.3);
  }

  .post-card-inner {
    padding: 36px;
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .post-category {
    font-size: 12px;
    font-weight: 600;
    color: var(--accent-primary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .post-date {
    font-size: 12px;
    color: var(--text-muted);
  }

  .post-card h3 {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 12px;
    color: var(--text-primary);
    transition: color 0.3s;
  }

  .post-card:hover h3 {
    color: var(--accent-primary);
  }

  .post-card p {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }

  .post-read {
    font-size: 13px;
    color: var(--text-muted);
  }

  .post-arrow {
    color: var(--text-muted);
    transition: all 0.3s;
  }

  .post-card:hover .post-arrow {
    color: var(--accent-primary);
    transform: translateX(4px);
  }

  /* Newsletter */
  .newsletter-section {
    padding: 80px 0 120px;
    background: var(--bg-primary);
    position: relative;
  }

  .newsletter-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }

  .newsletter-card {
    padding: 1px;
    max-width: 800px;
    margin: 0 auto;
  }

  .newsletter-inner {
    background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
    border-radius: calc(var(--radius-xl) - 1px);
    padding: 48px;
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .newsletter-content {
    flex: 1;
  }

  .newsletter-content h2 {
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 8px;
    color: var(--text-primary);
  }

  .newsletter-content p {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .newsletter-form {
    display: flex;
    gap: 12px;
    flex: 1;
  }

  .newsletter-form input {
    flex: 1;
    padding: 14px 18px;
    background: rgba(0, 0, 0, 0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-size: 15px;
    font-family: var(--font-body);
    outline: none;
    transition: all 0.3s;
  }

  .newsletter-form input::placeholder {
    color: var(--text-muted);
  }

  .newsletter-form input:focus {
    border-color: var(--accent-primary);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
  }

  .newsletter-form button {
    padding: 14px 28px;
    white-space: nowrap;
  }

  @media (max-width: 1024px) {
    .posts-grid { grid-template-columns: 1fr; }
    .newsletter-inner { flex-direction: column; text-align: center; }
    .newsletter-form { width: 100%; }
  }

  @media (max-width: 640px) {
    .blog-hero { padding: 140px 0 60px; }
    .blog-title { font-size: 36px; }
    .featured-card { padding: 32px 24px; }
    .post-card-inner { padding: 28px 24px; }
    .newsletter-inner { padding: 32px 24px; }
    .newsletter-form { flex-direction: column; }
    .gradient-blob { display: none; }
  }
</style>
