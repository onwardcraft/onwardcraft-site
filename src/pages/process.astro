---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const title = 'Our Process — How We Build Websites That Convert';
const description = 'Our proven 4-step process takes you from strategy to launch in 4-6 weeks. No surprises. No delays. Just results.';

const steps = [
  {
    num: '01',
    title: 'Discovery & Strategy',
    timeline: 'Week 1',
    desc: 'We start by understanding your business, your audience, and your goals. We audit your current site, analyze your competitors, and map every conversion opportunity.',
    deliverables: [
      'Competitive landscape analysis',
      'User persona definitions',
      'Conversion opportunity map',
      'Sitemap & content strategy',
      'Project timeline & milestones',
    ],
    clientInvolvement: '1 strategy call (60 min) + questionnaire',
  },
  {
    num: '02',
    title: 'Design & Prototyping',
    timeline: 'Weeks 2-3',
    desc: 'We design every page in Figma with conversion psychology baked in. You see exactly what your site will look like before a single line of code is written.',
    deliverables: [
      'High-fidelity mockups for all pages',
      'Mobile-responsive designs',
      'Interactive prototype',
      'Copy & messaging framework',
      'Design system & component library',
    ],
    clientInvolvement: '2 review rounds + feedback sessions',
  },
  {
    num: '03',
    title: 'Development & Build',
    timeline: 'Weeks 4-5',
    desc: 'We build your site with Astro/React for maximum speed, SEO, and flexibility. Every line of code is clean, semantic, and optimized for performance.',
    deliverables: [
      'Pixel-perfect frontend build',
      'SEO-optimized code architecture',
      'Analytics & tracking setup',
      'CMS integration (if applicable)',
      'Cross-browser testing',
    ],
    clientInvolvement: 'Progress updates + preview access',
  },
  {
    num: '04',
    title: 'Launch & Optimize',
    timeline: 'Week 6+',
    desc: 'We do not just launch and leave. We monitor performance, fix any issues, and set you up for ongoing growth with data-driven optimizations.',
    deliverables: [
      'Production deployment',
      'Performance audit & optimization',
      'Google Search Console setup',
      'Post-launch support (30 days)',
      'Growth roadmap & next steps',
    ],
    clientInvolvement: 'Launch approval + handoff call',
  },
];

const principles = [
  {
    title: 'No Surprises',
    desc: 'You see the design before we build. You approve every milestone. There are no "gotcha" moments or unexpected costs.',
  },
  {
    title: 'Speed Without Sacrifice',
    desc: 'We move fast because we are disciplined, not because we cut corners. Our process is optimized to deliver quality on a tight timeline.',
  },
  {
    title: 'Data Over Opinions',
    desc: 'Every design decision is backed by conversion data, user behavior research, and SEO best practices — not personal preference.',
  },
  {
    title: 'Your Input Matters',
    desc: 'This is a collaboration, not a black box. You are involved at every key milestone with clear feedback windows.',
  },
];
---

<Layout title={title} description={description}>
  <Navbar />

  <section class="process-hero">
    <div class="hero-bg">
      <div class="gradient-blob blob-1"></div>
      <div class="gradient-blob blob-2"></div>
    </div>
    <div class="process-hero-inner container">
      <p class="section-label reveal">Our Process</p>
      <h1 class="process-title reveal">
        From Strategy to Launch.<br/>
        <span class="accent">In 4 Simple Steps.</span>
      </h1>
      <p class="process-desc reveal">
        No chaos. No endless back-and-forth. Just a proven system that takes you from idea to live site in 4-6 weeks.
      </p>
    </div>
  </section>

  <section class="steps-section">
    <div class="container">
      <div class="steps-timeline">
        {steps.map((step, i) => (
          <div class="step-row reveal">
            <div class="step-number-col">
              <span class="step-num">{step.num}</span>
              {i < steps.length - 1 && <div class="step-connector"></div>}
            </div>
            <div class="step-content-col">
              <div class="step-card">
                <span class="step-timeline">{step.timeline}</span>
                <h2>{step.title}</h2>
                <p class="step-desc">{step.desc}</p>
                <div class="step-deliverables">
                  <h4>Deliverables</h4>
                  <ul>
                    {step.deliverables.map(d => <li>{d}</li>)}
                  </ul>
                </div>
                <div class="step-client">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                  <span><strong>Your involvement:</strong> {step.clientInvolvement}</span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="principles-section">
    <div class="container">
      <div class="principles-header reveal">
        <p class="section-label scramble-text">How We Work</p>
        <h2 class="section-title">Principles That Keep Every Project on Track.</h2>
      </div>
      <div class="principles-grid stagger-children">
        {principles.map((p) => (
          <div class="principle-card stagger-item">
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="final-cta-section">
    <div class="container">
      <div class="final-cta-card reveal gradient-border pulse-glow">
        <div class="final-cta-content">
          <h2>Ready to Start Your Project?</h2>
          <p>Book a free strategy call and get a clear timeline, deliverables list, and growth plan.</p>
          <a href="https://cal.com/rachit-nand-ud0itz/30min" target="_blank" rel="noopener" class="cta-button magnetic">Book Your Free Strategy Call</a>
          <p class="cta-guarantee">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            No commitment. No pressure.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .process-hero {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 160px 0 80px;
    position: relative;
    overflow: hidden;
    background: #030712;
  }
  .hero-bg { position: absolute; inset: 0; overflow: hidden; }
  .gradient-blob { position: absolute; border-radius: 50%; filter: blur(120px); opacity: 0.5; }
  .blob-1 { width: 500px; height: 500px; background: radial-gradient(circle, rgba(59,130,246,0.4), transparent 70%); top: -10%; left: -5%; animation: blobFloat1 20s ease-in-out infinite; }
  .blob-2 { width: 400px; height: 400px; background: radial-gradient(circle, rgba(139,92,246,0.3), transparent 70%); bottom: -5%; right: -5%; animation: blobFloat2 18s ease-in-out infinite; }
  @keyframes blobFloat1 { 0%,100%{transform:translate(0,0)scale(1)} 50%{transform:translate(40px,-30px)scale(1.1)} }
  @keyframes blobFloat2 { 0%,100%{transform:translate(0,0)scale(1)} 50%{transform:translate(-30px,20px)scale(1.15)} }
  .process-hero-inner { position: relative; z-index: 1; text-align: center; max-width: 720px; margin: 0 auto; }
  .process-title { font-size: clamp(40px, 6vw, 64px); font-weight: 700; line-height: 1.05; letter-spacing: -0.04em; margin-bottom: 24px; }
  .process-title .accent { background: linear-gradient(135deg, #A78BFA 0%, #22D3EE 50%, #34D399 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; font-style: italic; font-weight: 500; font-family: 'Georgia', 'Times New Roman', serif; }
  .process-desc { font-size: 18px; color: var(--text-secondary); line-height: 1.7; max-width: 600px; margin: 0 auto; }

  .steps-section { padding: 100px 0; background: var(--bg-primary); position: relative; }
  .steps-section::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, var(--border), transparent); }
  .steps-timeline { max-width: 900px; margin: 0 auto; }
  .step-row { display: grid; grid-template-columns: 80px 1fr; gap: 24px; }
  .step-number-col { display: flex; flex-direction: column; align-items: center; position: relative; }
  .step-num { width: 56px; height: 56px; border-radius: 50%; background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary)); display: flex; align-items: center; justify-content: center; font-family: var(--font-heading); font-size: 16px; font-weight: 700; color: white; flex-shrink: 0; box-shadow: 0 4px 20px rgba(59,130,246,0.3); }
  .step-connector { width: 2px; flex: 1; min-height: 60px; background: linear-gradient(180deg, var(--accent-primary), transparent); margin-top: 16px; }
  .step-content-col { padding-bottom: 60px; }
  .step-row:last-child .step-content-col { padding-bottom: 0; }
  .step-card { background: linear-gradient(180deg, rgba(17,24,39,0.6) 0%, rgba(5,8,22,0.4) 100%); border: 1px solid var(--border); border-radius: var(--radius-xl); padding: 40px; transition: all 0.4s var(--transition); }
  .step-card:hover { border-color: var(--border-hover); transform: translateY(-4px); box-shadow: 0 24px 48px rgba(0,0,0,0.3); }
  .step-timeline { display: inline-block; font-size: 12px; font-weight: 600; color: var(--accent-primary); text-transform: uppercase; letter-spacing: 0.08em; padding: 6px 14px; background: rgba(59,130,246,0.1); border: 1px solid rgba(59,130,246,0.2); border-radius: 100px; margin-bottom: 12px; }
  .step-card h2 { font-size: 26px; font-weight: 700; margin-bottom: 16px; color: var(--text-primary); }
  .step-desc { font-size: 16px; color: var(--text-secondary); line-height: 1.7; margin-bottom: 28px; }
  .step-deliverables h4 { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 12px; }
  .step-deliverables ul { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .step-deliverables li { font-size: 14px; color: var(--text-secondary); padding: 8px 12px; background: rgba(255,255,255,0.03); border-radius: var(--radius-sm); display: flex; align-items: center; gap: 8px; }
  .step-deliverables li::before { content: ''; width: 6px; height: 6px; background: var(--accent-primary); border-radius: 50%; flex-shrink: 0; }
  .step-client { display: flex; align-items: center; gap: 10px; margin-top: 24px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,0.06); font-size: 14px; color: var(--text-secondary); }
  .step-client svg { color: var(--accent-primary); flex-shrink: 0; }
  .step-client strong { color: var(--text-primary); }

  .principles-section { padding: 120px 0; background: var(--bg-primary); position: relative; }
  .principles-section::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, var(--border), transparent); }
  .principles-header { text-align: center; max-width: 560px; margin: 0 auto 80px; }
  .principles-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; max-width: 900px; margin: 0 auto; }
  .principle-card { background: linear-gradient(180deg, rgba(17,24,39,0.5) 0%, rgba(5,8,22,0.3) 100%); border: 1px solid var(--border); border-radius: var(--radius-xl); padding: 40px 36px; transition: all 0.4s var(--transition); }
  .principle-card:hover { border-color: var(--border-hover); transform: translateY(-4px); box-shadow: 0 20px 48px rgba(0,0,0,0.25); }
  .principle-card h3 { font-size: 20px; font-weight: 700; margin-bottom: 12px; color: var(--text-primary); }
  .principle-card p { font-size: 15px; color: var(--text-secondary); line-height: 1.7; }

  .final-cta-section { padding: 120px 0 80px; background: var(--bg-primary); position: relative; }
  .final-cta-card { position: relative; background: linear-gradient(180deg, rgba(139,92,246,0.08) 0%, rgba(17,24,39,0.6) 100%); border-radius: var(--radius-xl); padding: 80px; overflow: hidden; text-align: center; }
  .final-cta-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, rgba(139,92,246,0.4), rgba(59,130,246,0.3), transparent); }
  .final-cta-content { position: relative; z-index: 1; max-width: 600px; margin: 0 auto; }
  .final-cta-content h2 { font-size: clamp(32px, 4.5vw, 52px); font-weight: 700; line-height: 1.1; letter-spacing: -0.03em; margin-bottom: 20px; }
  .final-cta-content > p { font-size: 17px; color: var(--text-secondary); line-height: 1.7; margin-bottom: 36px; }
  .cta-button { display: inline-flex; align-items: center; gap: 10px; padding: 18px 36px; background: var(--accent-primary); color: white; font-size: 16px; font-weight: 600; border-radius: var(--radius-md); transition: all 0.35s var(--transition); box-shadow: 0 4px 24px rgba(59,130,246,0.3); }
  .cta-button:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(59,130,246,0.4); }
  .cta-guarantee { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 24px; font-size: 13px; color: var(--text-muted); }
  .cta-guarantee svg { color: #34D399; }

  @media (max-width: 1024px) {
    .principles-grid { grid-template-columns: 1fr; }
    .step-deliverables ul { grid-template-columns: 1fr; }
    .final-cta-card { padding: 48px 28px; }
  }
  @media (max-width: 640px) {
    .process-hero { padding: 140px 0 60px; }
    .process-title { font-size: 36px; }
    .step-row { grid-template-columns: 1fr; gap: 16px; }
    .step-number-col { flex-direction: row; gap: 12px; }
    .step-connector { display: none; }
    .step-card { padding: 28px 24px; }
    .step-content-col { padding-bottom: 40px; }
    .gradient-blob { display: none; }
  }
</style>
