---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const title = 'Contact OnwardCraft — Get a Free Website Audit';
const description = 'Ready to turn your website into a lead machine? Book a free strategy call or get a free website audit. We respond within 24 hours.';

const faqs = [
  { q: 'How quickly do you respond?', a: 'We respond to all inquiries within 24 hours during business days. For urgent requests, mention it in your message and we will prioritize it.' },
  { q: 'What happens after I submit the form?', a: 'We will review your submission, check out your current website, and send you a personalized video audit within 48 hours — completely free.' },
  { q: 'Is the strategy call really free?', a: 'Yes. 100% free. No credit card required. No obligation. Just a 20-minute call where we audit your site and give you a clear growth plan.' },
  { q: 'What information should I provide?', a: 'Your website URL, your business name, and a brief description of what you need. The more context, the better we can prepare for our call.' },
];

// Formspree form ID. Create a free form at https://formspree.io and paste the
// ID here (the part after /f/ in your endpoint, e.g. "myzgabcd").
// Until this is set to a real ID, the form falls back to a mailto: submission
// so no lead is ever silently lost.
const FORMSPREE_ID = 'YOUR_FORM_ID';
const FORM_ENDPOINT = `https://formspree.io/f/${FORMSPREE_ID}`;
const FORM_CONFIGURED = FORMSPREE_ID !== 'YOUR_FORM_ID';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://onwardcraft.com/" },
      { "@type": "ListItem", position: 2, name: "Contact", item: "https://onwardcraft.com/contact/" },
    ],
  },
];
---

<Layout title={title} description={description} schema={schema}>
  <Navbar />

  <!-- Hero -->
  <section class="contact-hero">
    <div class="hero-bg">
      <div class="gradient-blob blob-1"></div>
      <div class="gradient-blob blob-2"></div>
    </div>
    <div class="contact-hero-inner container">
      <p class="section-label reveal">Get In Touch</p>
      <h1 class="contact-title reveal">
        Let's Talk About<br/>
        <span class="accent">Your Growth.</span>
      </h1>
      <p class="contact-desc reveal">
        Tell us what you need. We'll review your site and send you a free video audit within 48 hours. No strings attached.
      </p>
    </div>
  </section>

  <!-- Contact Form -->
  <section class="contact-section">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-form-wrapper reveal">
          <div class="form-success" id="formSuccess" hidden>
            <div class="form-success-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
            </div>
            <h3>Got it — your audit is on the way.</h3>
            <p>We've received your details and we'll send your free video audit within 48 hours. Check your inbox (and spam folder, just in case).</p>
            <a href="/book-call/" class="submit-btn" rel="noopener noreferrer" style="margin-top:8px;width:auto;display:inline-flex;">Or book a call now</a>
          </div>
          <form class="contact-form" id="contactForm" action={FORM_ENDPOINT} method="POST" data-configured={FORM_CONFIGURED.toString()} novalidate>
            <div class="form-step" id="step1">
              <h3>Step 1: What do you need?</h3>
              <div class="radio-group">
                <label class="radio-card">
                  <input type="radio" name="need" value="new-website" checked />
                  <span class="radio-check"></span>
                  <span class="radio-label">New Website</span>
                </label>
                <label class="radio-card">
                  <input type="radio" name="need" value="redesign" />
                  <span class="radio-check"></span>
                  <span class="radio-label">Website Redesign</span>
                </label>
                <label class="radio-card">
                  <input type="radio" name="need" value="seo" />
                  <span class="radio-check"></span>
                  <span class="radio-label">SEO Only</span>
                </label>
                <label class="radio-card">
                  <input type="radio" name="need" value="other" />
                  <span class="radio-check"></span>
                  <span class="radio-label">Something Else</span>
                </label>
              </div>
            </div>

            <div class="form-step" id="step2">
              <h3>Step 2: What's your budget?</h3>
              <div class="radio-group">
                <label class="radio-card">
                  <input type="radio" name="budget" value="1k-2.5k" />
                  <span class="radio-check"></span>
                  <span class="radio-label">$1,000 – $2,500</span>
                </label>
                <label class="radio-card">
                  <input type="radio" name="budget" value="2.5k-5k" checked />
                  <span class="radio-check"></span>
                  <span class="radio-label">$2,500 – $5,000</span>
                </label>
                <label class="radio-card">
                  <input type="radio" name="budget" value="5k-10k" />
                  <span class="radio-check"></span>
                  <span class="radio-label">$5,000 – $10,000</span>
                </label>
                <label class="radio-card">
                  <input type="radio" name="budget" value="10k+" />
                  <span class="radio-check"></span>
                  <span class="radio-label">$10,000+</span>
                </label>
              </div>
            </div>

            <div class="form-step" id="step3">
              <h3>Step 3: Your Details</h3>
              <div class="form-fields">
                <div class="form-row">
                  <div class="form-field">
                    <label for="name">Name</label>
                    <input type="text" id="name" name="name" placeholder="John Smith" required />
                  </div>
                  <div class="form-field">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" placeholder="john@company.com" required />
                  </div>
                </div>
                <div class="form-row">
                  <div class="form-field">
                    <label for="phone">Phone (optional)</label>
                    <input type="tel" id="phone" name="phone" placeholder="(555) 123-4567" />
                  </div>
                  <div class="form-field">
                    <label for="website">Website URL</label>
                    <input type="url" id="website" name="website" placeholder="https://yourcompany.com" />
                  </div>
                </div>
                <div class="form-field">
                  <label for="business">Business Name</label>
                  <input type="text" id="business" name="business" placeholder="Your Company" />
                </div>
                <div class="form-field">
                  <label for="message">Tell us about your project</label>
                  <textarea id="message" name="message" rows="4" placeholder="What are your goals? What's your timeline? Anything else we should know?"></textarea>
                </div>
              </div>
            </div>

            <p class="form-error" id="formError" hidden></p>

            <button type="submit" class="submit-btn" id="submitBtn">
              <span class="submit-label">Get My Free Audit</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
            </button>
          </form>
        </div>

        <div class="contact-info reveal reveal-right">
          <div class="info-card">
            <h3>What Happens Next?</h3>
            <div class="info-steps">
              <div class="info-step">
                <span class="info-num">01</span>
                <div>
                  <strong>We review your submission</strong>
                  <p>Within 24 hours, we look at your current site and understand your goals.</p>
                </div>
              </div>
              <div class="info-step">
                <span class="info-num">02</span>
                <div>
                  <strong>You get a free video audit</strong>
                  <p>A 5-10 minute Loom video showing what's broken and how to fix it.</p>
                </div>
              </div>
              <div class="info-step">
                <span class="info-num">03</span>
                <div>
                  <strong>We book a strategy call</strong>
                  <p>If it makes sense, we'll hop on a call to map out your growth plan.</p>
                </div>
              </div>
            </div>
          </div>

          <div class="info-card contact-methods">
            <h3>Other Ways to Reach Us</h3>
            <div class="contact-method">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              <div>
                <strong>Email</strong>
                <a href="mailto:getonwardcraft@gmail.com">getonwardcraft@gmail.com</a>
              </div>
            </div>
            <div class="contact-method">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
              <div>
                <strong>Book Directly</strong>
                <a href="/book-call/">Book a free 30-minute call</a>
              </div>
            </div>
            <div class="contact-method">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <div>
                <strong>Response Time</strong>
                <span>Within 24 hours</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section" id="faq">
    <div class="container">
      <div class="faq-header reveal">
        <p class="section-label scramble-text">FAQ</p>
        <h2 class="section-title">Quick Questions. Quick Answers.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq, i) => (
          <details class="faq-item reveal" open={i === 0}>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  if (form) {
    const errorEl = document.getElementById('formError') as HTMLElement;
    const successEl = document.getElementById('formSuccess') as HTMLElement;
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
    const labelEl = submitBtn?.querySelector('.submit-label') as HTMLElement;
    const configured = form.dataset.configured === 'true';

    const showError = (msg: string) => {
      errorEl.textContent = msg;
      errorEl.hidden = false;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.hidden = true;

      const name = (form.querySelector('#name') as HTMLInputElement).value.trim();
      const email = (form.querySelector('#email') as HTMLInputElement).value.trim();

      if (!name) return showError('Please enter your name so we know who we are talking to.');
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return showError('Please enter a valid email address so we can send your audit.');

      // Fallback: if Formspree is not configured yet, open a pre-filled email
      // so the lead is never silently lost.
      if (!configured) {
        const data = new FormData(form);
        const body = Array.from(data.entries())
          .map(([k, v]) => `${k}: ${v}`)
          .join('%0D%0A');
        window.location.href =
          `mailto:getonwardcraft@gmail.com?subject=${encodeURIComponent('Free Audit Request — ' + name)}&body=${body}`;
        return;
      }

      submitBtn.disabled = true;
      if (labelEl) labelEl.textContent = 'Sending…';

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          form.hidden = true;
          successEl.hidden = false;
          successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
          (window as any).gtag && (window as any).gtag('event', 'generate_lead', { form_id: 'contact' });
        } else {
          const json = await res.json().catch(() => ({}));
          showError(json?.errors?.[0]?.message || 'Something went wrong. Please email getonwardcraft@gmail.com directly.');
        }
      } catch {
        showError('Network error. Please email getonwardcraft@gmail.com directly and we will respond fast.');
      } finally {
        submitBtn.disabled = false;
        if (labelEl) labelEl.textContent = 'Get My Free Audit';
      }
    });
  }
</script>

<style>
  .contact-hero {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 160px 0 80px;
    position: relative;
    overflow: hidden;
    background: #030712;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .gradient-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.5;
  }

  .blob-1 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(6, 214, 160, 0.4), transparent 70%);
    top: -10%;
    left: -5%;
    animation: blobFloat1 20s ease-in-out infinite;
  }

  .blob-2 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(255, 184, 77, 0.3), transparent 70%);
    bottom: -5%;
    right: -5%;
    animation: blobFloat2 18s ease-in-out infinite;
  }

  @keyframes blobFloat1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(40px, -30px) scale(1.1); }
  }

  @keyframes blobFloat2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-30px, 20px) scale(1.15); }
  }

  .contact-hero-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  .contact-title {
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.04em;
    margin-bottom: 24px;
  }

  .contact-title .accent {
    background: linear-gradient(135deg, #FFB84D 0%, #06D6A0 50%, #06D6A0 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-style: italic;
    font-weight: 500;
    font-family: 'Georgia', 'Times New Roman', serif;
  }

  .contact-desc {
    font-size: 18px;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 560px;
    margin: 0 auto;
  }

  /* Contact Section */
  .contact-section {
    padding: 80px 0 120px;
    background: var(--bg-primary);
    position: relative;
  }

  .contact-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 60px;
    align-items: start;
  }

  .contact-form-wrapper {
    background: linear-gradient(180deg, rgba(17, 24, 39, 0.6) 0%, rgba(5, 8, 22, 0.4) 100%);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 48px;
  }

  .form-step {
    margin-bottom: 36px;
    padding-bottom: 36px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .form-step:last-of-type {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .form-step h3 {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 20px;
  }

  .radio-group {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .radio-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.3s;
    font-size: 14px;
    color: var(--text-secondary);
  }

  .radio-card:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: var(--border-hover);
  }

  .radio-card input {
    /* Keep in accessibility tree for keyboard operation (sr-only pattern) */
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .radio-card:has(input:focus-visible) {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  .radio-check {
    width: 20px;
    height: 20px;
    border: 2px solid var(--border-hover);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s;
    flex-shrink: 0;
  }

  .radio-card input:checked + .radio-check {
    border-color: var(--accent-primary);
    background: var(--accent-primary);
  }

  .radio-card input:checked + .radio-check::after {
    content: '';
    width: 8px;
    height: 8px;
    background: white;
    border-radius: 50%;
  }

  .radio-card input:checked ~ .radio-label {
    color: var(--text-primary);
    font-weight: 600;
  }

  .form-fields {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-field label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .form-field input,
  .form-field textarea {
    padding: 14px 16px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-size: 15px;
    font-family: var(--font-body);
    outline: none;
    transition: all 0.3s;
  }

  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color: var(--text-muted);
  }

  .form-field input:focus,
  .form-field textarea:focus {
    border-color: var(--accent-primary);
    box-shadow: 0 0 0 3px rgba(6, 214, 160, 0.1);
  }

  .form-field textarea {
    resize: vertical;
    min-height: 100px;
  }

  .submit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 18px 36px;
    background: var(--accent-primary);
    color: var(--accent-on);
    font-size: 16px;
    font-weight: 600;
    border-radius: var(--radius-md);
    border: none;
    cursor: pointer;
    transition: all 0.35s var(--transition);
    box-shadow: 0 4px 24px rgba(6, 214, 160, 0.3);
    margin-top: 24px;
  }

  .submit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(6, 214, 160, 0.4);
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .form-error {
    margin-top: 16px;
    padding: 14px 18px;
    background: rgba(244, 63, 94, 0.08);
    border: 1px solid rgba(244, 63, 94, 0.3);
    border-radius: var(--radius-md);
    color: #fda4af;
    font-size: 14px;
    line-height: 1.5;
  }

  .form-success {
    text-align: center;
    padding: 24px 8px;
  }

  .form-success-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(6, 214, 160, 0.12);
    border: 1px solid rgba(6, 214, 160, 0.3);
    color: var(--accent-primary);
  }

  .form-success h3 {
    font-size: 22px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 12px;
  }

  .form-success p {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 420px;
    margin: 0 auto 24px;
  }

  /* Contact Info */
  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 24px;
    position: sticky;
    top: 120px;
  }

  .info-card {
    background: linear-gradient(180deg, rgba(17, 24, 39, 0.5) 0%, rgba(5, 8, 22, 0.3) 100%);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 36px;
  }

  .info-card h3 {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 24px;
    color: var(--text-primary);
  }

  .info-steps {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .info-step {
    display: flex;
    gap: 16px;
  }

  .info-num {
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 700;
    color: var(--accent-primary);
    padding: 6px 12px;
    background: rgba(6, 214, 160, 0.1);
    border: 1px solid rgba(6, 214, 160, 0.2);
    border-radius: 100px;
    height: fit-content;
    flex-shrink: 0;
  }

  .info-step strong {
    display: block;
    font-size: 15px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .info-step p {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .contact-method {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .contact-method svg {
    color: var(--accent-primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .contact-method strong {
    display: block;
    font-size: 14px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 2px;
  }

  .contact-method a,
  .contact-method span {
    font-size: 14px;
    color: var(--text-secondary);
  }

  .contact-method a:hover {
    color: var(--accent-primary);
  }

  /* FAQ */
  .faq-section {
    padding: 120px 0;
    background: var(--bg-primary);
    position: relative;
  }

  .faq-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }

  .faq-header {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 60px;
  }

  .faq-list {
    max-width: 800px;
    margin: 0 auto;
