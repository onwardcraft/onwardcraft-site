---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE } from '../data/site.js';
import { PUBLISHED_ISO } from '../data/posts.js';

const canonical = `${SITE.url}/contact/`;
const title = `Contact & Corrections | ${SITE.name}`;
const description =
  'Send a correction, suggest a city guide, or point out something we got wrong. OnwardCraft is an independent SEO publication — we take corrections seriously and publish them.';

// Same FormSubmit.co endpoint the newsletter uses. First submission after a
// deploy triggers a one-time activation email to the publication address.
const FORM_ENDPOINT = SITE.newsletterEndpoint;

const REASONS = [
  { value: 'correction', label: 'A correction — something here is wrong' },
  { value: 'city', label: 'A city guide request' },
  { value: 'topic', label: 'A topic you should cover' },
  { value: 'other', label: 'Something else' },
];
---

<Layout title={title} description={description} canonical={canonical} schema={[
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    '@id': `${canonical}#page`,
    url: canonical,
    name: 'Contact & corrections',
    description,
    isPartOf: { '@id': `${SITE.url}/#website` },
    dateModified: PUBLISHED_ISO,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: canonical },
    ],
  },
]}>
  <SiteHeader />

  <main id="main">
    <header class="page-head">
      <div class="container">
        <p class="kicker">Contact</p>
        <h1>Corrections, requests, and complaints</h1>
        <p class="page-head__dek">
          We are not selling anything, so this is not a lead form. It goes to the
          desk. The fastest way to get a reply is to tell us which page you are
          writing about.
        </p>
      </div>
    </header>

    <div class="container contact">
      <form class="cform" action={FORM_ENDPOINT} method="POST">
        <input type="hidden" name="_subject" value="OnwardCraft — message from the site" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="cform__honey" aria-hidden="true" />

        <div class="cform__row">
          <label for="name">Your name</label>
          <input id="name" name="name" type="text" required autocomplete="name" />
        </div>

        <div class="cform__row">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" />
        </div>

        <fieldset class="cform__row">
          <legend>What is this about?</legend>
          <div class="cform__radios">
            {REASONS.map((r, i) => (
              <label class="radio">
                <input type="radio" name="reason" value={r.value} checked={i === 0} />
                <span>{r.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="cform__row">
          <label for="page">Which page? <span class="opt">(optional, but it helps)</span></label>
          <input id="page" name="page" type="text" placeholder="e.g. /denver/local-seo/" />
        </div>

        <div class="cform__row">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="7" required placeholder="If this is a correction, tell us what is wrong and — where you can — what the right figure or source is."></textarea>
        </div>

        <button class="btn btn-primary" type="submit">Send it</button>
        <p class="cform__note">
          Goes straight to the desk. We read everything and reply to most things
          within a few days.
        </p>
      </form>

      <aside class="contact__rail">
        <div class="rail__sticky">
          <div class="rail__box">
            <h2 class="rail__h">Our corrections policy</h2>
            <p class="rail__body">
              If we published something wrong, we fix the page and add a line
              saying what changed and when. We do not silently edit an article
              and pretend the earlier version never ran.
            </p>
            <a class="rail__link" href="/about/">Editorial standards →</a>
          </div>

          <div class="rail__box">
            <h2 class="rail__h">Requesting a city</h2>
            <p class="rail__body">
              We publish guides for 160 US metros. If yours is missing, say which
              one and what is distinctive about demand there — that context is
              what makes a guide worth writing.
            </p>
            <a class="rail__link" href="/locations/">City index →</a>
          </div>

          <Newsletter variant="rail" heading="The OnwardCraft email" location="contact-rail" />
        </div>
      </aside>
    </div>
  </main>

  <SiteFooter />
</Layout>

<style>
  .page-head { padding: 44px 0 32px; border-bottom: 2px solid var(--ink); }
  .page-head h1 { font-size: clamp(32px, 4.8vw, 50px); margin: 12px 0 18px; }
  .page-head__dek {
    font-family: var(--font-read); font-size: 20px; line-height: 1.6;
    color: var(--ink-3); max-width: 60ch;
  }

  .contact {
    display: grid; grid-template-columns: minmax(0, 1fr) 280px;
    gap: 60px; align-items: start; padding: 44px 0 72px;
  }

  .cform { max-width: 620px; font-family: var(--font-ui); }
  .cform__row { margin-bottom: 24px; border: none; }
  .cform label, .cform legend {
    display: block; margin-bottom: 8px;
    font-size: 11.5px; font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--ink-3);
  }
  .opt { text-transform: none; letter-spacing: 0; font-weight: 400; }
  .cform input[type='text'], .cform input[type='email'], .cform textarea {
    width: 100%; padding: 13px 15px;
    font-family: var(--font-ui); font-size: 16px; color: var(--ink);
    background: var(--paper); border: 1px solid var(--rule-strong); border-radius: var(--radius);
  }
  .cform textarea { resize: vertical; line-height: 1.6; }
  .cform input:focus, .cform textarea:focus { outline: 2px solid var(--accent); outline-offset: 1px; }

  .cform__radios { display: flex; flex-direction: column; gap: 10px; }
  .radio { display: flex !important; align-items: center; gap: 10px; margin: 0 !important;
    font-size: 15px !important; font-weight: 400 !important; letter-spacing: 0 !important;
    text-transform: none !important; color: var(--ink-2) !important; cursor: pointer; }
  .radio input { accent-color: var(--accent); width: 16px; height: 16px; }

  .cform__note { margin-top: 14px; font-size: 13px; color: var(--ink-3); }
  .cform__honey { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  .contact__rail { font-family: var(--font-ui); }
  .rail__body { font-family: var(--font-read); font-size: 15.5px; line-height: 1.55; color: var(--ink-3); }
  .rail__link { display: inline-block; margin-top: 12px; font-size: 13px; font-weight: 600; color: var(--accent); }
  .rail__link:hover { text-decoration: underline; }

  @media (max-width: 1040px) {
    .contact { grid-template-columns: 1fr; gap: 44px; }
    .cform { max-width: none; }
  }
</style>
