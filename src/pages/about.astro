---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE, AUTHOR, STANDARDS, SECTIONS } from '../data/site.js';
import { posts, PUBLISHED_ISO } from '../data/posts.js';

const canonical = `${SITE.url}/about/`;
const title = `About ${SITE.name} — an independent SEO publication`;
const description =
  'OnwardCraft is an independent SEO publication for small businesses. What we cover, what we refuse to print, and who writes it.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    '@id': `${canonical}#about`,
    url: canonical,
    name: 'About OnwardCraft',
    description,
    isPartOf: { '@id': `${SITE.url}/#website` },
    mainEntity: { '@id': `${SITE.url}/#organization` },
    dateModified: PUBLISHED_ISO,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'About', item: canonical },
    ],
  },
];
---

<Layout title={title} description={description} canonical={canonical} schema={schema}>
  <SiteHeader />

  <main id="main">
    <header class="page-head">
      <div class="container">
        <p class="kicker">About</p>
        <h1>An SEO publication that has nothing to sell you</h1>
        <p class="page-head__dek">
          Almost everything written about SEO is written by someone who wants to
          do your SEO. That is not automatically dishonest, but it bends the
          advice — towards complexity, towards retainers, towards the parts that
          are hard to do yourself. OnwardCraft is the other thing: a small desk
          that publishes what we can verify and asks for nothing but an email
          address.
        </p>
      </div>
    </header>

    <div class="container page-body">
      <div class="page-main">
        <section class="sec">
          <h2>What we cover</h2>
          <p>
            One subject — search. Three desks, and nothing outside them. We do
            not cover paid ads, social, branding or "growth" in general, because
            a small publication only earns the right to be believed by staying
            narrow enough to be right.
          </p>
          <ul class="desk-list">
            {SECTIONS.map((s) => (
              <li>
                <a href={`/blog/category/${s.slug}/`}>{s.name}</a>
                <p>{s.blurb}</p>
              </li>
            ))}
          </ul>
        </section>

        <section class="sec">
          <h2>What we will and will not print</h2>
          <ol class="standards">
            {STANDARDS.map((s) => (
              <li>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </li>
            ))}
          </ol>
        </section>

        <section class="sec">
          <h2>Who writes this</h2>
          <p>{AUTHOR.bio}</p>
          <p>
            The archive is {posts.length} articles deep and was last reviewed in
            full on {new Date(PUBLISHED_ISO).toLocaleDateString('en-US', { dateStyle: 'long' })}.
            When an article stops being true, we would rather update it than let
            it quietly rot at the top of a search result.
          </p>
        </section>

        <section class="sec">
          <h2>How this is paid for</h2>
          <p>
            It is not, yet — and that is the honest answer rather than a
            positioning statement. There are no ads, no affiliate links, no
            sponsored placements and no paid inclusion in any list or city
            guide. Nobody has ever paid to appear on this site, and if that ever
            changes it will be disclosed on the page it affects, before you read
            it.
          </p>
        </section>

        <section class="sec">
          <h2>Corrections</h2>
          <p>
            If something here is wrong, tell us and we will fix the page and note
            what changed. <a href="/contact/">Send a correction →</a>
          </p>
        </section>
      </div>

      <aside class="page-rail">
        <div class="rail__sticky">
          <Newsletter variant="rail" heading="The OnwardCraft email" location="about-rail" />
          <div class="rail__box">
            <h2 class="rail__h">By the numbers</h2>
            <dl class="mini-stats">
              <div><dt>Articles</dt><dd>{posts.length}</dd></div>
              <div><dt>Desks</dt><dd>{SECTIONS.length}</dd></div>
              <div><dt>Things for sale</dt><dd>0</dd></div>
            </dl>
          </div>
        </div>
      </aside>
    </div>

    <Newsletter location="about-band" />
  </main>

  <SiteFooter />
</Layout>

<style>
  .page-head { padding: 44px 0 32px; border-bottom: 1px solid var(--rule); }
  .page-head h1 { font-size: clamp(32px, 4.8vw, 50px); margin: 12px 0 18px; max-width: 18ch; }
  .page-head__dek {
    font-family: var(--font-read); font-size: 20px; line-height: 1.6;
    color: var(--ink-3); max-width: 64ch;
  }

  .page-body {
    display: grid; grid-template-columns: minmax(0, 1fr) 280px;
    gap: 60px; align-items: start; padding: 44px 0 20px;
  }
  .page-main { max-width: 680px; }

  .sec { margin-bottom: 48px; }
  .sec h2 { font-size: 27px; padding-top: 18px; border-top: 1px solid var(--rule); margin-bottom: 16px; }
  .sec p {
    font-family: var(--font-read); font-size: 18.5px; line-height: 1.7;
    color: var(--ink-2); margin-bottom: 18px;
  }
  .sec a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .sec a:hover { color: var(--accent-deep); }

  .desk-list { list-style: none; margin-top: 22px; }
  .desk-list li { padding: 16px 0; border-top: 1px solid var(--rule); }
  .desk-list li > a {
    font-family: var(--font-display); font-weight: 700; font-size: 19px;
    color: var(--ink); text-decoration: none;
  }
  .desk-list li > a:hover { color: var(--accent); }
  .desk-list p { font-size: 16.5px; margin: 6px 0 0; color: var(--ink-3); }

  .standards { list-style: none; counter-reset: s; }
  .standards li { counter-increment: s; padding: 18px 0; border-top: 1px solid var(--rule); }
  .standards h3 { font-size: 19px; margin-bottom: 7px; }
  .standards h3::before {
    content: counter(s, decimal-leading-zero) ' ';
    font-family: var(--font-ui); font-size: 13px; font-weight: 700;
    letter-spacing: 0.1em; color: var(--accent); margin-right: 8px; vertical-align: 2px;
  }
  .standards p { font-size: 17px; margin-bottom: 0; color: var(--ink-3); }

  .mini-stats { font-family: var(--font-ui); }
  .mini-stats > div {
    display: flex; justify-content: space-between; align-items: baseline;
    padding: 9px 0; border-bottom: 1px solid var(--rule);
  }
  .mini-stats dt { font-size: 13.5px; color: var(--ink-3); }
  .mini-stats dd { font-family: var(--font-display); font-weight: 800; font-size: 20px; color: var(--ink); }

  @media (max-width: 1040px) {
    .page-body { grid-template-columns: 1fr; gap: 44px; }
    .page-main { max-width: none; }
  }
</style>
