---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const title = 'About OnwardCraft — The Team Behind High-Converting Websites';
const description = 'We are a team of designers, developers, and growth strategists obsessed with one thing: turning your website into your best salesperson.';

const values = [
  {
    title: 'Results Over Pretty',
    desc: 'A beautiful website that does not convert is worthless. Every decision we make is filtered through one question: will this drive more leads?',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg>`,
  },
  {
    title: 'Speed is a Feature',
    desc: 'Slow websites kill conversions. We build for sub-second load times because every millisecond of delay costs you leads.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
  },
  {
    title: 'Transparency Always',
    desc: 'No hidden fees. No surprise costs. No jargon. We tell you exactly what we are doing, why we are doing it, and what it will cost.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>`,
  },
  {
    title: 'Partners, Not Vendors',
    desc: 'We do not build and disappear. We stick around, optimize, and grow with you. Your success is our success.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>`,
  },
];

const stats = [
  { num: '50', suffix: '+', label: 'Websites Delivered' },
  { num: '12', prefix: '$', suffix: 'M+', label: 'Revenue Generated' },
  { num: '340', suffix: '%', label: 'Avg. Lead Increase' },
  { num: '4.9', suffix: '/5', label: 'Client Rating' },
];

---

<Layout title={title} description={description}>
  <Navbar />

  <!-- Hero -->
  <section class="about-hero">
    <div class="hero-bg">
      <div class="gradient-blob blob-1"></div>
      <div class="gradient-blob blob-2"></div>
    </div>
    <div class="about-hero-inner container">
      <p class="section-label reveal">About Us</p>
      <h1 class="about-title reveal">
        We Do Not Build Websites.<br/>
        <span class="accent">We Build Growth Engines.</span>
      </h1>
      <p class="about-desc reveal">
        OnwardCraft is a digital growth partner for businesses that are done playing small. We combine conversion-focused design, technical excellence, and growth strategy to turn your website into your most reliable lead source.
      </p>
    </div>
  </section>

  <!-- Stats -->
  <section class="stats-section">
    <div class="container">
      <div class="stats-grid stagger-children">
        {stats.map((s) => (
          <div class="stat-card stagger-item">
            <span class="stat-num">
              <span class="counter" data-target={s.num} data-prefix={s.prefix || ''} data-suffix={s.suffix} data-duration="2200">0</span>
            </span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="story-section">
    <div class="container">
      <div class="story-grid">
        <div class="story-content reveal">
          <p class="section-label">Our Story</p>
          <h2 class="section-title">Started With a Simple Observation.</h2>
          <p class="story-text">
            Most businesses treat their website like a digital brochure. Something to check off the list. "We have a website, so we are good."
          </p>
          <p class="story-text">
            But here is the truth: your website is either working for you 24/7, or it is silently costing you leads every single day. Every visitor who bounces. Every form that goes unfilled. Every competitor who shows up higher on Google.
          </p>
          <p class="story-text">
            OnwardCraft was born from a simple belief: every business deserves a website that actually works. One that ranks, converts, and generates revenue while you sleep.
          </p>
          <p class="story-text accent-text">
            We have helped 50+ businesses turn their websites from cost centers into profit centers. And we are just getting started.
          </p>
        </div>
        <div class="story-visual reveal reveal-right">
          <div class="story-card gradient-border">
            <div class="story-card-inner">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
              <h3>The OnwardCraft Difference</h3>
              <ul>
                <li>Conversion-first, not design-first</li>
                <li>SEO baked in, not bolted on</li>
                <li>Speed as a competitive advantage</li>
                <li>Partnership, not project handoffs</li>
                <li>Data-driven, not opinion-driven</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="values-section">
    <div class="container">
      <div class="values-header reveal">
        <p class="section-label scramble-text">What We Believe</p>
        <h2 class="section-title">Principles That Guide Everything We Do.</h2>
      </div>
      <div class="values-grid stagger-children">
        {values.map((v) => (
          <div class="value-card stagger-item tilt-card">
            <div class="value-icon" set:html={v.icon} />
            <h3>{v.title}</h3>
            <p>{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="final-cta-section">
    <div class="container">
      <div class="final-cta-card reveal gradient-border pulse-glow">
        <div class="final-cta-content">
          <h2>Ready to Turn Your Website Into a Lead Machine?</h2>
          <p>Book a free strategy call and get a custom growth plan worth $2,000 — on us. No pitch. Just a plan.</p>
          <div class="final-cta-buttons">
            <a href="https://calendly.com/getonwardcraft/30min" class="cta-button magnetic" rel="noopener noreferrer">Book Your Free Strategy Call</a>
            <a href="/case-studies/" class="btn-secondary">See Our Work</a>
          </div>
          <p class="cta-guarantee">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            100% satisfaction guarantee.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .about-hero {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 160px 0 100px;
    position: relative;
    overflow: hidden;
    background: #030712;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .gradient-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.5;
  }

  .blob-1 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.4), transparent 70%);
    top: -10%;
    left: -5%;
    animation: blobFloat1 20s ease-in-out infinite;
  }

  .blob-2 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.3), transparent 70%);
    bottom: -5%;
    right: -5%;
    animation: blobFloat2 18s ease-in-out infinite;
  }

  @keyframes blobFloat1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(40px, -30px) scale(1.1); }
  }

  @keyframes blobFloat2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-30px, 20px) scale(1.15); }
  }

  .about-hero-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .about-title {
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.04em;
    margin-bottom: 28px;
  }

  .about-title .accent {
    background: linear-gradient(135deg, #A78BFA 0%, #22D3EE 50%, #34D399 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-style: italic;
    font-weight: 500;
    font-family: 'Georgia', 'Times New Roman', serif;
  }

  .about-desc {
    font-size: 18px;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 640px;
    margin: 0 auto;
  }

  /* Stats */
  .stats-section {
    padding: 80px 0;
    background: var(--bg-primary);
    position: relative;
  }

  .stats-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .stat-card {
    text-align: center;
    padding: 40px 24px;
    background: linear-gradient(180deg, rgba(17, 24, 39, 0.4) 0%, rgba(5, 8, 22, 0.2) 100%);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    transition: all 0.4s var(--transition);
  }

  .stat-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-4px);
  }

  .stat-num {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(32px, 3vw, 44px);
    font-weight: 700;
    background: linear-gradient(135deg, var(--text-primary) 0%, var(--accent-primary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 8px;
    letter-spacing: -0.03em;
  }

  .stat-label {
    font-size: 14px;
    color: var(--text-muted);
  }

  /* Story */
  .story-section {
    padding: 160px 0;
    background: var(--bg-primary);
    position: relative;
  }

  .story-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }

  .story-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 80px;
    align-items: start;
  }

  .story-content .section-title {
    margin-bottom: 32px;
  }

  .story-text {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: 20px;
  }

  .accent-text {
    color: var(--accent-primary);
    font-weight: 600;
  }

  .story-visual {
    position: sticky;
    top: 120px;
  }

  .story-card {
    padding: 1px;
  }

  .story-card-inner {
    background: linear-gradient(180deg, rgba(17, 24, 39, 0.8) 0%, rgba(5, 8, 22, 0.6) 100%);
    border-radius: calc(var(--radius-xl) - 1px);
    padding: 40px;
  }

  .story-card-inner svg {
    color: var(--accent-primary);
    margin-bottom: 20px;
  }

  .story-card-inner h3 {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 20px;
    color: var(--text-primary);
  }

  .story-card-inner ul {
    list-style: none;
  }

  .story-card-inner li {
    font-size: 15px;
    color: var(--text-secondary);
    padding: 10px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .story-card-inner li::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--accent-primary);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .story-card-inner li:last-child {
    border-bottom: none;
  }

  /* Values */
  .values-section {
    padding: 160px 0;
    background: var(--bg-primary);
    position: relative;
  }

  .values-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }

  .values-header {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 80px;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    max-width: 900px;
    margin: 0 auto;
  }

  .value-card {
    background: linear-gradient(180deg, rgba(17, 24, 39, 0.6) 0%, rgba(5, 8, 22, 0.4) 100%);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 44px 36px;
    transition: all 0.5s var(--transition);
    transform-style: preserve-3d;
    will-change: transform;
  }

  .value-card:hover {
    border-color: var(--border-hover);
    transform: perspective(1000px) translateY(-6px);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.3);
  }

  .value-icon {
    width: 52px;
    height: 52px;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.2);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-primary);
    margin-bottom: 24px;
  }

  .value-card h3 {
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 12px;
    color: var(--text-primary);
  }

  .value-card p {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* Final CTA */
  .final-cta-section {
    padding: 120px 0 80px;
    background: var(--bg-primary);
    position: relative;
  }

  .final-cta-card {
    position: relative;
    background: linear-gradient(180deg, rgba(139, 92, 246, 0.08) 0%, rgba(17, 24, 39, 0.6) 100%);
    border-radius: var(--radius-xl);
    padding: 80px;
    overflow: hidden;
    text-align: center;
  }

  .final-cta-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(139, 92, 246, 0.4), rgba(59, 130, 246, 0.3), transparent);
  }

  .final-cta-content {
    position: relative;
    z-index: 1;
    max-width: 600px;
    margin: 0 auto;
  }

  .final-cta-content h2 {
    font-size: clamp(32px, 4.5vw, 52px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 20px;
  }

  .final-cta-content > p {
    font-size: 17px;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 36px;
  }

  .final-cta-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 18px 36px;
    background: var(--accent-primary);
    color: white;
    font-size: 16px;
    font-weight: 600;
    border-radius: var(--radius-md);
    transition: all 0.35s var(--transition);
    box-shadow: 0 4px 24px rgba(59, 130, 246, 0.3);
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(59, 130, 246, 0.4);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 18px 36px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-primary);
    font-size: 16px;
    font-weight: 600;
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.35s var(--transition);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  .cta-guarantee {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 24px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .cta-guarantee svg {
    color: #34D399;
  }

  @media (max-width: 1024px) {
    .story-grid { grid-template-columns: 1fr; gap: 60px; }
    .story-visual { position: static; }
    .values-grid { grid-template-columns: 1fr; }
    .team-grid { grid-template-columns: 1fr; }
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .final-cta-card { padding: 48px 28px; }
    .final-cta-buttons { flex-direction: column; align-items: center; }
    .final-cta-buttons .cta-button, .final-cta-buttons .btn-secondary { width: 100%; max-width: 300px; }
  }

  @media (max-width: 640px) {
    .about-hero { padding: 140px 0 80px; }
    .about-title { font-size: 36px; }
    .story-section, .values-section { padding: 100px 0; }
    .stats-grid { grid-template-columns: 1fr 1fr; }
    .gradient-blob { display: none; }
  }
</style>