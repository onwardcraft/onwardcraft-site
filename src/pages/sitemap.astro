---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE, SECTIONS } from '../data/site.js';
import { posts, getPostsByCategory } from '../data/posts.js';

const canonical = `${SITE.url}/sitemap/`;
const total = posts.length + 8;
const description = `A human-readable index of everything on OnwardCraft — all ${posts.length} SEO articles plus every section of the publication.`;
---

<Layout title={`Site index | ${SITE.name}`} description={description} canonical={canonical}>
  <SiteHeader />
  <main id="main">
    <header class="page-head">
      <div class="container">
        <p class="kicker">Index</p>
        <h1>Everything on this site</h1>
        <p class="page-head__dek">
          A readable index of all {total.toLocaleString()} pages. The machine
          version lives at <a href="/sitemap.xml">/sitemap.xml</a>, and the feed
          at <a href="/rss.xml">/rss.xml</a>.
        </p>
      </div>
    </header>

    <div class="container idx">
      <section class="idx__sec">
        <h2>The publication</h2>
        <ul class="idx__inline">
          <li><a href="/">Front page</a></li>
          <li><a href="/blog/">All articles</a></li>
          <li><a href="/topics/">Topics</a></li>
          <li><a href="/about/">About &amp; standards</a></li>
          <li><a href="/newsletter/">Newsletter</a></li>
          <li><a href="/contact/">Contact &amp; corrections</a></li>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="/terms/">Terms</a></li>
        </ul>
      </section>

      {SECTIONS.map((s) => {
        const items = getPostsByCategory(s.name);
        return (
          <section class="idx__sec">
            <h2>{s.name} <span>({items.length})</span></h2>
            <ul class="idx__list">
              {items.map((p) => <li><a href={`/blog/${p.slug}/`}>{p.title}</a></li>)}
            </ul>
          </section>
        );
      })}

    </div>
  </main>
  <SiteFooter />
</Layout>

<style>
  .page-head { padding: 44px 0 32px; border-bottom: 1px solid var(--rule); }
  .page-head h1 { font-size: clamp(32px, 4.8vw, 50px); margin: 12px 0 16px; }
  .page-head__dek { font-family: var(--font-read); font-size: 19px; line-height: 1.6; color: var(--ink-3); max-width: 60ch; }
  .page-head__dek a { color: var(--accent); text-decoration: underline; }

  .idx { padding: 44px 0 72px; }
  .idx__sec { margin-bottom: 48px; }
  .idx__sec h2 {
    font-size: 24px; padding-bottom: 12px; margin-bottom: 18px;
    border-bottom: 1px solid var(--rule);
  }
  .idx__sec h2 span { font-family: var(--font-ui); font-size: 13px; font-weight: 500; color: var(--ink-3); }

  .idx__inline { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 10px; }
  .idx__inline a {
    font-family: var(--font-ui); font-size: 14px; color: var(--ink-2);
    border: 1px solid var(--rule); padding: 6px 14px; border-radius: 100px;
  }
  .idx__inline a:hover { border-color: var(--ink); color: var(--accent); }

  .idx__list { list-style: none; columns: 2; column-gap: 44px; }
  .idx__list li { break-inside: avoid; padding: 9px 0; border-bottom: 1px solid var(--rule); }
  .idx__list a { font-family: var(--font-read); font-size: 16.5px; color: var(--ink-2); }
  .idx__list a:hover { color: var(--accent); }

  .idx__cities { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 36px; }
  .idx__cities li { padding: 11px 0; border-bottom: 1px solid var(--rule); }
  .idx__city { display: block; font-family: var(--font-display); font-weight: 700; font-size: 16px; color: var(--ink); }
  .idx__city:hover { color: var(--accent); }
  .idx__sub {
    display: inline-block; margin: 6px 10px 0 0;
    font-family: var(--font-ui); font-size: 12.5px; color: var(--ink-3);
  }
  .idx__sub:hover { color: var(--accent); text-decoration: underline; }

  @media (max-width: 900px) { .idx__cities { grid-template-columns: 1fr 1fr; } .idx__list { columns: 1; } }
  @media (max-width: 560px) { .idx__cities { grid-template-columns: 1fr; } }
</style>
