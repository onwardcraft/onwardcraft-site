---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import { industries } from '../../data/industries.js';

export async function getStaticPaths() {
  const { industries } = await import('../../data/industries.js');
  return industries.map((ind) => ({
    params: { trade: ind.slug },
    props: { ind },
  }));
}

const { ind } = Astro.props;
const canonical = `https://onwardcraft.com/industries/${ind.slug}/`;

// Other trades for cross-linking at the foot of the page.
const otherTrades = industries.filter((i) => i.slug !== ind.slug);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `${ind.trade} Marketing & Web Design`,
    serviceType: `${ind.trade} marketing, web design, SEO, and lead generation`,
    description: ind.metaDescription,
    url: canonical,
    provider: { '@id': 'https://onwardcraft.com/#organization' },
    areaServed: { '@type': 'Country', name: 'United States' },
    audience: { '@type': 'Audience', audienceType: ind.nounPlural },
    offers: ind.services.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.name, description: s.desc },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: ind.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://onwardcraft.com/' },
      { '@type': 'ListItem', position: 2, name: 'Industries', item: 'https://onwardcraft.com/industries/' },
      { '@type': 'ListItem', position: 3, name: ind.trade, item: canonical },
    ],
  },
];
---

<Layout title={ind.titleTag} description={ind.metaDescription} canonical={canonical} schema={schema}>
  <Navbar dark />

  <main class="trade">
    <!-- Hero -->
    <section class="trade-hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="container trade-hero-inner">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span>
          <a href="/industries/">Industries</a><span aria-hidden="true">/</span>
          <span class="breadcrumb-current">{ind.trade}</span>
        </nav>
        <p class="eyebrow">{ind.trade} Marketing</p>
        <h1>{ind.h1}</h1>
        <p class="hero-sub">{ind.heroSubhead}</p>
        <div class="hero-actions">
          <a href="https://calendly.com/getonwardcraft/30min" class="btn-primary" rel="noopener noreferrer">Get a Free {ind.trade} Marketing Audit</a>
          <a href="/pricing/" class="btn-ghost">See Pricing</a>
        </div>
      </div>
    </section>

    <!-- Intro / AIO answer block -->
    <section class="section">
      <div class="container narrow">
        <p class="lead">{ind.intro}</p>
        <div class="answer-block">
          <h2>{ind.aioQuestion}</h2>
          <p>{ind.aioAnswer}</p>
        </div>
      </div>
    </section>

    <!-- Pain points (PAS) -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">The Real Problem</p>
          <h2>Why generic marketing fails {ind.nounPlural}</h2>
          <p class="section-sub">{ind.whyDifferent}</p>
        </div>
        <div class="card-grid pain-grid">
          {ind.painPoints.map((p) => (
            <div class="card pain-card">
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Services -->
    <section class="section">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">What We Build</p>
          <h2>{ind.trade} marketing, engineered for {ind.accent}</h2>
        </div>
        <div class="card-grid service-grid">
          {ind.services.map((s, i) => (
            <div class="card service-card">
              <span class="service-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.name}</h3>
              <p>{s.desc}</p>
            </div>
          ))}
        </div>
        <div class="service-links">
          <span>Explore the services behind every {ind.trade.toLowerCase()} engagement:</span>
          <a href="/services/web-design/">Web Design</a>
          <a href="/services/seo/">SEO</a>
          <a href="/services/lead-generation/">Lead Generation</a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section section-alt">
      <div class="container narrow">
        <div class="section-head">
          <p class="eyebrow">{ind.trade} Marketing FAQ</p>
          <h2>Questions {ind.nounPlural} ask us</h2>
        </div>
        <div class="faq-list">
          {ind.faqs.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Other trades -->
    <section class="section">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Built for the Trades</p>
          <h2>We specialize in home-service contractors</h2>
        </div>
        <div class="trade-links">
          {otherTrades.map((t) => (
            <a href={`/industries/${t.slug}/`} class="trade-link">
              <span>{t.trade}</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <FinalCTA dark />
  <Footer />
</Layout>

<style>
  .trade { background: var(--bg-primary); color: var(--text-primary); }

  .container { max-width: 1140px; margin: 0 auto; padding: 0 24px; }
  .container.narrow { max-width: 760px; }

  /* Hero */
  .trade-hero {
    position: relative;
    padding: 160px 0 80px;
    overflow: hidden;
  }
  .hero-glow {
    position: absolute;
    top: -20%;
    left: 50%;
    transform: translateX(-50%);
    width: 900px;
    height: 600px;
    background: radial-gradient(ellipse at center, rgba(6, 214, 160, 0.16), transparent 65%);
    pointer-events: none;
  }
  .trade-hero-inner { position: relative; z-index: 1; max-width: 820px; }

  .breadcrumb {
    display: flex; flex-wrap: wrap; gap: 8px; align-items: center;
    font-size: 13px; color: var(--text-muted); margin-bottom: 28px;
  }
  .breadcrumb a { color: var(--text-secondary); text-decoration: none; transition: color 0.2s; }
  .breadcrumb a:hover { color: var(--accent-primary); }
  .breadcrumb-current { color: var(--text-primary); font-weight: 600; }

  .eyebrow {
    font-size: 13px; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.12em; color: var(--accent-primary); margin-bottom: 14px;
  }

  .trade-hero h1 {
    font-family: var(--font-heading);
    font-size: clamp(34px, 5vw, 56px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 22px;
  }
  .hero-sub {
    font-size: clamp(17px, 2vw, 20px);
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 680px;
    margin-bottom: 36px;
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; }

  .btn-ghost {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 15px 28px; border-radius: 100px;
    border: 1px solid var(--border-hover, rgba(6,214,160,0.28));
    color: var(--text-primary); text-decoration: none; font-weight: 600;
    transition: all 0.3s;
  }
  .btn-ghost:hover { border-color: var(--accent-primary); background: rgba(6,214,160,0.06); }

  /* Sections */
  .section { padding: 80px 0; }
  .section-alt { background: var(--bg-secondary); }
  .section-head { max-width: 720px; margin-bottom: 48px; }
  .section-head h2 {
    font-family: var(--font-heading);
    font-size: clamp(26px, 3.4vw, 38px);
    font-weight: 700; line-height: 1.15; letter-spacing: -0.02em;
    margin-bottom: 16px;
  }
  .section-sub { font-size: 17px; color: var(--text-secondary); line-height: 1.7; }

  .lead {
    font-size: clamp(18px, 2.2vw, 22px);
    line-height: 1.6; color: var(--text-primary);
    margin-bottom: 36px;
  }

  .answer-block {
    border-left: 3px solid var(--accent-primary);
    background: rgba(6, 214, 160, 0.05);
    border-radius: 0 var(--radius-lg, 14px) var(--radius-lg, 14px) 0;
    padding: 26px 28px;
  }
  .answer-block h2 {
    font-family: var(--font-heading);
    font-size: 20px; font-weight: 700; margin-bottom: 12px;
  }
  .answer-block p { font-size: 16px; line-height: 1.7; color: var(--text-secondary); margin: 0; }

  /* Cards */
  .card-grid { display: grid; gap: 20px; }
  .pain-grid { grid-template-columns: repeat(3, 1fr); }
  .service-grid { grid-template-columns: repeat(2, 1fr); }

  .card {
    background: var(--bg-card, rgba(255,255,255,0.02));
    border: 1px solid var(--border, rgba(255,255,255,0.08));
    border-radius: var(--radius-lg, 16px);
    padding: 30px;
    transition: all 0.3s;
  }
  .card:hover { border-color: var(--accent-primary); transform: translateY(-3px); }
  .card h3 {
    font-family: var(--font-heading);
    font-size: 19px; font-weight: 700; margin-bottom: 12px; line-height: 1.3;
  }
  .card p { font-size: 15px; line-height: 1.7; color: var(--text-secondary); margin: 0; }

  .service-card { position: relative; }
  .service-num {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 13px; font-weight: 800;
    color: var(--accent-on, #03100B);
    background: var(--accent-primary);
    border-radius: 8px; padding: 3px 9px; margin-bottom: 16px;
  }

  .service-links {
    margin-top: 36px; display: flex; flex-wrap: wrap; gap: 12px; align-items: center;
    font-size: 15px; color: var(--text-secondary);
  }
  .service-links a {
    color: var(--accent-primary); text-decoration: none; font-weight: 600;
    border-bottom: 1px solid transparent; transition: border-color 0.2s;
  }
  .service-links a:hover { border-color: var(--accent-primary); }

  /* FAQ */
  .faq-list { display: flex; flex-direction: column; gap: 12px; }
  .faq-item {
    border: 1px solid var(--border, rgba(255,255,255,0.08));
    border-radius: var(--radius-md, 12px);
    background: var(--bg-card, rgba(255,255,255,0.02));
    padding: 4px 22px;
  }
  .faq-item summary {
    list-style: none; cursor: pointer;
    font-family: var(--font-heading);
    font-size: 17px; font-weight: 600;
    padding: 18px 0; position: relative; padding-right: 32px;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: '+'; position: absolute; right: 0; top: 50%; transform: translateY(-50%);
    font-size: 22px; color: var(--accent-primary); transition: transform 0.2s;
  }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item p {
    font-size: 15px; line-height: 1.7; color: var(--text-secondary);
    padding: 0 0 20px; margin: 0;
  }

  /* Other trades */
  .trade-links { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .trade-link {
    display: flex; align-items: center; justify-content: space-between;
    padding: 20px 24px; border-radius: var(--radius-md, 12px);
    border: 1px solid var(--border, rgba(255,255,255,0.08));
    background: var(--bg-card, rgba(255,255,255,0.02));
    text-decoration: none; color: var(--text-primary); font-weight: 600;
    transition: all 0.3s;
  }
  .trade-link:hover { border-color: var(--accent-primary); color: var(--accent-primary); transform: translateY(-2px); }

  @media (max-width: 900px) {
    .pain-grid, .service-grid, .trade-links { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .trade-hero { padding: 130px 0 60px; }
    .section { padding: 56px 0; }
  }
</style>
