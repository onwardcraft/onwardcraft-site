---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import { industries } from '../../data/industries.js';

const canonical = 'https://onwardcraft.com/industries/';
const title = 'Industries We Serve — Marketing for Home-Service Contractors | OnwardCraft';
const description =
  'OnwardCraft is a marketing agency built exclusively for the trades: roofing, HVAC, plumbing, solar, electrical, and restoration. Web design, SEO, and lead generation that fit how each trade actually wins work.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Industries We Serve',
    description,
    url: canonical,
    isPartOf: { '@id': 'https://onwardcraft.com/#website' },
    publisher: { '@id': 'https://onwardcraft.com/#organization' },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: industries.length,
      itemListElement: industries.map((ind, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `https://onwardcraft.com/industries/${ind.slug}/`,
        name: `${ind.trade} Marketing`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://onwardcraft.com/' },
      { '@type': 'ListItem', position: 2, name: 'Industries', item: canonical },
    ],
  },
];
---

<Layout title={title} description={description} canonical={canonical} schema={schema}>
  <Navbar dark />

  <main class="ind-hub">
    <section class="hub-hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="container hub-hero-inner">
        <p class="eyebrow">Industries We Serve</p>
        <h1>A marketing agency built only for the trades</h1>
        <p class="hero-sub">
          We do not work with restaurants, startups, or law firms. OnwardCraft exists for one kind of business: home-service contractors. That focus means our websites, SEO, and lead systems are tuned to how each trade actually wins work — storm cycles, emergency calls, long solar deliberations, and everything between.
        </p>
        <div class="hero-actions">
          <a href="/book-call/" class="btn-primary" rel="noopener noreferrer">Get a Free Audit</a>
          <a href="/pricing/" class="btn-ghost">See Pricing</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="ind-grid">
          {industries.map((ind) => (
            <a href={`/industries/${ind.slug}/`} class="ind-card">
              <h2>{ind.trade}</h2>
              <p>{ind.heroSubhead}</p>
              <span class="ind-link">
                {ind.trade} marketing
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <FinalCTA dark />
  <Footer />
</Layout>

<style>
  .ind-hub { background: var(--bg-primary); color: var(--text-primary); }
  .container { max-width: 1140px; margin: 0 auto; padding: 0 24px; }

  .hub-hero { position: relative; padding: 160px 0 70px; overflow: hidden; }
  .hero-glow {
    position: absolute; top: -20%; left: 50%; transform: translateX(-50%);
    width: 900px; height: 600px;
    background: radial-gradient(ellipse at center, rgba(6, 214, 160, 0.16), transparent 65%);
    pointer-events: none;
  }
  .hub-hero-inner { position: relative; z-index: 1; max-width: 800px; }

  .eyebrow {
    font-size: 13px; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.12em; color: var(--accent-primary); margin-bottom: 14px;
  }
  .hub-hero h1 {
    font-family: var(--font-heading);
    font-size: clamp(34px, 5vw, 56px); font-weight: 800;
    line-height: 1.05; letter-spacing: -0.03em; margin-bottom: 22px;
  }
  .hero-sub {
    font-size: clamp(17px, 2vw, 20px); color: var(--text-secondary);
    line-height: 1.65; max-width: 720px; margin-bottom: 34px;
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; }
  .btn-ghost {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 15px 28px; border-radius: 100px;
    border: 1px solid var(--border-hover, rgba(6,214,160,0.28));
    color: var(--text-primary); text-decoration: none; font-weight: 600; transition: all 0.3s;
  }
  .btn-ghost:hover { border-color: var(--accent-primary); background: rgba(6,214,160,0.06); }

  .section { padding: 30px 0 90px; }
  .ind-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }

  .ind-card {
    display: flex; flex-direction: column;
    border: 1px solid var(--border, rgba(255,255,255,0.08));
    background: var(--bg-card, rgba(255,255,255,0.02));
    border-radius: var(--radius-lg, 16px);
    padding: 30px; text-decoration: none; color: var(--text-primary);
    transition: all 0.3s;
  }
  .ind-card:hover { border-color: var(--accent-primary); transform: translateY(-4px); }
  .ind-card h2 {
    font-family: var(--font-heading);
    font-size: 24px; font-weight: 700; margin-bottom: 12px;
  }
  .ind-card p {
    font-size: 14px; line-height: 1.65; color: var(--text-secondary);
    margin-bottom: 20px; flex: 1;
  }
  .ind-link {
    display: inline-flex; align-items: center; gap: 8px;
    color: var(--accent-primary); font-weight: 600; font-size: 14px; transition: gap 0.3s;
  }
  .ind-card:hover .ind-link { gap: 12px; }

  @media (max-width: 900px) { .ind-grid { grid-template-columns: 1fr; } }
  @media (max-width: 640px) { .hub-hero { padding: 130px 0 50px; } }
</style>
