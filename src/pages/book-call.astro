---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const title = 'Book a Free Strategy Call — OnwardCraft';
const description = 'Book a free 30-minute strategy call. Get a custom website audit and growth plan for your business. No pitch, just value.';

const whatToExpect = [
  { title: 'Website Audit', desc: 'We will review your current site and identify the top 3 things costing you leads.', time: '5 min' },
  { title: 'Competitive Analysis', desc: 'See what your top competitors are doing and where they are vulnerable.', time: '5 min' },
  { title: 'Growth Roadmap', desc: 'Get a clear plan for turning your website into a lead-generating machine.', time: '10 min' },
];

const faqs = [
  { q: 'How long is the call?', a: '30 minutes. We respect your time and keep it focused on actionable insights.' },
  { q: 'Is there any obligation?', a: 'Zero. The call is 100% free with no obligation to work with us.' },
  { q: 'What do I need to prepare?', a: 'Just your website URL and a general sense of your goals. We do the homework.' },
  { q: 'What if I do not have a website yet?', a: 'No problem. We will analyze your competitors and give you a roadmap.' },
];
---

<Layout title={title} description={description}>
  <Navbar />

  <section class="book-hero">
    <div class="hero-bg">
      <div class="gradient-blob blob-1"></div>
      <div class="gradient-blob blob-2"></div>
    </div>
    <div class="book-hero-inner container">
      <p class="section-label reveal">Book a Call</p>
      <h1 class="book-title reveal">
        Get a Free Strategy Call.
        <span class="accent">No Strings Attached.</span>
      </h1>
      <p class="book-desc reveal">
        In 30 minutes, we will audit your website, analyze your competitors, and give you a clear roadmap to more leads.
      </p>
    </div>
  </section>

  <section class="book-main">
    <div class="container">
      <div class="book-grid">
        <div class="calendly-wrapper reveal">
          <div class="calendly-card">
            <div class="calendly-header">
              <h2>Select a Time</h2>
              <p>Pick a 30-minute slot. We will send a calendar invite with a Zoom link.</p>
            </div>
            <!-- Calendly inline widget begin -->
            <div class="calendly-inline-widget" data-url="https://calendly.com/getonwardcraft/30min?hide_gdpr_banner=1&background_color=0f1d36&text_color=ffffff&primary_color=06d6a0" style="min-width:320px;height:680px;"></div>
            <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
            <!-- Calendly inline widget end -->
            <noscript>
              <div class="calendly-fallback">
                <p>Enable JavaScript to load the scheduler, or book directly:</p>
                <a href="https://calendly.com/getonwardcraft/30min" target="_blank" rel="noopener" class="btn-secondary">Open the Calendar</a>
              </div>
            </noscript>
          </div>
        </div>

        <div class="expect-wrapper reveal reveal-right">
          <div class="expect-card">
            <h3>What Happens on the Call</h3>
            <div class="expect-steps">
              {whatToExpect.map((step, i) => (
                <div class="expect-step">
                  <div class="expect-num">{String(i + 1).padStart(2, '0')}</div>
                  <div class="expect-content">
                    <div class="expect-header">
                      <h4>{step.title}</h4>
                      <span class="expect-time">{step.time}</span>
                    </div>
                    <p>{step.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <!-- Honesty rule: no fabricated testimonials. This card states the
               commitment we can actually stand behind; swap in a real, named,
               permission-granted client quote once one exists. -->
          <div class="trust-card">
            <h3>Our Commitment for This Call</h3>
            <div class="trust-quote">
              <p>No pitch deck. No pressure. You leave with a written list of the top three things costing your site leads — whether or not you ever work with us. If we're not the right fit, we'll say so and point you somewhere better.</p>
              <div class="trust-author">
                <strong>The OnwardCraft guarantee</strong>
                <span>Every call, founder-led</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="faq-section">
    <div class="container">
      <div class="faq-header reveal">
        <p class="section-label scramble-text">FAQ</p>
        <h2 class="section-title">Questions About the Call?</h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq, i) => (
          <details class="faq-item reveal" open={i === 0}>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="alt-cta-section">
    <div class="container">
      <div class="alt-cta-card reveal gradient-border">
        <div class="alt-cta-inner">
          <div class="alt-cta-content">
            <h2>Prefer Email?</h2>
            <p>Send us a message and we will get back within 24 hours with a free audit.</p>
          </div>
          <a href="/contact/" class="cta-button">Contact Us</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .book-hero { min-height: 60vh; display: flex; align-items: center; justify-content: center; padding: 160px 0 80px; position: relative; overflow: hidden; background: #030712; }
  .hero-bg { position: absolute; inset: 0; overflow: hidden; }
  .gradient-blob { position: absolute; border-radius: 50%; filter: blur(120px); opacity: 0.5; }
  .blob-1 { width: 500px; height: 500px; background: radial-gradient(circle, rgba(6, 214, 160, 0.4), transparent 70%); top: -10%; left: -5%; animation: blobFloat1 20s ease-in-out infinite; }
  .blob-2 { width: 400px; height: 400px; background: radial-gradient(circle, rgba(255, 184, 77, 0.3), transparent 70%); bottom: -5%; right: -5%; animation: blobFloat2 18s ease-in-out infinite; }
  @keyframes blobFloat1 { 0%,100%{transform:translate(0,0)scale(1)} 50%{transform:translate(40px,-30px)scale(1.1)} }
  @keyframes blobFloat2 { 0%,100%{transform:translate(0,0)scale(1)} 50%{transform:translate(-30px,20px)scale(1.15)} }
  .book-hero-inner { position: relative; z-index: 1; text-align: center; max-width: 720px; margin: 0 auto; }
  .book-title { font-size: clamp(40px, 6vw, 64px); font-weight: 700; line-height: 1.05; letter-spacing: -0.04em; margin-bottom: 24px; }
  .book-title .accent { display: block; background: linear-gradient(135deg, #FFB84D 0%, #06D6A0 50%, #06D6A0 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; font-style: italic; font-weight: 500; font-family: 'Georgia', 'Times New Roman', serif; }
  .book-desc { font-size: 18px; color: var(--text-secondary); line-height: 1.7; max-width: 600px; margin: 0 auto; }

  .book-main { padding: 80px 0 120px; background: var(--bg-primary); position: relative; }
  .book-main::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, var(--border), transparent); }
  .book-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; align-items: start; }
  .calendly-card { background: linear-gradient(180deg, rgba(17,24,39,0.6) 0%, rgba(5,8,22,0.4) 100%); border: 1px solid var(--border); border-radius: var(--radius-xl); overflow: hidden; }
  .calendly-header { padding: 36px 40px; border-bottom: 1px solid rgba(255,255,255,0.06); }
  .calendly-header h2 { font-size: 22px; font-weight: 700; margin-bottom: 8px; color: var(--text-primary); }
  .calendly-header p { font-size: 15px; color: var(--text-secondary); line-height: 1.6; }
  .calendly-placeholder { padding: 60px 40px; text-align: center; }
  .calendly-icon { width: 80px; height: 80px; border-radius: 50%; background: rgba(6, 214, 160, 0.1); border: 1px solid rgba(6, 214, 160, 0.2); display: flex; align-items: center; justify-content: center; color: var(--accent-primary); margin: 0 auto 24px; }
  .calendly-placeholder h3 { font-size: 18px; font-weight: 700; margin-bottom: 8px; color: var(--text-primary); }
  .calendly-placeholder > p { font-size: 14px; color: var(--text-muted); margin-bottom: 20px; }
  .calendly-placeholder code { display: block; background: rgba(0,0,0,0.4); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 20px; font-size: 12px; color: var(--accent-secondary); text-align: left; margin-bottom: 24px; line-height: 1.8; overflow-x: auto; }
  .btn-secondary { display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 14px 28px; background: rgba(255,255,255,0.04); color: var(--text-primary); font-size: 14px; font-weight: 600; border-radius: var(--radius-md); border: 1px solid rgba(255,255,255,0.1); transition: all 0.35s var(--transition); text-decoration: none; }
  .btn-secondary:hover { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.2); transform: translateY(-2px); }

  .expect-wrapper { display: flex; flex-direction: column; gap: 24px; position: sticky; top: 120px; }
  .expect-card, .trust-card { background: linear-gradient(180deg, rgba(17,24,39,0.5) 0%, rgba(5,8,22,0.3) 100%); border: 1px solid var(--border); border-radius: var(--radius-xl); padding: 36px; }
  .expect-card h3, .trust-card h3 { font-size: 18px; font-weight: 700; margin-bottom: 24px; color: var(--text-primary); }
  .expect-steps { display: flex; flex-direction: column; gap: 20px; }
  .expect-step { display: flex; gap: 16px; }
  .expect-num { font-family: var(--font-heading); font-size: 12px; font-weight: 700; color: var(--accent-primary); padding: 6px 12px; background: rgba(6, 214, 160, 0.1); border: 1px solid rgba(6, 214, 160, 0.2); border-radius: 100px; height: fit-content; flex-shrink: 0; }
  .expect-header { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 4px; }
  .expect-header h4 { font-size: 15px; font-weight: 700; color: var(--text-primary); }
  .expect-time { font-size: 12px; color: var(--text-muted); padding: 2px 8px; background: rgba(255,255,255,0.04); border-radius: 100px; flex-shrink: 0; }
  .expect-content p { font-size: 14px; color: var(--text-secondary); line-height: 1.6; }
  .trust-quote svg { color: rgba(255, 184, 77, 0.3); margin-bottom: 16px; }
  .trust-quote > p { font-size: 15px; color: var(--text-secondary); line-height: 1.7; margin-bottom: 16px; }
  .trust-author strong { display: block; font-size: 14px; font-weight: 700; color: var(--text-primary); }
  .trust-author span { font-size: 13px; color: var(--text-muted); }

  .faq-section { padding: 120px 0; background: var(--bg-primary); position: relative; }
  .faq-section::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, var(--border), transparent); }
  .faq-header { text-align: center; max-width: 560px; margin: 0 auto 60px; }
  .faq-list { max-width: 800px; margin: 0 auto; }
  .faq-item { background: linear-gradient(180deg, rgba(17,24,39,0.4) 0%, rgba(5,8,22,0.2) 100%); border: 1px solid var(--border); border-radius: var(--radius-lg); margin-bottom: 12px; overflow: hidden; transition: all 0.3s; }
  .faq-item:hover { border-color: var(--border-hover); }
  .faq-item summary { padding: 24px 28px; font-size: 16px; font-weight: 600; color: var(--text-primary); cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; font-size: 24px; color: var(--accent-primary); transition: transform 0.3s; }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item p { padding: 0 28px 24px; font-size: 15px; color: var(--text-secondary); line-height: 1.7; }

  .alt-cta-section { padding: 80px 0 120px; background: var(--bg-primary); position: relative; }
  .alt-cta-section::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, var(--border), transparent); }
  .alt-cta-card { padding: 1px; max-width: 800px; margin: 0 auto; }
  .alt-cta-inner { background: linear-gradient(180deg, rgba(17,24,39,0.8) 0%, rgba(5,8,22,0.6) 100%); border-radius: calc(var(--radius-xl) - 1px); padding: 48px; display: flex; align-items: center; gap: 40px; }
  .alt-cta-content { flex: 1; }
  .alt-cta-content h2 { font-size: 24px; font-weight: 700; margin-bottom: 8px; color: var(--text-primary); }
  .alt-cta-content p { font-size: 15px; color: var(--text-secondary); line-height: 1.6; }
  .cta-button { display: inline-flex; align-items: center; gap: 10px; padding: 16px 32px; background: var(--accent-primary); color: var(--accent-on); font-size: 15px; font-weight: 600; border-radius: var(--radius-md); transition: all 0.35s var(--transition); box-shadow: 0 4px 24px rgba(6, 214, 160, 0.3); white-space: nowrap; }
  .cta-button:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(6, 214, 160, 0.4); }

  @media (max-width: 1024px) {
    .book-grid { grid-template-columns: 1fr; }
    .expect-wrapper { position: static; }
    .alt-cta-inner { flex-direction: column; text-align: center; }
  }
  @media (max-width: 640px) {
    .book-hero { padding: 140px 0 60px; }
    .book-title { font-size: 36px; }
    .calendly-header { padding: 24px; }
    .calendly-placeholder { padding: 40px 24px; }
    .expect-card, .trust-card { padding: 28px 24px; }
    .alt-cta-inner { padding: 32px 24px; }
    .gradient-blob { display: none; }
  }
</style>
