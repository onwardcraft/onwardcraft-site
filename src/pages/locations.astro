---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE } from '../data/site.js';
import { cities } from '../data/cities.js';
import { locations } from '../data/locations.js';
import { GUIDE_ORDER, GUIDE_TOPICS } from '../data/guides.js';
import { PUBLISHED_ISO } from '../data/posts.js';

// Group every metro under its state so the index reads like a gazetteer
// rather than a 160-item wall.
const byState = new Map();
for (const c of cities) {
  if (!byState.has(c.state)) byState.set(c.state, []);
  byState.get(c.state).push(c);
}
const states = [...byState.entries()]
  .map(([state, list]) => ({ state, list: list.slice().sort((a, b) => a.city.localeCompare(b.city)) }))
  .sort((a, b) => a.state.localeCompare(b.state));

const guideCount = locations.length;
const title = `Local SEO City Guides — All ${cities.length} US Metros | ${SITE.name}`;
const description = `A local search guide for every major US metro: ${guideCount} city guides across ${cities.length} markets, covering map pack ranking, seasonal demand, neighbourhood search behaviour, and what SEO costs locally.`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${SITE.url}/locations/#index`,
    url: `${SITE.url}/locations/`,
    name: 'Local SEO city guides',
    description,
    isPartOf: { '@id': `${SITE.url}/#website` },
    dateModified: PUBLISHED_ISO,
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: cities.length,
      itemListElement: cities.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${SITE.url}/${c.citySlug}/`,
        name: `${c.city}, ${c.stateAbbr}`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'City guides', item: `${SITE.url}/locations/` },
    ],
  },
];
---

<Layout title={title} description={description} schema={schema}>
  <SiteHeader />

  <main id="main">
    <header class="loc-head">
      <div class="container">
        <p class="kicker">City guides</p>
        <h1>Local search, {cities.length} metros at a time</h1>
        <p class="loc-head__dek">
          Local SEO advice written for "a local business" is written for nobody.
          Demand in Denver spikes with hail; demand in Phoenix spikes with heat;
          Miami searches in two languages. So we publish a guide per market,
          built on that market's own demand pattern, geography and price level.
        </p>
        <dl class="loc-stats">
          <div><dt>Metros</dt><dd>{cities.length}</dd></div>
          <div><dt>Guides</dt><dd>{guideCount}</dd></div>
          <div><dt>States</dt><dd>{states.length}</dd></div>
        </dl>
      </div>
    </header>

    <section class="container loc-what" aria-labelledby="loc-what-h">
      <div class="section-head"><h2 id="loc-what-h">What each city gets</h2></div>
      <div class="loc-what__grid">
        <div class="loc-what__item">
          <h3>An overview</h3>
          <p>
            One hub per metro at <code>/city/</code> — the market, the seasonality,
            the areas that generate searches, and the questions asked most there.
          </p>
        </div>
        {GUIDE_ORDER.map((slug) => {
          const t = GUIDE_TOPICS[slug];
          return (
            <div class="loc-what__item">
              <h3>{t.label}</h3>
              <p>{t.dek('that city').replace('that city', 'the metro')}</p>
              <code>/city/{slug}/</code>
            </div>
          );
        })}
      </div>
    </section>

    <section class="container loc-index" aria-labelledby="loc-index-h">
      <div class="section-head">
        <h2 id="loc-index-h">Every metro, by state</h2>
      </div>
      {states.map((s) => (
        <div class="state">
          <h3 class="state__name">{s.state}</h3>
          <ul class="state__cities">
            {s.list.map((c) => (
              <li><a href={`/${c.citySlug}/`}>{c.city}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <Newsletter location="locations-band" />
  </main>

  <SiteFooter />
</Layout>

<style>
  .loc-head { padding: 44px 0 34px; border-bottom: 2px solid var(--ink); }
  .loc-head h1 { font-size: clamp(34px, 5vw, 54px); margin: 12px 0 16px; }
  .loc-head__dek {
    font-family: var(--font-read);
    font-size: 19px; line-height: 1.6; color: var(--ink-3); max-width: 66ch;
  }
  .loc-stats { display: flex; gap: 44px; margin-top: 28px; }
  .loc-stats dt {
    font-family: var(--font-ui); font-size: 11.5px; font-weight: 700;
    letter-spacing: 0.13em; text-transform: uppercase; color: var(--ink-3);
  }
  .loc-stats dd {
    font-family: var(--font-display); font-weight: 800; font-size: 32px;
    color: var(--ink); line-height: 1.1; margin-top: 4px;
  }

  .loc-what { padding: 44px 0 20px; }
  .loc-what__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .loc-what__item h3 { font-size: 19px; margin-bottom: 9px; }
  .loc-what__item p {
    font-family: var(--font-read); font-size: 16px; line-height: 1.55; color: var(--ink-3);
  }
  .loc-what__item code {
    display: inline-block; margin-top: 10px;
    font-family: ui-monospace, Menlo, monospace; font-size: 12.5px;
    background: var(--paper-2); padding: 3px 8px; color: var(--accent-deep);
  }

  .loc-index { padding: 48px 0 20px; }
  .state { padding: 20px 0; border-bottom: 1px solid var(--rule); display: grid; grid-template-columns: 200px 1fr; gap: 28px; }
  .state__name {
    font-size: 17px;
    font-family: var(--font-ui); font-weight: 700;
    letter-spacing: 0.02em;
  }
  .state__cities {
    list-style: none;
    display: flex; flex-wrap: wrap; gap: 8px 10px;
  }
  .state__cities a {
    display: inline-block;
    font-family: var(--font-ui); font-size: 14px;
    color: var(--ink-2);
    border: 1px solid var(--rule); padding: 6px 13px; border-radius: 100px;
    transition: border-color 0.18s var(--ease), color 0.18s var(--ease);
  }
  .state__cities a:hover { border-color: var(--ink); color: var(--accent); }

  @media (max-width: 900px) {
    .loc-what__grid { grid-template-columns: 1fr; gap: 26px; }
    .state { grid-template-columns: 1fr; gap: 12px; }
    .loc-stats { gap: 30px; }
  }
</style>
