---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../data/site.js';
import { PUBLISHED_ISO, PUBLISHED_LABEL } from '../data/posts.js';

const canonical = `${SITE.url}/terms/`;
---

<Layout
  title={`Terms | ${SITE.name}`}
  description="The terms for reading OnwardCraft: what the advice is and is not, how our figures should be read, and what you may do with our writing."
  canonical={canonical}
>
  <SiteHeader />
  <main id="main">
    <div class="container legal">
      <p class="kicker">Legal</p>
      <h1>Terms</h1>
      <p class="legal__date">Last updated <time datetime={PUBLISHED_ISO}>{PUBLISHED_LABEL}</time></p>

      <h2>What this site is</h2>
      <p>
        OnwardCraft is an independent publication about search engine
        optimization. It publishes editorial guidance. It is not a service
        business, it takes no clients, and nothing here is an offer to sell
        anything.
      </p>

      <h2>How to read the advice</h2>
      <p>
        Everything here is general information, not advice tailored to your
        business. Search results depend on your market, your competitors, your
        history and decisions made by Google that nobody outside Google fully
        understands. We cannot promise a ranking, a traffic level or a
        commercial outcome, and you should be sceptical of anyone who does.
      </p>

      <h2>How to read our numbers</h2>
      <p>
        Where a figure comes from published research we link the source. Where a
        figure is a benchmark, an estimate or a projection, we label it as one on
        the page. Pricing shown in our guides is a market benchmark collected
        from published rates — it is not a quote, and we do not sell the work
        being priced. Charts marked illustrative show the shape of a
        pattern, not a measurement of your market.
      </p>

      <h2>Third-party names</h2>
      <p>
        We name tools, platforms and companies for the purpose of reporting on
        them. Those names and trademarks belong to their owners, and mentioning
        one implies no relationship, endorsement or sponsorship in either
        direction. Nobody has paid to appear on this site.
      </p>

      <h2>Using our writing</h2>
      <p>
        The articles and guides are our copyright. You may quote from them and
        link to them freely — that is what they are for — provided the quotation
        is accurate and credits <a href="/">OnwardCraft</a> with a link to the
        page. Republishing an article in full, or feeding the archive into a
        product, requires written permission.
      </p>

      <h2>Liability</h2>
      <p>
        We publish in good faith and correct what we get wrong, but the site is
        provided as-is. We are not liable for losses arising from decisions made
        on the basis of anything you read here. If you find an error,
        <a href="/contact/">tell us</a> and we will fix it.
      </p>

      <h2>Changes</h2>
      <p>
        These terms may change. The date at the top of this page will change with
        them.
      </p>
    </div>
  </main>
  <SiteFooter />
</Layout>

<style>
  .legal { max-width: 720px; padding: 48px 0 80px; }
  .legal h1 { font-size: clamp(32px, 4.6vw, 46px); margin: 12px 0 10px; }
  .legal__date { font-family: var(--font-ui); font-size: 13px; color: var(--ink-3); margin-bottom: 36px; }
  .legal h2 { font-size: 22px; margin: 40px 0 12px; padding-top: 18px; border-top: 1px solid var(--rule); }
  .legal p, .legal li {
    font-family: var(--font-read); font-size: 18px; line-height: 1.7; color: var(--ink-2);
  }
  .legal p { margin-bottom: 16px; }
  .legal a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
</style>
