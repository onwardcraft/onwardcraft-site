---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE, SECTIONS } from '../data/site.js';
import { getPostsByCategory, posts, PUBLISHED_ISO } from '../data/posts.js';
import { cities } from '../data/cities.js';
import { GUIDE_ORDER, GUIDE_TOPICS } from '../data/guides.js';

const title = `Topics | ${SITE.name}`;
const description =
  'Everything OnwardCraft covers, in one index: the three SEO desks, every article filed under each, and the two local search guides published for all 160 US metros.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${SITE.url}/topics/#index`,
  url: `${SITE.url}/topics/`,
  name: 'Topics',
  description,
  isPartOf: { '@id': `${SITE.url}/#website` },
  dateModified: PUBLISHED_ISO,
};
---

<Layout title={title} description={description} schema={schema}>
  <SiteHeader />

  <main id="main">
    <header class="topics-head">
      <div class="container">
        <p class="kicker">Index</p>
        <h1>Topics</h1>
        <p class="topics-head__dek">
          One subject, three desks, {posts.length} articles — plus a local search
          guide for every one of {cities.length} US metros. If it is not about
          search, we do not publish it.
        </p>
      </div>
    </header>

    <div class="container topics">
      {SECTIONS.map((s) => {
        const items = getPostsByCategory(s.name);
        return (
          <section class="desk-block" aria-labelledby={`desk-${s.slug}`}>
            <div class="section-head">
              <h2 id={`desk-${s.slug}`}>{s.name}</h2>
              <a class="section-more" href={`/blog/category/${s.slug}/`}>
                {items.length} {items.length === 1 ? 'article' : 'articles'} →
              </a>
            </div>
            <p class="desk-block__blurb">{s.blurb}</p>
            <ul class="desk-block__list">
              {items.map((p) => (
                <li>
                  <a href={`/blog/${p.slug}/`}>{p.title}</a>
                  <span>{p.readTime}</span>
                </li>
              ))}
            </ul>
          </section>
        );
      })}

      <section class="desk-block" aria-labelledby="desk-local">
        <div class="section-head">
          <h2 id="desk-local">City guides</h2>
          <a class="section-more" href="/locations/">All {cities.length} cities →</a>
        </div>
        <p class="desk-block__blurb">
          Two guides per metro, written from that market's own search demand
          rather than a shared template.
        </p>
        <ul class="desk-block__list">
          {GUIDE_ORDER.map((slug) => {
            const t = GUIDE_TOPICS[slug];
            return (
              <li>
                <a href="/locations/">{t.label} — published for all {cities.length} metros</a>
                <span>/{'{city}'}/{slug}/</span>
              </li>
            );
          })}
        </ul>
      </section>
    </div>

    <Newsletter location="topics-band" />
  </main>

  <SiteFooter />
</Layout>

<style>
  .topics-head { padding: 44px 0 30px; border-bottom: 1px solid var(--rule); }
  .topics-head h1 { font-size: clamp(34px, 5vw, 52px); margin: 12px 0 14px; }
  .topics-head__dek {
    font-family: var(--font-read);
    font-size: 19px; line-height: 1.55; color: var(--ink-3); max-width: 62ch;
  }

  .topics { padding: 44px 0 20px; }
  .desk-block { margin-bottom: 56px; }
  .desk-block__blurb {
    font-family: var(--font-read);
    font-size: 17px; line-height: 1.55; color: var(--ink-3);
    max-width: 66ch; margin: -18px 0 22px;
  }
  .desk-block__list { list-style: none; columns: 2; column-gap: 48px; }
  .desk-block__list li {
    break-inside: avoid;
    display: flex; justify-content: space-between; gap: 18px; align-items: baseline;
    padding: 11px 0; border-bottom: 1px solid var(--rule);
  }
  .desk-block__list a {
    font-family: var(--font-display); font-weight: 700; font-size: 16.5px;
    line-height: 1.25; color: var(--ink);
  }
  .desk-block__list a:hover { color: var(--accent); }
  .desk-block__list span {
    font-family: var(--font-ui); font-size: 12px; color: var(--ink-3); white-space: nowrap;
  }

  @media (max-width: 760px) { .desk-block__list { columns: 1; } }
</style>
