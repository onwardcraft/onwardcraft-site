  .step-connector { width: 2px; flex: 1; min-height: 60px; background: linear-gradient(180deg, var(--accent-secondary), transparent); margin-top: 16px; }
  .step-content-col { padding-bottom: 60px; }
  .step-row:last-child .step-content-col { padding-bottom: 0; }
  .step-card { background: linear-gradient(180deg, rgba(17,24,39,0.6) 0%, rgba(5,8,22,0.4) 100%); border: 1px solid var(--border); border-radius: var(--radius-xl); padding: 40px; transition: all 0.4s var(--transition); }
