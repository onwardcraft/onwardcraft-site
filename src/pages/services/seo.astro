---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const title = 'SEO Management Services — Rank Higher, Get More Leads, Grow Faster';
const description = 'Technical SEO, content strategy, and authority building that ranks your business where customers are searching. Data-driven organic growth with measurable ROI.';

const painPoints = [
  {
    title: 'You are invisible on Google',
    desc: 'Your competitors show up on page one. You are on page four — where no one looks. Every day you are not ranking is a day your competitors are stealing your customers.',
  },
  {
    title: 'SEO "experts" gave you reports, not results',
    desc: 'They sent monthly PDFs full of jargon and keyword rankings that never moved. You paid for promises and got spreadsheets. No leads. No revenue. No ROI.',
  },
  {
    title: 'Your traffic is random, not qualified',
    desc: 'You get visitors, but they are not buyers. They bounce in 10 seconds. Your content ranks for the wrong keywords, attracting people who were never going to pay you.',
  },
];

const benefits = [
  {
    title: 'Technical SEO Foundation',
    desc: 'Site architecture, schema markup, Core Web Vitals, and crawl optimization. We fix the invisible problems that are silently killing your rankings.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
  },
  {
    title: 'Content That Ranks',
    desc: 'Keyword research, content strategy, and optimized blog posts that target high-intent searches. Content that brings qualified traffic, not casual browsers.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>`,
  },
  {
    title: 'Authority Building',
    desc: 'Strategic link building, local SEO, and brand mention campaigns that signal to Google you are the trusted authority in your market.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>`,
  },
];

const deliverables = [
  'Full technical SEO audit',
  'Keyword research & strategy',
  'On-page optimization',
  'Schema markup implementation',
  'Content strategy & calendar',
  'Monthly reporting & insights',
  'Local SEO optimization',
  'Competitor analysis',
];

const steps = [
  {
    num: '01',
    title: 'Audit & Discover',
    timeline: 'Week 1',
    desc: 'We run a full technical SEO audit, analyze your competitors, and identify every ranking opportunity your business is missing.',
    deliverables: [
      'Full technical SEO audit',
      'Competitor analysis & gap report',
      'Keyword research & targeting',
      'Content opportunity map',
      '90-day growth roadmap',
    ],
    clientInvolvement: '1 strategy call (60 min) + access to analytics',
  },
  {
    num: '02',
    title: 'Optimize & Build',
    timeline: 'Weeks 2-3',
    desc: 'Technical fixes, on-page optimization, and content creation targeting high-intent keywords your customers are actually searching for.',
    deliverables: [
      'Technical SEO fixes implemented',
      'On-page optimization for target pages',
      'Schema markup & structured data',
      'SEO-optimized content pieces',
      'Internal linking architecture',
    ],
    clientInvolvement: 'Content approval + feedback on changes',
  },
  {
    num: '03',
    title: 'Authority & Links',
    timeline: 'Weeks 4-5',
    desc: 'Strategic link building, local SEO, and brand mention campaigns that signal to Google you are the trusted authority in your market.',
    deliverables: [
      'Quality backlink acquisition',
      'Local SEO & GMB optimization',
      'Directory & citation building',
      'Guest post outreach',
      'Brand mention monitoring',
    ],
    clientInvolvement: 'Review link opportunities + approve content',
  },
  {
    num: '04',
    title: 'Monitor & Scale',
    timeline: 'Ongoing',
    desc: 'Monthly reporting, continuous optimization, and scaling what works. SEO is a compounding investment — we make sure it keeps growing.',
    deliverables: [
      'Monthly ranking & traffic reports',
      'Content calendar execution',
      'Continuous technical monitoring',
      'Competitor tracking',
      'Quarterly strategy reviews',
    ],
    clientInvolvement: 'Monthly review call + strategy alignment',
  },
];

const principles = [
  {
    title: 'No Surprises',
    desc: 'You see the design before we build. You approve every milestone. There are no "gotcha" moments or unexpected costs.',
  },
  {
    title: 'Speed Without Sacrifice',
    desc: 'We move fast because we are disciplined, not because we cut corners. Our process is optimized to deliver quality on a tight timeline.',
  },
  {
    title: 'Data Over Opinions',
    desc: 'Every design decision is backed by conversion data, user behavior research, and SEO best practices — not personal preference.',
  },
  {
    title: 'Your Input Matters',
    desc: 'This is a collaboration, not a black box. You are involved at every key milestone with clear feedback windows.',
  },
];

const faqs = [
  { q: 'How long until I see SEO results?', a: 'Most clients see measurable ranking improvements within 60-90 days. Significant traffic growth typically occurs within 4-6 months. SEO is a compounding investment — the results you get at month 6 are just the beginning.' },
  { q: 'Do you guarantee first-page rankings?', a: 'No ethical SEO agency can guarantee rankings — Google controls the algorithm. What we guarantee is a data-driven strategy, transparent reporting, and continuous optimization. Our track record: 90% of clients see top-10 rankings for target keywords within 6 months.' },
  { q: 'What industries do you work with?', a: 'We specialize in local services (roofing, HVAC, solar, home services), healthcare, B2B SaaS, and professional services. Our deep industry expertise means we know the keywords, search intent, and competitive landscape in your market.' },
  { q: 'How much does SEO cost?', a: 'Our SEO services start at $2,500/month for local businesses and scale based on competition, target keywords, and content volume. We provide a custom quote after our free audit.' },
  { q: 'Can you work with my existing website?', a: 'Absolutely. We work with most platforms — WordPress, Webflow, Shopify, Squarespace, and custom builds. Our technical team handles all on-site optimizations without disrupting your current design.' },
];
---

<Layout title={title} description={description}>
  <Navbar />

  <section class="service-hero">
    <div class="hero-bg">
      <div class="gradient-blob blob-1"></div>
      <div class="gradient-blob blob-2"></div>
    </div>
    <div class="service-hero-inner container">
      <p class="service-label reveal">SEO & Organic Growth</p>
      <h1 class="service-title reveal">
        Your Competitors Rank.<br/>
        <span class="accent">You Do Not.</span>
      </h1>
      <p class="service-desc reveal">
        Every day you are not on page one of Google is a day your competitors are stealing your customers. We build SEO systems that rank, drive qualified traffic, and generate leads that actually convert.
      </p>
      <div class="service-cta reveal">
        <a href="#contact" class="btn-primary magnetic">Get Your Free SEO Audit</a>
        <a href="#process" class="btn-secondary">See How It Works</a>
      </div>
      <div class="service-trust reveal">
        <div class="trust-stars">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </div>
        <span>4.9/5 (100+ Reviews) · Avg. +267% organic traffic</span>
      </div>
    </div>
  </section>

  <section class="problem-section">
    <div class="container">
      <div class="problem-header reveal">
        <p class="section-label scramble-text">The Problem</p>
        <h2 class="section-title">If This Sounds Familiar,<br/>We Need to Talk.</h2>
      </div>
      <div class="problem-grid stagger-children">
        {painPoints.map((p) => (
          <div class="problem-card stagger-item">
            <div class="problem-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
            </div>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="solution-section">
    <div class="container">
      <div class="solution-header reveal">
        <p class="section-label scramble-text">The Solution</p>
        <h2 class="section-title">We Do Not Do SEO.<br/>We Build Ranking Machines.</h2>
        <p class="section-subtitle">Technical foundation + content strategy + authority building. The three pillars of organic growth that actually work.</p>
      </div>
      <div class="solution-grid stagger-children">
        {benefits.map((b) => (
          <div class="solution-card stagger-item tilt-card">
            <div class="solution-icon" set:html={b.icon} />
            <h3>{b.title}</h3>
            <p>{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="results-section-mini">
    <div class="container">
      <div class="results-mini-header reveal">
        <p class="section-label scramble-text">Results</p>
        <h2 class="section-title">Real Numbers. Not Vanity Metrics.</h2>
      </div>
      <div class="results-mini-grid stagger-children">
        <div class="result-mini stagger-item">
          <span class="result-mini-num">+267%</span>
          <span class="result-mini-label">Organic Traffic</span>
          <span class="result-mini-desc">Healthcare Provider, 4 months</span>
        </div>
        <div class="result-mini stagger-item">
          <span class="result-mini-num">40+</span>
          <span class="result-mini-label">Top 3 Rankings</span>
          <span class="result-mini-desc">Target keywords achieved</span>
        </div>
        <div class="result-mini stagger-item">
          <span class="result-mini-num">3x</span>
          <span class="result-mini-label">Appointment Bookings</span>
          <span class="result-mini-desc">From organic search alone</span>
        </div>
      </div>
      <div class="testimonial-mini reveal">
        <svg class="quote-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V21c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg>
        <p>"Our organic traffic tripled within four months. The SEO strategy was meticulous, the execution flawless, and the results speak for themselves. We went from invisible to ranking top 3 for 40+ keywords."</p>
        <div class="testimonial-author-mini">
          <strong>David Park</strong>
          <span>CMO, Healthcare Provider</span>
        </div>
      </div>
    </div>
  </section>

  <section class="included-section">
    <div class="container">
      <div class="included-header reveal">
        <p class="section-label scramble-text">What's Included</p>
        <h2 class="section-title">Everything You Need.<br/>Nothing You Don't.</h2>
      </div>
      <div class="included-grid reveal">
        {deliverables.map((item) => (
          <div class="included-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            <span>{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="steps-section" id="process">
    <div class="container">
      <div class="steps-header reveal">
        <p class="section-label scramble-text">Our Process</p>
        <h2 class="section-title">From Invisible to Unmissable.</h2>
        <p class="section-subtitle">A data-driven 4-step system that builds your organic presence and keeps it growing month over month.</p>
      </div>
      <div class="steps-timeline">
        {steps.map((step, i) => (
          <div class="step-row reveal">
            <div class="step-number-col">
              <span class="step-num">{step.num}</span>
              {i < steps.length - 1 && <div class="step-connector"></div>}
            </div>
            <div class="step-content-col">
              <div class="step-card">
                <span class="step-timeline">{step.timeline}</span>
                <h2>{step.title}</h2>
                <p class="step-desc">{step.desc}</p>
                <div class="step-deliverables">
                  <h4>Deliverables</h4>
                  <ul>
                    {step.deliverables.map(d => <li>{d}</li>)}
                  </ul>
                </div>
                <div class="step-client">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                  <span><strong>Your involvement:</strong> {step.clientInvolvement}</span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="principles-section">
    <div class="container">
      <div class="principles-header reveal">
        <p class="section-label scramble-text">How We Work</p>
        <h2 class="section-title">Principles That Keep Every Project on Track.</h2>
      </div>
      <div class="principles-grid stagger-children">
        {principles.map((p) => (
          <div class="principle-card stagger-item">
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- Pricing -->
  <section class="pricing-section" id="pricing">
    <div class="container">
      <div class="pricing-header reveal">
        <p class="section-label scramble-text">Pricing</p>
        <h2 class="section-title">Investment. Not Expense.</h2>
        <p class="pricing-subtitle">SEO is the only marketing channel that compounds. The sooner you start, the bigger the gap you create.</p>
      </div>
      <div class="pricing-grid reveal">
        <div class="pricing-card">
          <div class="pricing-name">Starter</div>
          <div class="pricing-price">$500<span>/mo</span></div>
          <p class="pricing-desc">Build authority with consistent, high-quality blog content that ranks and drives organic traffic.</p>
          <ul class="pricing-features">
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>20 SEO-optimized blogs / month</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>Keyword research & targeting</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>On-page SEO for each post</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>Content calendar planning</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>Monthly performance report</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>1 revision round per blog</li>
          </ul>
          <a href="#contact" class="pricing-cta">Book a Call</a>
        </div>
        <div class="pricing-card popular">
          <div class="popular-badge">Most Popular</div>
          <div class="pricing-name">Growth</div>
          <div class="pricing-price">$1,000<span>/mo</span></div>
          <p class="pricing-desc">Scale your content engine with more blogs plus strategic link building to boost domain authority.</p>
          <ul class="pricing-features">
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>50 SEO-optimized blogs / month</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>10 quality backlinks / month</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>Link building outreach</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>Competitor content analysis</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>Technical SEO audit</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>Bi-weekly strategy calls</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>2 revision rounds per blog</li>
          </ul>
          <a href="#contact" class="pricing-cta primary">Book a Call</a>
        </div>
        <div class="pricing-card">
          <div class="pricing-name">Scale</div>
          <div class="pricing-price">$2,000<span>/mo</span></div>
          <p class="pricing-desc">Full website management with massive content output, aggressive link building, and local SEO dominance.</p>
          <ul class="pricing-features">
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>150 SEO-optimized blogs / month</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>25 quality backlinks / month</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>Full website management</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>Local SEO + GMB optimization</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>Weekly strategy calls</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>Unlimited revisions</li>
          </ul>
          <a href="#contact" class="pricing-cta">Book a Call</a>
        </div>
      </div>
      <p class="pricing-note reveal">All packages include a 100% satisfaction guarantee. No long-term contracts. Cancel anytime.</p>
    </div>
  </section>
  <!-- FAQ -->
  <section class="faq-section">
    <div class="container">
      <div class="faq-header reveal">
        <p class="section-label scramble-text">FAQ</p>
        <h2 class="section-title">Questions? Answered.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq, i) => (
          <details class="faq-item reveal" open={i === 0}>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="final-cta" id="contact">
    <div class="container">
      <div class="final-cta-card reveal gradient-border pulse-glow">
        <div class="final-cta-content">
          <h2>Stop Letting Your Competitors Own Page One.</h2>
          <p>Get your free SEO audit and discover exactly why you are not ranking — and the specific steps to fix it. No pitch. Just actionable insights.</p>
          <a href="#" class="cta-button magnetic">Get Your Free SEO Audit</a>
          <p class="cta-guarantee">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            100% satisfaction guarantee. If you are not happy, we make it right.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .service-hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 160px 0 100px;
    position: relative;
    overflow: hidden;
    background: #030712;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .gradient-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.5;
  }

  .blob-1 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(34, 211, 238, 0.35), transparent 70%);
    top: -10%;
    right: -5%;
    animation: blobFloat1 20s ease-in-out infinite;
  }

  .blob-2 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.3), transparent 70%);
    bottom: -5%;
    left: -5%;
    animation: blobFloat2 18s ease-in-out infinite;
  }

  @keyframes blobFloat1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-40px, -30px) scale(1.1); }
  }

  @keyframes blobFloat2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(30px, 20px) scale(1.15); }
  }

  .service-hero-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .service-label {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent-primary);
    margin-bottom: 24px;
  }

  .service-title {
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.04em;
    margin-bottom: 28px;
  }

  .service-title .accent {
    background: linear-gradient(135deg, #A78BFA 0%, #22D3EE 50%, #34D399 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-style: italic;
    font-weight: 500;
    font-family: 'Georgia', 'Times New Roman', serif;
  }

  .service-desc {
    font-size: 18px;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 40px;
