---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const title = 'Services — Web Design, SEO & Lead Generation';
const description = 'We build websites that generate leads, rank on Google, and turn visitors into customers. Explore our services.';

const services = [
  {
    title: 'Web Design & Development',
    desc: 'Conversion-focused websites built for speed, SEO, and results. Not digital brochures — growth engines.',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
    link: '/services/web-design',
    features: ['Custom conversion-focused design', 'Astro-powered development', 'Mobile-first responsive', 'CMS integration'],
  },
  {
    title: 'SEO & Organic Growth',
    desc: 'Get found on Google by the people actively searching for what you offer. Technical SEO + content strategy + link building.',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>`,
    link: '/services/seo',
    features: ['On-page SEO optimization', 'Technical SEO audits', 'Content strategy', 'Local SEO'],
  },
  {
    title: 'Lead Generation',
    desc: 'Turn your website into a lead machine with optimized funnels, landing pages, and conversion systems that work 24/7.',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
    link: '/services/lead-generation',
    features: ['Landing page optimization', 'Lead capture systems', 'A/B testing', 'Conversion tracking'],
  },
];

const addons = [
  { title: 'Website Maintenance', desc: 'Ongoing updates, security, and performance monitoring. Starting at $500/mo.' },
  { title: 'Content Writing', desc: 'SEO-optimized copy that ranks and converts. Blog posts, landing pages, and more.' },
  { title: 'PPC Management', desc: 'Google Ads and Meta Ads setup and optimization for maximum ROAS.' },
  { title: 'Brand Strategy', desc: 'Messaging, positioning, and visual identity that differentiates you from competitors.' },
];
---

<Layout title={title} description={description}>
  <Navbar />

  <section class="services-hero">
    <div class="hero-bg">
      <div class="gradient-blob blob-1"></div>
      <div class="gradient-blob blob-2"></div>
    </div>
    <div class="services-hero-inner container">
      <p class="section-label reveal">Our Services</p>
      <h1 class="services-title reveal">Everything You Need to<br><span class="accent">Grow Online.</span></h1>
      <p class="services-desc reveal">We do not sell services. We deliver results. Every offering is designed to move the needle on leads, rankings, and revenue.</p>
    </div>
  </section>

  <section class="services-list-section">
    <div class="container">
      <div class="services-grid stagger-children">
        {services.map((s) => (
          <a href={s.link} class="service-card stagger-item">
            <div class="service-icon" set:html={s.icon} />
            <h2>{s.title}</h2>
            <p>{s.desc}</p>
            <ul class="service-features">
              {s.features.map(f => <li>{f}</li>)}
            </ul>
            <span class="service-link">
              Learn More
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="addons-section">
    <div class="container">
      <div class="addons-header reveal">
        <p class="section-label scramble-text">Add-Ons</p>
        <h2 class="section-title">Extra Firepower When You Need It.</h2>
      </div>
      <div class="addons-grid stagger-children">
        {addons.map((a) => (
          <div class="addon-card stagger-item">
            <h3>{a.title}</h3>
            <p>{a.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="final-cta-section">
    <div class="container">
      <div class="final-cta-card reveal gradient-border pulse-glow">
        <div class="final-cta-content">
          <h2>Not Sure What You Need?</h2>
          <p>Book a free strategy call and we will help you figure out the right mix of services for your goals and budget.</p>
          <a href="https://calendly.com/getonwardcraft/30min" class="cta-button magnetic">Book Your Free Strategy Call</a>
          <p class="cta-guarantee">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            No commitment. No pressure.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .services-hero { min-height: 60vh; display: flex; align-items: center; justify-content: center; padding: 160px 0 80px; position: relative; overflow: hidden; background: #030712; }
  .hero-bg { position: absolute; inset: 0; overflow: hidden; }
  .gradient-blob { position: absolute; border-radius: 50%; filter: blur(120px); opacity: 0.5; }
  .blob-1 { width: 500px; height: 500px; background: radial-gradient(circle, rgba(59,130,246,0.4), transparent 70%); top: -10%; left: -5%; animation: blobFloat1 20s ease-in-out infinite; }
  .blob-2 { width: 400px; height: 400px; background: radial-gradient(circle, rgba(139,92,246,0.3), transparent 70%); bottom: -5%; right: -5%; animation: blobFloat2 18s ease-in-out infinite; }
  @keyframes blobFloat1 { 0%,100%{transform:translate(0,0)scale(1)} 50%{transform:translate(40px,-30px)scale(1.1)} }
  @keyframes blobFloat2 { 0%,100%{transform:translate(0,0)scale(1)} 50%{transform:translate(-30px,20px)scale(1.15)} }
  .services-hero-inner { position: relative; z-index: 1; text-align: center; max-width: 720px; margin: 0 auto; }
  .services-title { font-size: clamp(40px, 6vw, 64px); font-weight: 700; line-height: 1.05; letter-spacing: -0.04em; margin-bottom: 24px; }
  .services-title .accent { background: linear-gradient(135deg, #A78BFA 0%, #22D3EE 50%, #34D399 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; font-style: italic; font-weight: 500; font-family: 'Georgia', 'Times New Roman', serif; }
  .services-desc { font-size: 18px; color: var(--text-secondary); line-height: 1.7; max-width: 560px; margin: 0 auto; }

  .services-list-section { padding: 80px 0; background: var(--bg-primary); position: relative; }
  .services-list-section::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, var(--border), transparent); }
  .services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .service-card { display: block; background: linear-gradient(180deg, rgba(17,24,39,0.6) 0%, rgba(5,8,22,0.4) 100%); border: 1px solid var(--border); border-radius: var(--radius-xl); padding: 48px 36px; transition: all 0.5s var(--transition); text-decoration: none; }
  .service-card:hover { border-color: var(--border-hover); transform: translateY(-8px); box-shadow: 0 32px 64px rgba(0,0,0,0.35); }
  .service-icon { width: 64px; height: 64px; background: rgba(59,130,246,0.1); border: 1px solid rgba(59,130,246,0.2); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; color: var(--accent-primary); margin-bottom: 24px; }
  .service-card h2 { font-size: 24px; font-weight: 700; margin-bottom: 12px; color: var(--text-primary); }
  .service-card p { font-size: 15px; color: var(--text-secondary); line-height: 1.7; margin-bottom: 24px; }
  .service-features { list-style: none; margin-bottom: 28px; }
  .service-features li { font-size: 14px; color: var(--text-secondary); padding: 8px 0; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid rgba(255,255,255,0.04); }
  .service-features li::before { content: ''; width: 6px; height: 6px; background: var(--accent-primary); border-radius: 50%; flex-shrink: 0; }
  .service-link { display: inline-flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 600; color: var(--accent-primary); transition: gap 0.3s; }
  .service-card:hover .service-link { gap: 12px; }

  .addons-section { padding: 120px 0; background: var(--bg-primary); position: relative; }
  .addons-section::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, var(--border), transparent); }
  .addons-header { text-align: center; max-width: 560px; margin: 0 auto 60px; }
  .addons-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; max-width: 900px; margin: 0 auto; }
  .addon-card { background: linear-gradient(180deg, rgba(17,24,39,0.5) 0%, rgba(5,8,22,0.3) 100%); border: 1px solid var(--border); border-radius: var(--radius-xl); padding: 36px; transition: all 0.4s var(--transition); }
  .addon-card:hover { border-color: var(--border-hover); transform: translateY(-4px); }
  .addon-card h3 { font-size: 20px; font-weight: 700; margin-bottom: 8px; color: var(--text-primary); }
  .addon-card p { font-size: 14px; color: var(--text-secondary); line-height: 1.6; }

  .final-cta-section { padding: 120px 0 80px; background: var(--bg-primary); position: relative; }
  .final-cta-card { position: relative; background: linear-gradient(180deg, rgba(139,92,246,0.08) 0%, rgba(17,24,39,0.6) 100%); border-radius: var(--radius-xl); padding: 80px; overflow: hidden; text-align: center; }
  .final-cta-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, rgba(139,92,246,0.4), rgba(59,130,246,0.3), transparent); }
  .final-cta-content { position: relative; z-index: 1; max-width: 600px; margin: 0 auto; }
  .final-cta-content h2 { font-size: clamp(32px, 4.5vw, 52px); font-weight: 700; line-height: 1.1; letter-spacing: -0.03em; margin-bottom: 20px; }
  .final-cta-content > p { font-size: 17px; color: var(--text-secondary); line-height: 1.7; margin-bottom: 36px; }
  .cta-button { display: inline-flex; align-items: center; gap: 10px; padding: 18px 36px; background: var(--accent-primary); color: white; font-size: 16px; font-weight: 600; border-radius: var(--radius-md); transition: all 0.35s var(--transition); box-shadow: 0 4px 24px rgba(59,130,246,0.3); }
  .cta-button:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(59,130,246,0.4); }
  .cta-guarantee { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 24px; font-size: 13px; color: var(--text-muted); }
  .cta-guarantee svg { color: #34D399; }

  @media (max-width: 1024px) {
    .services-grid { grid-template-columns: 1fr; }
    .service-card { max-width: 500px; margin: 0 auto; }
    .addons-grid { grid-template-columns: 1fr; }
    .final-cta-card { padding: 48px 28px; }
  }
  @media (max-width: 640px) {
    .services-hero { padding: 140px 0 60px; }
    .services-title { font-size: 36px; }
    .service-card { padding: 36px 28px; }
    .gradient-blob { display: none; }
  }
</style>
