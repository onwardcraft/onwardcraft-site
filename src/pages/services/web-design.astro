---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const title = 'Web Design & Development Services — High-Converting Websites That Generate Leads';
const description = 'Premium website design and development services built to convert visitors into customers. Custom conversion-focused design, lightning-fast performance, and mobile-first architecture.';

const painPoints = [
  {
    title: 'Your site looks good but does not convert',
    desc: 'You spent thousands on a beautiful website. It won awards for design. But your phone is not ringing. Your inbox is empty. And your "contact us" form is a digital ghost town. Pretty does not pay the bills.',
  },
  {
    title: 'Mobile visitors bounce in under 3 seconds',
    desc: 'Over 70% of your traffic is on mobile. But your site breaks on phones, loads like dial-up, and forces users to pinch and zoom like it is 2010. Every bounce is a lead you just gave to your competitor.',
  },
  {
    title: 'Your developer vanished after launch',
    desc: 'The agency that built your site has gone silent. Updates take weeks. Bugs stay forever. And you are stuck with a site you cannot change without calling someone who never calls back.',
  },
];

const benefits = [
  {
    title: 'Conversion-First Design',
    desc: 'Every pixel is placed to move visitors toward action. Strategic CTAs, optimized layouts, and persuasive copy architecture that turns browsers into buyers.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
  },
  {
    title: 'Sub-Second Load Speed',
    desc: 'We build with Astro, React, and modern infrastructure for maximum performance. Your site loads instantly, ranks higher on Google, and keeps visitors engaged.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
  },
  {
    title: 'Mobile-First Architecture',
    desc: 'Designed for thumbs, not mice. Your site looks and performs flawlessly on every device — from iPhone to iPad to desktop — with touch-optimized interactions throughout.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/></svg>`,
  },
];

const deliverables = [
  'Custom conversion-focused homepage',
  'Service & about page design',
  'Lead capture forms & CTAs',
  'Mobile-responsive across all devices',
  'SEO-optimized code architecture',
  'Analytics & tracking setup',
  '2 revision rounds',
  '30-day post-launch support',
];

const steps = [
  {
    num: '01',
    title: 'Discovery & Strategy',
    timeline: 'Week 1',
    desc: 'We audit your current site, analyze your competitors, and map every conversion opportunity your business is missing.',
    deliverables: [
      'Competitive landscape analysis',
      'User persona definitions',
      'Conversion opportunity map',
      'Sitemap & content strategy',
      'Project timeline & milestones',
    ],
    clientInvolvement: '1 strategy call (60 min) + questionnaire',
  },
  {
    num: '02',
    title: 'Design & Prototyping',
    timeline: 'Weeks 2-3',
    desc: 'We design every page in Figma with conversion psychology baked in. You see exactly what your site will look like before a single line of code is written.',
    deliverables: [
      'High-fidelity mockups for all pages',
      'Mobile-responsive designs',
      'Interactive prototype',
      'Copy & messaging framework',
      'Design system & component library',
    ],
    clientInvolvement: '2 review rounds + feedback sessions',
  },
  {
    num: '03',
    title: 'Development & Build',
    timeline: 'Weeks 4-5',
    desc: 'We build your site with Astro/React for maximum speed, SEO, and flexibility. Every line of code is clean, semantic, and optimized for performance.',
    deliverables: [
      'Pixel-perfect frontend build',
      'SEO-optimized code architecture',
      'Analytics & tracking setup',
      'CMS integration (if applicable)',
      'Cross-browser testing',
    ],
    clientInvolvement: 'Progress updates + preview access',
  },
  {
    num: '04',
    title: 'Launch & Optimize',
    timeline: 'Week 6+',
    desc: 'We do not just launch and leave. We monitor performance, fix any issues, and set you up for ongoing growth with data-driven optimizations.',
    deliverables: [
      'Production deployment',
      'Performance audit & optimization',
      'Google Search Console setup',
      'Post-launch support (30 days)',
      'Growth roadmap & next steps',
    ],
    clientInvolvement: 'Launch approval + handoff call',
  },
];

const principles = [
  {
    title: 'No Surprises',
    desc: 'You see the design before we build. You approve every milestone. There are no "gotcha" moments or unexpected costs.',
  },
  {
    title: 'Speed Without Sacrifice',
    desc: 'We move fast because we are disciplined, not because we cut corners. Our process is optimized to deliver quality on a tight timeline.',
  },
  {
    title: 'Data Over Opinions',
    desc: 'Every design decision is backed by conversion data, user behavior research, and SEO best practices — not personal preference.',
  },
  {
    title: 'Your Input Matters',
    desc: 'This is a collaboration, not a black box. You are involved at every key milestone with clear feedback windows.',
  },
];

const faqs = [
  { q: 'How long does a website project take?', a: 'Most projects launch within 3-4 weeks from kickoff. Complex sites with custom functionality may take 6-8 weeks. We give you a precise timeline during our strategy call.' },
  { q: 'What platforms do you build on?', a: 'We primarily build with Astro and React for maximum performance and SEO. For clients who need a CMS, we use headless WordPress or Contentful — giving you easy content management without sacrificing speed.' },
  { q: 'Will my site rank on Google?', a: 'Every site we build follows SEO best practices: semantic HTML, structured data, fast load times, mobile optimization, and clean URL architecture. Many clients see ranking improvements within 30-60 days of launch.' },
  { q: 'What if I do not like the design?', a: 'You get 2 full revision rounds. Most clients love the first direction because we do deep discovery upfront. But if something is not right, we refine until it is.' },
  { q: 'Do you offer ongoing support?', a: 'Yes. Every project includes 30 days of post-launch support. After that, we offer monthly maintenance and optimization retainers for clients who want continuous improvement.' },
];
---

<Layout title={title} description={description}>
  <Navbar />

  <!-- Hero -->
  <section class="service-hero">
    <div class="hero-bg">
      <div class="gradient-blob blob-1"></div>
      <div class="gradient-blob blob-2"></div>
    </div>
    <div class="service-hero-inner container">
      <p class="service-label reveal">Web Design & Development</p>
      <h1 class="service-title reveal">
        Your Website Looks Good.<br/>
        <span class="accent">But Does It Convert?</span>
      </h1>
      <p class="service-desc reveal">
        Most agencies build digital brochures. We build conversion machines. Every pixel, every headline, every CTA is engineered to turn visitors into qualified leads. No guesswork. Just results.
      </p>
      <div class="service-cta reveal">
        <a href="#contact" class="btn-primary magnetic">Book a Free Strategy Call</a>
        <a href="#process" class="btn-secondary">See How It Works</a>
      </div>
      <div class="service-trust reveal">
        <div class="trust-stars">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </div>
        <span>4.9/5 (100+ Reviews) · Avg. 312% lead increase</span>
      </div>
    </div>
  </section>

  <!-- Problem -->
  <section class="problem-section">
    <div class="container">
      <div class="problem-header reveal">
        <p class="section-label scramble-text">The Problem</p>
        <h2 class="section-title">If This Sounds Familiar,<br/>We Need to Talk.</h2>
      </div>
      <div class="problem-grid stagger-children">
        {painPoints.map((p) => (
          <div class="problem-card stagger-item">
            <div class="problem-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
            </div>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Solution -->
  <section class="solution-section">
    <div class="container">
      <div class="solution-header reveal">
        <p class="section-label scramble-text">The Solution</p>
        <h2 class="section-title">We Do Not Build Websites.<br/>We Build Lead Machines.</h2>
        <p class="section-subtitle">Every site we build follows a proven conversion framework developed across 100+ projects.</p>
      </div>
      <div class="solution-grid stagger-children">
        {benefits.map((b) => (
          <div class="solution-card stagger-item tilt-card">
            <div class="solution-icon" set:html={b.icon} />
            <h3>{b.title}</h3>
            <p>{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Results -->
  <section class="results-section-mini">
    <div class="container">
      <div class="results-mini-header reveal">
        <p class="section-label scramble-text">Results</p>
        <h2 class="section-title">Real Numbers. Not Vanity Metrics.</h2>
      </div>
      <div class="results-mini-grid stagger-children">
        <div class="result-mini stagger-item">
          <span class="result-mini-num">+412%</span>
          <span class="result-mini-label">Qualified Leads</span>
          <span class="result-mini-desc">Roofing Company, 90 days</span>
        </div>
        <div class="result-mini stagger-item">
          <span class="result-mini-num">4.9x</span>
          <span class="result-mini-label">Return on Ad Spend</span>
          <span class="result-mini-desc">B2B SaaS Platform</span>
        </div>
        <div class="result-mini stagger-item">
          <span class="result-mini-num">0.8s</span>
          <span class="result-mini-label">Average Load Time</span>
          <span class="result-mini-desc">Across all client sites</span>
        </div>
      </div>
      <div class="testimonial-mini reveal">
        <svg class="quote-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V21c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg>
        <p>"OnwardCraft completely transformed how we generate leads. Our website went from a digital brochure to our best salesperson. 412% more qualified leads in 90 days."</p>
        <div class="testimonial-author-mini">
          <strong>Marcus Chen</strong>
          <span>CEO, Roofing Company</span>
        </div>
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="included-section">
    <div class="container">
      <div class="included-header reveal">
        <p class="section-label scramble-text">What's Included</p>
        <h2 class="section-title">Everything You Need.<br/>Nothing You Don't.</h2>
      </div>
      <div class="included-grid reveal">
        {deliverables.map((item) => (
          <div class="included-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            <span>{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="steps-section" id="process">
    <div class="container">
      <div class="steps-header reveal">
        <p class="section-label scramble-text">Our Process</p>
        <h2 class="section-title">From Idea to Launch in 6 Weeks.</h2>
        <p class="section-subtitle">A proven 4-step framework that takes you from strategy to a live, lead-generating website.</p>
      </div>
      <div class="steps-timeline">
        {steps.map((step, i) => (
          <div class="step-row reveal">
            <div class="step-number-col">
              <span class="step-num">{step.num}</span>
              {i < steps.length - 1 && <div class="step-connector"></div>}
            </div>
            <div class="step-content-col">
              <div class="step-card">
                <span class="step-timeline">{step.timeline}</span>
                <h2>{step.title}</h2>
                <p class="step-desc">{step.desc}</p>
                <div class="step-deliverables">
                  <h4>Deliverables</h4>
                  <ul>
                    {step.deliverables.map(d => <li>{d}</li>)}
                  </ul>
                </div>
                <div class="step-client">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                  <span><strong>Your involvement:</strong> {step.clientInvolvement}</span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="principles-section">
    <div class="container">
      <div class="principles-header reveal">
        <p class="section-label scramble-text">How We Work</p>
        <h2 class="section-title">Principles That Keep Every Project on Track.</h2>
      </div>
      <div class="principles-grid stagger-children">
        {principles.map((p) => (
          <div class="principle-card stagger-item">
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- Pricing -->
  <section class="pricing-section" id="pricing">
    <div class="container">
      <div class="pricing-header reveal">
        <p class="section-label scramble-text">Pricing</p>
        <h2 class="section-title">Investment. Not Expense.</h2>
        <p class="pricing-subtitle">A website that converts pays for itself. Here is what it takes to get yours.</p>
      </div>
      <div class="pricing-grid reveal">
        <div class="pricing-card">
          <div class="pricing-name">Starter</div>
          <div class="pricing-price">$2,000</div>
          <p class="pricing-desc">A high-converting landing page or single-page site for businesses ready to look professional and capture leads.</p>
          <ul class="pricing-features">
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>Single landing page design</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>Mobile-first responsive</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>Basic on-page SEO setup</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>Contact form + lead capture</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>2 revision rounds</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>Delivery in 2-3 weeks</li>
          </ul>
          <a href="#contact" class="pricing-cta">Book a Call</a>
        </div>
        <div class="pricing-card popular">
          <div class="popular-badge">Most Popular</div>
          <div class="pricing-name">Business</div>
          <div class="pricing-price">$4,500</div>
          <p class="pricing-desc">A complete multi-page website with CMS, analytics, and everything you need to grow.</p>
          <ul class="pricing-features">
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>Up to 5 custom pages</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>CMS for blog / content</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>Advanced SEO + speed opt</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>Google Analytics + Search Console</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>Custom design system</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>4 revision rounds</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>Delivery in 4-6 weeks</li>
          </ul>
          <a href="#contact" class="pricing-cta primary">Book a Call</a>
        </div>
        <div class="pricing-card">
          <div class="pricing-name">Custom</div>
          <div class="pricing-price">$8,000<span>+</span></div>
          <p class="pricing-desc">Complex builds, e-commerce, custom features, and dedicated support for serious growth.</p>
          <ul class="pricing-features">
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>Unlimited pages</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>E-commerce / memberships</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>Custom integrations + API</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>Priority support (30 days)</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>Unlimited revisions</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>Custom timeline</li>
          </ul>
          <a href="#contact" class="pricing-cta">Book a Call</a>
        </div>
      </div>
      <p class="pricing-note reveal">All packages include a 100% satisfaction guarantee. Not happy? We keep working until you are.</p>
    </div>
  </section>
  <!-- FAQ -->
  <section class="faq-section">
    <div class="container">
      <div class="faq-header reveal">
        <p class="section-label scramble-text">FAQ</p>
        <h2 class="section-title">Questions? Answered.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq, i) => (
          <details class="faq-item reveal" open={i === 0}>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="final-cta" id="contact">
    <div class="container">
      <div class="final-cta-card reveal gradient-border pulse-glow">
        <div class="final-cta-content">
          <h2>Stop Losing Leads to a Website That Does Not Work.</h2>
          <p>Book a free strategy call and get a clear roadmap to a website that generates leads while you sleep. No pitch. Just a plan.</p>
          <a href="#" class="cta-button magnetic">Book Your Free Strategy Call</a>
          <p class="cta-guarantee">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            100% satisfaction guarantee. If you are not happy, we make it right.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Hero */
  .service-hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 160px 0 100px;
    position: relative;
    overflow: hidden;
    background: #030712;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .gradient-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.5;
  }

  .blob-1 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.4), transparent 70%);
    top: -10%;
    left: -5%;
    animation: blobFloat1 20s ease-in-out infinite;
  }

  .blob-2 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.3), transparent 70%);
    bottom: -5%;
    right: -5%;
    animation: blobFloat2 18s ease-in-out infinite;
  }

  @keyframes blobFloat1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(40px, -30px) scale(1.1); }
  }

  @keyframes blobFloat2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-30px, 20px) scale(1.15); }
  }

  .service-hero-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .service-label {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent-primary);
    margin-bottom: 24px;
  }

  .service-title {
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.04em;
    margin-bottom: 28px;
  }

  .service-title .accent {
    background: linear-gradient(135deg, #A78BFA 0%, #22D3EE 50%, #34D399 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-style: italic;
    font-weight: 500;
    font-family: 'Georgia', 'Times New Roman', serif;
  }

  .service-desc {
    font-size: 18px;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 40px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .service-cta {
    display: flex;
    gap: 16px;
