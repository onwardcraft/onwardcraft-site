---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const title = 'Pricing — Transparent Pricing for High-Converting Websites';
const description = 'No hidden fees. No surprise costs. See exactly what you get at each tier — from starter landing pages to full custom builds.';

const plans = [
  {
    name: 'Starter',
    price: '$2,000',
    desc: 'A high-converting landing page or single-page site for businesses ready to look professional and capture leads.',
    features: [
      'Single landing page design',
      'Mobile-first responsive',
      'Basic on-page SEO setup',
      'Contact form + lead capture',
      '2 revision rounds',
      'Delivery in 2-3 weeks',
    ],
    cta: 'Book a Call',
    popular: false,
  },
  {
    name: 'Business',
    price: '$4,500',
    desc: 'A complete multi-page website with CMS, analytics, and everything you need to grow.',
    features: [
      'Up to 5 custom pages',
      'CMS for blog / content',
      'Advanced SEO + speed opt',
      'Google Analytics + Search Console',
      'Custom design system',
      '4 revision rounds',
      'Delivery in 4-6 weeks',
    ],
    cta: 'Book a Call',
    popular: true,
  },
  {
    name: 'Growth',
    price: '$8,000',
    desc: 'Complex builds, e-commerce, custom features, and dedicated support for serious growth.',
    features: [
      'Unlimited pages',
      'E-commerce / memberships',
      'Custom integrations + API',
      'Priority support (30 days)',
      'Unlimited revisions',
      'Custom timeline',
    ],
    cta: 'Book a Call',
    popular: false,
  },
];

const comparisonFeatures = [
  { name: 'Pages', starter: '1', business: 'Up to 5', growth: 'Unlimited' },
  { name: 'CMS', starter: '—', business: 'Included', growth: 'Included' },
  { name: 'SEO Setup', starter: 'Basic', business: 'Advanced', growth: 'Enterprise' },
  { name: 'Analytics', starter: '—', business: 'GA4 + GSC', growth: 'Full Stack' },
  { name: 'Revisions', starter: '2 rounds', business: '4 rounds', growth: 'Unlimited' },
  { name: 'E-commerce', starter: '—', business: '—', growth: 'Included' },
  { name: 'Custom Integrations', starter: '—', business: '—', growth: 'Included' },
  { name: 'Support', starter: '14 days', business: '30 days', growth: '60 days' },
  { name: 'Delivery', starter: '2-3 weeks', business: '4-6 weeks', growth: 'Custom' },
];

const faqs = [
  { q: 'Are there any hidden fees?', a: 'Absolutely not. The price you see is the price you pay. We will never surprise you with additional charges. If your project scope changes, we will discuss it upfront before any extra work begins.' },
  { q: 'What is your payment structure?', a: '50% deposit to begin, 50% on launch. For larger projects, we can split into 3 payments (30/40/30). We accept bank transfer, credit card, and PayPal.' },
  { q: 'What if I need changes after launch?', a: 'Every plan includes post-launch support. After that period, we offer monthly maintenance retainers starting at $500/month for ongoing updates, optimizations, and support.' },
  { q: 'Do you offer refunds?', a: 'We do not offer refunds, but we do offer a 100% satisfaction guarantee. If you are not happy with the work, we keep revising until you are. We have never had an unsatisfied client walk away.' },
  { q: 'Can I upgrade my plan later?', a: 'Yes. Many clients start with Starter and upgrade to Business or Growth as their needs evolve. We will credit what you have already paid toward the new plan.' },
];
---

<Layout title={title} description={description}>
  <Navbar />

  <!-- Hero -->
  <section class="pricing-hero">
    <div class="hero-bg">
      <div class="gradient-blob blob-1"></div>
      <div class="gradient-blob blob-2"></div>
    </div>
    <div class="pricing-hero-inner container">
      <p class="section-label reveal">Pricing</p>
      <h1 class="pricing-title reveal">
        Transparent Pricing.<br/>
        <span class="accent">Real Results.</span>
      </h1>
      <p class="pricing-desc reveal">
        No hidden fees. No surprise costs. Every tier includes everything you need to launch a website that converts. Pick what fits your stage — upgrade anytime.
      </p>
    </div>
  </section>

  <!-- Pricing Cards -->
  <section class="pricing-cards-section">
    <div class="container">
      <div class="pricing-cards-grid stagger-children">
        {plans.map((plan) => (
          <div class={`pricing-card ${plan.popular ? 'popular' : ''} stagger-item`}>
            {plan.popular && <div class="popular-badge">Most Popular</div>}
            <div class="pricing-card-header">
              <span class="plan-name">{plan.name}</span>
              <div class="plan-price">{plan.price}</div>
              <p class="plan-desc">{plan.desc}</p>
            </div>
            <ul class="plan-features">
              {plan.features.map(f => (
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
                  {f}
                </li>
              ))}
            </ul>
            <a href="https://cal.com/rachit-nand-ud0itz/30min" target="_blank" rel="noopener" class={`plan-cta ${plan.popular ? 'primary' : ''}`}>{plan.cta}</a>
          </div>
        ))}
      </div>
      <p class="pricing-note reveal">All packages include a 100% satisfaction guarantee. Not happy? We keep working until you are.</p>
    </div>
  </section>

  <!-- Comparison Table -->
  <section class="comparison-section">
    <div class="container">
      <div class="comparison-header reveal">
        <p class="section-label scramble-text">Compare</p>
        <h2 class="section-title">What's Included at Each Tier?</h2>
      </div>
      <div class="comparison-table-wrapper reveal">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>Feature</th>
              <th>Starter</th>
              <th class="highlight-col">Business</th>
              <th>Growth</th>
            </tr>
          </thead>
          <tbody>
            {comparisonFeatures.map((row) => (
              <tr>
                <td>{row.name}</td>
                <td>{row.starter}</td>
                <td class="highlight-col">{row.business}</td>
                <td>{row.growth}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ROI Calculator Teaser -->
  <section class="roi-section">
    <div class="container">
      <div class="roi-card reveal gradient-border">
        <div class="roi-inner">
          <div class="roi-content">
            <h2>Calculate Your Website ROI</h2>
            <p>See how much revenue a high-converting website could generate for your business. Our clients typically see a 3-5x return on their website investment within 6 months.</p>
          </div>
          <a href="https://cal.com/rachit-nand-ud0itz/30min" target="_blank" rel="noopener" class="cta-button">Get a Custom Quote</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section" id="faq">
    <div class="container">
      <div class="faq-header reveal">
        <p class="section-label scramble-text">FAQ</p>
        <h2 class="section-title">Pricing Questions. Answered.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((faq, i) => (
          <details class="faq-item reveal" open={i === 0}>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="final-cta-section">
    <div class="container">
      <div class="final-cta-card reveal gradient-border pulse-glow">
        <div class="final-cta-content">
          <h2>Still Not Sure Which Plan Fits?</h2>
          <p>Book a free strategy call and we will help you figure out exactly what you need — no pressure, no upsell.</p>
          <a href="https://cal.com/rachit-nand-ud0itz/30min" target="_blank" rel="noopener" class="cta-button magnetic">Book Your Free Strategy Call</a>
          <p class="cta-guarantee">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            No commitment. No pressure. Just honest insights.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .pricing-hero {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 160px 0 80px;
    position: relative;
    overflow: hidden;
    background: #030712;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .gradient-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.5;
  }

  .blob-1 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.4), transparent 70%);
    top: -10%;
    left: -5%;
    animation: blobFloat1 20s ease-in-out infinite;
  }

  .blob-2 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.3), transparent 70%);
    bottom: -5%;
    right: -5%;
    animation: blobFloat2 18s ease-in-out infinite;
  }

  @keyframes blobFloat1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(40px, -30px) scale(1.1); }
  }

  @keyframes blobFloat2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-30px, 20px) scale(1.15); }
  }

  .pricing-hero-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  .pricing-title {
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.04em;
    margin-bottom: 24px;
  }

  .pricing-title .accent {
    background: linear-gradient(135deg, #A78BFA 0%, #22D3EE 50%, #34D399 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-style: italic;
    font-weight: 500;
    font-family: 'Georgia', 'Times New Roman', serif;
  }

  .pricing-desc {
    font-size: 18px;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 600px;
    margin: 0 auto;
  }

  /* Pricing Cards */
  .pricing-cards-section {
    padding: 80px 0 40px;
    background: var(--bg-primary);
    position: relative;
  }

  .pricing-cards-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }

  .pricing-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    max-width: 1120px;
    margin: 0 auto;
    align-items: stretch;
  }

  .pricing-card {
    background: rgba(17, 24, 39, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    padding: 44px 36px;
    transition: all 0.45s var(--transition);
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .pricing-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.15), transparent);
  }

  .pricing-card:hover {
    border-color: rgba(255, 255, 255, 0.15);
    transform: translateY(-8px);
    box-shadow: 0 32px 64px rgba(0, 0, 0, 0.4);
  }

  .pricing-card.popular {
    border-color: rgba(59, 130, 246, 0.35);
    background:
      radial-gradient(ellipse 120% 80% at 50% 0%, rgba(59, 130, 246, 0.08) 0%, transparent 60%),
      rgba(17, 24, 39, 0.6);
    box-shadow:
      0 0 0 1px rgba(59, 130, 246, 0.15),
      0 24px 64px rgba(0, 0, 0, 0.4);
  }

  .pricing-card.popular:hover {
    border-color: rgba(59, 130, 246, 0.5);
    box-shadow:
      0 0 0 1px rgba(59, 130, 246, 0.25),
      0 32px 80px rgba(59, 130, 246, 0.12),
      0 24px 64px rgba(0, 0, 0, 0.4);
  }

  .popular-badge {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 24px;
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
    color: white;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    text-transform: uppercase;
    box-shadow: 0 4px 16px rgba(59, 130, 246, 0.3);
  }

  .plan-name {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 16px;
    margin-top: 8px;
    display: block;
  }

  .plan-price {
    font-family: var(--font-heading);
    font-size: clamp(36px, 3.5vw, 48px);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
    background: linear-gradient(135deg, #fff 30%, var(--accent-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .plan-desc {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 32px;
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .plan-features {
    list-style: none;
    margin-bottom: 36px;
    flex: 1;
  }

  .plan-features li {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 12px 0;
    font-size: 15px;
    color: var(--text-secondary);
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    line-height: 1.5;
  }

  .plan-features li:last-child {
    border-bottom: none;
  }

  .plan-features svg {
    color: var(--accent-primary);
    flex-shrink: 0;
    margin-top: 2px;
    filter: drop-shadow(0 0 4px rgba(59, 130, 246, 0.3));
  }

  .plan-cta {
    display: block;
    text-align: center;
    padding: 16px 28px;
    border-radius: var(--radius-md);
    font-size: 15px;
    font-weight: 600;
    border: 1.5px solid rgba(255, 255, 255, 0.12);
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.03);
    transition: all 0.35s;
    text-decoration: none;
    margin-top: auto;
  }

  .plan-cta:hover {
    border-color: rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.06);
    transform: translateY(-2px);
  }

  .plan-cta.primary {
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
    border-color: transparent;
    color: white;
    box-shadow: 0 4px 20px rgba(59, 130, 246, 0.25);
  }

  .plan-cta.primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(59, 130, 246, 0.4);
  }

  .pricing-note {
    text-align: center;
    margin-top: 48px;
    font-size: 15px;
    color: var(--text-muted);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.7;
  }

  /* Comparison */
  .comparison-section {
    padding: 120px 0;
    background: var(--bg-primary);
    position: relative;
  }

  .comparison-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }

  .comparison-header {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 60px;
  }

  .comparison-table-wrapper {
    max-width: 900px;
    margin: 0 auto;
    overflow-x: auto;
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }

  .comparison-table th {
    padding: 20px 24px;
    text-align: left;
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
  }

  .comparison-table th.highlight-col {
    color: var(--accent-primary);
  }

  .comparison-table td {
    padding: 18px 24px;
    color: var(--text-secondary);
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }

  .comparison-table td:first-child {
    font-weight: 600;
    color: var(--text-primary);
  }

  .comparison-table td.highlight-col {
    background: rgba(59, 130, 246, 0.04);
    color: var(--text-primary);
    font-weight: 600;
  }

  .comparison-table tr:hover td {
    background: rgba(255, 255, 255, 0.02);
  }

  .comparison-table tr:hover td.highlight-col {
    background: rgba(59, 130, 246, 0.06);
  }

  /* ROI */
  .roi-section {
    padding: 80px 0;
    background: var(--bg-primary);
    position: relative;
  }

  .roi-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }

  .roi-card {
    padding: 1px;
    max-width: 800px;
    margin: 0 auto;
  }

  .roi-inner {
    background: linear-gradient(180deg, rgba(17, 24, 39, 0.8) 0%, rgba(5, 8, 22, 0.6) 100%);
    border-radius: calc(var(--radius-xl) - 1px);
    padding: 48px;
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .roi-content {
    flex: 1;
  }

  .roi-content h2 {
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 8px;
    color: var(--text-primary);
  }

  .roi-content p {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 32px;
    background: var(--accent-primary);
    color: white;
    font-size: 15px;
    font-weight: 600;
    border-radius: var(--radius-md);
    transition: all 0.35s var(--transition);
    box-shadow: 0 4px 24px rgba(59, 130, 246, 0.3);
    white-space: nowrap;
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(59, 130, 246, 0.4);
  }

  /* FAQ */
  .faq-section {
    padding: 120px 0;
    background: var(--bg-primary);
    position: relative;
  }

  .faq-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }

  .faq-header {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 60px;
  }

  .faq-list {
    max-width: 800px;
    margin: 0 auto;
  }

  .faq-item {
    background: linear-gradient(180deg, rgba(17, 24, 39, 0.4) 0%, rgba(5, 8, 22, 0.2) 100%);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    margin-bottom: 12px;
    overflow: hidden;
    transition: all 0.3s;
  }

  .faq-item:hover {
    border-color: var(--border-hover);
  }

  .faq-item summary {
    padding: 24px 28px;
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .faq-item summary::-webkit-details-marker { display: none; }

  .faq-item summary::after {
    content: '+';
    font-size: 24px;
    color: var(--accent-primary);
    transition: transform 0.3s;
  }

  .faq-item[open] summary::after {
    transform: rotate(45deg);
  }

  .faq-item p {
    padding: 0 28px 24px;
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* Final CTA */
  .final-cta-section {
    padding: 120px 0 80px;
    background: var(--bg-primary);
    position: relative;
  }

  .final-cta-card {
    position: relative;
    background: linear-gradient(180deg, rgba(139, 92, 246, 0.08) 0%, rgba(17, 24, 39, 0.6) 100%);
    border-radius: var(--radius-xl);
    padding: 80px;
    overflow: hidden;
    text-align: center;
  }

  .final-cta-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(139, 92, 246, 0.4), rgba(59, 130, 246, 0.3), transparent);
  }

  .final-cta-content {
    position: relative;
    z-index: 1;
    max-width: 600px;
    margin: 0 auto;
  }

  .final-cta-content h2 {
    font-size: clamp(32px, 4.5vw, 52px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 20px;
  }

  .final-cta-content > p {
    font-size: 17px;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 36px;
  }

  .cta-guarantee {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 24px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .cta-guarantee svg {
    color: #34D399;
  }

  @media (max-width: 1024px) {
    .pricing-cards-grid { grid-template-columns: 1fr; }
    .pricing-card { max-width: 420px; margin: 0 auto; }
    .roi-inner { flex-direction: column; text-align: center; }
    .comparison-table-wrapper { overflow-x: auto; }
    .final-cta-card { padding: 48px 28px; }
  }

  @media (max-width: 640px) {
    .pricing-hero { padding: 140px 0 60px; }
    .pricing-title { font-size: 36px; }
    .pricing-card { padding: 36px 28px; }
    .roi-inner { padding: 32px 24px; }
    .gradient-blob { display: none; }
  }
</style>