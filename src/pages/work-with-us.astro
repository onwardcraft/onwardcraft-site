---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const title = 'Work With Us — OnwardCraft Growth Partner';
const description = 'Stop burning money on pretty websites that do not convert. Partner with OnwardCraft to turn your online presence into a revenue-generating machine. Book your free strategy call.';

const services = [
  {
    title: 'Web Design & Development',
    desc: 'Conversion-focused websites built for speed, SEO, and results. Not digital brochures — growth engines.',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
    features: ['Custom conversion-focused design', 'Astro-powered development', 'Mobile-first responsive', 'CMS integration'],
    accent: '#3B82F6',
  },
  {
    title: 'SEO & Organic Growth',
    desc: 'Get found on Google by the people actively searching for what you offer. Technical SEO + content strategy + link building.',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>`,
    features: ['On-page SEO optimization', 'Technical SEO audits', 'Content strategy', 'Local SEO'],
    accent: '#22D3EE',
  },
  {
    title: 'Lead Generation & Paid Ads',
    desc: 'Turn your website into a lead machine with optimized funnels, landing pages, and conversion systems that work 24/7.',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
    features: ['Landing page optimization', 'Lead capture systems', 'A/B testing', 'Conversion tracking'],
    accent: '#EC4899',
  },
];

const pricing = [
  {
    name: 'Foundation',
    price: '$2,500',
    period: 'one-time',
    desc: 'Perfect for small businesses ready to look professional and start capturing leads online.',
    features: ['5-page custom website', 'Basic on-page SEO setup', 'Mobile-first responsive design', 'Lead capture forms', 'Google Analytics integration', '2 rounds of revisions'],
    cta: 'Book My Free Call',
    popular: false,
  },
  {
    name: 'Growth',
    price: '$5,000',
    period: 'one-time',
    desc: 'For businesses serious about growth. More pages, better SEO, and conversion funnels built in.',
    features: ['10-page custom website', 'Advanced SEO + blog setup', 'Conversion funnel design', 'A/B test ready pages', 'CMS integration (Sanity/Strapi)', '3 rounds of revisions', '30-day post-launch support'],
    cta: 'Book My Free Call',
    popular: true,
  },
  {
    name: 'Enterprise',
    price: 'Custom',
    period: 'quote',
    desc: 'Unlimited scope for brands that need a full digital growth system, not just a website.',
    features: ['Unlimited pages + custom features', 'Full design system', 'Custom integrations + API work', 'Dedicated project manager', 'Priority support', 'Ongoing maintenance included', 'Performance guarantee'],
    cta: 'Book My Free Call',
    popular: false,
  },
];

const addons = [
  { title: 'Website Maintenance', price: 'From $500/mo', desc: 'Ongoing updates, security, performance monitoring, and priority support.' },
  { title: 'SEO Retainer', price: 'From $1,000/mo', desc: 'Monthly content, backlinks, technical audits, and ranking reports.' },
  { title: 'PPC Management', price: 'From $1,500/mo', desc: 'Google Ads + Meta Ads setup, optimization, and monthly reporting.' },
];

const results = [
  { metric: '+412%', label: 'Qualified Leads', client: 'Roofing Company', detail: '12 leads/mo → 62 leads/mo in 90 days' },
  { metric: '4.9x', label: 'ROAS', client: 'B2B SaaS Platform', detail: 'Trial conversion: 2.1% → 8.7%' },
  { metric: '+267%', label: 'Organic Traffic', client: 'Healthcare Provider', detail: 'Top 3 rankings for 40+ keywords' },
  { metric: '15x', label: 'Lead Growth', client: 'General Contractor', detail: '2 leads/mo → 30+ leads/mo' },
];

const whatToExpect = [
  { title: 'Website Audit', desc: 'We will review your current site and identify the top 3 things costing you leads.', time: '5 min' },
  { title: 'Competitive Analysis', desc: 'See what your top competitors are doing and where they are vulnerable.', time: '5 min' },
  { title: 'Growth Roadmap', desc: 'Get a clear plan for turning your website into a lead-generating machine.', time: '10 min' },
];

const faqs = [
  { q: 'How long is the call?', a: '30 minutes. We respect your time and keep it focused on actionable insights you can use immediately.' },
  { q: 'Is there any obligation?', a: 'Zero. The call is 100% free with no obligation to work with us. We will give you value either way.' },
  { q: 'What do I need to prepare?', a: 'Just your website URL and a general sense of your goals. We do the homework before the call.' },
  { q: 'What if I do not have a website yet?', a: 'No problem. We will analyze your competitors and give you a roadmap for what to build first.' },
];
---

<Layout title={title} description={description}>
  <Navbar />

  <!-- ═══════════════════════════════════════════════════════════════
       SECTION 1: HERO — GET ATTENTION
       ═══════════════════════════════════════════════════════════════ -->
  <section class="deck-hero">
    <div class="hero-bg">
      <div class="gradient-blob blob-1"></div>
      <div class="gradient-blob blob-2"></div>
      <div class="gradient-blob blob-3"></div>
    </div>
    <div class="deck-hero-inner container">
      <div class="hero-badge reveal">
        <span class="badge-dot"></span>
        <span>Only 3 client spots open this month</span>
      </div>
      <h1 class="deck-hero-title reveal">
        Your Website Is Costing You<br>
        <span class="accent">Thousands in Lost Revenue.</span>
        <br>Here Is How We Fix It.
      </h1>
      <p class="deck-hero-sub reveal">
        Most agencies build pretty websites. We build growth engines that turn visitors into leads,
        leads into customers, and customers into repeat revenue. In the next 30 minutes, you will see exactly how.
      </p>
      <div class="hero-ctas reveal">
        <a href="/book-call" class="cta-button magnetic">Book My Free Strategy Call</a>
        <a href="#results" class="btn-secondary">See Our Results First</a>
      </div>
      <p class="hero-guarantee reveal">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        No credit card required. No commitment. No pitch-fest.
      </p>
      <div class="hero-trust reveal">
        <div class="trust-avatars">
          <div class="trust-avatar">MC</div>
          <div class="trust-avatar">SW</div>
          <div class="trust-avatar">DP</div>
          <div class="trust-avatar">ER</div>
        </div>
        <p>Trusted by 100+ businesses. 4.9/5 average rating.</p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       SECTION 2: THE PROBLEM — IDENTIFY & AGITATE
       ═══════════════════════════════════════════════════════════════ -->
  <section class="problem-section" id="problem">
    <div class="container">
      <div class="problem-header reveal">
        <p class="section-label scramble-text">The Real Problem</p>
        <h2 class="section-title">You Did Not Hire a Designer.<br>You Hired an <span class="accent">Expense.</span></h2>
      </div>
      <div class="problem-grid">
        <div class="problem-card tilt-card reveal">
          <div class="problem-num">01</div>
          <h3>Your Website Looks Good. It Just Does Not Sell.</h3>
          <p>It is beautiful. Your team loves it. Your mom loves it. But here is the truth nobody wants to say: <strong>pretty does not pay the bills.</strong> If your site is not generating qualified leads every single week, it is a liability — not an asset.</p>
        </div>
        <div class="problem-card tilt-card reveal">
          <div class="problem-num">02</div>
          <h3>You Are Invisible on Google.</h3>
          <p>You are on page 3. Maybe page 5. Your competitors are eating your lunch because they invested in SEO while you were focused on "brand aesthetics." Every day you are not on page one, your ideal customer is clicking on someone else.</p>
        </div>
        <div class="problem-card tilt-card reveal">
          <div class="problem-num">03</div>
          <h3>Your "Funnel" Is a Leaky Bucket.</h3>
          <p>People visit. They browse. They leave. No phone number captured. No email. No retargeting pixel. You spent money to get them there — ads, SEO, referrals — and they vanish into the void. That is not a funnel. That is a black hole.</p>
        </div>
      </div>
      <div class="problem-closing reveal">
        <p class="problem-closing-text">
          Here is what happens if nothing changes: Six months from now, you will be in the exact same place. Same revenue plateau. Same frustration. Same competitors winning the customers that should have been yours. The only difference? You will have spent another six months waiting.
        </p>
        <a href="/book-call" class="cta-button">I Want This Fixed — Book a Call</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       SECTION 3: WHO WE ARE — CREDENTIALS & AUTHORITY
       ═══════════════════════════════════════════════════════════════ -->
  <section class="who-section" id="who">
    <div class="container">
      <div class="who-grid">
        <div class="who-left reveal">
          <p class="section-label">Who We Are</p>
          <h2 class="section-title">We Are Not Another<br><span class="accent">"Agency."</span></h2>
          <p class="who-body">
            We are OnwardCraft — a digital growth partner for businesses that are done playing small. We do not build digital brochures. We build <strong>growth engines</strong>.
          </p>
          <p class="who-body">
            After 100+ projects across roofing, healthcare, SaaS, law, and home services, we have seen what actually moves the needle — and what is just expensive noise. We have influenced over <strong>$10M in client revenue</strong> and our average client sees a <strong>312% increase in leads</strong> within 90 days.
          </p>
          <p class="who-body">
            We are not designers who learned marketing. We are marketers who happen to design exceptionally well. Every pixel, every line of code, every headline — it all serves one purpose: <strong>making you more money.</strong>
          </p>
          <div class="who-stats">
            <div class="who-stat">
              <span class="who-stat-num">100+</span>
              <span class="who-stat-label">Projects Launched</span>
            </div>
            <div class="who-stat">
              <span class="who-stat-num">$10M+</span>
              <span class="who-stat-label">Revenue Influenced</span>
            </div>
            <div class="who-stat">
              <span class="who-stat-num">312%</span>
              <span class="who-stat-label">Avg Lead Increase</span>
            </div>
          </div>
        </div>
        <div class="who-right reveal reveal-right">
          <div class="who-image-card gradient-border">
            <div class="who-image-inner">
              <div class="who-mockup">
                <div class="mockup-header">
                  <div class="mockup-dots">
                    <span></span><span></span><span></span>
                  </div>
                  <div class="mockup-url">onwardcraft.com</div>
                </div>
                <div class="mockup-body">
                  <div class="mockup-hero">
                    <div class="mockup-line wide"></div>
                    <div class="mockup-line medium"></div>
                    <div class="mockup-line short"></div>
                    <div class="mockup-btn"></div>
                  </div>
                  <div class="mockup-stats">
                    <div class="mockup-stat">
                      <div class="mockup-stat-bar"></div>
                      <div class="mockup-line tiny"></div>
                    </div>
                    <div class="mockup-stat">
                      <div class="mockup-stat-bar tall"></div>
                      <div class="mockup-line tiny"></div>
                    </div>
                    <div class="mockup-stat">
                      <div class="mockup-stat-bar"></div>
                      <div class="mockup-line tiny"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="who-trust-card">
            <div class="who-trust-stars">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            </div>
            <p class="who-trust-text">"I got more value in a 20-minute call than I did from my last $15,000 agency engagement."</p>
            <div class="who-trust-author">
              <strong>Marcus Chen</strong>
              <span>CEO, Apex Roofing</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       SECTION 4: SERVICES — WHAT WE DO
       ═══════════════════════════════════════════════════════════════ -->
  <section class="services-section" id="services">
    <div class="container">
      <div class="services-header reveal">
        <p class="section-label scramble-text">What We Do</p>
        <h2 class="section-title">Three Services.<br><span class="accent">One Goal:</span> Grow Your Revenue.</h2>
        <p class="section-subtitle">We do not do everything. We do the three things that actually move the needle — and we do them better than anyone else.</p>
      </div>
      <div class="services-grid stagger-children">
        {services.map((s) => (
          <div class="service-card-deck stagger-item" style={`--card-accent: ${s.accent}`}>
            <div class="service-icon-deck" set:html={s.icon} />
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <ul class="service-features-deck">
              {s.features.map(f => <li>{f}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <div class="addons-deck reveal">
        <p class="addons-label">Need more firepower? We also offer:</p>
        <div class="addons-list">
          {addons.map((a) => (
            <div class="addon-tag">
              <span class="addon-tag-name">{a.title}</span>
              <span class="addon-tag-price">{a.price}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       SECTION 5: RESULTS — SOCIAL PROOF
       ═══════════════════════════════════════════════════════════════ -->
  <section class="results-section" id="results">
    <div class="container">
      <div class="results-header reveal">
        <p class="section-label scramble-text">Proof It Works</p>
        <h2 class="section-title">We Do Not Talk.<br>We <span class="accent">Deliver.</span></h2>
      </div>
      <div class="results-grid stagger-children">
        {results.map((r) => (
          <div class="result-card-deck stagger-item">
            <div class="result-metric">{r.metric}</div>
            <div class="result-label">{r.label}</div>
            <div class="result-divider"></div>
            <div class="result-client">{r.client}</div>
            <div class="result-detail">{r.detail}</div>
          </div>
        ))}
      </div>
      <div class="results-testimonial reveal">
        <div class="testimonial-card">
          <svg class="testimonial-quote-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V21c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg>
          <p class="testimonial-text">"I was skeptical — I had been burned by two agencies before. But OnwardCraft delivered 412% more qualified leads in 90 days. My only regret is not finding them sooner."</p>
          <div class="testimonial-author">
            <div class="testimonial-avatar">MC</div>
            <div>
              <strong>Marcus Chen</strong>
              <span>CEO, Apex Roofing</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       SECTION 6: PRICING — THE OFFER
       ═══════════════════════════════════════════════════════════════ -->
  <section class="pricing-section" id="pricing">
    <div class="container">
      <div class="pricing-header reveal">
        <p class="section-label scramble-text">Investment</p>
        <h2 class="section-title">Transparent Pricing.<br><span class="accent">Real ROI.</span></h2>
        <p class="section-subtitle">No hidden fees. No surprise invoices. You know exactly what you are investing — and exactly what you are getting.</p>
      </div>
      <div class="pricing-grid stagger-children">
        {pricing.map((p) => (
          <div class={`pricing-card-deck stagger-item ${p.popular ? 'popular' : ''}`}>
            {p.popular && <div class="popular-badge">Most Popular</div>}
            <div class="pricing-card-header">
              <h3>{p.name}</h3>
              <div class="pricing-price">
                <span class="price-num">{p.price}</span>
                <span class="price-period">{p.period}</span>
              </div>
              <p class="pricing-desc">{p.desc}</p>
            </div>
            <ul class="pricing-features-deck">
              {p.features.map(f => <li>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                {f}
              </li>)}
            </ul>
            <a href="/book-call" class={`pricing-cta ${p.popular ? 'cta-button' : 'btn-secondary'}`}>{p.cta}</a>
          </div>
        ))}
      </div>
      <div class="pricing-guarantee reveal">
        <div class="guarantee-card">
          <div class="guarantee-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div class="guarantee-content">
            <h3>Our 100% Satisfaction Guarantee</h3>
            <p>If you are not completely satisfied with the direction we take after the first design round, we will keep revising until you are — or you do not pay a cent. We have never had a client ask for a refund. We plan to keep it that way.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       SECTION 7: WARNING — COST OF INACTION
       ═══════════════════════════════════════════════════════════════ -->
  <section class="warning-section">
    <div class="container">
      <div class="warning-card reveal gradient-border pulse-glow">
        <div class="warning-content">
          <h2>Here Is What I Know About You.</h2>
          <p>You have read this far. Which means the pain is real. You know your website should be doing more. You know your competitors are pulling ahead.</p>
          <p>But here is what I also know: <strong>90% of people who read this will do nothing.</strong> They will bookmark this page. They will think "I will come back to it." And then Monday will hit, and they will be right back in the same cycle — invisible on Google, leaking leads, watching competitors win.</p>
          <p>The 10% who act? They are the ones sending us those "I can not believe I waited this long" emails 30 days from now.</p>
          <p class="warning-question"><strong>Which group are you in?</strong></p>
          <a href="/book-call" class="cta-button magnetic">I Am in the 10% — Book My Call</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       SECTION 8: BOOK A CALL — THE CTA
       ═══════════════════════════════════════════════════════════════ -->
  <section class="book-section" id="book">
    <div class="hero-bg">
      <div class="gradient-blob blob-1"></div>
      <div class="gradient-blob blob-2"></div>
    </div>
    <div class="container">
      <div class="book-header reveal">
        <p class="section-label">Book a Call</p>
        <h2 class="section-title">Get Your Free 30-Minute<br><span class="accent">Strategy Call.</span></h2>
        <p class="section-subtitle">No strings attached. In 30 minutes, we will audit your site, analyze your competitors, and map out exactly what it takes to 3x your leads.</p>
      </div>
      <div class="book-grid">
        <div class="calendly-wrapper reveal">
          <div class="calendly-card-deck">
            <div class="calendly-header-deck">
              <h3>Book Your Free Call</h3>
              <p>Pick a 30-minute slot. We will send a calendar invite with a meeting link.</p>
            </div>
            <div class="calendly-cta-body">
              <div class="calendly-cta-icon">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                  <line x1="16" y1="2" x2="16" y2="6"/>
                  <line x1="8" y1="2" x2="8" y2="6"/>
                  <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
              </div>
              <p class="calendly-cta-text">30 minutes. Zero obligation. A clear roadmap to more leads.</p>
              <a href="/book-call" class="cta-button magnetic">
                Pick a Time
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <p class="calendly-cta-sub">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                No credit card required
              </p>
            </div>
          </div>
        </div>
        <div class="expect-wrapper reveal reveal-right">
          <div class="expect-card-deck">
            <h3>What Happens on the Call</h3>
            <div class="expect-steps">
              {whatToExpect.map((step, i) => (
                <div class="expect-step">
                  <div class="expect-num">{String(i + 1).padStart(2, '0')}</div>
                  <div class="expect-content">
                    <div class="expect-header">
                      <h4>{step.title}</h4>
                      <span class="expect-time">{step.time}</span>
                    </div>
                    <p>{step.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <div class="trust-card-deck">
            <h3>Why Business Owners Love These Calls</h3>
            <div class="trust-quote">
