---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const title = 'Work With Us — OnwardCraft Growth Partner';
const description = 'Stop burning money on pretty websites that do not convert. Partner with OnwardCraft to turn your online presence into a revenue-generating machine. Book your free strategy call.';

const systems = [
  {
    title: 'Conversion Infrastructure',
    desc: 'We redesign your website to turn visitors into booked calls. Every headline, button, and page flow is engineered for one outcome: action.',
    outcome: 'Typical result: 2-3x more form fills and calls within 60 days',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
    includes: ['Conversion audit & wireframes', 'Custom design + development', 'Mobile-first, sub-2s load times', 'CMS you can actually use'],
  },
  {
    title: 'Demand Capture System',
    desc: 'We put you where your best prospects are already looking — page one of Google — and build the authority that keeps you there.',
    outcome: 'Typical result: Top 3 rankings for 20+ buyer-intent keywords in 90 days',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>`,
    includes: ['Technical SEO foundation', 'Content that ranks & converts', 'Local search dominance', 'Monthly ranking reports'],
  },
  {
    title: 'Scalable Customer Acquisition',
    desc: 'We build automated funnels that capture, qualify, and deliver high-intent leads to your inbox — so you spend your time closing, not chasing.',
    outcome: 'Typical result: 40-60% reduction in cost per lead within 90 days',
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
    includes: ['High-intent landing pages', 'Lead capture & qualification', 'A/B testing setup', 'Conversion tracking'],
  },
];

const pricing = [
  {
    name: 'Foundation',
    price: '$2,500',
    period: 'one-time',
    desc: 'A professional conversion-focused website that starts generating leads from day one.',
    features: ['5-page custom website', 'Basic on-page SEO setup', 'Mobile-first responsive design', 'Lead capture forms', 'Google Analytics integration', '2 rounds of revisions'],
    cta: 'Book My Free Call',
    popular: false,
  },
  {
    name: 'Growth',
    price: '$5,000',
    period: 'one-time',
    desc: 'The complete system: conversion architecture, SEO dominance, and lead funnels that work while you sleep.',
    features: ['10-page custom website', 'Advanced SEO + blog setup', 'Conversion funnel design', 'A/B test ready pages', 'CMS integration', '3 rounds of revisions', '30-day post-launch support'],
    cta: 'Book My Free Call',
    popular: true,
  },
  {
    name: 'Enterprise',
    price: 'Custom',
    period: 'quote',
    desc: 'Unlimited scope for brands that need a full digital growth system, not just a website.',
    features: ['Unlimited pages + custom features', 'Full design system', 'Custom integrations + API work', 'Dedicated project manager', 'Priority support', 'Ongoing maintenance included', 'Performance guarantee'],
    cta: 'Book My Free Call',
    popular: false,
  },
];

const results = [
  { metric: '+412%', label: 'Qualified Leads', client: 'Apex Roofing', before: '12 leads/mo', after: '62 leads/mo', timeline: '90 days', detail: 'Redesigned conversion funnel + local SEO' },
  { metric: '4.9x', label: 'ROAS', client: 'CloudSync SaaS', before: '1.9x ROAS', after: '4.9x ROAS', timeline: '90 days', detail: 'Landing page optimization + onboarding flow' },
  { metric: '+267%', label: 'Organic Traffic', client: 'MedFirst Healthcare', before: 'Page 5 for key terms', after: 'Top 3 for 40+ keywords', timeline: '4 months', detail: 'Technical SEO + content strategy' },
  { metric: '15x', label: 'Lead Growth', client: 'BuildRight Construction', before: '2 leads/mo', after: '30+ leads/mo', timeline: '6 months', detail: 'Full website rebuild + local SEO + lead funnel' },
];

const whatToExpect = [
  { title: 'Website Audit', desc: 'We review your current site and identify the top 3 things costing you leads.', time: '5 min' },
  { title: 'Competitive Analysis', desc: 'See what your top competitors are doing and where they are vulnerable.', time: '5 min' },
  { title: 'Growth Roadmap', desc: 'Get a clear plan for turning your website into a lead-generating machine.', time: '10 min' },
];

const faqs = [
  { q: 'How long is the call?', a: '30 minutes. We respect your time and keep it focused on actionable insights you can use immediately.' },
  { q: 'Is there any obligation?', a: 'Zero. The call is 100% free with no obligation to work with us. We will give you value either way.' },
  { q: 'What do I need to prepare?', a: 'Just your website URL and a general sense of your goals. We do the homework before the call.' },
  { q: 'What if I do not have a website yet?', a: 'No problem. We will analyze your competitors and give you a roadmap for what to build first.' },
];

const notFor = [
  'Businesses doing under $20K/month in revenue',
  'People looking for the cheapest option',
  'Businesses unwilling to invest in growth for 90+ days',
  'Companies that want a "set it and forget it" solution',
];
---

<Layout title={title} description={description}>
  <Navbar />

  <!-- HERO -->
  <section class="deck-hero">
    <div class="deck-hero-inner container">
      <p class="hero-eyebrow reveal">Only 3 client spots open this month</p>
      <h1 class="deck-hero-title reveal">
        Your Website Is Costing You<br>Thousands in Lost Revenue.<br>Here Is How We Fix It.
      </h1>
      <p class="deck-hero-sub reveal">
        Every month your site underperforms, you are losing leads your competitors are capturing. In 30 minutes, we will show you exactly where your funnel is leaking — and how to fix it.
      </p>
      <div class="hero-ctas reveal">
        <a href="/book-call" class="btn-primary">Book My Free Strategy Call</a>
        <a href="#results" class="btn-secondary">See Results First</a>
      </div>
      <div class="hero-trust reveal">
        <div class="trust-avatars">
          <div class="trust-avatar" style="background: linear-gradient(135deg, #3B82F6, #22D3EE);">MC</div>
          <div class="trust-avatar" style="background: linear-gradient(135deg, #8B5CF6, #EC4899);">SW</div>
          <div class="trust-avatar" style="background: linear-gradient(135deg, #F59E0B, #EF4444);">DP</div>
          <div class="trust-avatar" style="background: linear-gradient(135deg, #10B981, #22D3EE);">ER</div>
        </div>
        <p>Trusted by 100+ businesses. 4.9/5 average rating.</p>
      </div>
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="problem-section" id="problem">
    <div class="container">
      <div class="problem-header reveal">
        <p class="section-label">The Real Problem</p>
        <h2 class="section-title">Your Website Looks Good.<br>It Just Does Not Sell.</h2>
      </div>
      <div class="problem-grid stagger-children">
        <div class="problem-card reveal stagger-item">
          <span class="problem-num">01</span>
          <h3>You Are Invisible on Google</h3>
          <p>Your competitors show up on page one. You are on page three. Every single day, your ideal customer searches for what you offer, clicks on your competitor, and never knows you exist.</p>
        </div>
        <div class="problem-card reveal stagger-item">
          <span class="problem-num">02</span>
          <h3>Visitors Leave Without Acting</h3>
          <p>People visit your site, browse for 12 seconds, and leave. No phone call. No form fill. No booking. You paid to get them there — through ads, referrals, or word of mouth — and they vanish.</p>
        </div>
        <div class="problem-card reveal stagger-item">
          <span class="problem-num">03</span>
          <h3>Your "Funnel" Is a Black Hole</h3>
          <p>No lead capture. No follow-up system. No retargeting. The few inquiries you get are price shoppers and tire kickers. No qualification. Just noise in your inbox.</p>
        </div>
      </div>
      <div class="problem-closing reveal">
        <p class="problem-closing-text">
          Here is what happens if nothing changes: Six months from now, you will be in the exact same place. Same revenue plateau. Same frustration. Same competitors winning the customers that should have been yours.
        </p>
        <a href="/book-call" class="btn-primary">I Want This Fixed — Book a Call</a>
      </div>
    </div>
  </section>

  <!-- PROOF / RESULTS (moved BEFORE services) -->
  <section class="results-section" id="results">
    <div class="container">
      <div class="results-header reveal">
        <p class="section-label">Proof It Works</p>
        <h2 class="section-title">Real Clients. Real Numbers.<br>Real Revenue Growth.</h2>
        <p class="section-subtitle">These are not cherry-picked outliers. They are typical outcomes when strategy and execution actually align.</p>
      </div>
      <div class="results-grid stagger-children">
        {results.map((r, i) => (
          <div class="result-card-deck reveal stagger-item">
            <div class="result-metric">{r.metric}</div>
            <div class="result-label">{r.label}</div>
            <div class="result-divider"></div>
            <div class="result-client">{r.client}</div>
            <div class="result-before-after">
              <span class="result-before">{r.before}</span>
              <span class="result-arrow">→</span>
              <span class="result-after">{r.after}</span>
            </div>
            <div class="result-timeline">{r.timeline}</div>
            <div class="result-detail">{r.detail}</div>
          </div>
        ))}
      </div>
      <div class="results-testimonial reveal">
        <div class="testimonial-card">
          <p class="testimonial-text">"I was skeptical — I had been burned by two agencies before. But OnwardCraft delivered 412% more qualified leads in 90 days. My only regret is not finding them sooner."</p>
          <div class="testimonial-author">
            <div class="testimonial-avatar" style="background: linear-gradient(135deg, #3B82F6, #22D3EE);">MC</div>
            <div>
              <strong>Marcus Chen</strong>
              <span>CEO, Apex Roofing</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHO WE ARE -->
  <section class="who-section" id="who">
    <div class="container">
      <div class="who-grid">
        <div class="who-left reveal">
          <p class="section-label">Who We Are</p>
          <h2 class="section-title">We Are Not Another Agency.<br>We Are Your Growth Partner.</h2>
          <p class="who-body">
            After 100+ projects across roofing, healthcare, SaaS, law, and home services, we know what actually moves the needle. We have influenced over <strong>$10M in client revenue</strong> and our average client sees a <strong>312% increase in leads</strong> within 90 days.
          </p>
          <p class="who-body">
            We are not designers who learned marketing. We are marketers who happen to design exceptionally well. Every pixel, every headline, every line of code — it all serves one purpose: <strong>making you more money.</strong>
          </p>
          <div class="who-stats">
            <div class="who-stat">
              <span class="who-stat-num">100+</span>
              <span class="who-stat-label">Projects Launched</span>
            </div>
            <div class="who-stat">
              <span class="who-stat-num">$10M+</span>
              <span class="who-stat-label">Revenue Influenced</span>
            </div>
            <div class="who-stat">
              <span class="who-stat-num">312%</span>
              <span class="who-stat-label">Avg Lead Increase</span>
            </div>
          </div>
        </div>
        <div class="who-right reveal">
          <div class="who-trust-card">
            <div class="who-trust-stars">★★★★★</div>
            <p class="who-trust-text">"I got more value in a 20-minute call than I did from my last $15,000 agency engagement."</p>
            <div class="who-trust-author">
              <strong>Marcus Chen</strong>
              <span>CEO, Apex Roofing</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SYSTEMS (renamed from Services) -->
  <section class="services-section" id="services">
    <div class="container">
      <div class="services-header reveal">
        <p class="section-label">What We Do</p>
        <h2 class="section-title">Three Systems. One Goal:<br>Grow Your Revenue.</h2>
        <p class="section-subtitle">We do not do everything. We do the three things that actually move the needle — and we do them better than anyone else.</p>
      </div>
      <div class="services-grid stagger-children">
        {systems.map((s, i) => (
          <div class="service-card-deck reveal stagger-item">
            <div class="service-icon-deck" set:html={s.icon} />
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <p class="service-outcome">{s.outcome}</p>
            <ul class="service-features-deck">
              {s.includes.map(f => <li>{f}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section class="pricing-section" id="pricing">
    <div class="container">
      <div class="pricing-header reveal">
        <p class="section-label">Investment</p>
        <h2 class="section-title">Transparent Pricing.<br>Real ROI.</h2>
        <p class="section-subtitle">No hidden fees. No surprise invoices. You know exactly what you are investing — and exactly what you are getting.</p>
      </div>
      <div class="pricing-grid stagger-children">
        {pricing.map((p) => (
          <div class={`pricing-card-deck reveal stagger-item ${p.popular ? 'popular' : ''}`}>
            {p.popular && <div class="popular-badge">Most Popular</div>}
            <div class="pricing-card-header">
              <h3>{p.name}</h3>
              <div class="pricing-price">
                <span class="price-num">{p.price}</span>
                <span class="price-period">{p.period}</span>
              </div>
              <p class="pricing-desc">{p.desc}</p>
            </div>
            <ul class="pricing-features-deck">
              {p.features.map(f => <li>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                {f}
              </li>)}
            </ul>
            <a href="/book-call" class={`pricing-cta ${p.popular ? 'btn-primary' : 'btn-secondary'}`}>{p.cta}</a>
          </div>
        ))}
      </div>

      <div class="pricing-guarantee reveal">
        <div class="guarantee-card">
          <div class="guarantee-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div class="guarantee-content">
            <h3>Performance Guarantee</h3>
            <p>If your metrics do not improve within 90 days, we keep working until they do — at no extra cost. We have never had a client need to use this. We plan to keep it that way.</p>
          </div>
        </div>
      </div>

      <div class="not-for reveal">
        <h4>Who This Is NOT For</h4>
        <ul>
          {notFor.map(item => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- WARNING / COST OF INACTION -->
  <section class="warning-section">
    <div class="container">
      <div class="warning-card reveal">
        <div class="warning-content">
          <h2>Here Is What I Know About You.</h2>
          <p>You have read this far. That means the pain is real. You know your website should be doing more. You know your competitors are pulling ahead.</p>
          <p>But here is what I also know: <strong>90% of people who read this will do nothing.</strong> They will bookmark this page, think "I will come back to it," and then Monday hits — same cycle, same frustration, same competitors winning.</p>
          <p>The 10% who act? They are the ones sending us "I can not believe I waited this long" emails 30 days from now.</p>
          <p class="warning-question"><strong>Which group are you in?</strong></p>
          <a href="/book-call" class="btn-primary">I Am in the 10% — Book My Call</a>
        </div>
      </div>
    </div>
  </section>

  <!-- BOOK A CALL -->
  <section class="book-section" id="book">
    <div class="container">
      <div class="book-header reveal">
        <p class="section-label">Book a Call</p>
        <h2 class="section-title">Get Your Free 30-Minute<br>Strategy Call.</h2>
        <p class="section-subtitle">No strings attached. In 30 minutes, we will audit your site, analyze your competitors, and map out exactly what it takes to 3x your leads.</p>
      </div>
      <div class="book-grid">
        <div class="calendly-wrapper reveal">
          <div class="calendly-card-deck">
            <div class="calendly-header-deck">
              <h3>Book Your Free Call</h3>
              <p>Pick a 30-minute slot. We will send a calendar invite with a meeting link.</p>
            </div>
            <div class="calendly-cta-body">
              <div class="calendly-cta-icon">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                  <line x1="16" y1="2" x2="16" y2="6"/>
                  <line x1="8" y1="2" x2="8" y2="6"/>
                  <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
              </div>
              <p class="calendly-cta-text">30 minutes. Zero obligation. A clear roadmap to more leads.</p>
              <a href="/book-call" class="btn-primary">
                Pick a Time
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <p class="calendly-cta-sub">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                No credit card required
              </p>
            </div>
          </div>
        </div>
        <div class="expect-wrapper reveal">
          <div class="expect-card-deck">
            <h3>What Happens on the Call</h3>
            <div class="expect-steps">
              {whatToExpect.map((step, i) => (
                <div class="expect-step">
                  <div class="expect-num">{String(i + 1).padStart(2, '0')}</div>
                  <div class="expect-content">
                    <div class="expect-header">
                      <h4>{step.title}</h4>
                      <span class="expect-time">{step.time}</span>
                    </div>
                    <p>{step.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <div class="trust-card-deck">
            <h3>Why Business Owners Love These Calls</h3>
            <div class="trust-quote">
              <p>"I expected a sales pitch. Instead I got a 30-minute masterclass on what was wrong with my website and exactly how to fix it. Even if I had not hired them, that call alone was worth it."</p>
              <div class="trust-author">
                <strong>Sarah Williams</strong>
                <span>Founder, CloudSync</span>
              </div>
            </div>
          </div>
          <div class="faq-card-deck">
            <h3>Quick Questions</h3>
            <div class="faq-mini-list">
              {faqs.map((faq) => (
                <details class="faq-mini-item">
                  <summary>{faq.q}</summary>
                  <p>{faq.a}</p>
                </details>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* HERO */
  .deck-hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 160px 0 100px;
    position: relative;
    background: #030712;
  }

  .deck-hero-inner { position: relative; z-index: 1; text-align: center; max-width: 800px; margin: 0 auto; }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px;
    background: rgba(236, 72, 153, 0.08);
    border: 1px solid rgba(236, 72, 153, 0.2);
    border-radius: 100px;
    font-size: 13px;
    font-weight: 600;
    color: #EC4899;
    margin-bottom: 28px;
  }

  .deck-hero-title {
    font-size: clamp(38px, 5.5vw, 64px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 24px;
    color: var(--text-primary);
  }

  .deck-hero-sub {
    font-size: 19px;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 600px;
    margin: 0 auto 32px;
  }

  .hero-ctas {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .hero-trust {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
  }

  .trust-avatars {
    display: flex;
    align-items: center;
  }

  .trust-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 700;
    color: white;
    border: 2px solid var(--bg-primary);
    margin-left: -8px;
  }

  .trust-avatar:first-child { margin-left: 0; }
  .hero-trust p { font-size: 14px; color: var(--text-muted); font-weight: 500; }

  /* PROBLEM */
  .problem-section { padding: 180px 0; position: relative; }
  .problem-section::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, var(--border), transparent); }
  .problem-header { text-align: center; max-width: 640px; margin: 0 auto 80px; }
  .problem-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 60px;
  }
  .problem-card {
    background: rgba(17, 24, 39, 0.5);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 40px 32px;
    transition: all 0.3s var(--transition);
  }
  .problem-card:hover {
    border-color: var(--border-hover);
    background: rgba(17, 24, 39, 0.65);
    transform: translateY(-4px);
  }
  .problem-num {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    color: var(--accent-primary);
    padding: 6px 14px;
    background: rgba(59,130,246,0.1);
    border: 1px solid rgba(59,130,246,0.2);
    border-radius: 100px;
    display: inline-block;
    margin-bottom: 20px;
  }
  .problem-card h3 {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 14px;
    color: var(--text-primary);
    line-height: 1.3;
  }
  .problem-card p {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.7;
  }
  .problem-closing {
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
  }
  .problem-closing-text {
    font-size: 18px;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 28px;
  }

  /* RESULTS */
  .results-section { padding: 180px 0; position: relative; }
  .results-section::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, var(--border), transparent); }
  .results-header { text-align: center; max-width: 640px; margin: 0 auto 80px; }
  .results-header .section-title { margin-left: auto; margin-right: auto; }
  .results-header .section-subtitle { margin-left: auto; margin-right: auto; }
  .results-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 60px;
  }
  .result-card-deck {
    background: rgba(17, 24, 39, 0.5);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 32px 24px;
    text-align: center;
    transition: all 0.3s var(--transition);
