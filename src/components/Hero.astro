---
---

<section class="hero" id="home">
  <div class="hero-bg"></div>

  <div class="hero-content">
    <p class="hero-eyebrow">Growth Systems for Home Service & Local Businesses</p>

    <h1 class="hero-title">
      We Turn Your Website Into Your Best Salesperson
    </h1>

    <p class="hero-desc">
      OnwardCraft is a web design, SEO, and lead-generation agency built exclusively for home-service contractors — roofing, HVAC, plumbing, solar, electrical, and restoration. Most agencies build pretty sites that don't sell. We engineer conversion systems that rank on Google, capture qualified leads, and book jobs while you're on the tools.
    </p>

    <div class="hero-actions">
      <a href="/book-call/" class="btn-primary">
        Get Your Free 48hr Audit
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="/process/" class="btn-secondary">How We Work</a>
    </div>

    <div class="hero-trust">
      <div class="hero-trust-badges">
        <span class="hero-trust-badge">Free 48-hour video audit</span>
        <span class="hero-trust-badge">Written performance guarantee</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image:
      radial-gradient(ellipse at 70% 20%, rgba(6, 214, 160, 0.08) 0%, transparent 50%),
      linear-gradient(160deg, rgba(5, 8, 22, 0.82) 0%, rgba(10, 18, 41, 0.75) 50%, rgba(5, 8, 22, 0.82) 100%),
      url('/Homepage%20hero.png');
    background-size: cover;
    background-position: center;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    max-width: var(--container);
    margin: 0 auto;
    width: 100%;
    padding: 140px 40px 100px;
  }

  .hero-eyebrow {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-primary);
    margin-bottom: 20px;
    opacity: 0;
    transform: translateY(12px);
    animation: heroFadeIn 0.6s var(--transition) 0.2s forwards;
  }

  .hero-title {
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 24px;
    color: var(--text-primary);
    max-width: 680px;
    opacity: 0;
    transform: translateY(16px);
    animation: heroFadeIn 0.7s var(--transition) 0.35s forwards;
  }

  .hero-desc {
    font-size: 18px;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 36px;
    max-width: 540px;
    opacity: 0;
    transform: translateY(16px);
    animation: heroFadeIn 0.7s var(--transition) 0.5s forwards;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 32px;
    opacity: 0;
    transform: translateY(16px);
    animation: heroFadeIn 0.6s var(--transition) 0.65s forwards;
  }

  .hero-actions .btn-primary {
    padding: 16px 28px;
    font-size: 15px;
  }

  .hero-actions .btn-secondary {
    padding: 16px 28px;
    font-size: 15px;
  }

  .hero-trust {
    display: flex;
    align-items: center;
    gap: 14px;
    opacity: 0;
    transform: translateY(12px);
    animation: heroFadeIn 0.6s var(--transition) 0.8s forwards;
  }

  .hero-trust-badges {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .hero-trust-badge {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-secondary);
    padding: 7px 16px;
    border-radius: 100px;
    background: rgba(6, 214, 160, 0.08);
    border: 1px solid rgba(6, 214, 160, 0.18);
  }

  @keyframes heroFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .hero-title { font-size: 32px; max-width: 100%; }
    .hero-desc { font-size: 16px; max-width: 100%; }
    .hero-content { padding: 120px 20px 100px; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .hero-actions .btn-primary,
    .hero-actions .btn-secondary { width: 100%; justify-content: center; min-height: 52px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-eyebrow,
    .hero-title,
    .hero-desc,
    .hero-actions,
    .hero-trust {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
