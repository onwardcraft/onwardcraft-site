---
---

<section class="hero" id="home">
  <div class="hero-bg">
    <img src="/Homepage hero.png" alt="" class="hero-bg-img" loading="eager" />
    <div class="hero-overlay"></div>
  </div>

  <div class="hero-content">
    <h1 class="hero-title" id="heroTitle">
      <span class="title-line" data-animate="words">We Do Not Build</span>
      <span class="title-line" data-animate="words">Websites. We Build</span>
      <span class="title-line accent" data-animate="fade">Growth Engines.</span>
    </h1>

    <p class="hero-desc">
      OnwardCraft is a digital growth partner for businesses that are done playing small. We combine conversion-focused design, technical excellence, and growth strategy to turn your website into your most reliable lead source.
    </p>

    <div class="hero-actions">
      <a href="/book-call" class="btn-primary">
        Get Started Today
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="/contact" class="btn-secondary">Contact page</a>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    position: relative;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(3, 7, 18, 0.82) 0%, rgba(3, 7, 18, 0.55) 40%, rgba(3, 7, 18, 0.2) 100%);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    max-width: var(--container);
    margin: 0 auto;
    width: 100%;
    padding: 140px 32px 100px;
  }

  .hero-title {
    font-size: clamp(43px, 5.4vw, 70px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 28px;
    color: white;
    max-width: 640px;
  }

  .title-line {
    display: block;
    white-space: nowrap;
  }

  .title-line .word {
    display: inline-block;
    opacity: 0;
    filter: blur(8px);
    transform: translateY(20px);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
                filter 0.7s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .title-line .word.visible {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0);
  }

  .title-line.accent {
    background: linear-gradient(135deg, #A78BFA 0%, #22D3EE 50%, #34D399 100%);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-style: italic;
    font-weight: 500;
    font-family: 'Georgia', 'Times New Roman', serif;
    letter-spacing: -0.02em;
    animation: gradientTextShift 6s ease infinite;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.6s,
                transform 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.6s;
  }

  .title-line.accent.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @keyframes gradientTextShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .hero-desc {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.7;
    margin-bottom: 36px;
    max-width: 500px;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.4s,
                transform 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.4s;
  }

  .hero-desc.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.6s,
                transform 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.6s;
  }

  .hero-actions.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .hero-actions .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    background: var(--accent-primary);
    color: white;
    font-size: 14px;
    font-weight: 600;
    border-radius: 100px;
    border: none;
    transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow: 0 4px 20px rgba(59, 130, 246, 0.2);
    text-decoration: none;
  }

  .hero-actions .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(59, 130, 246, 0.3);
  }

  .hero-actions .btn-primary svg {
    transition: transform 0.3s;
  }

  .hero-actions .btn-primary:hover svg {
    transform: translateX(3px);
  }

  .hero-actions .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 14px 28px;
    background: transparent;
    color: white;
    font-size: 14px;
    font-weight: 600;
    border-radius: 100px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    text-decoration: none;
  }

  .hero-actions .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .hero-title { font-size: 36px; }
    .hero-content { padding: 120px 20px 140px; }
    .hero-actions { flex-direction: column; align-items: flex-start; }
    .hero-actions .btn-primary, .hero-actions .btn-secondary { width: 100%; max-width: 280px; justify-content: center; }
    .hero-overlay { background: linear-gradient(90deg, rgba(3, 7, 18, 0.92) 0%, rgba(3, 7, 18, 0.8) 100%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .title-line .word, .title-line.accent, .hero-desc, .hero-actions {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
      transition: none !important;
    }
  }
</style>

<script is:inline>
  (function() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function initWordReveal() {
      document.querySelectorAll('.hero .title-line[data-animate="words"]').forEach((line, lineIndex) => {
        const text = line.textContent || '';
        line.innerHTML = '';
        const words = text.split(' ');
        words.forEach((word, i) => {
          const span = document.createElement('span');
          span.className = 'word';
          span.textContent = word;
          span.style.transitionDelay = `${(lineIndex * 0.2) + (i * 0.08) + 0.3}s`;
          line.appendChild(span);
          if (i < words.length - 1) {
            line.appendChild(document.createTextNode(' '));
          }
        });
      });
    }
    initWordReveal();

    function triggerHeroAnimations() {
      if (prefersReducedMotion) return;
      setTimeout(() => {
        document.querySelectorAll('.title-line .word, .title-line.accent, .hero-desc, .hero-actions').forEach((el) => {
          el.classList.add('visible');
        });
      }, 100);
    }

    if (document.readyState === 'complete') {
      triggerHeroAnimations();
    } else {
      window.addEventListener('load', triggerHeroAnimations);
    }
  })();
</script>
