---
import { SITE, SECTIONS } from '../data/site.js';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <span class="footer__wordmark">{SITE.name}</span>
      <p class="footer__blurb">{SITE.description}</p>
      <p class="footer__pledge">
        Independent. Nothing on this site is for sale, and no one pays to appear on it.
      </p>
    </div>

    <nav class="footer__col" aria-label="Desks">
      <h2 class="footer__h">Desks</h2>
      <ul>
        {SECTIONS.map((s) => (
          <li><a href={`/blog/category/${s.slug}/`}>{s.name}</a></li>
        ))}
        <li><a href="/blog/">All articles</a></li>
        <li><a href="/topics/">Topics index</a></li>
      </ul>
    </nav>

    <nav class="footer__col" aria-label="The publication">
      <h2 class="footer__h">The publication</h2>
      <ul>
        <li><a href="/about/">About &amp; standards</a></li>
        <li><a href="/newsletter/">Newsletter</a></li>
        <li><a href="/contact/">Contact &amp; corrections</a></li>
        <li><a href="/rss.xml">RSS feed</a></li>
        <li><a href="/sitemap/">Site index</a></li>
      </ul>
    </nav>
  </div>

  <div class="container footer__base">
    <p>© {year} {SITE.name}. Published independently.</p>
    <p class="footer__legal">
      <a href="/privacy/">Privacy</a>
      <span aria-hidden="true">·</span>
      <a href="/terms/">Terms</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    font-family: var(--font-ui);
    background: var(--navy);
    color: rgba(255, 255, 255, 0.72);
    padding: 72px 0 32px;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 48px;
  }

  .footer__wordmark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 24px;
    letter-spacing: -0.03em;
    color: #fff;
  }
  .footer__blurb {
    margin-top: 14px;
    font-family: var(--font-read);
    font-size: 15px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.62);
    max-width: 42ch;
  }
  .footer__pledge {
    margin-top: 18px;
    padding: 12px 14px;
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.06);
    font-size: 13px;
    font-weight: 500;
    color: #C9B8FF;
    max-width: 42ch;
  }

  .footer__h {
    font-family: var(--font-ui);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 16px;
  }
  .footer__col ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .footer__col a {
    font-size: 14.5px;
    color: rgba(255, 255, 255, 0.76);
    transition: color 0.18s var(--ease);
  }
  .footer__col a:hover { color: #fff; }

  .footer__cities {
    display: grid !important;
    grid-template-columns: 1fr 1fr;
    gap: 10px 18px;
  }
  .footer__more {
    display: inline-block;
    margin-top: 16px;
    font-size: 13.5px;
    font-weight: 600;
    color: #B9A6FF;
  }
  .footer__more:hover { text-decoration: underline; }

  .footer__base {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 52px;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 13px;
    color: rgba(255, 255, 255, 0.5);
  }
  .footer__legal { display: flex; gap: 10px; }
  .footer__legal a:hover { color: #fff; }

  @media (max-width: 960px) {
    .footer__grid { grid-template-columns: 1fr 1fr; gap: 36px; }
    .footer__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) {
    .footer__grid { grid-template-columns: 1fr; }
    .footer__cities { grid-template-columns: 1fr 1fr; }
  }
</style>
