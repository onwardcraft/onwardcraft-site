---
import { categorySlug } from '../data/posts.js';

export interface Props {
  post: {
    slug: string;
    title: string;
    excerpt: string;
    category: string;
    date: string;
    readTime: string;
  };
  /** 'lead' = oversized top story, 'default' = grid card, 'compact' = list row. */
  size?: 'lead' | 'default' | 'compact';
  /** Show the deck. Off for dense list views. */
  showDek?: boolean;
}
const { post, size = 'default', showDek = true } = Astro.props;

// We do not license stock photography, so each card gets a generated cover:
// a category-tinted panel carrying the desk name. It keeps the card grid
// scannable without pretending to illustrate anything.
const slug = categorySlug(post.category);
const initials = post.category
  .split(' ')
  .map((w: string) => w[0])
  .join('')
  .toUpperCase();

// Four tints per desk, chosen by a stable hash of the slug, so a grid of
// twenty-eight cards does not read as one repeated block of colour.
const COVERS: Record<string, string[][]> = {
  seo: [['#5B33EF', '#8B5CF6'], ['#4327C9', '#6D5BF7'], ['#6D28D9', '#A855F7'], ['#3B2ACB', '#7C6BFF']],
  'local-seo': [['#0E7490', '#22A6B3'], ['#0B6B7C', '#2DD4BF'], ['#115E75', '#38BDF8'], ['#0F766E', '#34D399']],
  'technical-seo': [['#1E293B', '#475569'], ['#0F172A', '#3F4A63'], ['#243043', '#5A6B85'], ['#182238', '#41506B']],
};
const palette = COVERS[slug] || COVERS.seo;
let hash = 0;
for (const ch of post.slug) hash = (hash * 31 + ch.charCodeAt(0)) >>> 0;
const [c1, c2] = palette[hash % palette.length];
---

<article class:list={['card', `card--${size}`]} data-cat={slug} style={`--c1:${c1};--c2:${c2}`}>
  {size !== 'compact' && (
    <a class="card__cover" href={`/blog/${post.slug}/`} aria-hidden="true" tabindex="-1">
      <span class="card__cover-mark">{initials}</span>
      <span class="card__cover-label">{post.category}</span>
    </a>
  )}

  <div class="card__body">
    <div class="card__top">
      <a class="tag card__cat" href={`/blog/category/${slug}/`}>{post.category}</a>
      <span class="card__time">{post.readTime}</span>
    </div>
    <h3 class="card__title">
      <a href={`/blog/${post.slug}/`}>{post.title}</a>
    </h3>
    {showDek && <p class="card__dek">{post.excerpt}</p>}
    <p class="card__meta">{post.date}</p>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .card:hover { border-color: var(--rule-strong); box-shadow: var(--shadow); transform: translateY(-3px); }

  /* ── Generated cover ── */
  .card__cover {
    position: relative;
    display: flex;
    align-items: flex-end;
    aspect-ratio: 16 / 9;
    padding: 16px;
    background: linear-gradient(135deg, var(--c1), var(--c2));
    overflow: hidden;
  }
  .card__cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.24) 1px, transparent 1px);
    background-size: 14px 14px;
    opacity: 0.55;
  }
  .card__cover-mark {
    position: absolute;
    right: -8px;
    top: -18px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 110px;
    line-height: 1;
    letter-spacing: -0.05em;
    color: rgba(255, 255, 255, 0.2);
  }
  .card__cover-label {
    position: relative;
    z-index: 1;
    font-family: var(--font-ui);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.95);
  }

  /* Cover tints arrive per card from the desk palette (see frontmatter). */

  .card__body { display: flex; flex-direction: column; flex: 1; padding: 20px; }
  .card__top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .card__time {
    font-family: var(--font-ui);
    font-size: 12.5px;
    color: var(--ink-3);
    white-space: nowrap;
  }

  .card__title {
    font-size: 19px;
    line-height: 1.3;
    margin: 12px 0 8px;
  }
  .card__title a { transition: color 0.18s var(--ease); }
  .card:hover .card__title a { color: var(--accent); }

  .card__dek {
    font-family: var(--font-read);
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-3);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card__meta {
    margin-top: auto;
    padding-top: 14px;
    font-family: var(--font-ui);
    font-size: 12.5px;
    color: var(--ink-3);
  }

  /* ── Lead story — the one above the fold. ── */
  .card--lead { flex-direction: row; align-items: stretch; }
  .card--lead .card__cover { aspect-ratio: auto; flex: 0 0 44%; padding: 24px; }
  .card--lead .card__cover-mark { font-size: 170px; }
  .card--lead .card__body { padding: 32px; justify-content: center; }
  .card--lead .card__title { font-size: clamp(25px, 3.2vw, 34px); line-height: 1.14; margin: 14px 0 12px; }
  .card--lead .card__dek { font-size: 17px; color: var(--ink-2); -webkit-line-clamp: 4; }

  /* ── Compact row — archives and rails. ── */
  .card--compact { border: none; border-radius: 0; border-top: 1px solid var(--rule); background: none; }
  .card--compact:hover { box-shadow: none; transform: none; border-color: var(--rule); }
  .card--compact .card__body { padding: 16px 0; }
  .card--compact .card__title { font-size: 16.5px; margin: 10px 0 0; }
  .card--compact:hover .card__title a { color: var(--accent); }
  .card--compact .card__meta { padding-top: 10px; }

  @media (max-width: 760px) {
    .card--lead { flex-direction: column; }
    .card--lead .card__cover { aspect-ratio: 16 / 7; flex: none; }
    .card--lead .card__body { padding: 24px; }
  }
</style>
