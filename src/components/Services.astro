---
const services = [
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>`,
    title: 'Website Design & Development',
    desc: 'Your current site is a silent salesperson who never shows up to work. We build conversion-first websites where every headline, every button, and every scroll is engineered to turn strangers into buyers.',
    features: ['Conversion-first architecture', 'Sub-2-second load times', 'Mobile-optimized'],
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>`,
    title: 'SEO & Organic Growth',
    desc: 'Stop renting your customers from Google Ads. We put you where your best prospects are already looking — page one — and build the authority that keeps you there without writing another check.',
    features: ['Local search dominance', 'Technical SEO foundation', 'Authority content systems'],
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>`,
    title: 'Lead Generation Systems',
    desc: 'Hope is not a strategy. We build automated funnels that capture, qualify, and deliver high-intent leads to your inbox — so you spend your time closing, not chasing.',
    features: ['High-intent landing pages', 'CRM & automation', 'Conversion tracking'],
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
    title: 'Brand & Creative',
    desc: 'In a sea of sameness, the brands that win are the ones that make the choice obvious. We build visual identities and positioning systems that make prospects choose you before they ever talk to sales.',
    features: ['Strategic positioning', 'Visual identity systems', 'Differentiation that converts'],
  },
];
---

<section class="services-section" id="services">
  <div class="container">
    <div class="services-header reveal">
      <p class="section-label">Services</p>
      <h2 class="section-title">Four Systems. One Outcome: Revenue.</h2>
      <p class="section-subtitle">Most agencies sell you tactics. We engineer interconnected systems that compound — each one making the others more effective. The result is growth that accelerates, not flatlines.</p>
    </div>

    <div class="services-grid stagger-children">
      {services.map((service, i) => (
        <div class="service-card stagger-item reveal" style={`transition-delay: ${i * 100}ms`}>
          <div class="service-card-top">
            <div class="service-icon" set:html={service.icon} />
            <h3>{service.title}</h3>
            <p>{service.desc}</p>
          </div>
          <div class="service-features">
            {service.features.map(f => (
              <span class="service-tag">{f}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    padding: 180px 0;
    position: relative;
  }

  .services-header {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 100px;
  }

  .services-header .section-title {
    margin-left: auto;
    margin-right: auto;
  }

  .services-header .section-subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .service-card {
    background: rgba(17, 24, 39, 0.5);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 44px 36px;
    transition: all 0.3s var(--transition);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 320px;
  }

  .service-card:hover {
    border-color: var(--border-hover);
    background: rgba(17, 24, 39, 0.65);
    transform: translateY(-4px);
  }

  .service-icon {
    width: 48px;
    height: 48px;
    background: rgba(6, 214, 160, 0.08);
    border: 1px solid rgba(6, 214, 160, 0.15);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-primary);
    margin-bottom: 24px;
    transition: transform 0.3s;
  }

  .service-card:hover .service-icon {
    transform: scale(1.05);
  }

  .service-card h3 {
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 14px;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .service-card p {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 24px;
  }

  .service-features {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .service-tag {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    padding: 6px 12px;
    border-radius: 100px;
  }

  @media (max-width: 1024px) {
    .services-grid { grid-template-columns: 1fr; }
    .service-card { min-height: auto; }
  }

  @media (max-width: 640px) {
    .services-section { padding: 100px 0; }
    .services-header { margin-bottom: 56px; }
    .service-card { padding: 32px 24px; }
    .service-card h3 { font-size: 20px; }
  }
</style>
