---
const industries = [
  { name: 'Roofing', desc: 'Storm chasing is expensive. SEO-driven leads cost a fraction and keep your calendar full year-round.', icon: 'home', color: '#F59E0B' },
  { name: 'Solar', desc: 'Stop educating tire-kickers. Funnel design that attracts buyers ready to sign — not just browse.', icon: 'sun', color: '#FBBF24' },
  { name: 'Home Services', desc: 'HVAC, plumbing, electrical — your customers search at midnight when the problem is urgent. Be the one they find.', icon: 'wrench', color: '#3B82F6' },
  { name: 'Healthcare', desc: 'Patients do not choose the best doctor. They choose the one they trust online first. We make sure that is you.', icon: 'heart', color: '#EF4444' },
  { name: 'SaaS', desc: 'Your trial signups are leaking. Fix the funnel and watch your CAC drop while revenue compounds.', icon: 'cpu', color: '#8B5CF6' },
  { name: 'Local Business', desc: 'The map pack is the new front door. Own local search and watch foot traffic you did not have to pay for.', icon: 'map', color: '#10B981' },
];

const lawIndustry = {
  name: 'Law Firms',
  desc: 'Your next client is Googling "best lawyer near me" right now. The firm that shows up first gets the case. We build authority sites that rank for high-intent legal searches and convert browsers into retained clients — ethically, effectively, and at scale.',
  icon: 'scale',
  color: '#B45309',
};

const icons: Record<string, string> = {
  home: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><path d="M9 22V12h6v10"/></svg>`,
  sun: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>`,
  wrench: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>`,
  heart: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>`,
  cpu: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h6v6H9z"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"/></svg>`,
  map: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
  scale: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22a7 7 0 007-7c0-2-1-3.9-3-5.5l-4-3.2a1 1 0 00-1.2 0L7 9.5C5 11.1 4 13 4 15a7 7 0 007 7z"/><path d="M12 2v4"/><path d="M12 12l-4 3"/><path d="M12 12l4 3"/></svg>`,
};
---

<section class="industries-section">
  <div class="container">
    <div class="industries-header reveal">
      <p class="section-label scramble-text">Industries</p>
      <h2 class="section-title">We Do Not Generalize.<br>We Specialize.</h2>
      <p class="section-subtitle">Deep expertise in industries where a high-converting website creates the biggest competitive advantage.</p>
    </div>

    <div class="industries-grid stagger-children">
      {industries.map(ind => (
        <div class="industry-card stagger-item tilt-card shine-sweep" style={`--industry-color: ${ind.color}`}>
          <div class="industry-shine"></div>
          <div class="industry-icon" set:html={icons[ind.icon]} />
          <h3>{ind.name}</h3>
          <p>{ind.desc}</p>
          <div class="industry-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </div>
      ))}
    </div>

    <!-- Specialized: Law Firms -->
    <div class="industries-specialized reveal">
      <div class="specialized-label">Our Specialized</div>
      <div class="industry-card industry-card-full tilt-card shine-sweep" style={`--industry-color: ${lawIndustry.color}`}>
        <div class="industry-shine"></div>
        <div class="industry-card-full-inner">
          <div class="industry-card-full-left">
            <div class="industry-icon" set:html={icons[lawIndustry.icon]} />
            <h3>{lawIndustry.name}</h3>
          </div>
          <p>{lawIndustry.desc}</p>
          <div class="industry-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .industries-section {
    padding: 160px 0;
    background: var(--bg-primary);
    position: relative;
    overflow: hidden;
  }

  .industries-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }

  .industries-header {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 100px;
    position: relative;
    z-index: 1;
  }

  .industries-header .section-title {
    margin-left: auto;
    margin-right: auto;
  }

  .industries-header .section-subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  .industries-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    position: relative;
    z-index: 1;
  }

  .industry-card {
    background: linear-gradient(180deg, rgba(17, 24, 39, 0.6) 0%, rgba(5, 8, 22, 0.4) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    padding: 40px 32px;
    transition: all 0.5s var(--transition);
    position: relative;
    overflow: hidden;
    cursor: pointer;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .industry-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--industry-color), transparent);
    opacity: 0;
    transition: opacity 0.5s;
  }

  .industry-shine {
    position: absolute;
    top: 0;
    left: -100%;
    width: 50%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.03), transparent);
    transition: left 0.7s;
    pointer-events: none;
  }

  .industry-card:hover {
    border-color: rgba(255, 255, 255, 0.15);
    background: linear-gradient(180deg, rgba(17, 24, 39, 0.8) 0%, rgba(5, 8, 22, 0.6) 100%);
    transform: perspective(1000px) translateY(-6px);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.3);
  }

  .industry-card:hover::before {
    opacity: 1;
  }

  .industry-card:hover .industry-shine {
    left: 150%;
  }

  .industry-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--industry-color);
    background: color-mix(in srgb, var(--industry-color) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--industry-color) 15%, transparent);
    margin-bottom: 20px;
    transition: all 0.4s;
  }

  .industry-card:hover .industry-icon {
    transform: scale(1.1) rotate(-5deg);
    box-shadow: 0 0 24px color-mix(in srgb, var(--industry-color) 15%, transparent);
  }

  .industry-card h3 {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 10px;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .industry-card p {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .industry-arrow {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: all 0.4s;
  }

  .industry-card:hover .industry-arrow {
    background: color-mix(in srgb, var(--industry-color) 10%, transparent);
    border-color: color-mix(in srgb, var(--industry-color) 25%, transparent);
    color: var(--industry-color);
    transform: translateX(4px);
  }

  .industries-specialized {
    margin-top: 60px;
  }

  .specialized-label {
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent-primary);
    margin-bottom: 20px;
    text-align: center;
  }

  .specialized-label::before {
    content: '';
    display: inline-block;
    width: 20px;
    height: 1px;
    background: linear-gradient(90deg, var(--accent-primary), var(--accent-secondary));
    vertical-align: middle;
    margin-right: 10px;
  }

  .specialized-label::after {
    content: '';
    display: inline-block;
    width: 20px;
    height: 1px;
    background: linear-gradient(90deg, var(--accent-secondary), var(--accent-primary));
    vertical-align: middle;
    margin-left: 10px;
  }

  .industry-card-full {
    grid-column: 1 / -1;
  }

  .industry-card-full-inner {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .industry-card-full-left {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .industry-card-full-left .industry-icon {
    margin-bottom: 0;
  }

  .industry-card-full-left h3 {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--text-primary);
  }

  .industry-card-full p {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
    flex: 1;
  }

  .industry-card-full .industry-arrow {
    margin: 0;
    flex-shrink: 0;
  }

  @media (max-width: 1024px) {
    .industries-header { text-align: center; margin: 0 auto 80px; }
    .industries-grid { grid-template-columns: repeat(2, 1fr); }
    .industry-card-full-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
    .industry-card-full-left h3 { font-size: 20px; }
    .industry-card-full .industry-arrow { align-self: flex-end; }
  }

  @media (max-width: 640px) {
    .industries-section { padding: 100px 0; }
    .industries-grid { grid-template-columns: 1fr; }
    .industry-card-full-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .industry-card-full-left { flex-direction: column; align-items: flex-start; gap: 12px; }
    .industry-card-full-left h3 { font-size: 20px; }
    .industry-card-full p { font-size: 14px; }
  }
</style>