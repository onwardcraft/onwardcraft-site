---
import { industries as trades } from '../data/industries.js';

// Punchy, homepage-specific blurbs per trade (distinct from the landing-page
// hero copy). Keyed by the slug in src/data/industries.js so this stays in sync
// with the real /industries/[trade]/ pages it links to.
const blurbs = {
  roofing: 'Storm chasing is expensive. We build the website and local SEO that capture insurance-claim homeowners and keep crews busy between storms.',
  hvac: 'Emergencies fill July and January. We build the maintenance-plan and seasonal systems that keep your pipeline full in spring and fall too.',
  plumbing: 'A burst pipe does not wait for business hours. We engineer sites and map-pack rankings that win the 2am emergency search every time.',
  solar: 'Leads keep getting pricier. We cut acquisition cost with education-led content and nurture that closes the long solar sale.',
  electrical: 'From panel upgrades to EV chargers, we build trust-forward sites that win safety-sensitive residential and commercial work.',
  restoration: 'Water and fire do not keep hours. We capture urgent searches and build the insurance referral relationships that drive steady volume.',
};

const icons = {
  roofing: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><path d="M9 22V12h6v10"/></svg>`,
  hvac: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9.5 14.5A2.5 2.5 0 1014 16.5V5a2 2 0 10-4 0v9.5z"/><path d="M16 9h3M16 13h4M16 17h2"/></svg>`,
  plumbing: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2.7s6 6.2 6 10.3a6 6 0 01-12 0c0-4.1 6-10.3 6-10.3z"/></svg>`,
  solar: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>`,
  electrical: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2L4.5 13.5H11l-1 8.5L19.5 10H13z"/></svg>`,
  restoration: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l8 3v6c0 5-3.5 8.5-8 11-4.5-2.5-8-6-8-11V5z"/><path d="M9 12l2 2 4-4"/></svg>`,
};

// Alternate teal/gold accent per card to stay on-brand.
const accents = ['#06D6A0', '#FFB84D', '#14B8A6', '#FFB84D', '#06D6A0', '#14B8A6'];
---

<section class="industries-section" id="industries">
  <div class="container">
    <div class="industries-header reveal">
      <p class="section-label scramble-text">Industries</p>
      <h2 class="section-title">Built for One Thing:<br>The Trades.</h2>
      <p class="section-subtitle">We do not work with restaurants, startups, or law firms. Every site, campaign, and lead system we build is tuned to how home-service contractors actually win work.</p>
    </div>

    <div class="industries-grid stagger-children">
      {trades.map((ind, i) => (
        <a href={`/industries/${ind.slug}/`} class="industry-card stagger-item tilt-card shine-sweep" style={`--industry-color: ${accents[i % accents.length]}`}>
          <div class="industry-shine"></div>
          <div class="industry-icon" set:html={icons[ind.slug]} />
          <h3>{ind.trade}</h3>
          <p>{blurbs[ind.slug]}</p>
          <div class="industry-arrow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </a>
      ))}
    </div>

    <div class="industries-cta reveal">
      <a href="/industries/" class="industries-cta-link">
        See how we market every trade
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .industries-section {
    padding: 160px 0;
    background: var(--bg-primary);
    position: relative;
    overflow: hidden;
  }

  .industries-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }

  .industries-header {
    text-align: center;
    max-width: 580px;
    margin: 0 auto 80px;
    position: relative;
    z-index: 1;
  }

  .industries-header .section-title {
    margin-left: auto;
    margin-right: auto;
  }

  .industries-header .section-subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  .industries-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    position: relative;
    z-index: 1;
  }

  .industry-card {
    display: block;
    text-decoration: none;
    background: linear-gradient(180deg, rgba(17, 24, 39, 0.6) 0%, rgba(5, 8, 22, 0.4) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    padding: 40px 32px;
    transition: all 0.5s var(--transition);
    position: relative;
    overflow: hidden;
    cursor: pointer;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .industry-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--industry-color), transparent);
    opacity: 0;
    transition: opacity 0.5s;
  }

  .industry-shine {
    position: absolute;
    top: 0;
    left: -100%;
    width: 50%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.03), transparent);
    transition: left 0.7s;
    pointer-events: none;
  }

  .industry-card:hover {
    border-color: rgba(255, 255, 255, 0.15);
    background: linear-gradient(180deg, rgba(17, 24, 39, 0.8) 0%, rgba(5, 8, 22, 0.6) 100%);
    transform: perspective(1000px) translateY(-6px);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.3);
  }

  .industry-card:hover::before {
    opacity: 1;
  }

  .industry-card:hover .industry-shine {
    left: 150%;
  }

  .industry-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--industry-color);
    background: color-mix(in srgb, var(--industry-color) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--industry-color) 15%, transparent);
    margin-bottom: 20px;
    transition: all 0.4s;
  }

  .industry-card:hover .industry-icon {
    transform: scale(1.1) rotate(-5deg);
    box-shadow: 0 0 24px color-mix(in srgb, var(--industry-color) 15%, transparent);
  }

  .industry-card h3 {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 10px;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .industry-card p {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 20px;
  }

  .industry-arrow {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: all 0.4s;
  }

  .industry-card:hover .industry-arrow {
    background: color-mix(in srgb, var(--industry-color) 10%, transparent);
    border-color: color-mix(in srgb, var(--industry-color) 25%, transparent);
    color: var(--industry-color);
    transform: translateX(4px);
  }

  .industries-cta {
    margin-top: 56px;
    text-align: center;
  }

  .industries-cta-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 600;
    color: var(--accent-primary);
    text-decoration: none;
    transition: gap 0.3s;
  }

  .industries-cta-link:hover {
    gap: 16px;
  }

  @media (max-width: 1024px) {
    .industries-header { text-align: center; margin: 0 auto 60px; }
    .industries-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .industries-section { padding: 100px 0; }
    .industries-grid { grid-template-columns: 1fr; }
  }
</style>
