---
const metrics = [
  { value: 48, suffix: 'hr', prefix: '', label: 'Free Audit Turnaround', desc: 'We deliver your custom website & SEO audit within two business days' },
  { value: 2, suffix: 's', prefix: '<', label: 'Target Load Time', desc: 'Every site we build is engineered to load in under two seconds' },
  { value: 100, suffix: '%', prefix: '', label: 'Satisfaction Guarantee', desc: 'Written performance guarantee on every engagement' },
  { value: 1, suffix: '', prefix: '#', label: 'Trades Focus', desc: 'A specialist agency built exclusively for home-service contractors' },
];

const donutSegments = [
  { color: '#06D6A0', label: 'Direct', value: 45 },
  { color: '#06D6A0', label: 'Organic', value: 28 },
  { color: '#FFB84D', label: 'Paid', value: 18 },
  { color: '#E2E8F0', label: 'Referral', value: 9 },
];

const bottomStats = [
  { value: 'Data', label: 'Backed Decisions', desc: 'Competitive intelligence and customer behavior, not guesswork' },
  { value: 'Built', label: 'For The Trades', desc: 'Funnels engineered specifically for home-service contractors' },
];
---

<section class="results-section" id="results">
  <div class="container">
    <div class="results-header reveal">
      <p class="section-label scramble-text">Results</p>
      <h2 class="section-title">Built To Drive Growth.<br>Not Vanity Metrics.</h2>
      <p class="section-subtitle">Vanity metrics do not pay your bills. We focus on the numbers that matter: faster sites, more qualified leads, and growth that compounds for your business.</p>
    </div>

    <div class="results-grid stagger-children">
      {metrics.map((m, i) => (
        <div class="result-card stagger-item tilt-card" style={`--result-delay: ${i * 0.1}s`}>
          <div class="result-glow"></div>
          <div class="result-number">
            <span class="counter" data-target={m.value} data-prefix={m.prefix} data-suffix={m.suffix} data-duration="2500">0</span>
          </div>
          <div class="result-label">{m.label}</div>
          <div class="result-desc">{m.desc}</div>
        </div>
      ))}
    </div>

    <div class="results-bottom reveal">
      <div class="results-bottom-left">
        <div class="donut-card">
          <div class="donut-header">
            <span>Balanced Traffic Mix</span>
            <span class="donut-total">Our Target Model</span>
          </div>
          <div class="donut-body">
            <div class="donut-chart">
              <svg viewBox="0 0 200 200" class="donut-svg">
                <defs>
                  <filter id="donutGlow" x="-20%" y="-20%" width="140%" height="140%">
                    <feGaussianBlur stdDeviation="3" result="blur"/>
                    <feMerge>
                      <feMergeNode in="blur"/>
                      <feMergeNode in="SourceGraphic"/>
                    </feMerge>
                  </filter>
                </defs>
                <circle cx="100" cy="100" r="70" fill="none" stroke="#1e293b" stroke-width="22" />
                {(() => {
                  let cumulativePercent = 0;
                  return donutSegments.map((seg, i) => {
                    const circumference = 2 * Math.PI * 70;
                    const offset = circumference - (seg.value / 100) * circumference;
                    const rotation = (cumulativePercent / 100) * 360 - 90;
                    cumulativePercent += seg.value;
                    return (
                      <circle
                        cx="100"
                        cy="100"
                        r="70"
                        fill="none"
                        stroke={seg.color}
                        stroke-width="22"
                        stroke-linecap="round"
                        stroke-dasharray={`${circumference} ${circumference}`}
                        stroke-dashoffset={offset}
                        transform={`rotate(${rotation} 100 100)`}
                        class="donut-segment"
                        style={`animation-delay: ${0.3 + i * 0.2}s`}
                      />
                    );
                  });
                })()}
              </svg>
              <div class="donut-center">
                <div class="donut-center-value">100%</div>
                <div class="donut-center-label">Traffic</div>
              </div>
            </div>
            <div class="donut-legend">
              {donutSegments.map(seg => (
                <div class="donut-legend-item">
                  <span class="donut-legend-dot" style={`background: ${seg.color}`}></span>
                  <span class="donut-legend-label">{seg.label}</span>
                  <span class="donut-legend-value">{seg.value}%</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="results-bottom-right">
        <div class="bottom-content">
          <p class="bottom-label">How We Do It</p>
          <h3 class="bottom-title">We Do Not Guess.<br>We Engineer.</h3>
          <p class="bottom-desc">Every decision is backed by competitive intelligence, customer behavior data, and market analysis. We find the exact points where your funnel hemorrhages revenue, patch them with precision, and turn your website into a system that generates qualified leads while you focus on closing them.</p>

          <div class="bottom-stats">
            {bottomStats.map(stat => (
              <div class="bottom-stat">
                <div class="bottom-stat-value">{stat.value}</div>
                <div class="bottom-stat-label">{stat.label}</div>
                <div class="bottom-stat-desc">{stat.desc}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .results-section {
    padding: 160px 0;
    background: var(--bg-primary);
  }

  .results-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 80px;
  }

  .results-header .section-title {
    margin-left: auto;
    margin-right: auto;
  }

  .results-header .section-subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  .results-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 80px;
  }

  .result-card {
    background: linear-gradient(180deg, rgba(17, 24, 39, 0.8) 0%, rgba(5, 8, 22, 0.6) 100%);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 40px 24px;
    text-align: center;
    transition: all 0.5s var(--transition);
    position: relative;
    overflow: hidden;
    cursor: pointer;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .result-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(6, 214, 160, 0.3), transparent);
    opacity: 0;
    transition: opacity 0.5s;
  }

  .result-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100px;
    height: 100px;
    background: radial-gradient(circle, rgba(6, 214, 160, 0.15), transparent 70%);
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 0.5s;
    pointer-events: none;
  }

  .result-card:hover {
    border-color: var(--border-hover);
    transform: perspective(1000px) translateY(-6px);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.3);
  }

  .result-card:hover::before {
    opacity: 1;
  }

  .result-card:hover .result-glow {
    opacity: 1;
  }

  .result-number {
    font-family: var(--font-heading);
    font-size: clamp(36px, 3.5vw, 48px);
    font-weight: 700;
    background: linear-gradient(135deg, var(--text-primary) 0%, var(--accent-primary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 12px;
    letter-spacing: -0.03em;
  }

  .result-label {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 6px;
  }

  .result-desc {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* Bottom two-column layout */
  .results-bottom {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }

  /* Donut card */
  .donut-card {
    background: linear-gradient(180deg, rgba(17, 24, 39, 0.8) 0%, rgba(5, 8, 22, 0.6) 100%);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 36px;
    transition: all 0.5s;
  }

  .donut-card:hover {
    border-color: var(--border-hover);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.3);
  }

  .donut-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .donut-total {
    font-size: 13px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .donut-body {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .donut-chart {
    position: relative;
    width: 200px;
    height: 200px;
    flex-shrink: 0;
  }

  .donut-svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .donut-segment {
    animation: donutDraw 1s ease-out backwards;
    transition: stroke-width 0.3s;
  }

  @keyframes donutDraw {
    from { stroke-dashoffset: 440; }
  }

  .donut-center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
  }

  .donut-center-value {
    font-family: var(--font-heading);
    font-size: 28px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .donut-center-label {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 4px;
    font-weight: 500;
  }

  .donut-legend {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .donut-legend-item {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .donut-legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .donut-legend-label {
    font-size: 14px;
    color: var(--text-secondary);
    font-weight: 500;
    flex: 1;
  }

  .donut-legend-value {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
  }

  /* Right side content */
  .bottom-content {
    padding: 20px 0;
  }

  .bottom-label {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-primary);
    margin-bottom: 16px;
  }

  .bottom-title {
    font-family: var(--font-heading);
    font-size: clamp(28px, 3vw, 36px);
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 20px;
  }

  .bottom-desc {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 40px;
    max-width: 420px;
  }

  .bottom-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  .bottom-stat-value {
    font-family: var(--font-heading);
    font-size: clamp(36px, 3.5vw, 48px);
    font-weight: 700;
    background: linear-gradient(135deg, var(--text-primary) 0%, var(--accent-primary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: 8px;
  }

  .bottom-stat-label {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .bottom-stat-desc {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  @media (max-width: 1024px) {
    .results-grid { grid-template-columns: repeat(2, 1fr); }
    .results-bottom { grid-template-columns: 1fr; gap: 60px; }
    .donut-body { justify-content: center; }
  }

  @media (max-width: 640px) {
    .results-section { padding: 100px 0; }
    .results-grid { grid-template-columns: 1fr; margin-bottom: 48px; }
    .results-header { margin-bottom: 56px; }
    .donut-card { padding: 24px; }
    .donut-body { flex-direction: column; align-items: center; }
    .bottom-stats { grid-template-columns: 1fr; }
    .bottom-title { font-size: 26px; }
    .bottom-desc { font-size: 15px; }
  }
</style>
