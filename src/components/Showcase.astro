---
const features = [
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 7V4h3M4 17v3h3M20 7V4h-3M20 17v3h-3M9 9h6v6H9z"/><circle cx="12" cy="12" r="9"/></svg>`,
    title: 'SEO-First Architecture',
    desc: 'Your competitors are ranking. Why are not you? We build every page to climb Google — semantic HTML, structured data, and content that search engines devour.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>`,
    title: 'Conversion Engineering',
    desc: 'Strategic CTAs, optimized funnels, A/B-tested layouts, and copy that makes clicking feel like the obvious next step. Not design. Persuasion.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
    title: 'Performance Obsessed',
    desc: 'Every extra second of load time costs you 7% of conversions. We build sub-second sites that load before your visitor thinks about leaving.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`,
    title: 'Data-Driven Iteration',
    desc: 'We do not guess what works. We watch real users, measure every click, and optimize until your conversion rate stops being a problem and starts being an advantage.',
  },
];
---

<section class="showcase-section" id="showcase">
  <div class="container">
    <div class="showcase-header reveal">
      <p class="section-label scramble-text">Why Choose Us</p>
      <h2 class="section-title">Pretty Loses.<br>Profit Wins.</h2>
      <p class="section-subtitle">Most agencies sell you a trophy website. We sell you a machine that prints leads. Every line of code, every headline, every pixel — engineered for one thing: revenue.</p>
    </div>

    <div class="showcase-grid">
      <!-- Left: Text Content -->
      <div class="showcase-text reveal">
        <div class="showcase-badge">Exclusive Feature</div>
        <h3>Your Website Should Be Your Best Salesperson</h3>
        <p>It works 24/7. Never calls in sick. Never asks for a raise. And when built right, it outperforms your entire sales team combined.</p>
        <ul class="showcase-checks">
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            Predictable lead flow — month after month
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            Compounding growth that your competitors can not copy
          </li>
        </ul>
        <a href="https://cal.com/rachit-nand-ud0itz/30min" target="_blank" rel="noopener" class="showcase-cta magnetic">
          See How It Works
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <!-- Right: Dashboard Mockup -->
      <div class="showcase-visual reveal">
        <div class="dashboard-card">
          <div class="dashboard-header">
            <span>Website Stats Activity</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
          </div>
          <div class="dashboard-chart">
            <svg viewBox="0 0 300 140" width="100%" height="140">
              <!-- Grid lines -->
              <line x1="0" y1="35" x2="300" y2="35" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>
              <line x1="0" y1="70" x2="300" y2="70" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>
              <line x1="0" y1="105" x2="300" y2="105" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>
              <!-- Line 1 -->
              <path d="M0,105 Q30,100 60,95 T120,80 T180,55 T240,45 T300,35" fill="none" stroke="url(#lineGrad1)" stroke-width="2.5" stroke-linecap="round" class="chart-line"/>
              <!-- Line 2 -->
              <path d="M0,115 Q30,112 60,108 T120,95 T180,85 T240,75 T300,70" fill="none" stroke="url(#lineGrad2)" stroke-width="2" stroke-linecap="round" stroke-dasharray="4,4" class="chart-line-dashed"/>
              <!-- Area under line 1 -->
              <defs>
                <linearGradient id="areaGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" stop-color="#8B5CF6" stop-opacity="0.15"/>
                  <stop offset="100%" stop-color="#8B5CF6" stop-opacity="0"/>
                </linearGradient>
                <linearGradient id="lineGrad1" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#8B5CF6"/>
                  <stop offset="100%" stop-color="#22D3EE"/>
                </linearGradient>
                <linearGradient id="lineGrad2" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#3B82F6"/>
                  <stop offset="100%" stop-color="#8B5CF6"/>
                </linearGradient>
              </defs>
              <path d="M0,105 Q30,100 60,95 T120,80 T180,55 T240,45 T300,35 L300,140 L0,140 Z" fill="url(#areaGrad)"/>
              <!-- Data points -->
              <circle cx="300" cy="35" r="4" fill="#22D3EE" class="chart-dot"/>
              <circle cx="240" cy="45" r="3" fill="#8B5CF6" class="chart-dot"/>
            </svg>
          </div>
          <div class="dashboard-labels">
            <span>10</span>
            <span>30</span>
            <span>60</span>
          </div>
        </div>

        <!-- Floating stat card -->
        <div class="float-stat-card float-anim">
          <div class="float-stat-header">
            <span>Total Revenue</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
          </div>
          <div class="float-stat-value">$1.89K</div>
          <div class="float-stat-mini-chart">
            <div class="mini-bar" style="height: 40%"></div>
            <div class="mini-bar" style="height: 60%"></div>
            <div class="mini-bar" style="height: 35%"></div>
            <div class="mini-bar" style="height: 75%;"></div>
            <div class="mini-bar" style="height: 55%"></div>
          </div>
          <div class="float-stat-trend">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17l5-5 5 5M12 12V3"/></svg>
            45% Since last period
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom: Feature Grid -->
    <div class="showcase-features">
      {features.map((f, i) => (
        <div class="feature-card reveal" style={`animation-delay: ${i * 0.1}s`}>
          <div class="feature-icon">
            <Fragment set:html={f.icon} />
          </div>
          <h4>{f.title}</h4>
          <p>{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .showcase-section {
    padding: 160px 0;
    background: var(--bg-primary);
    position: relative;
    overflow: hidden;
  }

  .showcase-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }

  .showcase-header {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 80px;
  }

  .showcase-header .section-title {
    margin-left: auto;
    margin-right: auto;
  }

  .showcase-header .section-subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 60px;
    align-items: center;
    margin-bottom: 100px;
  }

  .showcase-text {
    position: relative;
    z-index: 1;
  }

  .showcase-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-primary);
    padding: 8px 16px;
    border-radius: 100px;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.03);
    margin-bottom: 24px;
  }

  .showcase-text h3 {
    font-size: 36px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
  }

  .showcase-text > p {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 28px;
  }

  .showcase-checks {
    list-style: none;
    margin-bottom: 32px;
  }

  .showcase-checks li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    color: var(--text-secondary);
    margin-bottom: 14px;
  }

  .showcase-checks svg {
    color: var(--accent-primary);
    flex-shrink: 0;
  }

  .showcase-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    background: linear-gradient(135deg, #8B5CF6, #3B82F6);
    color: white;
    border-radius: var(--radius-lg);
    font-size: 15px;
    font-weight: 600;
    transition: all 0.35s var(--transition);
    box-shadow: 0 8px 32px rgba(139, 92, 246, 0.25);
  }

  .showcase-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(139, 92, 246, 0.35);
    gap: 14px;
  }

  .showcase-visual {
    position: relative;
    min-height: 380px;
    padding-bottom: 40px;
  }

  .dashboard-card {
    background: linear-gradient(180deg, rgba(139, 92, 246, 0.1) 0%, rgba(17, 24, 39, 0.6) 100%);
    border: 1px solid rgba(139, 92, 246, 0.15);
    border-radius: var(--radius-xl);
    padding: 28px;
    position: relative;
    overflow: hidden;
    transition: all 0.5s var(--transition);
  }

  .dashboard-card:hover {
    border-color: rgba(139, 92, 246, 0.3);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.4), 0 0 40px rgba(139, 92, 246, 0.05);
  }

  .dashboard-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(139, 92, 246, 0.4), transparent);
  }

  .dashboard-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 20px;
  }

  .dashboard-header svg {
    color: var(--text-muted);
  }

  .dashboard-chart {
    margin-bottom: 12px;
  }

  .chart-line {
    stroke-dasharray: 500;
    stroke-dashoffset: 500;
    animation: drawLine 2s ease-out forwards;
  }

  .chart-line-dashed {
    opacity: 0;
    animation: fadeIn 1s ease-out 1s forwards;
  }

  .chart-dot {
    opacity: 0;
    animation: popIn 0.4s ease-out 1.5s forwards;
  }

  @keyframes drawLine {
    to { stroke-dashoffset: 0; }
  }

  @keyframes fadeIn {
    to { opacity: 1; }
  }

  @keyframes popIn {
    0% { opacity: 0; transform: scale(0); }
    80% { transform: scale(1.2); }
    100% { opacity: 1; transform: scale(1); }
  }

  .dashboard-labels {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--text-muted);
    padding: 0 4px;
  }

  .float-stat-card {
    position: absolute;
    bottom: -20px;
    left: -20px;
    width: 180px;
    background: rgba(17, 24, 39, 0.9);
    backdrop-filter: blur(20px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 18px;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.4);
    z-index: 2;
  }

  .float-stat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 11px;
    color: var(--text-muted);
    margin-bottom: 8px;
  }

  .float-stat-value {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 12px;
  }

  .float-stat-mini-chart {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 32px;
    margin-bottom: 10px;
  }

  .mini-bar {
    flex: 1;
    background: linear-gradient(180deg, rgba(139, 92, 246, 0.6), rgba(139, 92, 246, 0.15));
    border-radius: 2px 2px 0 0;
  }

  .float-stat-trend {
    font-size: 10px;
    color: #34D399;
    display: flex;
    align-items: center;
    gap: 4px;
    font-weight: 500;
  }

  .float-stat-trend svg {
    color: #34D399;
  }

  .showcase-features {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .feature-card {
    background: rgba(17, 24, 39, 0.4);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    padding: 32px;
    transition: all 0.4s var(--transition);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .feature-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(59, 130, 246, 0.2), transparent);
    opacity: 0;
    transition: opacity 0.4s;
  }

  .feature-card:hover {
    border-color: rgba(255, 255, 255, 0.15);
    background: rgba(17, 24, 39, 0.6);
    transform: translateY(-4px);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.3), 0 0 40px rgba(59, 130, 246, 0.05);
  }

  .feature-card:hover::before {
    opacity: 1;
  }

  .feature-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    margin-bottom: 20px;
    transition: all 0.3s;
  }

  .feature-card:hover .feature-icon {
    background: rgba(59, 130, 246, 0.1);
    border-color: rgba(59, 130, 246, 0.3);
    color: var(--accent-primary);
  }

  .feature-card h4 {
    font-size: 17px;
    font-weight: 700;
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }

  .feature-card p {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.6;
    flex: 1;
  }

  @media (max-width: 1024px) {
    .showcase-header { text-align: center; margin: 0 auto 60px; }
    .showcase-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .showcase-text { text-align: center; }
    .showcase-checks { display: inline-block; text-align: left; }
    .showcase-features { grid-template-columns: repeat(2, 1fr); }
    .float-stat-card { left: 10px; bottom: -10px; }
  }

  @media (max-width: 640px) {
    .showcase-section { padding: 100px 0; }
    .showcase-text h3 { font-size: 28px; }
    .showcase-features { grid-template-columns: 1fr; }
    .feature-card { padding: 28px; }
    .dashboard-card { padding: 20px; }
    .float-stat-card { width: 150px; padding: 14px; }
    .float-stat-value { font-size: 20px; }
  }
</style>