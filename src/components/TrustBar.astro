---
const stats = [
  { value: '50+', label: 'Businesses Trusted' },
  { value: '$10M+', label: 'Revenue Influenced' },
  { value: '312%', label: 'Avg. Lead Increase' },
  { value: '4.9/5', label: 'Client Rating' },
];

const industries = [
  'Roofing',
  'Solar',
  'HVAC',
  'Law Firms',
  'Healthcare',
  'SaaS',
];
---

<section class="trust-bar">
  <div class="container">
    <div class="trust-stats">
      {stats.map((stat, i) => (
        <div class="trust-stat reveal" style={`transition-delay: ${i * 100}ms`}>
          <span class="trust-stat-value">{stat.value}</span>
          <span class="trust-stat-label">{stat.label}</span>
        </div>
      ))}
    </div>

    <div class="trust-divider"></div>

    <div class="trust-industries reveal">
      <span class="trust-industries-label">Serving:</span>
      <div class="trust-industries-pills">
        {industries.map(name => (
          <span class="industry-pill">{name}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .trust-bar {
    padding: 60px 0 40px;
    position: relative;
  }

  .trust-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
    margin-bottom: 40px;
  }

  .trust-stat {
    text-align: center;
    padding: 20px;
    border-radius: var(--radius-lg);
    transition: all 0.3s var(--transition);
  }

  .trust-stat:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .trust-stat-value {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(32px, 3.5vw, 48px);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 8px;
    letter-spacing: -0.03em;
  }

  .trust-stat-label {
    font-size: 14px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .trust-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
    margin-bottom: 28px;
  }

  .trust-industries {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .trust-industries-label {
    font-size: 13px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .trust-industries-pills {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .industry-pill {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    padding: 6px 14px;
    border-radius: 100px;
  }

  @media (max-width: 768px) {
    .trust-stats { grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .trust-bar { padding: 48px 0 32px; }
    .trust-industries { gap: 10px; }
  }
</style>
