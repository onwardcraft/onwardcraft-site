---
const testimonials = [
  {
    name: 'Marcus Chen',
    company: 'Apex Roofing',
    role: 'CEO',
    initials: 'MC',
    color: 'linear-gradient(135deg, #3B82F6, #22D3EE)',
    text: '412% more qualified leads in 90 days. Our website went from a cost to our best salesperson.',
  },
  {
    name: 'Sarah Williams',
    company: 'CloudSync',
    role: 'Founder',
    initials: 'SW',
    color: 'linear-gradient(135deg, #8B5CF6, #EC4899)',
    text: 'Trial conversion jumped from 2.1% to 8.7%. They do not just build sites — they architect growth.',
  },
  {
    name: 'David Park',
    company: 'MedFirst',
    role: 'CMO',
    initials: 'DP',
    color: 'linear-gradient(135deg, #F59E0B, #EF4444)',
    text: 'From invisible to top 3 for 40+ keywords in four months. The SEO strategy was surgical.',
  },
  {
    name: 'Elena Rodriguez',
    company: 'Nexus Tech',
    role: 'Director',
    initials: 'ER',
    color: 'linear-gradient(135deg, #10B981, #22D3EE)',
    text: 'Conversion rate went from 1.2% to 4.7%. That is the difference between a vendor and a partner.',
  },
];
---

<section class="testimonials-section">
  <div class="container">
    <div class="testimonials-header reveal">
      <p class="section-label">Testimonials</p>
      <h2 class="section-title">What Our Clients Say</h2>
      <p class="section-subtitle">Real results from real businesses.</p>
    </div>

    <div class="testimonials-grid stagger-children">
      {testimonials.map((t, i) => (
        <div class="testimonial-card stagger-item reveal" style={`transition-delay: ${i * 100}ms`}>
          <p class="testimonial-text">"{t.text}"</p>
          <div class="testimonial-author">
            <div class="testimonial-avatar" style={`background: ${t.color}`}>
              {t.initials}
            </div>
            <div class="testimonial-author-info">
              <strong>{t.name}</strong>
              <span>{t.role}, {t.company}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    padding: 180px 0;
    position: relative;
  }

  .testimonials-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }

  .testimonials-header {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 80px;
  }

  .testimonials-header .section-title {
    margin-left: auto;
    margin-right: auto;
  }

  .testimonials-header .section-subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .testimonial-card {
    background: rgba(17, 24, 39, 0.4);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 40px;
    transition: all 0.3s var(--transition);
  }

  .testimonial-card:hover {
    border-color: var(--border-hover);
    background: rgba(17, 24, 39, 0.55);
  }

  .testimonial-text {
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 28px;
  }

  .testimonial-author {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .testimonial-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    color: white;
    flex-shrink: 0;
  }

  .testimonial-author-info strong {
    display: block;
    font-size: 15px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 2px;
  }

  .testimonial-author-info span {
    font-size: 14px;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .testimonials-grid { grid-template-columns: 1fr; }
    .testimonial-card { padding: 28px; }
    .testimonial-text { font-size: 15px; }
  }

  @media (max-width: 640px) {
    .testimonials-section { padding: 100px 0; }
    .testimonials-header { margin-bottom: 48px; }
  }
</style>
