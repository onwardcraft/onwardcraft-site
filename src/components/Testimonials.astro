---
// Honest proof: instead of fabricated client quotes, we lead with the
// commitments every engagement comes with. Real reviews go here once
// clients approve them (wire in Review schema at that point).
const commitments = [
  {
    title: 'A Free, No-Obligation Audit',
    text: 'Before you spend a dollar, you get a recorded teardown of your current site — the exact leaks costing you leads, ranked by impact. Yours to keep, even if we never work together.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>`,
  },
  {
    title: 'A Written Performance Guarantee',
    text: 'We agree on the metrics that matter — leads, rankings, conversion rate — before we start. If they do not improve, we keep working at no extra cost until they do. In writing.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>`,
  },
  {
    title: 'Founder-Led, Never Outsourced',
    text: 'You work directly with the person building your site. No account managers relaying messages, no offshore B-team, no junior handoffs. One point of contact who owns the outcome.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
  },
  {
    title: 'Fixed, Transparent Pricing',
    text: 'You approve the full scope and price before a single line of code is written. No hourly meters, no surprise invoices, no scope-creep upsells. The number you see is the number you pay.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>`,
  },
];
---

<section class="promise-section">
  <div class="container">
    <div class="promise-header reveal">
      <p class="section-label">Why Work With Us</p>
      <h2 class="section-title">No Inflated Numbers.<br/>Just Work We Stand Behind.</h2>
      <p class="section-subtitle">We would rather show you exactly how we operate than parade recycled testimonials. Every engagement comes with the same four commitments — in writing.</p>
    </div>

    <div class="promise-grid stagger-children">
      {commitments.map((c, i) => (
        <div class="promise-card stagger-item reveal" style={`transition-delay: ${i * 100}ms`}>
          <div class="promise-icon" set:html={c.icon} />
          <h3>{c.title}</h3>
          <p>{c.text}</p>
        </div>
      ))}
    </div>

    <p class="promise-footnote reveal">Client case studies and named reviews are published here as engagements complete — only with the client's permission, and only with numbers we can defend.</p>
  </div>
</section>

<style>
  .promise-section {
    padding: 180px 0;
    position: relative;
  }

  .promise-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }

  .promise-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 72px;
  }

  .promise-header .section-title {
    margin-left: auto;
    margin-right: auto;
  }

  .promise-header .section-subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  .promise-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .promise-card {
    background: rgba(17, 24, 39, 0.4);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 40px;
    transition: all 0.3s var(--transition);
  }

  .promise-card:hover {
    border-color: var(--border-hover);
    background: rgba(17, 24, 39, 0.55);
    transform: translateY(-4px);
  }

  .promise-icon {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    background: rgba(6, 214, 160, 0.1);
    border: 1px solid rgba(6, 214, 160, 0.2);
    color: var(--accent-primary);
    margin-bottom: 22px;
  }

  .promise-card h3 {
    font-size: 20px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 12px;
  }

  .promise-card p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .promise-footnote {
    text-align: center;
    max-width: 620px;
    margin: 56px auto 0;
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.7;
  }

  @media (max-width: 768px) {
    .promise-grid { grid-template-columns: 1fr; }
    .promise-card { padding: 28px; }
  }

  @media (max-width: 640px) {
    .promise-section { padding: 100px 0; }
    .promise-header { margin-bottom: 48px; }
  }
</style>
