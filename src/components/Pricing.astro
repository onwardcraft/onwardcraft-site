---
const plans = [
  {
    name: 'Foundation',
    desc: 'Stop looking amateur. Start looking like the leader.',
    price: '$2,500',
    period: 'one-time',
    features: ['5-page conversion website', 'Mobile-first design', 'Basic SEO setup', 'Lead capture forms', '2 revision rounds', '30-day support'],
    cta: 'Book My Call',
    highlight: false,
  },
  {
    name: 'Growth',
    desc: 'The system that turns your website into a lead machine.',
    price: '$5,000',
    period: 'one-time',
    features: ['10-page conversion site', 'Advanced SEO architecture', 'Blog + content system', 'Lead generation funnels', 'Analytics & tracking', 'A/B testing setup', '60-day support'],
    cta: 'Most Popular',
    highlight: true,
  },
  {
    name: 'Enterprise',
    desc: 'Unlimited scope for brands that refuse to settle.',
    price: '$10,000+',
    period: 'custom',
    features: ['Unlimited pages', 'Custom design system', 'Full SEO + content strategy', 'Multi-funnel architecture', 'CMS integration', 'Performance optimization', 'Priority support'],
    cta: 'Book My Call',
    highlight: false,
  },
];
---

<section class="pricing-section" id="pricing">
  <div class="container">
    <div class="pricing-header reveal">
      <p class="section-label scramble-text">Engagement Models</p>
      <h2 class="section-title">Built Around<br>Your Growth Goals.</h2>
      <p class="section-subtitle">No hidden fees. No surprise invoices. You know exactly what you are investing — and exactly what you are getting back. Every package is designed to pay for itself.</p>
    </div>

    <div class="pricing-grid stagger-children">
      {plans.map(plan => (
        <div class:list={['pricing-card', 'stagger-item', 'tilt-card', { highlight: plan.highlight }]}>
          {plan.highlight && <div class="pricing-badge">Recommended</div>}
          <div class="pricing-name">{plan.name}</div>
          <div class="pricing-desc">{plan.desc}</div>
          <div class="pricing-price">
            {plan.price}
            <span>/{plan.period}</span>
          </div>
          <ul class="pricing-features">
            {plan.features.map(f => (
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                {f}
              </li>
            ))}
          </ul>
          <a href="https://cal.com/rachit-nand-ud0itz/30min" target="_blank" rel="noopener" class:list={['pricing-cta', 'magnetic', { primary: plan.highlight }]}>{plan.cta}</a>
        </div>
      ))}
    </div>

    <div class="pricing-note reveal">
      <p>Not sure which is right? <a href="https://cal.com/rachit-nand-ud0itz/30min" target="_blank" rel="noopener">Book a free call</a> and we will recommend the exact package for your goals and budget. Every project comes with a 100% satisfaction guarantee.</p>
    </div>
  </div>
</section>

<style>
  .pricing-section {
    padding: 160px 0;
    background: var(--bg-primary);
    position: relative;
  }

  .pricing-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }

  .pricing-header {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 100px;
  }

  .pricing-header .section-title {
    margin-left: auto;
    margin-right: auto;
  }

  .pricing-header .section-subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 1060px;
    margin: 0 auto;
    align-items: start;
  }

  .pricing-card {
    background: linear-gradient(180deg, rgba(17, 24, 39, 0.6) 0%, rgba(5, 8, 22, 0.4) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    padding: 44px 28px;
    position: relative;
    transition: all 0.5s var(--transition);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    transform-style: preserve-3d;
    will-change: transform;
  }

  .pricing-card:hover {
    border-color: rgba(255, 255, 255, 0.15);
    background: linear-gradient(180deg, rgba(17, 24, 39, 0.8) 0%, rgba(5, 8, 22, 0.6) 100%);
    transform: perspective(1000px) translateY(-4px);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.3);
  }

  .pricing-card.highlight {
    border-color: rgba(59, 130, 246, 0.25);
    background: linear-gradient(180deg, rgba(59, 130, 246, 0.08) 0%, rgba(5, 8, 22, 0.5) 100%);
    box-shadow: 0 20px 60px rgba(59, 130, 246, 0.1);
  }

  .pricing-card.highlight:hover {
    border-color: rgba(59, 130, 246, 0.4);
    box-shadow: 0 24px 60px rgba(59, 130, 246, 0.2);
  }

  .pricing-badge {
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
    color: white;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 6px 16px;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
  }

  .pricing-name {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 6px;
    color: var(--text-primary);
  }

  .pricing-desc {
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 24px;
    min-height: 36px;
  }

  .pricing-price {
    font-family: var(--font-heading);
    font-size: 36px;
    font-weight: 700;
    margin-bottom: 28px;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, var(--text-primary) 0%, var(--accent-primary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .pricing-price span {
    font-size: 14px;
    color: var(--text-muted);
    font-weight: 500;
    -webkit-text-fill-color: var(--text-muted);
    background: none;
  }

  .pricing-features {
    list-style: none;
    margin-bottom: 36px;
  }

  .pricing-features li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 9px 0;
    font-size: 14px;
    color: var(--text-secondary);
    border-bottom: 1px solid var(--border);
  }

  .pricing-features li:last-child {
    border-bottom: none;
  }

  .pricing-features svg {
    color: var(--accent-primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .pricing-cta {
    display: block;
    width: 100%;
    text-align: center;
    padding: 14px;
    border-radius: var(--radius-md);
    font-size: 14px;
    font-weight: 600;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-primary);
    transition: all 0.35s;
    text-decoration: none;
    position: relative;
    overflow: hidden;
  }

  .pricing-cta:hover {
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.04);
  }

  .pricing-cta.primary {
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
    border-color: transparent;
    color: white;
  }

  .pricing-cta.primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(59, 130, 246, 0.3);
  }

  .pricing-note {
    text-align: center;
    margin-top: 56px;
    font-size: 14px;
    color: var(--text-muted);
  }

  .pricing-note a {
    color: var(--accent-primary);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.3s;
  }

  .pricing-note a:hover {
    color: var(--accent-secondary);
  }

  @media (max-width: 1024px) {
    .pricing-header { text-align: center; margin: 0 auto 80px; }
    .pricing-grid { grid-template-columns: 1fr; max-width: 420px; }
    .pricing-card.highlight { order: -1; }
  }

  @media (max-width: 640px) {
    .pricing-section { padding: 100px 0; }
  }
</style>