---
import { SITE, NAV, SECTIONS } from '../data/site.js';

export interface Props {
  /** Compact masthead for article and guide pages: no promo strip. */
  compact?: boolean;
}
const { compact = false } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

{!compact && (
  <div class="promo">
    <div class="container promo__inner">
      <span class="promo__dot" aria-hidden="true"></span>
      <span>Independent · nothing for sale · a free SEO email every other week</span>
      <a class="promo__cta" href="/newsletter/">Join free →</a>
    </div>
  </div>
)}

<header class:list={['nav', compact && 'nav--compact']} id="siteNav">
  <div class="container nav__inner">
    <a href="/" class="brand" aria-label={`${SITE.name} home`}>
      <span class="brand__mark" aria-hidden="true">OC</span>
      <span class="brand__name">{SITE.name}</span>
    </a>

    <button class="nav__toggle" id="navToggle" aria-label="Open menu" aria-expanded="false" aria-controls="navMenu">
      <span></span><span></span><span></span>
    </button>

    <nav class="nav__menu" id="navMenu" aria-label="Main">
      <div class="nav__links">
        {NAV.map((item) =>
          item.label === 'Topics' ? (
            <div class="nav__item nav__item--has-menu">
              <a href={item.href} class:list={['nav__link', isActive(item.href) && 'is-active']}>
                {item.label}
                <svg class="nav__chev" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              </a>
              <div class="nav__drop">
                {SECTIONS.map((s) => (
                  <a class="nav__drop-item" href={`/blog/category/${s.slug}/`}>
                    <span class="nav__drop-name">{s.name}</span>
                    <span class="nav__drop-blurb">{s.blurb}</span>
                  </a>
                ))}
                <a class="nav__drop-item nav__drop-item--all" href="/topics/">Every topic we cover →</a>
              </div>
            </div>
          ) : (
            <a href={item.href} class:list={['nav__link', isActive(item.href) && 'is-active']}>{item.label}</a>
          )
        )}
      </div>
      <a href="/newsletter/" class="nav__cta">Get the newsletter</a>
    </nav>
  </div>
</header>

<style>
  /* ── Promo strip ── */
  .promo {
    background: var(--ink);
    color: rgba(255, 255, 255, 0.82);
    font-family: var(--font-ui);
    font-size: 13px;
  }
  .promo__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 40px;
    text-align: center;
  }
  .promo__dot {
    width: 7px; height: 7px; border-radius: 999px;
    background: #7BE5A8; flex: none;
  }
  .promo__cta { color: #fff; font-weight: 600; }
  .promo__cta:hover { text-decoration: underline; }

  /* ── Nav bar ── */
  .nav {
    position: sticky;
    top: 0;
    z-index: 900;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--rule);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 72px;
  }
  .nav--compact .nav__inner { height: 64px; }

  .brand { display: inline-flex; align-items: center; gap: 10px; }
  .brand__mark {
    display: grid;
    place-items: center;
    width: 34px; height: 34px;
    border-radius: 9px;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 13.5px;
    letter-spacing: 0.02em;
  }
  .brand__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 21px;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .nav__menu { display: flex; align-items: center; gap: 22px; }
  .nav__links { display: flex; align-items: center; gap: 4px; }
  .nav__item { position: relative; }

  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 500;
    color: var(--ink-2);
    padding: 9px 12px;
    border-radius: 8px;
    transition: color 0.18s var(--ease), background 0.18s var(--ease);
  }
  .nav__link:hover { color: var(--ink); background: var(--paper-2); }
  .nav__link.is-active { color: var(--accent); font-weight: 600; }
  .nav__chev { opacity: 0.6; transition: transform 0.2s var(--ease); }
  .nav__item--has-menu:hover .nav__chev { transform: rotate(180deg); }

  /* Dropdown */
  .nav__drop {
    position: absolute;
    top: calc(100% + 10px);
    left: -8px;
    width: 340px;
    padding: 8px;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.18s var(--ease), transform 0.18s var(--ease), visibility 0.18s;
  }
  .nav__item--has-menu:hover .nav__drop,
  .nav__item--has-menu:focus-within .nav__drop {
    opacity: 1; visibility: visible; transform: translateY(0);
  }
  .nav__drop-item {
    display: block;
    padding: 11px 12px;
    border-radius: 10px;
    transition: background 0.16s var(--ease);
  }
  .nav__drop-item:hover { background: var(--paper-2); }
  .nav__drop-name {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    color: var(--ink);
  }
  .nav__drop-blurb {
    display: block;
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-3);
    margin-top: 3px;
  }
  .nav__drop-item--all {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--accent);
    border-top: 1px solid var(--rule);
    border-radius: 0 0 10px 10px;
    margin-top: 4px;
  }

  .nav__cta {
    padding: 11px 18px;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-ui);
    font-size: 14.5px;
    font-weight: 600;
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    transition: background 0.2s var(--ease), transform 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .nav__cta:hover { background: var(--accent-deep); transform: translateY(-1px); box-shadow: var(--shadow); }

  .nav__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px; height: 42px;
    background: none;
    border: 1px solid var(--rule);
    border-radius: 10px;
    cursor: pointer;
  }
  .nav__toggle span {
    display: block; width: 18px; height: 1.8px;
    margin: 0 auto; border-radius: 2px; background: var(--ink);
    transition: transform 0.25s var(--ease), opacity 0.2s var(--ease);
  }
  .nav__toggle.is-open span:nth-child(1) { transform: translateY(6.8px) rotate(45deg); }
  .nav__toggle.is-open span:nth-child(2) { opacity: 0; }
  .nav__toggle.is-open span:nth-child(3) { transform: translateY(-6.8px) rotate(-45deg); }

  @media (max-width: 940px) {
    .nav__toggle { display: flex; }
    .nav__menu {
      display: none;
      position: absolute;
      left: 0; right: 0; top: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--paper);
      border-bottom: 1px solid var(--rule);
      padding: 10px 20px 22px;
      box-shadow: var(--shadow-lg);
    }
    .nav__menu.is-open { display: flex; }
    .nav__links { flex-direction: column; align-items: stretch; gap: 0; }
    .nav__link {
      padding: 14px 0;
      font-size: 17px;
      border-bottom: 1px solid var(--rule);
      border-radius: 0;
      justify-content: space-between;
    }
    .nav__link:hover { background: none; }
    .nav__drop {
      position: static;
      opacity: 1; visibility: visible; transform: none;
      width: auto; box-shadow: none; border: none; padding: 4px 0 10px;
      border-bottom: 1px solid var(--rule);
    }
    .nav__drop-blurb { display: none; }
    .nav__cta { margin-top: 18px; text-align: center; }
  }
  @media (max-width: 600px) {
    .promo__inner span:not(.promo__dot) { font-size: 12px; }
    .promo__cta { display: none; }
  }
</style>

<script is:inline>
  (function () {
    var toggle = document.getElementById('navToggle');
    var menu = document.getElementById('navMenu');
    if (!toggle || !menu) return;
    toggle.addEventListener('click', function () {
      var open = menu.classList.toggle('is-open');
      toggle.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
  })();
</script>
