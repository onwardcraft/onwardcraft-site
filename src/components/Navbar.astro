---
const serviceLinks = [
  { label: 'Web Design', href: '/services/web-design' },
  { label: 'SEO', href: '/services/seo' },
  { label: 'Lead Generation', href: '/services/lead-generation' },
];

const navLinks = [
  { label: 'Work', href: '/case-studies' },
  { label: 'Process', href: '/process' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Blog', href: '/blog' },
  { label: 'About', href: '/about' },
];
---

<nav class="navbar" id="navbar">
  <div class="navbar-pill">
    <a href="/" class="nav-brand">
      <img src="/logo/logo.svg" alt="OnwardCraft" height="28" class="brand-logo" />
    </a>

    <div class="nav-links" id="navLinks">
      <div class="nav-dropdown">
        <a href="#services" class="nav-link">Services</a>
        <div class="dropdown-menu">
          {serviceLinks.map(link => (
            <a href={link.href} class="dropdown-item">{link.label}</a>
          ))}
        </div>
      </div>
      {navLinks.map(link => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
    </div>

    <div class="nav-actions">
      <a href="https://cal.com/rachit-nand-ud0itz/30min" target="_blank" rel="noopener" class="nav-cta">
        <span>Book Call</span>
        <svg class="cta-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      <button class="nav-mobile-toggle" id="mobileToggle" aria-label="Menu">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Menu Overlay -->
<div class="mobile-overlay" id="mobileOverlay">
  <div class="mobile-menu-content">
    <div class="mobile-links">
      <a href="#services" class="mobile-link">Services</a>
      {serviceLinks.map(link => (
        <a href={link.href} class="mobile-link mobile-sublink">{link.label}</a>
      ))}
      {navLinks.map(link => (
        <a href={link.href} class="mobile-link">{link.label}</a>
      ))}
    </div>
    <a href="https://cal.com/rachit-nand-ud0itz/30min" target="_blank" rel="noopener" class="mobile-cta">Book a Free Strategy Call</a>
  </div>
</div>

<style>
  .navbar {
    position: fixed;
    top: 16px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    width: 100%;
    max-width: var(--container);
    padding: 0 32px;
    opacity: 0;
    animation: navSlideDown 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.6s forwards;
  }

  @keyframes navSlideDown {
    from { opacity: 0; transform: translateX(-50%) translateY(-20px); }
    to { opacity: 1; transform: translateX(-50%) translateY(0); }
  }

  .navbar-pill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 20px;
    border-radius: 100px;
    background: transparent;
    border: 1px solid transparent;
    transition: all 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .navbar.scrolled .navbar-pill {
    background: rgba(5, 8, 22, 0.7);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-color: rgba(255, 255, 255, 0.08);
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.3),
      0 0 0 1px rgba(255, 255, 255, 0.04),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .nav-brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    padding: 4px 8px;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    opacity: 0;
    animation: navItemIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.8s forwards;
    flex-shrink: 0;
  }

  .nav-brand:hover {
    transform: scale(1.03);
  }

  .brand-logo {
    height: 28px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 0 8px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .nav-link {
    position: relative;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    padding: 10px 18px;
    border-radius: 100px;
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    opacity: 0;
    animation: navItemIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .nav-link:nth-child(1) { animation-delay: 0.85s; }
  .nav-link:nth-child(2) { animation-delay: 0.9s; }
  .nav-link:nth-child(3) { animation-delay: 0.95s; }
  .nav-link:nth-child(4) { animation-delay: 1.0s; }
  .nav-link:nth-child(5) { animation-delay: 1.05s; }
  .nav-link:nth-child(6) { animation-delay: 1.1s; }

  @keyframes navItemIn {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .nav-link::before {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 50%;
    transform: translateX(-50%) scale(0);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent-primary);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-link:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.04);
  }

  .nav-link:hover::before,
  .nav-link.active::before {
    transform: translateX(-50%) scale(1);
  }

  .nav-link.active {
    color: var(--text-primary);
    font-weight: 600;
  }

  /* Dropdown */
  .nav-dropdown {
    position: relative;
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%) translateY(-6px) scale(0.96);
    background: rgba(5, 8, 22, 0.92);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    padding: 8px;
    min-width: 200px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.5);
  }

  .nav-dropdown:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  .dropdown-item {
    display: block;
    padding: 10px 16px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
    border-radius: var(--radius-sm);
    transition: all 0.2s;
    white-space: nowrap;
  }

  .dropdown-item:hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-primary);
  }

  /* CTA */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    opacity: 0;
    animation: navItemIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) 1.15s forwards;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 18px;
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
    color: white;
    font-size: 13px;
    font-weight: 600;
    border-radius: 100px;
    transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(59, 130, 246, 0.2);
  }

  .nav-cta::before {
    content: '';
    position: absolute;
    inset: -2px;
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary), var(--accent-glow));
    border-radius: inherit;
    z-index: -1;
    opacity: 0;
    transition: opacity 0.4s;
    filter: blur(12px);
  }

  .nav-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 20px rgba(59, 130, 246, 0.35);
  }

  .nav-cta:hover::before {
    opacity: 0.5;
  }

  .nav-cta:hover .cta-arrow {
    transform: translateX(3px);
  }

  .cta-arrow {
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    flex-shrink: 0;
  }

  /* Mobile Toggle */
  .nav-mobile-toggle {
    display: none;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px 6px;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    position: relative;
    z-index: 1002;
  }

  .hamburger-line {
    display: block;
    width: 20px;
    height: 1.5px;
    background: var(--text-primary);
    border-radius: 2px;
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    transform-origin: center;
  }

  .nav-mobile-toggle.active .hamburger-line:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .nav-mobile-toggle.active .hamburger-line:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* Mobile Overlay */
  .mobile-overlay {
    position: fixed;
    inset: 0;
    z-index: 999;
    background: rgba(5, 8, 22, 0.85);
    backdrop-filter: blur(30px) saturate(150%);
    -webkit-backdrop-filter: blur(30px) saturate(150%);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1), visibility 0.5s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mobile-overlay.active {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
  }

  .mobile-menu-content {
    text-align: center;
    padding: 40px;
  }

  .mobile-links {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 40px;
  }

  .mobile-link {
    font-family: var(--font-heading);
    font-size: 32px;
    font-weight: 700;
    color: var(--text-primary);
    padding: 8px;
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    display: block;
  }

  .mobile-overlay.active .mobile-link {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-overlay.active .mobile-link:nth-child(1) { transition-delay: 0.05s; }
  .mobile-overlay.active .mobile-link:nth-child(2) { transition-delay: 0.1s; }
  .mobile-overlay.active .mobile-link:nth-child(3) { transition-delay: 0.15s; }
  .mobile-overlay.active .mobile-link:nth-child(4) { transition-delay: 0.2s; }
  .mobile-overlay.active .mobile-link:nth-child(5) { transition-delay: 0.25s; }
  .mobile-overlay.active .mobile-link:nth-child(6) { transition-delay: 0.3s; }
  .mobile-overlay.active .mobile-link:nth-child(7) { transition-delay: 0.35s; }
  .mobile-overlay.active .mobile-link:nth-child(8) { transition-delay: 0.4s; }
  .mobile-overlay.active .mobile-link:nth-child(9) { transition-delay: 0.45s; }

  .mobile-sublink {
    font-size: 18px;
    font-weight: 500;
    color: var(--text-secondary);
    padding: 4px;
  }

  .mobile-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 32px;
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
    color: white;
    font-size: 15px;
    font-weight: 600;
    border-radius: 100px;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.5s;
  }

  .mobile-overlay.active .mobile-cta {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 900px) {
    .navbar {
      top: 12px;
      padding: 0 16px;
      animation: navSlideDown 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.6s forwards;
    }

    .navbar-pill {
      padding: 10px 16px;
      background: rgba(5, 8, 22, 0.7);
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      border-color: rgba(255, 255, 255, 0.08);
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
    }

    .nav-links {
      display: none;
    }

    .nav-cta {
      display: none;
    }

    .nav-mobile-toggle {
      display: flex;
    }

    .mobile-link {
      font-size: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar,
    .nav-brand,
    .nav-link,
    .nav-actions {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .mobile-link,
    .mobile-cta {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script is:inline>
  (function() {
    const toggle = document.getElementById('mobileToggle');
    const overlay = document.getElementById('mobileOverlay');
    const navbar = document.getElementById('navbar');

    if (toggle && overlay) {
      toggle.addEventListener('click', () => {
        toggle.classList.toggle('active');
        overlay.classList.toggle('active');
        document.body.style.overflow = overlay.classList.contains('active') ? 'hidden' : '';
      });

      overlay.querySelectorAll('.mobile-link, .mobile-cta').forEach((link) => {
        link.addEventListener('click', () => {
          toggle.classList.remove('active');
          overlay.classList.remove('active');
          document.body.style.overflow = '';
        });
      });
    }

    // Scroll state
    if (navbar) {
      let lastScroll = 0;
      window.addEventListener('scroll', () => {
        const currentScroll = window.scrollY;
        navbar.classList.toggle('scrolled', currentScroll > 40);
        lastScroll = currentScroll;
      }, { passive: true });
    }
  })();
</script>
