---
import { industries } from '../data/industries.js';

const { dark = false } = Astro.props;

const serviceLinks = [
  { label: 'Web Design', href: '/services/web-design/' },
  { label: 'SEO', href: '/services/seo/' },
  { label: 'Lead Generation', href: '/services/lead-generation/' },
];

const industryLinks = industries.map((i) => ({ label: i.trade, href: `/industries/${i.slug}/` }));

const navLinks = [
  { label: 'Work', href: '/case-studies/' },
  { label: 'Locations', href: '/locations/' },
  { label: 'Pricing', href: '/pricing/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'About', href: '/about/' },
];

const darkPillStyle = dark
  ? 'background:#0B1020;border-color:rgba(255,255,255,0.1);box-shadow:0 4px 24px rgba(0,0,0,0.3),0 0 0 1px rgba(255,255,255,0.04),inset 0 1px 0 rgba(255,255,255,0.05);'
  : '';
---

<nav class="navbar" id="navbar" data-dark={dark ? 'true' : undefined}>
  <div class="navbar-pill" style={darkPillStyle}>
    <a href="/" class="nav-brand">
      <img src="/logo/logo-nav.png" alt="OnwardCraft" width="168" height="28" loading="eager" decoding="async" class="brand-logo" />
    </a>

    <div class="nav-links" id="navLinks">
      <div class="nav-dropdown">
        <a href="/services/" class="nav-link">Services</a>
        <div class="dropdown-menu">
          {serviceLinks.map(link => (
            <a href={link.href} class="dropdown-item">{link.label}</a>
          ))}
        </div>
      </div>
      <div class="nav-dropdown">
        <a href="/industries/" class="nav-link">Industries</a>
        <div class="dropdown-menu">
          {industryLinks.map(link => (
            <a href={link.href} class="dropdown-item">{link.label}</a>
          ))}
        </div>
      </div>
      {navLinks.map(link => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
    </div>

    <div class="nav-actions">
      <a href="/book-call/" class="nav-cta">
        <span>Book Free Audit</span>
        <svg class="cta-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      <button class="nav-mobile-toggle" id="mobileToggle" aria-label="Menu" aria-expanded="false" aria-controls="mobileOverlay">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Menu Overlay -->
<div class="mobile-overlay" id="mobileOverlay">
  <div class="mobile-menu-content">
    <div class="mobile-links">
      <a href="/services/" class="mobile-link">Services</a>
      {serviceLinks.map(link => (
        <a href={link.href} class="mobile-link mobile-sublink">{link.label}</a>
      ))}
      <a href="/industries/" class="mobile-link">Industries</a>
      {industryLinks.map(link => (
        <a href={link.href} class="mobile-link mobile-sublink">{link.label}</a>
      ))}
      {navLinks.map(link => (
        <a href={link.href} class="mobile-link">{link.label}</a>
      ))}
    </div>
    <a href="/book-call/" class="mobile-cta">Book Free Audit</a>
  </div>
</div>

<style>
  .navbar {
    position: fixed;
    top: 16px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    width: 100%;
    max-width: var(--container);
    padding: 0 40px;
  }

  .navbar-pill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 20px;
    border-radius: 100px;
    background: transparent;
    border: 1px solid transparent;
    transition: all 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .navbar.scrolled .navbar-pill {
    background: rgba(5, 8, 22, 0.7);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-color: rgba(255, 255, 255, 0.08);
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.3),
      0 0 0 1px rgba(255, 255, 255, 0.04),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .nav-brand {
    display: flex;
    align-items: center;
    text-decoration: none;
    padding: 4px 8px;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    flex-shrink: 0;
  }

  .nav-brand:hover {
    transform: scale(1.03);
  }

  .brand-logo {
    height: 28px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 0 8px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .nav-link {
    position: relative;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    padding: 10px 18px;
    border-radius: 100px;
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-link:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.04);
  }

  .nav-link.active {
    color: var(--text-primary);
    font-weight: 600;
  }

  /* Dropdown */
  .nav-dropdown {
    position: relative;
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%) translateY(-6px) scale(0.96);
    background: rgba(5, 8, 22, 0.92);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    padding: 8px;
    min-width: 200px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.5);
  }

  .nav-dropdown:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  .dropdown-item {
    display: block;
    padding: 10px 16px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
    border-radius: var(--radius-sm);
    transition: all 0.2s;
    white-space: nowrap;
  }

  .dropdown-item:hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-primary);
  }

  /* CTA */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 22px;
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
    color: white;
    font-size: 14px;
    font-weight: 600;
    border-radius: 100px;
    transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 20px rgba(6, 214, 160, 0.3);
  }

  .nav-cta:hover .cta-arrow {
    transform: translateX(3px);
  }

  .cta-arrow {
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    flex-shrink: 0;
  }

  /* Mobile Toggle */
  .nav-mobile-toggle {
    display: none;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px 6px;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    position: relative;
    z-index: 1002;
  }

  .hamburger-line {
    display: block;
    width: 20px;
    height: 1.5px;
    background: var(--text-primary);
    border-radius: 2px;
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    transform-origin: center;
  }

  .nav-mobile-toggle.active .hamburger-line:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .nav-mobile-toggle.active .hamburger-line:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* Mobile Overlay */
  .mobile-overlay {
    position: fixed;
    inset: 0;
    z-index: 999;
    background: rgba(5, 8, 22, 0.9);
    backdrop-filter: blur(30px) saturate(150%);
    -webkit-backdrop-filter: blur(30px) saturate(150%);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1), visibility 0.5s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mobile-overlay.active {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
  }

  .mobile-menu-content {
    text-align: center;
    padding: 40px;
  }

  .mobile-links {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 40px;
  }

  .mobile-link {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 700;
    color: var(--text-primary);
    padding: 8px;
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    display: block;
  }

  .mobile-overlay.active .mobile-link {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-overlay.active .mobile-link:nth-child(1) { transition-delay: 0.05s; }
  .mobile-overlay.active .mobile-link:nth-child(2) { transition-delay: 0.1s; }
  .mobile-overlay.active .mobile-link:nth-child(3) { transition-delay: 0.15s; }
  .mobile-overlay.active .mobile-link:nth-child(4) { transition-delay: 0.2s; }
  .mobile-overlay.active .mobile-link:nth-child(5) { transition-delay: 0.25s; }
  .mobile-overlay.active .mobile-link:nth-child(6) { transition-delay: 0.3s; }
  .mobile-overlay.active .mobile-link:nth-child(7) { transition-delay: 0.35s; }
  .mobile-overlay.active .mobile-link:nth-child(8) { transition-delay: 0.4s; }
  .mobile-overlay.active .mobile-link:nth-child(9) { transition-delay: 0.45s; }

  .mobile-sublink {
    font-size: 16px;
    font-weight: 500;
    color: var(--text-secondary);
    padding: 4px;
  }

  .mobile-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 32px;
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
    color: white;
    font-size: 15px;
    font-weight: 600;
    border-radius: 100px;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.5s;
  }

  .mobile-overlay.active .mobile-cta {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 900px) {
    .navbar {
      top: 12px;
      padding: 0 20px;
    }

    .navbar-pill {
      padding: 10px 16px;
      background: rgba(5, 8, 22, 0.7);
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      border-color: rgba(255, 255, 255, 0.08);
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
    }

    .nav-links {
      display: none;
    }

    .nav-cta {
      display: none;
    }

    .nav-mobile-toggle {
      display: flex;
    }
  }
</style>

<script is:inline>
  (function() {
    const toggle = document.getElementById('mobileToggle');
    const overlay = document.getElementById('mobileOverlay');
    const navbar = document.getElementById('navbar');

    if (toggle && overlay) {
      toggle.addEventListener('click', () => {
        toggle.classList.toggle('active');
        overlay.classList.toggle('active');
        const open = overlay.classList.contains('active');
        toggle.setAttribute('aria-expanded', String(open));
        document.body.style.overflow = open ? 'hidden' : '';
      });

      overlay.querySelectorAll('.mobile-link, .mobile-cta').forEach((link) => {
        link.addEventListener('click', () => {
          toggle.classList.remove('active');
          overlay.classList.remove('active');
          toggle.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        });
      });
    }

    // Scroll state — skip for dark/blog pages
    if (navbar && !navbar.hasAttribute('data-dark')) {
      let lastScroll = 0;
      window.addEventListener('scroll', () => {
        const currentScroll = window.scrollY;
        navbar.classList.toggle('scrolled', currentScroll > 40);
        lastScroll = currentScroll;
      }, { passive: true });
    }
  })();
</script>
