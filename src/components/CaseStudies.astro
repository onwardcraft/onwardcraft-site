---
const cases = [
  {
    company: 'The Free 48-Hour Audit',
    industry: 'Step 01',
    metric: '48hr',
    metricLabel: 'Turnaround',
    beforeDesc: "You hand us your site and your target market. No contract, no card, no pressure.",
    afterDesc: "Within 48 hours you get a personal video teardown showing exactly where you're losing jobs and what we'd fix first.",
    beforeShort: 'No cost',
    afterShort: 'Clear plan',
    tags: ['Free Video Audit', 'Conversion Teardown', 'No Obligation'],
  },
  {
    company: 'Founder-Led Build',
    industry: 'Step 02',
    metric: '<2s',
    metricLabel: 'Load Time',
    beforeDesc: 'Most agencies outsource your project to whoever is cheapest that week.',
    afterDesc: "We build it ourselves on Astro — sub-2-second load, conversion-first layout, and SEO baked into the foundation. Fixed, transparent pricing.",
    beforeShort: 'Outsourced',
    afterShort: 'Founder-built',
    tags: ['Astro Performance', 'Conversion-First', 'Fixed Pricing'],
  },
  {
    company: 'The Performance Guarantee',
    industry: 'Step 03',
    metric: '100%',
    metricLabel: 'Accountability',
    beforeDesc: "Most agencies launch your site, send the invoice, and disappear.",
    afterDesc: "We put it in writing: if your agreed metrics don't improve, we keep working until they do. Your win is the only definition of done.",
    beforeShort: 'Hand-off',
    afterShort: 'In writing',
    tags: ['Written Guarantee', 'Trades Focus', 'Ongoing Support'],
  },
];
---

<section class="cases-section" id="work">
  <div class="container">
    <div class="cases-header reveal">
      <p class="section-label">How We Work</p>
      <h2 class="section-title">No Fluff. Just a Clear Path to More Booked Jobs.</h2>
      <p class="section-subtitle">We're a founder-led studio built for the trades. Here's exactly what working with us looks like — from the free audit to the written guarantee that we stand behind.</p>
    </div>

    <div class="cases-list">
      {cases.map((c, i) => (
        <div class={`case-item ${i % 2 === 1 ? 'case-reverse' : ''} reveal`}>
          <div class="case-visual">
            <div class="case-metric-card">
              <span class="case-metric-label">{c.metricLabel}</span>
              <span class="case-metric-value">{c.metric}</span>
              <div class="case-metric-bar">
                <div class="case-metric-bar-fill" style={`width: ${Math.min(parseInt(c.metric) || 80, 100)}%`}></div>
              </div>
            </div>
          </div>

          <div class="case-content">
            <div class="case-meta">
              <span class="case-industry">{c.industry}</span>
            </div>
            <h3>{c.company}</h3>
            <div class="case-transformation">
              <div class="transform-block transform-before">
                <span class="transform-label">Before</span>
                <p>{c.beforeDesc}</p>
              </div>
              <div class="transform-arrow">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </div>
              <div class="transform-block transform-after">
                <span class="transform-label">After</span>
                <p>{c.afterDesc}</p>
              </div>
            </div>
            <div class="case-tags">
              {c.tags.map(tag => (
                <span class="case-tag">{tag}</span>
              ))}
            </div>
            <a href="/book-call/" class="case-link">
              Start With a Free Audit
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .cases-section {
    padding: 180px 0;
    position: relative;
  }

  .cases-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 100px;
  }

  .cases-header .section-title {
    margin-left: auto;
    margin-right: auto;
  }

  .cases-header .section-subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  .case-item {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
    margin-bottom: 120px;
  }

  .case-item:last-child {
    margin-bottom: 0;
  }

  .case-reverse {
    direction: rtl;
  }

  .case-reverse > * {
    direction: ltr;
  }

  .case-visual {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .case-metric-card {
    background: rgba(17, 24, 39, 0.6);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 48px;
    text-align: center;
    width: 100%;
    max-width: 340px;
  }

  .case-metric-label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 12px;
  }

  .case-metric-value {
    display: block;
    font-family: var(--font-heading);
    font-size: 56px;
    font-weight: 700;
    color: var(--accent-primary);
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: 20px;
  }

  .case-metric-bar {
    height: 4px;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 2px;
    overflow: hidden;
  }

  .case-metric-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent-primary), var(--accent-secondary));
    border-radius: 2px;
    transition: width 1s var(--transition);
  }

  .case-content h3 {
    font-size: 36px;
    font-weight: 700;
    margin-bottom: 20px;
    letter-spacing: -0.03em;
  }

  .case-meta {
    display: flex;
    gap: 16px;
    margin-bottom: 16px;
    align-items: center;
  }

  .case-industry {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 5px 14px;
    border-radius: 100px;
    background: rgba(6, 214, 160, 0.08);
    border: 1px solid rgba(6, 214, 160, 0.15);
    color: var(--accent-primary);
  }

  .case-year {
    font-size: 13px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .case-transformation {
    margin-bottom: 24px;
  }

  .transform-block {
    padding: 16px 20px;
    border-radius: var(--radius-md);
    background: rgba(17, 24, 39, 0.4);
    border: 1px solid var(--border);
    margin-bottom: 12px;
  }

  .transform-before {
    border-left: 3px solid rgba(239, 68, 68, 0.5);
  }

  .transform-after {
    border-left: 3px solid var(--accent-primary);
  }

  .transform-label {
    display: block;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 6px;
  }

  .transform-block p {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .transform-arrow {
    display: flex;
    justify-content: center;
    padding: 4px 0;
    color: var(--text-muted);
  }

  .case-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .case-tag {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    padding: 5px 12px;
    border-radius: 100px;
  }

  .case-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-primary);
    transition: gap 0.3s, color 0.3s;
  }

  .case-link:hover {
    gap: 12px;
    color: var(--accent-secondary);
  }

  @media (max-width: 1024px) {
    .cases-header { text-align: center; margin: 0 auto 64px; }
    .case-item,
    .case-reverse {
      grid-template-columns: 1fr;
      direction: ltr;
      gap: 40px;
      margin-bottom: 80px;
    }
    .case-item > * { direction: ltr; }
    .case-metric-card { padding: 36px; }
    .case-metric-value { font-size: 44px; }
    .case-content h3 { font-size: 28px; }
  }

  @media (max-width: 640px) {
    .cases-section { padding: 100px 0; }
    .case-metric-card { padding: 28px; }
    .case-metric-value { font-size: 36px; }
    .case-content h3 { font-size: 24px; }
    .cases-header { margin-bottom: 48px; }
  }
</style>
