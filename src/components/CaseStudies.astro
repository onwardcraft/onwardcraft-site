---
const cases = [
  {
    company: 'Roofing Company',
    industry: 'Home Services',
    metric: '+412%',
    metricLabel: 'Qualified Leads',
    beforeDesc: 'Website from 2015. Zero SEO. 12 cold leads per month. Dead in the water.',
    afterDesc: 'Conversion engine. #1 local rankings. 62 qualified leads per month — on autopilot.',
    beforeShort: '12 leads/mo',
    afterShort: '62 leads/mo',
    tags: ['Local SEO', 'Lead Funnel', 'Conversion Design'],
  },
  {
    company: 'B2B SaaS Platform',
    industry: 'SaaS',
    metric: '4.9x',
    metricLabel: 'ROAS',
    beforeDesc: '2.1% trial conversion. Users signing up and vanishing. No system to keep them.',
    afterDesc: '8.7% trial conversion. Onboarding that hooks. Retention that compounds.',
    beforeShort: '2.1% convert',
    afterShort: '8.7% convert',
    tags: ['Onboarding Flow', 'CRO', 'Paid Acquisition'],
  },
  {
    company: 'Healthcare Provider',
    industry: 'Healthcare',
    metric: '+267%',
    metricLabel: 'Organic Traffic',
    beforeDesc: 'Invisible on Google. Patients going to competitors. Marketing budget wasted on ads.',
    afterDesc: 'Top 3 for 40+ keywords. Organic traffic tripled. Appointments — not inquiries — tripled.',
    beforeShort: 'Invisible',
    afterShort: 'Top 3 ranks',
    tags: ['Healthcare SEO', 'Content System', 'Local Search'],
  },
];
---

<section class="cases-section" id="work">
  <div class="container">
    <div class="cases-header reveal">
      <p class="section-label">Proven Results</p>
      <h2 class="section-title">From Invisible to Dominant</h2>
      <p class="section-subtitle">Real clients. Real industries. Real revenue growth. These are not cherry-picked outliers — they are typical outcomes when strategy and execution align.</p>
    </div>

    <div class="cases-list">
      {cases.map((c, i) => (
        <div class={`case-item ${i % 2 === 1 ? 'case-reverse' : ''} reveal`}>
          <div class="case-visual">
            <div class="case-metric-card">
              <span class="case-metric-label">{c.metricLabel}</span>
              <span class="case-metric-value">{c.metric}</span>
              <div class="case-metric-bar">
                <div class="case-metric-bar-fill" style={`width: ${Math.min(parseInt(c.metric) || 80, 100)}%`}></div>
              </div>
            </div>
          </div>

          <div class="case-content">
            <div class="case-meta">
              <span class="case-industry">{c.industry}</span>
              <span class="case-year">2025</span>
            </div>
            <h3>{c.company}</h3>
            <div class="case-transformation">
              <div class="transform-block transform-before">
                <span class="transform-label">Before</span>
                <p>{c.beforeDesc}</p>
              </div>
              <div class="transform-arrow">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </div>
              <div class="transform-block transform-after">
                <span class="transform-label">After</span>
                <p>{c.afterDesc}</p>
              </div>
            </div>
            <div class="case-tags">
              {c.tags.map(tag => (
                <span class="case-tag">{tag}</span>
              ))}
            </div>
            <a href="/case-studies/" class="case-link">
              Read Full Case Study
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .cases-section {
    padding: 180px 0;
    position: relative;
  }

  .cases-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 100px;
  }

  .cases-header .section-title {
    margin-left: auto;
    margin-right: auto;
  }

  .cases-header .section-subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  .case-item {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
    margin-bottom: 120px;
  }

  .case-item:last-child {
    margin-bottom: 0;
  }

  .case-reverse {
    direction: rtl;
  }

  .case-reverse > * {
    direction: ltr;
  }

  .case-visual {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .case-metric-card {
    background: rgba(17, 24, 39, 0.6);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 48px;
    text-align: center;
    width: 100%;
    max-width: 340px;
  }

  .case-metric-label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 12px;
  }

  .case-metric-value {
    display: block;
    font-family: var(--font-heading);
    font-size: 56px;
    font-weight: 700;
    color: var(--accent-primary);
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: 20px;
  }

  .case-metric-bar {
    height: 4px;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 2px;
    overflow: hidden;
  }

  .case-metric-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent-primary), var(--accent-secondary));
    border-radius: 2px;
    transition: width 1s var(--transition);
  }

  .case-content h3 {
    font-size: 36px;
    font-weight: 700;
    margin-bottom: 20px;
    letter-spacing: -0.03em;
  }

  .case-meta {
    display: flex;
    gap: 16px;
    margin-bottom: 16px;
    align-items: center;
  }

  .case-industry {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 5px 14px;
    border-radius: 100px;
    background: rgba(59, 130, 246, 0.08);
    border: 1px solid rgba(59, 130, 246, 0.15);
    color: var(--accent-primary);
  }

  .case-year {
    font-size: 13px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .case-transformation {
    margin-bottom: 24px;
  }

  .transform-block {
    padding: 16px 20px;
    border-radius: var(--radius-md);
    background: rgba(17, 24, 39, 0.4);
    border: 1px solid var(--border);
    margin-bottom: 12px;
  }

  .transform-before {
    border-left: 3px solid rgba(239, 68, 68, 0.5);
  }

  .transform-after {
    border-left: 3px solid var(--accent-primary);
  }

  .transform-label {
    display: block;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 6px;
  }

  .transform-block p {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .transform-arrow {
    display: flex;
    justify-content: center;
    padding: 4px 0;
    color: var(--text-muted);
  }

  .case-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .case-tag {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    padding: 5px 12px;
    border-radius: 100px;
  }

  .case-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-primary);
    transition: gap 0.3s, color 0.3s;
  }

  .case-link:hover {
    gap: 12px;
    color: var(--accent-secondary);
  }

  @media (max-width: 1024px) {
    .cases-header { text-align: center; margin: 0 auto 64px; }
    .case-item,
    .case-reverse {
      grid-template-columns: 1fr;
      direction: ltr;
      gap: 40px;
      margin-bottom: 80px;
    }
    .case-item > * { direction: ltr; }
    .case-metric-card { padding: 36px; }
    .case-metric-value { font-size: 44px; }
    .case-content h3 { font-size: 28px; }
  }

  @media (max-width: 640px) {
    .cases-section { padding: 100px 0; }
    .case-metric-card { padding: 28px; }
    .case-metric-value { font-size: 36px; }
    .case-content h3 { font-size: 24px; }
    .cases-header { margin-bottom: 48px; }
  }
</style>
