---
const features = [
  {
    title: 'Conversion-first, not design-first',
    desc: 'Every decision is filtered through one question: will this generate revenue? If not, it does not ship.',
  },
  {
    title: 'SEO built into the foundation',
    desc: 'Not an afterthought. Not a plugin. Semantic structure, schema markup, and content architecture that ranks before your first visitor arrives.',
  },
  {
    title: 'Sub-second performance',
    desc: 'A 1-second delay costs 7% of conversions. On a $50K/month funnel, that is $3,500 lost every month. We do not let that happen.',
  },
  {
    title: 'Data-driven iteration',
    desc: 'We do not launch and pray. We launch, measure, and refine. Every heatmap and click pattern feeds back into the system.',
  },
];

const stats = [
  { value: '100+', label: 'Projects Launched', desc: 'High-converting websites delivered' },
  { value: '$10M+', label: 'Revenue Influenced', desc: 'Revenue driven for our clients' },
  { value: '312%', label: 'Avg. Lead Increase', desc: 'Average lead growth within 90 days' },
  { value: '4.9', label: 'Client Satisfaction', desc: 'Out of 5.0 rating across all projects' },
];
---

<section class="whyus-section" id="why-us">
  <div class="container">
    <div class="whyus-header reveal">
      <p class="section-label">Why OnwardCraft</p>
      <h2 class="section-title">Pretty Loses. Profit Wins.</h2>
      <p class="section-subtitle">Most agencies sell you a trophy website. We engineer revenue machines. Here is what that actually means:</p>
    </div>

    <div class="whyus-grid">
      <div class="whyus-features reveal">
        {features.map((f, i) => (
          <div class="feature-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M20 6L9 17l-5-5"/>
            </svg>
            <div>
              <h4>{f.title}</h4>
              <p>{f.desc}</p>
            </div>
          </div>
        ))}
        <a href="https://calendly.com/getonwardcraft/30min" class="btn-primary" rel="noopener noreferrer">
          See If We Are a Fit
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <div class="whyus-stats reveal">
        {stats.map(s => (
          <div class="whyus-stat">
            <span class="whyus-stat-value">{s.value}</span>
            <span class="whyus-stat-label">{s.label}</span>
            <span class="whyus-stat-desc">{s.desc}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .whyus-section {
    padding: 180px 0;
    position: relative;
  }

  .whyus-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }

  .whyus-header {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 80px;
  }

  .whyus-header .section-title {
    margin-left: auto;
    margin-right: auto;
  }

  .whyus-header .section-subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  .whyus-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 80px;
    align-items: start;
  }

  .whyus-features {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .feature-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .feature-item svg {
    color: var(--accent-primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .feature-item h4 {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 6px;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .feature-item p {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .whyus-features .btn-primary {
    align-self: flex-start;
    margin-top: 8px;
    font-size: 15px;
    padding: 14px 28px;
  }

  .whyus-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  .whyus-stat {
    padding: 28px;
    background: rgba(17, 24, 39, 0.4);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    text-align: center;
    transition: all 0.3s var(--transition);
  }

  .whyus-stat:hover {
    border-color: var(--border-hover);
    background: rgba(17, 24, 39, 0.55);
  }

  .whyus-stat-value {
    display: block;
    font-family: var(--font-heading);
    font-size: 36px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: 8px;
  }

  .whyus-stat-label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .whyus-stat-desc {
    display: block;
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
  }

  @media (max-width: 1024px) {
    .whyus-grid {
      grid-template-columns: 1fr;
      gap: 60px;
    }
    .whyus-header { text-align: center; margin: 0 auto 60px; }
    .whyus-features { text-align: center; }
    .feature-item { text-align: left; }
    .whyus-features .btn-primary { align-self: center; }
    .whyus-stats { max-width: 480px; margin: 0 auto; }
  }

  @media (max-width: 640px) {
    .whyus-section { padding: 100px 0; }
    .whyus-stats { grid-template-columns: 1fr; }
    .feature-item h4 { font-size: 16px; }
    .feature-item p { font-size: 14px; }
  }
</style>
