---
const steps = [
  {
    num: '01',
    title: 'Diagnose the Leaks',
    desc: 'We find every dollar you are leaving on the table. Competitor analysis, funnel audits, and gap mapping — so we know exactly what to fix before we build a thing.',
  },
  {
    num: '02',
    title: 'Design to Convert',
    desc: 'Every headline, button, and scroll is engineered for one outcome: action. No pretty fluff. Just persuasion science applied to pixels.',
  },
  {
    num: '03',
    title: 'Build for Speed & Scale',
    desc: 'Sub-second load times. SEO architecture baked in. Code so clean Google smiles. Your site performs before a single visitor arrives.',
  },
  {
    num: '04',
    title: 'Launch & Keep Winning',
    desc: 'The launch is day one. We A/B test, optimize, and refine — so your results improve week over week, long after we have delivered.',
  },
];
---

<section class="process-section" id="process">
  <div class="container">
    <div class="process-header reveal">
      <p class="section-label scramble-text">Build Process</p>
      <h2 class="section-title">From Strategy<br>to Revenue.</h2>
      <p class="section-subtitle">No surprises. No scope creep. Just a proven 4-step system that turns your website from a liability into your hardest-working employee.</p>
    </div>

    <div class="process-layout">
      <!-- Left: Steps -->
      <div class="process-steps reveal">
        {steps.map((step, i) => (
          <div class="process-step" data-step={i}>
            <div class="step-line">
              <div class="step-line-bar"></div>
            </div>
            <div class="step-content">
              <span class="step-num">{step.num}</span>
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Right: Stats Dashboard -->
      <div class="process-mockup reveal">
        <div class="stats-dashboard">
          <div class="stats-dashboard-header">
            <span>Growth Analytics</span>
            <div class="live-dot"></div>
          </div>
          <div class="stats-dashboard-body">
            <!-- Main metric -->
            <div class="main-stat">
              <span class="main-stat-label">Monthly Revenue</span>
              <span class="main-stat-value">$124,890</span>
              <span class="main-stat-change">+23.5%</span>
            </div>
            <!-- Mini chart -->
            <div class="mini-chart">
              <div class="chart-bars">
                {[40, 55, 45, 70, 60, 85, 75, 90, 80, 95].map((h, j) => (
                  <div class="chart-bar" style={`height: ${h}%; animation-delay: ${j * 0.1}s`}></div>
                ))}
              </div>
            </div>
            <!-- Stat grid -->
            <div class="stat-grid">
              <div class="stat-grid-item">
                <span class="sg-label">Leads</span>
                <span class="sg-value">2,847</span>
                <span class="sg-change up">+18%</span>
              </div>
              <div class="stat-grid-item">
                <span class="sg-label">Conversion</span>
                <span class="sg-value">4.2%</span>
                <span class="sg-change up">+0.8%</span>
              </div>
              <div class="stat-grid-item">
                <span class="sg-label">Traffic</span>
                <span class="sg-value">67.8K</span>
                <span class="sg-change up">+31%</span>
              </div>
              <div class="stat-grid-item">
                <span class="sg-label">Bounce</span>
                <span class="sg-value">32%</span>
                <span class="sg-change down">-5%</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .process-section {
    padding: 160px 0;
    background: var(--bg-primary);
    position: relative;
    overflow: hidden;
  }

  .process-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }

  .process-header {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 100px;
  }

  .process-header .section-title {
    margin-left: auto;
    margin-right: auto;
  }

  .process-header .section-subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  .process-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: stretch;
  }

  /* Left Steps */
  .process-steps {
    position: relative;
  }

  .process-step {
    display: flex;
    gap: 24px;
    padding-bottom: 48px;
    position: relative;
    opacity: 0.6;
    transition: opacity 0.5s var(--transition);
  }

  .process-step.active {
    opacity: 1;
  }

  .process-step:last-child {
    padding-bottom: 0;
  }

  .step-line {
    position: relative;
    width: 2px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .step-line::before {
    content: '';
    position: absolute;
    top: 8px;
    bottom: 0;
    width: 1px;
    background: linear-gradient(180deg, rgba(59, 130, 246, 0.3), rgba(139, 92, 246, 0.1) 60%, transparent);
  }

  .process-step:last-child .step-line::before {
    display: none;
  }

  .step-line-bar {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-primary);
    box-shadow: 0 0 12px rgba(59, 130, 246, 0.4);
    position: relative;
    z-index: 1;
    margin-top: 6px;
    flex-shrink: 0;
    transition: all 0.4s var(--transition);
  }

  .process-step.active .step-line-bar {
    width: 12px;
    height: 12px;
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
    box-shadow: 0 0 20px rgba(59, 130, 246, 0.6), 0 0 40px rgba(34, 211, 238, 0.2);
  }

  .step-num {
    display: block;
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    color: var(--accent-primary);
    letter-spacing: 0.06em;
    margin-bottom: 8px;
  }

  .step-content h3 {
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 12px;
    letter-spacing: -0.02em;
    line-height: 1.2;
    transition: color 0.3s;
  }

  .process-step.active .step-content h3 {
    color: var(--text-primary);
  }

  .step-content p {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* Right: Stats Dashboard */
  .process-mockup {
    position: sticky;
    top: 140px;
    align-self: start;
  }

  .stats-dashboard {
    background: linear-gradient(180deg, rgba(17, 24, 39, 0.8) 0%, rgba(5, 8, 22, 0.9) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 40px 80px rgba(0, 0, 0, 0.5);
    transition: all 0.5s var(--transition);
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .stats-dashboard:hover {
    border-color: rgba(59, 130, 246, 0.2);
    box-shadow: 0 48px 96px rgba(0, 0, 0, 0.5), 0 0 40px rgba(59, 130, 246, 0.05);
    transform: translateY(-4px);
  }

  .stats-dashboard-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    background: rgba(17, 24, 39, 0.4);
  }

  .stats-dashboard-header span {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10B981;
    position: relative;
    animation: livePulse 2s ease-in-out infinite;
  }

  @keyframes livePulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4); }
    50% { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
  }

  .stats-dashboard-body {
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    flex: 1;
  }

  .main-stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .main-stat-label {
    font-size: 12px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .main-stat-value {
    font-family: var(--font-heading);
    font-size: 36px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .main-stat-change {
    font-size: 13px;
    font-weight: 600;
    color: #34D399;
  }

  .mini-chart {
    height: 80px;
  }

  .chart-bars {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    height: 100%;
  }

  .chart-bar {
    flex: 1;
    background: linear-gradient(180deg, rgba(59, 130, 246, 0.6), rgba(59, 130, 246, 0.1));
    border-radius: 3px 3px 0 0;
    animation: barGrow 0.8s ease-out backwards;
    min-height: 4px;
  }

  @keyframes barGrow {
    from { height: 0 !important; }
  }

  .stat-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: auto;
  }

  .stat-grid-item {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-md);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    transition: all 0.3s;
  }

  .stat-grid-item:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
  }

  .sg-label {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .sg-value {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .sg-change {
    font-size: 12px;
    font-weight: 600;
  }

  .sg-change.up {
    color: #34D399;
  }

  .sg-change.down {
    color: #34D399;
  }

  @media (max-width: 1024px) {
    .process-header { text-align: center; margin: 0 auto 80px; }
    .process-layout { grid-template-columns: 1fr; gap: 60px; }
    .process-mockup { position: relative; top: 0; max-width: 520px; margin: 0 auto; }
    .step-content h3 { font-size: 24px; }
    .process-step { opacity: 1; }
  }

  @media (max-width: 640px) {
    .process-section { padding: 100px 0; }
    .process-step { gap: 16px; padding-bottom: 36px; }
    .step-content h3 { font-size: 22px; }
    .stats-dashboard-body { padding: 20px 16px; }
    .main-stat-value { font-size: 28px; }
    .stat-grid { gap: 10px; }
    .stat-grid-item { padding: 12px; }
  }
</style>

<script is:inline>
  (function() {
    // Active step highlighting based on scroll
    const steps = document.querySelectorAll('.process-step');
    if (!steps.length) return;

    const stepObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            steps.forEach((s) => s.classList.remove('active'));
            entry.target.classList.add('active');
          }
        });
      },
      { threshold: 0.5, rootMargin: '-100px 0px -40% 0px' }
    );

    steps.forEach((step) => stepObserver.observe(step));
  })();
</script>
