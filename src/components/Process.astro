---
const steps = [
  {
    num: '01',
    title: 'We Find the Leaks',
    desc: 'Before we write a line of code, we audit your funnel, reverse-engineer your competitors, and map exactly where your prospects are dropping off.',
  },
  {
    num: '02',
    title: 'We Build to Convert',
    desc: 'Every headline, button, and scroll trigger is engineered for action. No aesthetic fluff. Just behavioral psychology applied to every pixel.',
  },
  {
    num: '03',
    title: 'We Launch & Optimize',
    desc: 'The launch is day one. We measure, A/B test, and refine — so your results compound week over week while you focus on closing deals.',
  },
];

// Honesty rule: only verifiable positioning facts here — no invented success
// metrics (this section previously claimed a 94% success rate / 78% referral
// rate that a new studio cannot substantiate).
const bottomStats = [
  { value: '4-6 weeks', label: 'Average timeline' },
  { value: '<2s', label: 'Load-time target' },
  { value: '100%', label: 'Founder-built, never outsourced' },
];
---

<section class="process-section" id="process">
  <div class="container">
    <div class="process-header reveal">
      <p class="section-label">How It Works</p>
      <h2 class="section-title">Three Steps. One Outcome: Growth.</h2>
      <p class="section-subtitle">No surprises. No scope creep. Just a rigorous system that transforms your website from a cost center into your most profitable channel.</p>
    </div>

    <div class="process-grid stagger-children">
      {steps.map((step, i) => (
        <div class="process-step stagger-item reveal" style={`transition-delay: ${i * 120}ms`}>
          <span class="step-number">{step.num}</span>
          <h3>{step.title}</h3>
          <p>{step.desc}</p>
        </div>
      ))}
    </div>

    <div class="process-bottom-stats reveal">
      {bottomStats.map(stat => (
        <div class="process-stat">
          <span class="process-stat-value">{stat.value}</span>
          <span class="process-stat-label">{stat.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .process-section {
    padding: 180px 0;
    position: relative;
  }

  .process-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }

  .process-header {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 100px;
  }

  .process-header .section-title {
    margin-left: auto;
    margin-right: auto;
  }

  .process-header .section-subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin-bottom: 80px;
  }

  .process-step {
    text-align: center;
    padding: 40px;
  }

  .step-number {
    display: block;
    font-family: var(--font-heading);
    font-size: 64px;
    font-weight: 700;
    color: var(--accent-primary);
    opacity: 0.25;
    line-height: 1;
    margin-bottom: 20px;
  }

  .process-step h3 {
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 14px;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .process-step p {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .process-bottom-stats {
    display: flex;
    justify-content: center;
    gap: 80px;
    padding-top: 60px;
    border-top: 1px solid var(--border);
  }

  .process-stat {
    text-align: center;
  }

  .process-stat-value {
    display: block;
    font-family: var(--font-heading);
    font-size: 28px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 6px;
    letter-spacing: -0.02em;
  }

  .process-stat-label {
    font-size: 14px;
    color: var(--text-muted);
    font-weight: 500;
  }

  @media (max-width: 1024px) {
    .process-header { text-align: center; margin: 0 auto 80px; }
    .process-grid { grid-template-columns: 1fr; gap: 20px; max-width: 520px; margin: 0 auto 60px; }
    .process-bottom-stats { gap: 40px; }
  }

  @media (max-width: 640px) {
    .process-section { padding: 100px 0; }
    .step-number { font-size: 48px; }
    .process-step { padding: 24px; }
    .process-bottom-stats { flex-direction: column; gap: 24px; }
  }
</style>
