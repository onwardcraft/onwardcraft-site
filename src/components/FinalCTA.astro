---
const { dark = false } = Astro.props;
---

<section class={`cta-section ${dark ? 'cta-section-dark' : ''}`} id="contact">
  <div class="container">
    <div class={`cta-card ${dark ? 'cta-card-dark' : ''}`}>
      <div class="cta-content">
        <h2>Ready to Stop Losing Leads?</h2>
        <p>Book a free 30-minute Revenue Audit. We'll diagnose your funnel, reverse-engineer your top competitors, and show you exactly where your site is hemorrhaging revenue.</p>

        <ul class="cta-bullets">
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            No pitch deck — just a precise diagnosis
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            Leave with a clear fix-it roadmap
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            100% free. No commitment required.
          </li>
        </ul>

        <div class="cta-actions">
          <a href="https://calendly.com/getonwardcraft/30min" class="btn-primary">
            Book My Free Audit
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/pricing" class={`cta-secondary ${dark ? 'cta-secondary-dark' : ''}`}>Or view pricing first →</a>
        </div>

        <p class={`cta-urgency ${dark ? 'cta-urgency-dark' : ''}`}>Limited to 5 audits per week. Average response time: under 4 hours.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding: 120px 0 80px;
    position: relative;
  }

  .cta-card {
    background: rgba(17, 24, 39, 0.5);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 80px;
    text-align: center;
  }

  .cta-content {
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-content h2 {
    font-size: clamp(32px, 4.5vw, 52px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 20px;
    color: var(--text-primary);
  }

  .cta-content > p {
    font-size: 18px;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 32px;
  }

  .cta-bullets {
    list-style: none;
    text-align: left;
    max-width: 360px;
    margin: 0 auto 36px;
  }

  .cta-bullets li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    color: var(--text-secondary);
    margin-bottom: 12px;
  }

  .cta-bullets svg {
    color: var(--accent-primary);
    flex-shrink: 0;
  }

  .cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .cta-actions .btn-primary {
    padding: 16px 32px;
    font-size: 16px;
  }

  .cta-secondary {
    font-size: 15px;
    color: var(--text-muted);
    font-weight: 500;
    transition: color 0.3s;
  }

  .cta-secondary:hover {
    color: var(--text-secondary);
  }

  .cta-urgency {
    font-size: 13px;
    color: var(--text-muted);
    font-weight: 500;
  }

  /* Dark variant for blog pages */
  .cta-card-dark {
    background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);
    border-color: rgba(255,255,255,0.1);
  }
  .cta-card-dark .cta-content h2 {
    color: #ffffff;
  }
  .cta-card-dark .cta-content > p {
    color: rgba(255,255,255,0.85);
  }
  .cta-card-dark .cta-bullets li {
    color: rgba(255,255,255,0.8);
  }
  .cta-secondary-dark {
    color: rgba(255,255,255,0.6);
  }
  .cta-secondary-dark:hover {
    color: rgba(255,255,255,0.9);
  }
  .cta-urgency-dark {
    color: rgba(255,255,255,0.5);
  }

  @media (max-width: 768px) {
    .cta-card { padding: 48px 28px; }
    .cta-content h2 { font-size: 28px; }
    .cta-content > p { font-size: 16px; }
    .cta-actions { flex-direction: column; gap: 16px; }
    .cta-actions .btn-primary { width: 100%; max-width: 320px; justify-content: center; }
  }
</style>
