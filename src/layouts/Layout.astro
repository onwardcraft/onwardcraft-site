---
import { SITE, AUTHOR } from '../data/site.js';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  schema?: object | object[];
  /** Article pages get a slightly narrower measure and no hero rule. */
  variant?: 'default' | 'article';
}
const {
  title = `${SITE.name} — ${SITE.tagline}`,
  description = SITE.description,
  canonical,
  ogType = 'website',
  ogImage = `${SITE.url}/og-image.png`,
  schema,
} = Astro.props;

const pathname = Astro.url.pathname;
const canonicalPath = pathname === '/' ? '/' : pathname.endsWith('/') ? pathname : pathname + '/';
const canonicalUrl = canonical || `${SITE.url}${canonicalPath}`;

// Sitewide structured data. This site is a publication, so the root entity is
// an Organization acting as a `publisher`, plus a Blog node that every Article
// points back to. Page-specific schema (Article, FAQPage, BreadcrumbList…)
// arrives via the `schema` prop.
//
// sameAs stays omitted while empty — shipping an empty array tells AI systems
// "no entity presence" rather than nothing at all. Add profile URLs as created.
const sameAs: string[] = [];
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  url: `${SITE.url}/`,
  logo: {
    '@type': 'ImageObject',
    '@id': `${SITE.url}/#logo`,
    url: `${SITE.url}/logo.png`,
    width: 1228,
    height: 206,
  },
  image: ogImage,
  description: SITE.description,
  email: SITE.email,
  foundingDate: SITE.founded,
  knowsAbout: [
    'Search Engine Optimization',
    'Local SEO',
    'Small Business Marketing',
    'Web Design',
    'Conversion Rate Optimization',
    'Content Marketing',
  ],
  ...(sameAs.length > 0 ? { sameAs } : {}),
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: `${SITE.url}/`,
  name: SITE.name,
  description: SITE.description,
  inLanguage: SITE.language,
  publisher: { '@id': `${SITE.url}/#organization` },
};
const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${SITE.url}/#blog`,
  url: `${SITE.url}/blog/`,
  name: `${SITE.name} — ${SITE.tagline}`,
  description: SITE.description,
  inLanguage: SITE.language,
  publisher: { '@id': `${SITE.url}/#organization` },
  author: { '@id': `${SITE.url}/#desk` },
  isPartOf: { '@id': `${SITE.url}/#website` },
};
const deskSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#desk`,
  name: AUTHOR.name,
  description: AUTHOR.bio,
  url: `${SITE.url}/about/`,
  parentOrganization: { '@id': `${SITE.url}/#organization` },
};
const pageSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const allSchemas = [orgSchema, websiteSchema, blogSchema, deskSchema, ...pageSchemas];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} — ${SITE.tagline}`} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${SITE.name} — ${SITE.tagline}`} />

    {allSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Latest`} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" href="/logo/fabicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-2MNB80FGW4"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-2MNB80FGW4');
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />

    <script>
      document.body.classList.add('js-enabled');

      // ── Reading progress bar (articles and guides only) ──
      (function () {
        const bar = document.getElementById('readProgress');
        const article = document.querySelector('[data-progress-target]');
        if (!bar || !article) return;
        const update = () => {
          const rect = article.getBoundingClientRect();
          const total = rect.height - window.innerHeight;
          const seen = Math.min(Math.max(-rect.top, 0), Math.max(total, 1));
          bar.style.transform = `scaleX(${total > 0 ? seen / total : 0})`;
        };
        update();
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update, { passive: true });
      })();

      // ── Analytics: newsletter is the only conversion event on the site ──
      (function () {
        document.addEventListener('submit', function (e) {
          const form = (e.target as HTMLElement).closest('.newsletter-form');
          if (!form) return;
          gtag && gtag('event', 'newsletter_signup', {
            event_category: 'engagement',
            form_location: form.getAttribute('data-location') || 'unknown',
          });
        });

        // Outbound + internal article clicks, for reading-path analysis.
        document.addEventListener('click', function (e) {
          const link = (e.target as HTMLElement).closest('a');
          if (!link) return;
          const href = link.getAttribute('href') || '';
          if (href.startsWith('/blog/')) {
            gtag && gtag('event', 'article_click', {
              event_category: 'engagement',
              event_label: (link.textContent || '').trim().slice(0, 80),
              destination: href,
            });
          }
        });
      })();

      // ── Reveal on scroll ──
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.06, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>

<style is:global>
  /* ============================================================
     OnwardCraft — modern SEO-publication design system.
     White canvas, near-black type, one violet accent, a single
     geometric sans for display over Inter for everything else.
     Card-led layout: rounded surfaces, hairline borders, soft
     lift on hover. Light only — the archive pages are dense.
     ============================================================ */
  :root {
    --paper: #FFFFFF;          /* page background */
    --paper-2: #F6F7FB;        /* recessed panels, table stripes, cards */
    --paper-3: #EDEFF6;        /* deeper wells */
    --ink: #0E1220;            /* headlines, primary text */
    --ink-2: #3C4256;          /* body copy */
    --ink-3: #6B7387;          /* meta, captions, muted */
    --rule: #E6E8F0;           /* hairlines */
    --rule-strong: #CFD3E2;
    --accent: #5B33EF;         /* violet — links, tags, CTAs */
    --accent-deep: #4522C4;
    --accent-soft: #EFEAFE;
    --accent-wash: rgba(91, 51, 239, 0.08);
    --ink-invert: #FFFFFF;
    --navy: #0E1220;           /* dark bands and footer */
    --navy-2: #181D31;

    --font-display: 'Plus Jakarta Sans', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-read: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-ui: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;

    --container: 1200px;
    --measure: 720px;          /* article line length */
    --radius: 10px;
    --radius-lg: 16px;
    --shadow-sm: 0 1px 2px rgba(14, 18, 32, 0.05);
    --shadow: 0 6px 24px rgba(14, 18, 32, 0.07);
    --shadow-lg: 0 18px 44px rgba(14, 18, 32, 0.12);
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
  }

  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  html {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation-duration: 0.001ms !important; transition-duration: 0.001ms !important; }
  }

  body {
    font-family: var(--font-ui);
    background: var(--paper);
    color: var(--ink-2);
    line-height: 1.65;
    overflow-x: hidden;
    font-size: 16px;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-display);
    color: var(--ink);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.022em;
  }

  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; display: block; }

  .skip-link {
    position: absolute; left: -9999px; top: 0; z-index: 2000;
    background: var(--ink); color: var(--ink-invert);
    padding: 12px 20px; font-size: 14px; font-weight: 600; border-radius: var(--radius);
  }
  .skip-link:focus { left: 12px; top: 12px; }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .container {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 32px;
  }
  .container-narrow {
    max-width: 840px;
    margin: 0 auto;
    padding: 0 32px;
  }
  @media (max-width: 768px) {
    .container, .container-narrow { padding: 0 20px; }
  }

  /* ── Eyebrows / tags ──────────────────────────────────────── */
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
  }
  .kicker--muted { color: var(--ink-3); }

  /* A pill tag, the way category labels read on card grids. */
  .tag {
    display: inline-flex;
    align-items: center;
    padding: 5px 11px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-deep);
    font-family: var(--font-ui);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background 0.18s var(--ease), color 0.18s var(--ease);
  }
  a.tag:hover { background: var(--accent); color: #fff; }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }
  .section-head h2 {
    font-size: clamp(25px, 3vw, 34px);
    letter-spacing: -0.028em;
  }
  .section-head .section-more {
    font-family: var(--font-ui);
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
  }
  .section-head .section-more:hover { text-decoration: underline; }

  /* ── Buttons ──────────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 13px 24px;
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 600;
    border-radius: var(--radius);
    border: 1px solid transparent;
    cursor: pointer;
    transition: background 0.2s var(--ease), color 0.2s var(--ease),
                border-color 0.2s var(--ease), transform 0.2s var(--ease),
                box-shadow 0.2s var(--ease);
  }
  .btn-primary { background: var(--accent); color: #fff; box-shadow: var(--shadow-sm); }
  .btn-primary:hover { background: var(--accent-deep); transform: translateY(-1px); box-shadow: var(--shadow); }
  .btn-secondary { background: var(--paper); color: var(--ink); border-color: var(--rule-strong); }
  .btn-secondary:hover { border-color: var(--ink); background: var(--paper-2); }

  /* ── Reveal ───────────────────────────────────────────────── */
  .reveal { opacity: 1; transform: none; transition: opacity 0.6s var(--ease), transform 0.6s var(--ease); }
  body.js-enabled .reveal:not(.revealed) { opacity: 0; transform: translateY(16px); }

  /* ── Reading progress ─────────────────────────────────────── */
  .read-progress {
    position: fixed; top: 0; left: 0; right: 0; height: 3px;
    background: var(--accent); transform: scaleX(0); transform-origin: 0 50%;
    z-index: 1200; pointer-events: none;
  }

  /* ── Shared article/story card ────────────────────────────── */
  .story {
    display: block;
    padding: 20px;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .story:hover { border-color: var(--rule-strong); box-shadow: var(--shadow); transform: translateY(-2px); }
  .story__cat {
    font-family: var(--font-ui);
    font-size: 11.5px; font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--accent);
  }
  .story__title {
    font-size: 19px;
    line-height: 1.28;
    margin: 10px 0 8px;
    transition: color 0.18s var(--ease);
  }
  .story:hover .story__title { color: var(--accent); }
  .story__dek {
    font-family: var(--font-read);
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-3);
  }
  .story__meta {
    margin-top: 12px;
    font-family: var(--font-ui);
    font-size: 12.5px;
    color: var(--ink-3);
  }

  /* ── Tables shared by guides + articles ───────────────────── */
  .oc-table {
    width: 100%; border-collapse: separate; border-spacing: 0;
    font-family: var(--font-ui); font-size: 14.5px;
    border: 1px solid var(--rule); border-radius: var(--radius); overflow: hidden;
  }
  .oc-table th {
    text-align: left; padding: 13px 16px;
    font-size: 11.5px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink-invert); background: var(--ink);
  }
  .oc-table td { padding: 13px 16px; border-bottom: 1px solid var(--rule); color: var(--ink-2); }
  .oc-table tbody tr:nth-child(even) { background: var(--paper-2); }
  .oc-table tbody tr:last-child td { border-bottom: none; }

  /* ── Breadcrumbs (articles and guides) ────────────────────── */
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--font-ui);
    font-size: 13px;
    color: var(--ink-3);
    margin-bottom: 24px;
  }
  .crumbs a:hover { color: var(--accent); text-decoration: underline; }

  /* ── Sidebar rail primitives (articles and guides) ────────── */
  .rail__sticky { position: sticky; top: 92px; display: flex; flex-direction: column; gap: 20px; }
  .rail__box {
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    padding: 20px;
  }
  .rail__h {
    font-family: var(--font-ui);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 12px;
  }
  @media (max-width: 1040px) { .rail__sticky { position: static; } }

  ::selection { background: var(--accent-wash); color: var(--ink); }
  ::-webkit-scrollbar { width: 10px; }
  ::-webkit-scrollbar-track { background: var(--paper-2); }
  ::-webkit-scrollbar-thumb { background: var(--rule-strong); border-radius: 999px; }
  ::-webkit-scrollbar-thumb:hover { background: var(--ink-3); }
</style>
