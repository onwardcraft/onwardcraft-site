---
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  schema?: object | object[];
}
const {
  title = "OnwardCraft — We Turn Websites Into Revenue Machines",
  description = "Conversion-focused websites, SEO, and lead generation for home-service contractors — roofing, HVAC, plumbing, solar, electrical, and restoration.",
  canonical,
  ogType = "website",
  ogImage = "https://onwardcraft.com/og-image.png",
  schema,
} = Astro.props;

const pathname = Astro.url.pathname;
const canonicalPath = pathname === '/' ? '/' : pathname.endsWith('/') ? pathname : pathname + '/';
const canonicalUrl = canonical || `https://onwardcraft.com${canonicalPath}`;

// Sitewide structured data (Organization + WebSite). Page-specific schema
// (Service, FAQPage, BreadcrumbList…) is passed in via the `schema` prop.
// Real external profiles only — never ship an empty sameAs array (it signals
// "no entity presence" to AI systems). Add LinkedIn/Clutch/Crunchbase/YouTube
// URLs here as each profile is created; the key is omitted while the list is empty.
const sameAs: string[] = [];
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://onwardcraft.com/#organization",
  name: "OnwardCraft",
  url: "https://onwardcraft.com/",
  logo: {
    "@type": "ImageObject",
    "@id": "https://onwardcraft.com/#logo",
    url: "https://onwardcraft.com/logo.png",
    width: 1246,
    height: 206,
  },
  image: "https://onwardcraft.com/og-image.png",
  description: "Conversion-focused web design, SEO, and lead generation for home-service contractors.",
  email: "getonwardcraft@gmail.com",
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "sales",
    email: "getonwardcraft@gmail.com",
    url: "https://onwardcraft.com/book-call/",
    areaServed: "US",
    availableLanguage: "English",
  },
  areaServed: "United States",
  knowsAbout: ["Web Design", "Search Engine Optimization", "Lead Generation", "Local SEO", "Conversion Rate Optimization", "Home Services Marketing"],
  ...(sameAs.length > 0 ? { sameAs } : {}),
};
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://onwardcraft.com/#website",
  url: "https://onwardcraft.com/",
  name: "OnwardCraft",
  publisher: { "@id": "https://onwardcraft.com/#organization" },
};
const pageSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const allSchemas = [orgSchema, websiteSchema, ...pageSchemas];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="OnwardCraft — conversion-focused websites, SEO & lead generation for contractors" />
    <meta property="og:site_name" content="OnwardCraft" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="OnwardCraft — conversion-focused websites, SEO & lead generation for contractors" />

    <!-- Structured data -->
    {allSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" href="/logo/fabicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#080C14" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://api.fontshare.com/v2/css?f[]=satoshi@500,600,700,800,900&display=swap" rel="stylesheet" />

    <slot name="head" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-2MNB80FGW4"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-2MNB80FGW4');
    </script>
  </head>
  <body>
    <slot />

    <script>
      document.body.classList.add('js-enabled');

      // ── GA4 Event Tracking ──
      (function () {
        function getCtaLocation(el) {
          const section = el.closest('section[id]');
          if (section) return section.id;
          const component = el.closest('[class*="cta"], [class*="hero"], [class*="pricing"], [class*="navbar"], [class*="footer"]');
          if (component) {
            const cls = component.className;
            if (cls.includes('hero')) return 'hero';
            if (cls.includes('navbar')) return 'navbar';
            if (cls.includes('pricing')) return 'pricing';
            if (cls.includes('footer')) return 'footer';
            if (cls.includes('cta')) return 'cta_section';
          }
          return 'unknown';
        }

        // Track CTA link clicks
        document.addEventListener('click', function (e) {
          const link = e.target.closest('a');
          if (!link) return;

          const href = link.getAttribute('href') || '';
          const text = (link.textContent || '').trim();
          const location = getCtaLocation(link);

          // Calendly bookings
          if (href.includes('calendly.com')) {
            gtag && gtag('event', 'cta_click', {
              event_category: 'engagement',
              event_label: text || 'Book a Call',
              destination: 'calendly',
              cta_location: location,
            });
            return;
          }

          // Contact page / #contact
          if (href === '/contact' || href === '#contact') {
            gtag && gtag('event', 'cta_click', {
              event_category: 'engagement',
              event_label: text || 'Contact',
              destination: 'contact',
              cta_location: location,
            });
            return;
          }

          // Pricing page
          if (href === '/pricing') {
            gtag && gtag('event', 'cta_click', {
              event_category: 'engagement',
              event_label: text || 'Pricing',
              destination: 'pricing',
              cta_location: location,
            });
            return;
          }

          // Case studies
          if (href === '/case-studies') {
            gtag && gtag('event', 'cta_click', {
              event_category: 'engagement',
              event_label: text || 'Case Studies',
              destination: 'case_studies',
              cta_location: location,
            });
            return;
          }
        });

        // Track contact form submissions
        const contactForm = document.querySelector('.contact-form');
        if (contactForm) {
          contactForm.addEventListener('submit', function () {
            const need = contactForm.querySelector('input[name="need"]:checked')?.value || '';
            const budget = contactForm.querySelector('input[name="budget"]:checked')?.value || '';

            gtag && gtag('event', 'form_submit', {
              event_category: 'lead',
              event_label: 'contact_form',
              form_id: 'contact',
              need_type: need,
              budget_range: budget,
            });
          });
        }
      })();

      // ── IntersectionObserver reveal ──
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal, .stagger-children').forEach((el) => observer.observe(el));

      document.querySelectorAll('.stagger-children').forEach((parent) => {
        const children = parent.querySelectorAll('.stagger-item');
        children.forEach((child, i) => {
          (child as HTMLElement).style.transitionDelay = `${i * 100}ms`;
        });
      });

      // ── Active nav section tracking ──
      const navLinks = document.querySelectorAll('.nav-link');
      const sections = document.querySelectorAll('section[id]');
      if (navLinks.length && sections.length) {
        const sectionObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const id = entry.target.getAttribute('id');
                navLinks.forEach((link) => {
                  link.classList.toggle('active', link.getAttribute('href') === '#' + id);
                });
              }
            });
          },
          { threshold: 0.3, rootMargin: '-80px 0px -60% 0px' }
        );
        sections.forEach((s) => sectionObserver.observe(s));
      }

      // ── Counter animation ──
      document.querySelectorAll('.counter').forEach((el) => {
        const target = parseFloat(el.getAttribute('data-target') || '0');
        const suffix = el.getAttribute('data-suffix') || '';
        const prefix = el.getAttribute('data-prefix') || '';
        const duration = parseInt(el.getAttribute('data-duration') || '2200', 10);
        const isFloat = target % 1 !== 0;

        const counterObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const startTime = performance.now();
                const animate = (now: number) => {
                  const elapsed = now - startTime;
                  const progress = Math.min(elapsed / duration, 1);
                  const eased = 1 - Math.pow(1 - progress, 4);
                  const current = eased * target;
                  el.textContent = prefix + (isFloat ? current.toFixed(1) : Math.floor(current).toLocaleString()) + suffix;
                  if (progress < 1) requestAnimationFrame(animate);
                };
                requestAnimationFrame(animate);
                counterObserver.unobserve(el);
              }
            });
          },
          { threshold: 0.5 }
        );
        counterObserver.observe(el);
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* Brand palette — "Luminous Dark, Structural Light" (see brand guide) */
    --bg-primary: #080C14;        /* Obsidian Void */
    --bg-secondary: #0F1D36;      /* Abyssal Navy */
    --bg-card: #111A2E;
    --bg-card-hover: #16223A;
    --accent-primary: #06D6A0;    /* Bioluminescent Teal */
    --accent-secondary: #14B8A6;  /* Teal (gradient end) */
    --accent-glow: #FFB84D;       /* Solar Gold */
    --accent-on: #03100B;         /* text/icon color on teal fills */
    --text-primary: #F8FAFC;      /* Polar White */
    --text-secondary: rgba(248, 250, 252, 0.82);
    --text-muted: rgba(248, 250, 252, 0.55);
    --border: rgba(255, 255, 255, 0.08);
    --border-hover: rgba(6, 214, 160, 0.28);
    --radius-sm: 12px;
    --radius-md: 16px;
    --radius-lg: 20px;
    --radius-xl: 24px;
    --font-heading: 'Satoshi', 'Space Grotesk', sans-serif;
    --font-body: 'Inter', sans-serif;
    --container: 1140px;
    --transition: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  *, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }

  body {
    font-family: var(--font-body);
    background: var(--bg-primary);
    color: var(--text-primary);
    line-height: 1.6;
    overflow-x: hidden;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; display: block; }

  /* Keyboard focus visibility (WCAG 2.4.7) — dark theme needs an explicit ring */
  :focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .container {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 40px;
  }

  @media (max-width: 768px) {
    .container { padding: 0 20px; }
  }

  /* ── Reveal animations ── */
  .reveal {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.8s var(--transition), transform 0.8s var(--transition);
  }

  .stagger-item {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.7s var(--transition), transform 0.7s var(--transition);
  }

  body.js-enabled .reveal:not(.revealed) {
    opacity: 0;
    transform: translateY(28px);
  }

  body.js-enabled .stagger-item:not(.revealed) {
    opacity: 0;
    transform: translateY(20px);
  }

  body.js-enabled .reveal.revealed,
  body.js-enabled .stagger-children.revealed .stagger-item,
  body.js-enabled .stagger-item.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Section label ── */
  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-primary);
    margin-bottom: 20px;
  }

  .section-label::before {
    content: '';
    width: 20px;
    height: 1px;
    background: linear-gradient(90deg, var(--accent-primary), var(--accent-secondary));
  }

  .section-title {
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 700;
    line-height: 1.05;
    margin-bottom: 20px;
    max-width: 720px;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .section-subtitle {
    font-size: 19px;
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 560px;
  }

  /* ── Buttons ── */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 32px;
    background: var(--accent-primary);
    color: var(--accent-on);
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    border-radius: var(--radius-md);
    border: none;
    cursor: pointer;
    transition: all 0.3s var(--transition);
    position: relative;
    overflow: hidden;
    text-decoration: none;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(6, 214, 160, 0.28);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 32px;
    background: transparent;
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 600;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-hover);
    cursor: pointer;
    transition: all 0.3s var(--transition);
    position: relative;
    overflow: hidden;
    text-decoration: none;
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  /* ── Simplified card base ── */
  .card {
    background: rgba(17, 24, 39, 0.5);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 40px;
    transition: all 0.3s var(--transition);
  }

  .card:hover {
    border-color: var(--border-hover);
    background: rgba(17, 24, 39, 0.65);
    transform: translateY(-4px);
  }

  /* ── Glass card ── */
  .glass-card {
    background: rgba(17, 24, 39, 0.55);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    transition: all 0.4s var(--transition);
  }

  .glass-card:hover {
    border-color: var(--border-hover);
    background: rgba(17, 24, 39, 0.7);
    transform: translateY(-4px);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.35);
  }

  /* ── Scrollbar ── */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: var(--bg-primary); }
  ::-webkit-scrollbar-thumb { background: var(--bg-card); border-radius: 3px; }
  ::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.12); }

  /* ── Selection ── */
  ::selection {
    background: rgba(6, 214, 160, 0.3);
    color: var(--text-primary);
  }
</style>
