---
import Layout from './Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE, AUTHOR } from '../data/site.js';
import { getPost, getRelatedPosts, categorySlug, PUBLISHED_ISO, PUBLISHED_LABEL } from '../data/posts.js';

export interface Props {
  title: string;
  description: string;
  category?: string;
  date?: string;
  readTime?: string;
  tags?: string[];
  contentHtml?: string;
  author?: string;
  schema?: object | object[];
}

const {
  title,
  description,
  contentHtml,
  tags = [],
  author = AUTHOR.name,
  schema,
} = Astro.props;

const displayTitle = title.replace(/^['"]+|['"]+$/g, '').trim();

// Derive the slug from the URL, then read the article's own metadata from the
// registry. The registry is the single source of truth for category, date and
// read time, so re-dating the library is a one-line change in posts.js rather
// than an edit to 28 files.
const slug = Astro.url.pathname.replace(/^\/blog\//, '').replace(/\/$/, '');
const record = getPost(slug);
const category = record?.category ?? Astro.props.category ?? 'SEO';
const date = record?.date ?? Astro.props.date ?? PUBLISHED_LABEL;
const isoDate = record?.isoDate ?? PUBLISHED_ISO;
const readTime = record?.readTime ?? Astro.props.readTime ?? '';
const canonical = `${SITE.url}/blog/${slug}/`;
const related = getRelatedPosts(slug, 4);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Articles', item: `${SITE.url}/blog/` },
    { '@type': 'ListItem', position: 3, name: category, item: `${SITE.url}/blog/category/${categorySlug(category)}/` },
    { '@type': 'ListItem', position: 4, name: displayTitle, item: canonical },
  ],
};
---

<Layout
  title={`${displayTitle} | ${SITE.name}`}
  description={description}
  canonical={canonical}
  ogType="article"
  schema={breadcrumbSchema}
>
  {schema && (
    <Fragment slot="head">
      <meta property="article:published_time" content={isoDate} />
      <meta property="article:modified_time" content={isoDate} />
      <meta property="article:section" content={category} />
      {(Array.isArray(schema) ? schema : [schema]).map((s) => (
        <script type="application/ld+json" set:html={JSON.stringify(s)} />
      ))}
    </Fragment>
  )}

  <div class="read-progress" id="readProgress"></div>
  <SiteHeader compact />

  <main id="main">
    <article class="article" data-progress-target>
      <div class="container article__grid">
        <div class="article__main">
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/blog/">Articles</a>
            <span aria-hidden="true">/</span>
            <a href={`/blog/category/${categorySlug(category)}/`}>{category}</a>
          </nav>

          <header class="article__head">
            <p class="kicker">{category}</p>
            <h1 class="article__title">{displayTitle}</h1>
            <p class="article__dek">{description}</p>
            <div class="article__byline">
              <span class="article__author">{author}</span>
              <span aria-hidden="true">·</span>
              <time datetime={isoDate}>{date}</time>
              {readTime && <><span aria-hidden="true">·</span><span>{readTime}</span></>}
            </div>
          </header>

          <div class="prose" set:html={contentHtml}>
            {!contentHtml && <slot />}
          </div>

          <Newsletter
            variant="inline"
            heading="Get the next one by email"
            blurb="One SEO email every other week — what changed in search and the checklist to act on it. Free, and we have nothing to sell you."
            location="article-footer"
          />

          {tags.length > 0 && (
            <ul class="tags" aria-label="Tags">
              {tags.map((tag) => <li>{tag}</li>)}
            </ul>
          )}

          <section class="related" aria-labelledby="related-h">
            <div class="section-head">
              <h2 id="related-h">Keep reading</h2>
              <a class="section-more" href="/blog/">All articles →</a>
            </div>
            <div class="related__grid">
              {related.map((p) => (
                <a class="related__item" href={`/blog/${p.slug}/`}>
                  <span class="related__cat">{p.category}</span>
                  <span class="related__title">{p.title}</span>
                  <span class="related__meta">{p.readTime}</span>
                </a>
              ))}
            </div>
          </section>
        </div>

        <aside class="article__rail">
          <div class="rail__sticky">
            <Newsletter variant="rail" heading="The OnwardCraft email" location="article-rail" />

            <div class="rail__box">
              <h2 class="rail__h">About this desk</h2>
              <p class="rail__body">{AUTHOR.bio}</p>
              <a class="rail__link" href="/about/">Our editorial standards →</a>
            </div>

            <div class="rail__box">
              <h2 class="rail__h">Share</h2>
              <div class="rail__share">
                <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(displayTitle)}&url=${encodeURIComponent(canonical)}`} target="_blank" rel="noopener noreferrer">X</a>
                <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonical)}`} target="_blank" rel="noopener noreferrer">LinkedIn</a>
                <a href={`mailto:?subject=${encodeURIComponent(displayTitle)}&body=${encodeURIComponent(canonical)}`}>Email</a>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </article>
  </main>

  <SiteFooter />
</Layout>

<style is:global>
  /* ============================================================
     Article page. Deliberately plain: one column of serif text on
     warm paper, a single rail, no boxes competing with the prose.
     ============================================================ */
  .article { padding: 44px 0 72px; }

  .article__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 64px;
    align-items: start;
  }
  .article__main { min-width: 0; max-width: var(--measure); }


  .article__head { padding-bottom: 28px; border-bottom: 1px solid var(--rule); margin-bottom: 36px; }
  .article__title {
    font-size: clamp(30px, 4.6vw, 48px);
    line-height: 1.05;
    margin: 14px 0 18px;
  }
  .article__dek {
    font-family: var(--font-read);
    font-size: 20px;
    line-height: 1.5;
    color: var(--ink-3);
  }
  .article__byline {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 22px;
    font-family: var(--font-ui);
    font-size: 13px;
    color: var(--ink-3);
  }
  .article__author { font-weight: 600; color: var(--ink-2); }

  /* ── Prose ────────────────────────────────────────────────── */
  .prose {
    font-family: var(--font-read);
    font-size: 19px;
    line-height: 1.72;
    color: var(--ink-2);
  }
  .prose > *:first-child { margin-top: 0; }
  .prose p { margin: 0 0 22px; }
  .prose .lead { font-size: 21px; line-height: 1.6; color: var(--ink); margin-bottom: 28px; }

  .prose h2 {
    font-size: 30px;
    line-height: 1.12;
    margin: 52px 0 18px;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
  }
  .prose h3 { font-size: 23px; margin: 36px 0 14px; }
  .prose h4 { font-size: 19px; font-family: var(--font-ui); font-weight: 700; margin: 28px 0 10px; letter-spacing: 0; }
  .prose h2 a, .prose h3 a, .prose h4 a { border-bottom: none; color: inherit; }

  .prose a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .prose a:hover { color: var(--accent-deep); text-decoration-thickness: 2px; }

  .prose ul, .prose ol { margin: 0 0 24px; padding-left: 24px; }
  .prose li { margin-bottom: 10px; }
  .prose li::marker { color: var(--accent); }
  .prose strong { color: var(--ink); font-weight: 600; }

  /* Table of contents — a plain boxed list, no counters or gradients. */
  .prose .toc {
    background: var(--paper-2);
    border-left: 3px solid var(--accent);
    padding: 22px 26px;
    margin: 0 0 40px;
    font-family: var(--font-ui);
    font-size: 15px;
  }
  .prose .toc h2, .prose .toc h4 {
    font-family: var(--font-ui);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0 0 14px;
    padding: 0;
    border: none;
  }
  .prose .toc ol, .prose .toc ul { margin: 0; padding-left: 20px; }
  .prose .toc li { margin-bottom: 7px; }
  .prose .toc a { color: var(--ink-2); text-decoration: none; }
  .prose .toc a:hover { color: var(--accent); text-decoration: underline; }

  /* Callouts — one flat style, differentiated by the rule colour only. */
  .prose .callout {
    background: var(--paper-2);
    border-left: 3px solid var(--rule-strong);
    padding: 20px 24px;
    margin: 30px 0;
    font-family: var(--font-ui);
    font-size: 16px;
    line-height: 1.6;
  }
  .prose .callout p { margin-bottom: 10px; }
  .prose .callout p:last-child { margin-bottom: 0; }
  .prose .callout p strong { display: block; font-size: 11.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 6px; }
  .prose .callout-tip, .prose .callout-success { border-left-color: #2F7D52; }
  .prose .callout-warning { border-left-color: #B8860B; }
  .prose .callout-info { border-left-color: var(--accent); }

  .prose blockquote, .prose .highlight-quote {
    border-left: 3px solid var(--accent);
    padding: 4px 0 4px 24px;
    margin: 32px 0;
  }
  .prose blockquote p, .prose .highlight-quote p {
    font-size: 21px;
    line-height: 1.5;
    font-style: italic;
    color: var(--ink);
    margin-bottom: 0;
  }

  /* Tables */
  .prose table, .prose .cost-table table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-ui);
    font-size: 15px;
    margin: 0;
  }
  .prose .cost-table { margin: 30px 0; overflow-x: auto; border: 1px solid var(--rule); }
  .prose th { text-align: left; padding: 12px 16px; background: var(--ink); color: var(--ink-invert); font-size: 11.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  .prose td { padding: 12px 16px; border-bottom: 1px solid var(--rule); }
  .prose tbody tr:nth-child(even) { background: var(--paper-2); }
  .prose tbody tr:last-child td { border-bottom: none; }

  /* The old templates shipped sales CTAs inside article bodies. This site has
     nothing to sell, so they are flattened into a plain note rather than left
     as dark gradient panels with a button. */
  .prose .cta-box {
    background: var(--paper-2);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 26px;
    margin: 36px 0;
    text-align: left;
  }
  .prose .cta-box h3 { font-size: 21px; margin: 0 0 10px; }
  .prose .cta-box p { font-family: var(--font-ui); font-size: 16px; margin-bottom: 14px; }
  .prose .cta-box a, .prose .cta-box .cta-button {
    display: inline-block;
    padding: 11px 20px;
    background: var(--ink);
    color: var(--ink-invert);
    font-family: var(--font-ui);
    font-size: 14px;
    font-weight: 600;
    border-radius: var(--radius);
    text-decoration: none;
  }
  .prose .cta-box a:hover, .prose .cta-box .cta-button:hover { background: var(--accent); color: #fff; }

  .prose .stat-card {
    background: var(--paper-2);
    border-left: 3px solid var(--accent);
    padding: 18px 22px;
    margin: 18px 0;
    font-family: var(--font-ui);
    font-size: 16px;
  }
  .prose .stat-card p { margin-bottom: 0; }
  .prose .stat-card strong { color: var(--accent); }

  .prose .conclusion {
    font-size: 19px;
    margin-top: 44px;
    padding: 26px;
    background: var(--paper-2);
    border-left: 3px solid var(--accent);
  }

  .prose code {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 15px;
    background: var(--paper-3);
    padding: 2px 6px;
    border-radius: 3px;
    color: var(--accent-deep);
  }
  .prose pre { background: var(--ink); color: #EDE6DA; padding: 20px; overflow-x: auto; margin: 26px 0; border-radius: var(--radius); }
  .prose pre code { background: none; color: inherit; font-size: 14px; padding: 0; }

  .prose hr { border: none; border-top: 1px solid var(--rule); margin: 44px 0; }
  .prose img { margin: 28px 0; border: 1px solid var(--rule); }

  /* ── Tags ─────────────────────────────────────────────────── */
  .tags { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 32px 0 0; }
  .tags li {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--ink-3);
    border: 1px solid var(--rule);
    padding: 5px 12px;
    border-radius: 100px;
  }

  /* ── Related ──────────────────────────────────────────────── */
  .related { margin-top: 56px; }
  .related__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 32px; }
  .related__item {
    display: block;
    padding: 18px 0;
    border-top: 1px solid var(--rule);
  }
  .related__item:hover .related__title { color: var(--accent); }
  .related__cat {
    display: block;
    font-family: var(--font-ui);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .related__title {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 17.5px;
    line-height: 1.2;
    color: var(--ink);
    margin: 8px 0 6px;
    transition: color 0.18s var(--ease);
  }
  .related__meta { font-family: var(--font-ui); font-size: 12px; color: var(--ink-3); }

  /* ── Rail ─────────────────────────────────────────────────── */
  .article__rail { font-family: var(--font-ui); }
  .rail__body { font-family: var(--font-read); font-size: 15.5px; line-height: 1.55; color: var(--ink-3); }
  .rail__link { display: inline-block; margin-top: 12px; font-size: 13px; font-weight: 600; color: var(--accent); }
  .rail__link:hover { text-decoration: underline; }
  .rail__share { display: flex; gap: 8px; flex-wrap: wrap; }
  .rail__share a {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-2);
    border: 1px solid var(--rule-strong);
    padding: 7px 14px;
    border-radius: var(--radius);
  }
  .rail__share a:hover { border-color: var(--ink); color: var(--accent); }

  @media (max-width: 1040px) {
    .article__grid { grid-template-columns: 1fr; gap: 48px; }
    .article__main { max-width: none; }
  }
  @media (max-width: 640px) {
    .article { padding: 28px 0 56px; }
    .prose { font-size: 18px; }
    .prose h2 { font-size: 25px; margin-top: 40px; }
    .prose h3 { font-size: 20px; }
    .article__dek { font-size: 18px; }
    .related__grid { grid-template-columns: 1fr; }
  }
</style>
